				local Selection = {}

				local function ResolveDropdownList(ListSource)
					local Source = ListSource
					if type(Source) == "function" then
						local Success, Result = pcall(Source)
						Source = Success and Result or {}
					end
					return typeof(Source) == "table" and Source or {}
				end

				local CurrentDropdownList = ResolveDropdownList(DropdownList)
				local DropdownRowHeight = 37
				local DropdownRowPadding = 5
				local DropdownTopPadding = 7
				local DropdownBottomPadding = 7
				local DropdownMinHeight = 44
				local DropdownMaxHeight = 175

				local function UpdateText()
					local Preview = ""
					if Selection and #Selection > 0 then
						for Index, Selected in Selection do
							Preview = Preview .. Selected.Button.Text .. ((#Selection == 1 or Index == #Selection) and "" or ", ")
						end
					else
						Preview = Default or CurrentDropdownList[1] or "None"
					end
					Search.Text = Preview
				end

				local Options = {}

				local function GetVisibleOptionCount()
					local Count = 0
					for _, Option in Options do
						if Option.Visible then
							Count += 1
						end
					end
					return Count
				end

				local function GetHolderHeight()
					local VisibleCount = GetVisibleOptionCount()
					local ContentHeight = DropdownTopPadding + DropdownBottomPadding
					if VisibleCount > 0 then
						ContentHeight += (VisibleCount * DropdownRowHeight) + ((VisibleCount - 1) * DropdownRowPadding)
					end
					return math.clamp(ContentHeight, DropdownMinHeight, DropdownMaxHeight)
				end

				local function ApplyDropdownHeight(Animated)
					local HolderHeight = GetHolderHeight()
					local BackHeight = DropdownRowHeight + 7 + HolderHeight
					local ListHeight = HolderHeight
					if Animated then
						TweenService:Create(Back, TweenInfo.new(.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, BackHeight) }):Play()
					else
						Back.Size = UDim2.new(1, 0, 0, BackHeight)
					end
					Holder.Size = UDim2.new(1, 0, 0, HolderHeight)
					List.Size = UDim2.new(1, 0, 0, ListHeight)
				end

				local function CreateOption(LayoutOrder, Name)
					local Button = Instance.new("TextButton")
					Button.Name = "Button"
					Button.Parent = List
					Button.BackgroundColor3 = Color3.fromRGB(34, 34, 57)
					Button.BorderColor3 = Color3.fromRGB(0, 0, 0)
					Button.BorderSizePixel = 0
					Button.Position = UDim2.new(0, 0, 0.161458328, 0)
					Button.Size = UDim2.new(1, -10, 0, 37)
					Button.AutoButtonColor = false
					Button.Font = Enum.Font.SourceSansBold
					Button.TextColor3 = Color3.fromRGB(255, 255, 255)
					Button.TextSize = 16.000
					Button.TextTransparency = 0.050
					Button.Text = Name
					Button.ClipsDescendants = false
					Button.LayoutOrder = LayoutOrder

					Library:RegisterThemeObject(Button, "BackgroundColor3", "Main")
					Library:RegisterThemeObject(Button, "TextColor3", "Text")

					local ButtonC = Instance.new("UICorner")
					ButtonC.CornerRadius = UDim.new(.1, 0)
					ButtonC.Name = "ButtonC"
					ButtonC.Parent = Button

					local function FindSelection(Button)
						for index, info in Selection do
							if info.Button == Button then
								return index, info
							end
						end
						return false
					end

					Util.Imports.Maid:register("Button_Callback" .. tostring(HttpService:GenerateGUID(false)), Button.Activated:Connect(function()
						local Index, Selected = FindSelection(Button)

						if MultiSelect then
							if Selected then
								Button.LayoutOrder = LayoutOrder
								table.remove(Selection, Index)
							else
								Button.LayoutOrder = 1
								table.insert(Selection, {
									Button      = Button,
									LayoutOrder = LayoutOrder,
								})
							end
						elseif not MultiSelect then
							if not Selected then
								for index, info in Selection do
									info.Button.LayoutOrder = info.LayoutOrder
								end
								Selection = {}
								Button.LayoutOrder = 1
								table.insert(Selection, {
									Button      = Button,
									LayoutOrder = LayoutOrder,
								})
							end
						end

						UpdateText()

						if MultiSelect then
							for _, option in Options do
								option.Visible = true
							end
							ApplyDropdownHeight(true)
						else
							for _, option in Options do
								option.Visible = true
							end
							TweenService:Create(Arrow, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 90 }):Play()
							TweenService:Create(Back, TweenInfo.new(.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 37) }):Play()
							Holder.Visible = false
						end

						local FilteredSelections = {}
						for index, selection in Selection do
							table.insert(FilteredSelections, selection.Button.Text)
						end
						CallBack(FilteredSelections)

						local NewTheme = Library:GetTheme()
						if MultiSelect then
							TweenService:Create(Button, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								TextColor3 = Selected and NewTheme.Text or NewTheme.Accent
							}):Play()
						else
							TweenService:Create(Button, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextColor3 = NewTheme.Accent }):Play()
							for _, option in Options do
								if option ~= Button then
									TweenService:Create(option, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { TextColor3 = NewTheme.Text }):Play()
								end
							end
						end
					end))

					return Button
				end

				local index1 = 0
				for index, option in CurrentDropdownList do
					index1 += 1
					Options[option] = CreateOption(index1 + 1, typeof(index) == "string" and index or option)
				end

				local NewDropdown = {}
				local TypingUUID
				Util.Imports.Maid:register("Dropdown_Callback" .. tostring(HttpService:GenerateGUID(false)), Search.Focused:Connect(function()
					NewDropdown:Refresh()
					Search.Text = ""
					Holder.Visible = true
					ApplyDropdownHeight(true)
					TweenService:Create(Arrow, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
					task.delay(0.12, function()
						EnsureControlVisible(Back, 10)
					end)

					TypingUUID = "Dropdown_Callback" .. tostring(HttpService:GenerateGUID(false))
					Util.Imports.Maid:register(TypingUUID, Search:GetPropertyChangedSignal("Text"):Connect(function()
						for _, option in Options do
							option.Visible = option.Text:lower():match(Search.Text:lower())
						end
						ApplyDropdownHeight(false)
					end))
				end))

				Util.Imports.Maid:register("Dropdown_Callback" .. tostring(HttpService:GenerateGUID(false)), Search.FocusLost:Connect(function()
					Util.Imports.Maid:deregister(TypingUUID)
					UpdateText()
				end))

				UIListLayout.Parent = List
				UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
				UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
				UIListLayout.Padding = UDim.new(0, 5)

				UIPadding.Parent = List
				UIPadding.PaddingTop = UDim.new(0, 7)
				UIPadding.PaddingBottom = UDim.new(0, 7)

				local HolderC = Instance.new("UICorner")
				HolderC.CornerRadius = UDim.new(0, 7)
				HolderC.Name = "HolderC"
				HolderC.Parent = Holder

				Holder.Visible = false
				task.defer(RefreshSectionSize)

				Util.Imports.Maid:register("Dropdown_Callback" .. tostring(HttpService:GenerateGUID(false)), Arrow.Activated:Connect(function()
					if not Holder.Visible then
						NewDropdown:Refresh()
						Holder.Visible = true
						ApplyDropdownHeight(true)
						TweenService:Create(Arrow, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 0 }):Play()
						task.delay(0.12, function()
							EnsureControlVisible(Back, 10)
						end)
					else
						TweenService:Create(Arrow, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Rotation = 90 }):Play()
						TweenService:Create(Back, TweenInfo.new(.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(1, 0, 0, 37) }):Play()
						Holder.Visible = false
					end
				end))

				function NewDropdown:Set(List)
					if List and List[1] then
						local Name = List[1]
						Selection = {}
						local Theme = Library:GetTheme()

						-- Update text and internal state
						if Name ~= "None" and Options[Name] then
							table.insert(Selection, {
								Button = Options[Name],
								LayoutOrder = Options[Name].LayoutOrder
							})
							Search.Text = Name
						else
							Search.Text = "None"
						end

						-- Update visual highlighting
						for OptionName, Button in Options do
							local IsSelected = false
							for _, Sel in Selection do
								if Sel.Button == Button then
									IsSelected = true
									break
								end
							end
							TweenService:Create(Button, TweenInfo.new(.2), {
								TextColor3 = IsSelected and Theme.Accent or Theme.Text
							}):Play()
						end

						if Callback then
							task.spawn(Callback, {Name})
						end
					end
				end

				function NewDropdown:Refresh(NewList)
					if NewList then
						DropdownList = NewList
					end
					local PreviousSelectionTexts = {}
					for _, Info in Selection do
						if Info and Info.Button and Info.Button.Text then
							table.insert(PreviousSelectionTexts, Info.Button.Text)
						end
					end

					CurrentDropdownList = ResolveDropdownList(DropdownList)
					for _, Option in Options do
						Option:Destroy()
					end
					Options = {}
					local index1 = 0
					for index, option in CurrentDropdownList do
						index1 += 1
						Options[option] = CreateOption(index1 + 1, typeof(index) == "string" and index or option)
					end

					Selection = {}
					if MultiSelect then
						for _, SelectedText in ipairs(PreviousSelectionTexts) do
							if Options[SelectedText] then
								local Btn = Options[SelectedText]
								table.insert(Selection, {
									Button = Btn,
									LayoutOrder = Btn.LayoutOrder,
								})
								Btn.LayoutOrder = 1
							end
						end
						UpdateText()
						local Theme = Library:GetTheme()
						for _, Button in Options do
							local IsSelected = false
							for _, Sel in Selection do
								if Sel.Button == Button then
									IsSelected = true
									break
								end
							end
							TweenService:Create(Button, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
								TextColor3 = IsSelected and Theme.Accent or Theme.Text
							}):Play()
						end
					else
						local SelectedText = PreviousSelectionTexts[1]
						if SelectedText and Options[SelectedText] then
							NewDropdown:Set({ SelectedText })
						else
							UpdateText()
							local Theme = Library:GetTheme()
							for _, Button in Options do
								TweenService:Create(Button, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
									TextColor3 = Theme.Text
								}):Play()
							end
						end
					end

					if Holder.Visible then
						ApplyDropdownHeight(false)
					end
				end

				NewDropdown.Selection = Selection
				NewDropdown.Options = Options
				table.insert(Library.Dropdowns, NewDropdown)
				return NewDropdown
			end

