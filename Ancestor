        table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    end

    panel = Instance.new("Frame")
    panel.Name                   = "AsciiArtPanel"
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel        = 0
    panel.AnchorPoint            = Vector2.new(0.5, 0.5)
    panel.Position               = UDim2.new(0.5, 0, 0.5, 0)
    panel.AutomaticSize          = Enum.AutomaticSize.Y
    panel.Size                   = UDim2.new(0, 380, 0, 0)
    panel.Visible                = false
    panel.ZIndex                 = 20
    panel.Parent = parent

    section = Instance.new("Frame")
    section.Name                   = "Section"
    section.BackgroundColor3       = T.Section
    section.BackgroundTransparency = 1
    section.BorderSizePixel        = 0
    section.AutomaticSize          = Enum.AutomaticSize.Y
    section.Size                   = UDim2.new(1, 0, 0, 0)
    section.ZIndex                 = 20
    section.Parent = panel
    Instance.new("UICorner", section).CornerRadius = UDim.new(0, 7)
    local ll = Instance.new("UIListLayout", section)
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Padding   = UDim.new(0, 10)
    local pad = Instance.new("UIPadding", section)
    pad.PaddingTop    = UDim.new(0, 7)
    pad.PaddingBottom = UDim.new(0, 7)
    pad.PaddingLeft   = UDim.new(0, 7)
    pad.PaddingRight  = UDim.new(0, 7)

    local title = Instance.new("TextLabel")
    title.Name                   = "Title"
    title.BackgroundTransparency = 1
    title.BorderSizePixel        = 0
    title.Size                   = UDim2.new(1, -16, 0, 29)
    title.Text                   = " ASCII Art"
    title.TextColor3             = T.Text
    title.TextTransparency       = 1
    title.TextSize               = 18
    title.Font                   = Enum.Font.SourceSansBold
    title.TextXAlignment         = Enum.TextXAlignment.Left
    title.LayoutOrder            = 0
    title.ZIndex                 = 21
    title.Parent                 = section

    local function makeHdr(text, lo)
        local h = Instance.new("TextLabel")
        h.Name                   = "Hdr_" .. text:gsub("%s+", "_")
        h.BackgroundTransparency = 1
        h.BorderSizePixel        = 0
        h.Size                   = UDim2.new(1, -16, 0, 29)
        h.Text                   = " " .. text
        h.TextColor3             = T.Text
        h.TextSize               = 18
        h.Font                   = Enum.Font.SourceSansBold
        h.TextXAlignment         = Enum.TextXAlignment.Left
        h.LayoutOrder            = lo
        h.ZIndex                 = 21
        h.Parent                 = section
        return h
    end

    -- ── Players ───────────────────────────────────────────────────────────────
    makeHdr("Build For", 11)
    local _asciiTargetRestore = borrowTargetPlayerRow(section, 12)
    makeHdr("Use Selected Players Wires", 13)
    local _asciiWireSourceRestore = borrowWireSourceRow(section, 14)

    -- ── ASCII Art ─────────────────────────────────────────────────────────────
    makeHdr("ASCII Art", 20)
    -- borrowed rows are placed after layout order 20

    local ROW_ORDERS = { 21, 22, 23, 24, 25, 26, 27, 28 }

    local function borrow()
        for i, row in ipairs(rows) do
            row.LayoutOrder = ROW_ORDERS[i] or (20 + i)
            row.ZIndex      = 21
            row.Parent      = section
        end
    end
    local function restore()
        for _, row in ipairs(rows) do
            if row.Parent == section and rowHome[row] then
                row.LayoutOrder = rowLO[row]
                row.ZIndex      = rowZ[row]
                row.Parent      = rowHome[row]
            end
        end
    end

    makeScrollable(panel, section, T, 800)
    local show, hide, reset = makePanelFade(panel, section, title, borrow, restore)
    return panel, show, hide, function()
        restore()
        if _asciiTargetRestore     then pcall(_asciiTargetRestore)     end
        if _asciiWireSourceRestore then pcall(_asciiWireSourceRestore) end
        pcall(function()
            if hiddenTab and hiddenTab.Container then hiddenTab.Container:Destroy() end
            if hiddenTab and hiddenTab.Button then hiddenTab.Button:Destroy() end
        end)
        reset()
    end
end

local _imageArtCounter = 0

-- ── Image Art panel (toolbar imageArt button) ────────────────────────────────
-- Renders a Roblox image asset as a wire grid. Pixels darker than the threshold
-- become "on" cells; each on cell gets a wire segment to its right/down on
-- neighbours, producing a wireframe silhouette of the image.
local function makeImageArtPanel(parent, T)
    _imageArtCounter += 1
    local Library = Util.Imports.Library

    local panel
    local section

    local txtboxRef
    local thickness3DRow = nil

    local ok, hiddenTab = pcall(function()
        return Library:CreateTab("", "__imgart_" .. _imageArtCounter)
    end)
    local libSection
    if ok and hiddenTab then
        pcall(function() hiddenTab.Button.Parent = nil end)
        hiddenTab.Container.Visible = false
        local secOk, sec = pcall(function() return hiddenTab:CreateSection("Image To Wire") end)
        if secOk then libSection = sec end
    end

    -- Applies T2W-style settings so the Wire Art scale slider stays decoupled.
    local function applyImageSettings()
        local WireArt = Util.Imports.WireArt
        local state   = BuildMode.ImageArt
        BuildMode._t2wPending = true
        WireArt.Settings.Preview.Scale = state.Scale
        if state.WireType and state.WireType ~= "" then
            WireArt.Settings.Preview.SelectedWireType = state.WireType
        end
        WireArt.Settings.BoxedWiresOnly = state.BoxedWiresOnly
    end

    local function refreshPreviewIfActive()
        local WireArt   = Util.Imports.WireArt
        local Placement = Util.Imports.Placement
        if not (WireArt and Placement and Placement.HasPreview and Placement:HasPreview()) then return end
        local state = BuildMode.ImageArt
        if not state.AssetId or state.AssetId == "" then return end
        local okBuild, result = pcall(function()
            return WireArt:BuildFromImage(state.AssetId, state.Scale, state.ThreeD, state.Threshold, state.Resolution, state.Fill)
        end)
        if okBuild and result then
            WireArt.Settings.Properties.Wires = result
            applyImageSettings()
            pcall(function() Placement:StartPlacement() end)
        end
    end

    if libSection then
        -- 0. How To Use button
        pcall(function()
            libSection:CreateButton("How To Use", function()
                local cf = Util.Imports.CoreFramework
                pcall(function() cf:Notice("Option A — Roblox asset id:", 8) end)
                pcall(function() cf:Notice("Paste a Roblox image id (e.g. 12345678) or rbxassetid://...", 8) end)
                pcall(function() cf:Notice("Option B — External URL:", 8) end)
                pcall(function() cf:Notice("Paste any direct image URL (.png .jpg .bmp).", 8) end)
                pcall(function() cf:Notice("Then tune Threshold + Resolution and click Build Image Art.", 8) end)
            end)
        end)
        -- 1. Asset ID input
        pcall(function()
            txtboxRef = libSection:CreateTextbox("Image", function(value)
                BuildMode.ImageArt.AssetId = value or ""
            end, BuildMode.ImageArt.AssetId, "Asset id or image URL", false, false)
            if txtboxRef and txtboxRef.Instance then
                local inputBox = txtboxRef.Instance:FindFirstChild("Input")
                if inputBox then
                    inputBox.TextColor3        = Color3.fromRGB(255, 255, 255)
                    inputBox.PlaceholderColor3 = Color3.fromRGB(200, 200, 200)
                    -- Clamp size so the input doesn't keep growing when the
                    -- panel is borrowed/restored across container moves.
                    -- The original UILib textbox toggles between 91 and 220
                    -- studs wide via cursor-position logic; we just enforce
                    -- those bounds via a UISizeConstraint so they hold even
                    -- when AutomaticSize.X tries to expand mid-layout.
                    local existing = inputBox:FindFirstChildOfClass("UISizeConstraint")
                    if not existing then
                        local sc = Instance.new("UISizeConstraint")
                        sc.MinSize = Vector2.new(91, 23)
                        sc.MaxSize = Vector2.new(220, 23)
                        sc.Parent  = inputBox
                    end
                end
            end
        end)
        -- 1b. Local Image dropdown — lists files in Ancestor/Games/<id>/Image Art.
        --     Selecting one writes "local:<filename>" into the textbox AND
        --     state, then triggers a live preview rebuild so the user sees
        --     the result immediately.
        local localDropdownRef
        local function _setImageInput(value)
            -- State is authoritative — set it first, regardless of UI state.
            BuildMode.ImageArt.AssetId = value
            -- Find the Image textbox's Input child via BOTH the cached
            -- txtboxRef.Instance AND a broader descendant search, in case the
            -- row was reparented between the visible panel section and the
            -- hidden borrow source mid-flight.
            local function pushText()
                if txtboxRef and txtboxRef.Instance then
                    local inputBox = txtboxRef.Instance:FindFirstChild("Input")
                    if inputBox and inputBox:IsA("TextBox") then
                        inputBox.Text = value
                        return true
                    end
                end
                -- Fallback descendant scan: any TextBox named "Input" whose
                -- parent's SearchText attribute is "Image".
                for _, root in ipairs({ section, panel, hiddenTab and hiddenTab.Container }) do
                    if root then
                        for _, d in ipairs(root:GetDescendants()) do
                            if d:IsA("TextBox") and d.Name == "Input"
                               and d.Parent and d.Parent:GetAttribute("SearchText") == "Image" then
                                d.Text = value
                                return true
                            end
                        end
                    end
                end
                return false
            end
            pushText()
            refreshPreviewIfActive()
        end

        -- Build the latest file list from disk. Empty placeholder text shown
        -- when the folder has no images, so the dropdown is still selectable
        -- but doesn't break the build pipeline.
        local function _currentFileList()
            local files = Util.Imports.WireArt:GetImageArts()
            if #files == 0 then files = { "(folder is empty — drop images in)" } end
            return files
        end

        pcall(function()
            localDropdownRef = libSection:CreateDropdown(function(value)
                local selected = (type(value) == "table" and value[1]) or value
                if not selected or selected == "" then return end
                if selected:match("^%(folder") then return end  -- placeholder entry
                _setImageInput("local:" .. selected)
            end, _currentFileList(), "(pick a local image)", false)
        end)

        -- Hook the dropdown's "Search" textbox Focused signal so the file list
        -- auto-refreshes the moment the user opens the dropdown. UILib opens
        -- the option list on Search:Focused, so this is the click-equivalent.
        -- Also hooks MouseEnter on the dropdown row as a backup trigger.
        pcall(function()
            if not localDropdownRef then return end
            local srcFrame = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
            if not srcFrame then return end
            -- The dropdown's row is the most recently added GuiObject child of
            -- srcFrame whose SearchText matches the dropdown's first entry.
            local dropdownRow
            for _, child in ipairs(srcFrame:GetChildren()) do
                if child:IsA("GuiObject") then
                    -- Find the row that contains a "Search" TextBox (UILib's
                    -- dropdown internal). That row is OUR dropdown.
                    local searchBox = child:FindFirstChild("Search", true)
                    if searchBox and searchBox:IsA("TextBox") then
                        dropdownRow = child
                        break
                    end
                end
            end
            if not dropdownRow then return end

            local function doRefresh()
                if localDropdownRef and localDropdownRef.Refresh then
                    pcall(function() localDropdownRef:Refresh(_currentFileList()) end)
                end
            end

            local searchBox = dropdownRow:FindFirstChild("Search", true)
            if searchBox and searchBox:IsA("TextBox") then
                pcall(function() searchBox.Focused:Connect(doRefresh) end)
            end
            -- Also catch the arrow button if it exists (some UILib variants
            -- have a separate clickable arrow next to the search box).
            local arrow = dropdownRow:FindFirstChild("Arrow", true)
            if arrow and (arrow:IsA("ImageButton") or arrow:IsA("TextButton")) then
                pcall(function() arrow.Activated:Connect(doRefresh) end)
            end
            -- Final safety net: refresh on hover. Cheap, fires once per enter,
            -- guarantees the list is current before the user even clicks.
            pcall(function() dropdownRow.MouseEnter:Connect(doRefresh) end)
        end)

        -- Manual refresh button — keeps working as a no-fuss option.
        -- 2. Wire Type dropdown
        pcall(function()
            local wireTypes = Util.Imports.WireArt:GetWireTypes()
            local defaultWire = BuildMode.ImageArt.WireType
            local defaultDisplay = defaultWire
            for displayName, wireId in pairs(Util.Imports.WireArt.Settings.Properties.WireConversions) do
                if wireId == defaultWire then defaultDisplay = displayName break end
            end
            libSection:CreateDropdown(function(value)
                local selected = (type(value) == "table" and value[1]) or value
                if not selected or selected == "" then return end
                local wireId = Util.Imports.WireArt.Settings.Properties.WireConversions[selected]
                if wireId then
                    BuildMode.ImageArt.WireType = wireId
                    refreshPreviewIfActive()
                end
            end, wireTypes, defaultDisplay, false)
        end)
        -- 3D toggle and 3D Thickness slider removed — image art is always 2D.
        -- 3. Scale slider
        pcall(function()
            libSection:CreateSlider("Scale", function(value)
                BuildMode.ImageArt.Scale = value
                refreshPreviewIfActive()
            end, 0.1, 1, BuildMode.ImageArt.Scale, true)
        end)
        -- Resolution slider removed — always uses the image's native pixel
        -- dimensions (capped at 1920) for maximum fidelity.
        -- 7. Threshold
        pcall(function()
            libSection:CreateSlider("Threshold", function(value)
                BuildMode.ImageArt.Threshold = value
                refreshPreviewIfActive()
            end, 0.1, 0.9, BuildMode.ImageArt.Threshold, true)
        end)
        -- 8. Image Fill toggle
        -- pcall(function()
        --     libSection:CreateToggle("Image Fill", function(value)
        --         BuildMode.ImageArt.Fill = value
        --         refreshPreviewIfActive()
        --     end, BuildMode.ImageArt.Fill)
        -- end)
        -- 9. Boxed Wires Only
        pcall(function()
            libSection:CreateToggle("Boxed Wires Only", function(value)
                BuildMode.ImageArt.BoxedWiresOnly = value
            end, BuildMode.ImageArt.BoxedWiresOnly)
        end)
        -- 9. Build button
        pcall(function()
            libSection:CreateButton("Build Image Art", function()
                local WireArt   = Util.Imports.WireArt
                local Placement = Util.Imports.Placement
                local cf        = Util.Imports.CoreFramework
                if not (WireArt and WireArt.BuildFromImage) then
                    pcall(function() cf:Notice("Image art builder not available.", 3) end)
                    return
                end
                local state = BuildMode.ImageArt

                -- Live-read the textbox in case FocusLost hasn't fired yet.
                local liveText
                local roots = { section, panel, hiddenTab and hiddenTab.Container }
                for _, root in ipairs(roots) do
                    if root then
                        for _, d in ipairs(root:GetDescendants()) do
                            if d:IsA("TextBox") and d.Name == "Input"
                               and d.Parent and d.Parent:GetAttribute("SearchText") == "Image" then
                                liveText = d.Text
                                break
                            end
                        end
                    end
                    if liveText then break end
                end
                -- Only overwrite state from the textbox if the textbox actually
                -- has content. An empty textbox shouldn't wipe a state value
                -- set programmatically by the local-image dropdown.
                if liveText ~= nil and liveText:gsub("%s+", "") ~= "" then
                    state.AssetId = liveText
                end

                if not state.AssetId or state.AssetId:gsub("%s+", "") == "" then
                    pcall(function() cf:Notice("Please paste an image asset id or URL, or pick a local image from the dropdown.", 4) end)
                    return
                end

                pcall(function() cf:Notice("Loading image…", 2) end)
                local okBuild, result, why = pcall(function()
                    return WireArt:BuildFromImage(state.AssetId, state.Scale, false, state.Threshold, state.Resolution, state.Fill)
                end)
                if not okBuild then
                    pcall(function() cf:Notice("Image art error: " .. tostring(tostring(result):sub(1, 120)), 6) end)
                    return
                end
                if not result then
                    -- Surface the real reason instead of a generic message.
                    local reason = tostring(why or "unknown — try a lower resolution"):sub(1, 140)
                    pcall(function() cf:Notice("Couldn't build image: " .. tostring(reason), 8) end)
                    return
                end
                WireArt.Settings.Properties.Wires = result
                applyImageSettings()
                pcall(function() Placement:EnterPlacement() end)
            end)
        end)
    end

    -- Collect borrowed rows from the hidden section.
    local rows, rowHome, rowLO, rowZ = {}, {}, {}, {}
    local srcSection = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
    if srcSection then
        for _, child in srcSection:GetChildren() do
            if child:IsA("GuiObject") and child.Name ~= "Title" then
                table.insert(rows, child)
                rowHome[child] = srcSection
                rowLO[child]   = child.LayoutOrder
                rowZ[child]    = child.ZIndex
            end
        end
        table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    end

    panel = Instance.new("Frame")
    panel.Name                   = "ImageArtPanel"
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel        = 0
    panel.AnchorPoint            = Vector2.new(0.5, 0.5)
    panel.Position               = UDim2.new(0.5, 0, 0.5, 0)
    panel.AutomaticSize          = Enum.AutomaticSize.Y
    panel.Size                   = UDim2.new(0, 380, 0, 0)
    panel.Visible                = false
    panel.ZIndex                 = 20
    panel.Parent = parent

    section = Instance.new("Frame")
    section.Name                   = "Section"
    section.BackgroundColor3       = T.Section
    section.BackgroundTransparency = 1
    section.BorderSizePixel        = 0
    section.AutomaticSize          = Enum.AutomaticSize.Y
    section.Size                   = UDim2.new(1, 0, 0, 0)
    section.ZIndex                 = 20
    section.Parent = panel
