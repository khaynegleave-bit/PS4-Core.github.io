                cf:LassoBeginPlacement()
            else
                local selection = cf.Status.LassoSelectedItems
                if #selection == 0 then return end

                -- Group items by name + boxed state (boxed/unboxed can't stack together)
                local groups     = {}
                local groupOrder = {}
                local seen       = {}
                for _, item in ipairs(selection) do
                    if not item or not item.Parent then continue end
                    local isBoxed = item:FindFirstChild("BoxItemName") ~= nil
                        or item:FindFirstChild("PurchasedBoxItemName") ~= nil
                    local key = item.Name .. (isBoxed and "\0boxed" or "\0unboxed")
                    if not seen[key] then
                        seen[key] = true
                        table.insert(groupOrder, key)
                        groups[key] = {}
                    end
                    table.insert(groups[key], item)
                end

                if #groupOrder <= 1 then
                    local y = _LassoYAxis > 0 and _LassoYAxis or nil
                    cf:LassoPreview(_LassoXAxis, y, _LassoZAxis)
                else
                    local orderedGroups = {}
                    for _, name in ipairs(groupOrder) do
                        table.insert(orderedGroups, groups[name])
                    end
                    cf:StartStackerQueue(orderedGroups, _LassoXAxis, _LassoYAxis, _LassoZAxis)
                end
