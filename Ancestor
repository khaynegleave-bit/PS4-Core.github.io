    TS:Create(RowStroke,   fadeIn, { Transparency = 0.2           }):Play()
    TS:Create(TaskLabel,   fadeIn, { TextTransparency = 0.15       }):Play()
    TS:Create(AbortButton, fadeIn, { BackgroundTransparency = 0.3  }):Play()

    local lib = Util.Imports.Library
    local getControls = ABORT_CONTROLS[tostring(Task)]
    local controls = getControls and getControls(lib) or {}

    local abortSet = { [AbortButton] = true }
    self._abortHighlights = {}
    for _, control in controls do
        if not (control and control.Instance) then continue end
        local inst = control.Instance
        abortSet[inst] = true

        local origColor = inst.BackgroundColor3
        local origTransp = inst.BackgroundTransparency
        local origTextColor = inst:IsA("TextButton") and inst.TextColor3 or nil
        inst.BackgroundColor3 = Theme.Accent
        inst.BackgroundTransparency = 0.75
        if origTextColor then inst.TextColor3 = Theme.Text end
        table.insert(self._abortHighlights, {
            inst = inst, color = origColor, transp = origTransp, textColor = origTextColor
        })
    end

    self._disabledControls = {}
    for _, desc in MainFrame:GetDescendants() do
        if (desc:IsA("TextButton") or desc:IsA("ImageButton")) and desc.Active and not abortSet[desc] then
            desc.Active = false
            table.insert(self._disabledControls, desc)
        end
    end

    self._lockStartTime = os.clock()
end

function CoreFramework:DownloadWireArts()
    local notice = self:Notice("Downloading Wire Arts...", false)

    local Response = Util.WireArtRequest()
    if Response.StatusCode ~= 200 then
        notice:Set("Download failed (HTTP " .. tostring(Response.StatusCode) .. ")")
        task.delay(3, function() notice:Dismiss() end)
        return
    end

    local Data = Util.Services.HttpService:JSONDecode(Response.Body)
    local files = {}
    for _, Item in ipairs(Data) do
        if Item.type == "file" then table.insert(files, Item) end
    end

    local SHA_PATH = "Ancestor/Games/2471084/Wire Art/.sha"
    local shaCached = {}
    pcall(function()
        if isfile and isfile(SHA_PATH) then
            shaCached = Util.Services.HttpService:JSONDecode(readfile(SHA_PATH))
        end
    end)

    local toDownload, skipped = {}, 0
    for _, Item in ipairs(files) do
        local fp = "Ancestor/Games/2471084/Wire Art/" .. Item.name
        if shaCached[Item.name] == Item.sha and isfile and isfile(fp) then
            skipped += 1
        else
            table.insert(toDownload, Item)
        end
    end

    local total = #toDownload
    if total == 0 then
        notice:Set("All " .. tostring(skipped) .. " Wire Art(s) up to date")
        task.delay(3, function() notice:Dismiss() end)
        return
    end

    notice:Set("Downloading " .. tostring(total) .. " new/updated Wire Art(s)...")

    local CONCURRENCY = 8
    local active, done = 0, 0
    local newShas = {}

    for _, Item in ipairs(toDownload) do
        while active >= CONCURRENCY do task.wait() end
        active += 1
        task.spawn(function()
            local fp = "Ancestor/Games/2471084/Wire Art/" .. Item.name
            local ok, r = pcall(Util.AuthRequest, Item.download_url)
            if ok and r and r.StatusCode == 200 then
                pcall(writefile, fp, r.Body)
                newShas[Item.name] = Item.sha
            end
            done   += 1
            active -= 1
            notice:Set("Downloading Wire Arts... (" .. tostring(done) .. "/" .. tostring(total) .. ")")
            notice:SetProgress(done / math.max(total, 1))
        end)
    end

    while active > 0 do task.wait() end

    for k, v in newShas do shaCached[k] = v end
    pcall(writefile, SHA_PATH, Util.Services.HttpService:JSONEncode(shaCached))

    notice:SetProgress(1)
    notice:Set("Downloaded " .. tostring(done) .. "/" .. tostring(#files) .. " Wire Art(s) (" .. tostring(skipped) .. " cached)")
    task.delay(3, function() notice:Dismiss() end)
end

-- Downloads every file in /2D_WA and /3D_WA from the GitHub repo into their
-- respective local folders. Uses the GitHub Contents API to list each folder,
-- then downloads each file via its raw download_url. SHA-cached so re-runs
-- only fetch updated files. Files are saved with their original GitHub names.
function CoreFramework:DownloadTextWires()
    local notice = self:Notice("Downloading Text Wires...", false)
    local gameId = tostring(Util.GameId)

    -- GitHub Contents API: returns a JSON array of {name, type, sha, download_url}.
    local API_BASE = "https://api.github.com/repos/khaynegleave-bit/Ancestor-Rel/contents/"
    local REF      = "?ref=main"

    local folders = { "2D_WA", "3D_WA" }
    local allTasks = {}

    -- Recursively lists every file under the given remote sub-path. `localPrefix`
    -- is the destination folder (e.g. "Ancestor/Games/2471084/2D_WA") plus any
    -- subdirectory we've descended into. Subfolders are mirrored locally.
    local function listRecursive(remotePath, localPrefix)
        local url = tostring(API_BASE) .. tostring(remotePath) .. tostring(REF)
        local ok, resp = pcall(Util.AuthRequest, url)
        if not ok or not resp or resp.StatusCode ~= 200 or not resp.Body then
            return false, resp and resp.StatusCode or "?"
        end
        local listOk, data = pcall(function()
            return Util.Services.HttpService:JSONDecode(resp.Body)
        end)
        if not listOk or type(data) ~= "table" then return false, "parse" end

        -- Ensure local mirror folder exists.
        if isfolder and not isfolder(localPrefix) and makefolder then
            pcall(makefolder, localPrefix)
        end

        for _, Item in ipairs(data) do
            if Item.type == "file" and Item.download_url then
                table.insert(allTasks, {
                    item       = Item,
                    localPath  = tostring(localPrefix) .. "/" .. tostring(Item.name),
                    -- shaKey scoped per-subfolder so identical filenames in
                    -- different subdirs don't collide.
                    shaKey     = tostring(localPrefix) .. "/" .. tostring(Item.name),
                })
            elseif Item.type == "dir" then
                local subRemote = tostring(remotePath) .. "/" .. tostring(Item.name)
                local subLocal  = tostring(localPrefix) .. "/" .. tostring(Item.name)
                local subOk, err = listRecursive(subRemote, subLocal)
                if not subOk then return false, err end
            end
        end
        return true
    end

    for _, folder in ipairs(folders) do
        local localRoot = "Ancestor/Games/" .. tostring(gameId) .. "/" .. tostring(folder)
        local ok, err   = listRecursive("Games/" .. tostring(gameId) .. "/" .. tostring(folder), localRoot)
        if not ok then
            notice:Set("Failed to list /" .. tostring(folder) .. " (" .. tostring(err) .. ")")
            task.delay(4, function() notice:Dismiss() end)
            return
        end
    end

    if #allTasks == 0 then
        notice:Set("No text wire files found in repo.")
        task.delay(4, function() notice:Dismiss() end)
        return
    end

    -- No SHA cache — always download. Simpler and avoids stale-cache bugs.
    notice:Set("Downloading " .. tostring(#allTasks) .. " Text Wire(s)...")

    local CONCURRENCY = 8
    local active, done, downloaded, failed = 0, 0, 0, 0

    for _, t in ipairs(allTasks) do
        while active >= CONCURRENCY do task.wait() end
        active += 1
        task.spawn(function()
            local ok, r = pcall(Util.AuthRequest, t.item.download_url)
            if ok and r and r.StatusCode == 200 and r.Body and #r.Body > 0 then
                pcall(writefile, t.localPath, r.Body)
                downloaded += 1
            else
                failed += 1
            end
            done   += 1
            active -= 1
            notice:Set("Downloading Text Wires... (" .. tostring(done) .. "/" .. tostring(#allTasks) .. ")")
            notice:SetProgress(done / math.max(#allTasks, 1))
        end)
    end

    while active > 0 do task.wait() end

    -- Make sure the next BuildFromText re-scans the local folders.
    pcall(function() Util.Imports.WireArt:InvalidateTextWireIndex() end)

    notice:SetProgress(1)
    notice:Set("Downloaded " .. tostring(downloaded) .. "/" .. tostring(#allTasks) .. " Text Wire(s) (" .. tostring(failed) .. " failed)")
    task.delay(4, function() notice:Dismiss() end)
end

function CoreFramework:UnlockUI(Message)
    if self._abortHighlights then
        for _, data in self._abortHighlights do
            if data.inst and data.inst.Parent then
                data.inst.BackgroundColor3 = data.color
                data.inst.BackgroundTransparency = data.transp
                if data.textColor then data.inst.TextColor3 = data.textColor end
            end
        end
        self._abortHighlights = nil
    end

    if self._disabledControls then
        for _, inst in self._disabledControls do
            if inst and inst.Parent then
                inst.Active = true
            end
        end
        self._disabledControls = nil
    end

    local MainFrame = Util.Imports.Library.MainFrame
    if not MainFrame then
        if Message then self:Notice(Message) end
        return
    end

    local Overlay = MainFrame:FindFirstChild("_UILock")
    if not Overlay then
        if Message then self:Notice(Message) end
        return
    end

    local TS = Util.Services.TweenService
    local TI = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    TS:Create(Overlay, TI, { BackgroundTransparency = 1 }):Play()
    for _, child in Overlay:GetDescendants() do
        if child:IsA("TextLabel") then
            TS:Create(child, TI, { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
        elseif child:IsA("Frame") or child:IsA("ImageLabel") then
            TS:Create(child, TI, { BackgroundTransparency = 1 }):Play()
        elseif child:IsA("UIStroke") then
            TS:Create(child, TI, { Transparency = 1 }):Play()
        end
    end

    task.delay(0.25, function()
        if Overlay and Overlay.Parent then Overlay:Destroy() end
    end)

    if Message then
        local elapsed = self._lockStartTime and (os.clock() - self._lockStartTime) or nil
        self._lockStartTime = nil
        local timeStr
        if elapsed then
            local secs = math.round(elapsed)
            if secs >= 60 then
                timeStr = string.format("%dm %ds", math.floor(secs / 60), secs % 60)
            else
                timeStr = string.format("%ds", secs)
            end
        end
        self:Notice(timeStr and (Message .. " in " .. timeStr) or Message)
    end
end

