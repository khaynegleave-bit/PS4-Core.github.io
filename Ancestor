-- Re-registers all placement keybind connections, baking in the current key values
-- so the old key is guaranteed to stop working and the new key starts immediately.
function Placement:RefreshKeybinds()
    local UIS  = Util.Services.UserInputService
    local keys = Util.Imports.Settings.Placement
    if not keys then return end

    -- Tear down existing connections first.
    for _, name in {"RotateY", "RotateZ", "RotateX"} do
        Util.Imports.Maid:deregister(name)
    end

    -- Capture key values NOW so each connection listens for exactly one fixed key.
    local kY = Enum.KeyCode[keys.RotateYKey]
    local kZ = Enum.KeyCode[keys.RotateTiltKey]
    local kX = Enum.KeyCode[keys.RotateXKey]

    Util.Imports.Maid:register("RotateY", UIS.InputBegan:Connect(function(Key, Processed)
        if not Processed and Key.KeyCode == kY then
            Util.Imports.Placement.Settings.Rotations.Y += 45
            if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace() end
        end
    end))
    Util.Imports.Maid:register("RotateZ", UIS.InputBegan:Connect(function(Key, Processed)
        if not Processed and Key.KeyCode == kZ then
            Util.Imports.Placement.Settings.Rotations.Z += 45
            if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace() end
        end
    end))
    Util.Imports.Maid:register("RotateX", UIS.InputBegan:Connect(function(Key, Processed)
        if not Processed and Key.KeyCode == kX then
            Util.Imports.Placement.Settings.Rotations.X += 45
            if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace() end
        end
    end))
end

