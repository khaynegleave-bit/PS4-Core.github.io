function Ancestor:SpawnVehicle()

	if Util.Imports.CoreFramework.Status.SpawningVehicle then
		return Util.Imports.CoreFramework:Notice("Vehicle Spawner is already running.", 2)
	end

	local session = {}
	local progressNotice

	local function isActive()
		return Util.Imports.CoreFramework.Status._spawnVehicleSession == session
	end

	local function EndSpawnVehicle()
		if not Util.Imports.CoreFramework.Status.SpawningVehicle then return end
		Util.Imports.CoreFramework.Status.SpawningVehicle = false
		Util.Imports.CoreFramework.Status._spawnVehicleSession = nil
		Util.Imports.CoreFramework.Status._endSpawnVehicle = nil
		Util.Imports.Maid:deregister("SelectVehicleSpot")
		Util.Imports.Maid:deregister("VehicleSpawner")
		if progressNotice then
			progressNotice:Dismiss()
			progressNotice = nil
		end
		Util.Imports.Library.Buttons["Spawn Vehicle"]:Set("Spawn Vehicle")
	end

	local function findPrice(model)
		for _, desc in model:GetDescendants() do
			if (desc.Name == "Price" or desc.Name == "Cost") and typeof(desc.Value) == "number" then
				return desc.Value
			end
		end
		return nil
	end

	Util.Imports.CoreFramework.Status.SpawningVehicle = true
	Util.Imports.CoreFramework.Status._spawnVehicleSession = session
	Util.Imports.CoreFramework.Status._endSpawnVehicle = EndSpawnVehicle
	Util.Imports.Library.Buttons["Spawn Vehicle"]:Set("Abort")
	progressNotice = Util.Imports.CoreFramework:Notice("Select a vehicle spawn pad.", false)

	Util.Imports.Maid:register("SelectVehicleSpot", Util.Mouse.Button1Down:Connect(function()
		if not isActive() then return end

		local Target = Util.Mouse.Target
		if not Target then return end
		Target = Target.Parent

		local typeTag = Target:FindFirstChild("Type")
		local ownerTag = Target:FindFirstChild("Owner")
		local isVehicleSpot = typeTag and typeTag.Value and typeTag.Value:match("Vehicle Spot")
			and ownerTag and ownerTag.Value == Util.Client
		if not isVehicleSpot then return end

		local price = findPrice(Target)
		if price then
			local canAfford, neededCash = Util.Imports.CoreFramework:CanAfford(price)
			if not canAfford then
				Util.Imports.CoreFramework:Notice(neededCash, 3)
				return EndSpawnVehicle()
			end
		end

		Util.Imports.Maid:deregister("SelectVehicleSpot")
		if progressNotice then progressNotice:Dismiss() end
		progressNotice = Util.Imports.CoreFramework:Notice("Spawning vehicle...", false)

		local desiredColor = Util.Imports.Settings.Vehicle.SpawnColor

		Util.Imports.Maid:register("VehicleSpawner", Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Vehicle)
			if not isActive() then return end

			local Owner = Vehicle:WaitForChild("Owner", 10)
			local typeValue = Vehicle:WaitForChild("Type", 10)
			if not (Owner and Owner.Value == Util.Client and typeValue and typeValue.Value == "Vehicle") then
				return
			end

			local PaintParts = Vehicle:WaitForChild("PaintParts", 10)
			local BasePart = PaintParts:FindFirstChild("Union")

			if not BasePart then return end

			if tostring(BasePart.BrickColor) == tostring(BrickColor.new(desiredColor)) then
				Util.Imports.CoreFramework:Notice("Spawned " .. tostring(desiredColor) .. " vehicle.", 3)
				if Util.Imports.Settings.Vehicle.DeleteSpawnPadAfterVehicleSpawn then
					Util:FireServer("DestroyStructure", Target)
				end
				return EndSpawnVehicle()
			end

			-- Wrong colour, check affordability again before re-spawning
			if price then
				local canAfford = Util.Imports.CoreFramework:CanAfford(price)
				if not canAfford then
					Util.Imports.CoreFramework:Notice("Out of cash — vehicle spawner stopped.", 3)
					return EndSpawnVehicle()
				end
			end
		end))
		local Spawn_Btn = Target:FindFirstChild("ButtonRemote_SpawnButton", true)
		repeat Util.Imports.Maid:Wait()
			task.spawn(function()
				Util:FireServer("RemoteProxy", Spawn_Btn)
			end)
		until not isActive()
	end))
end

