	ResizeHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			Resizing = true
			dragging = false
			dragInput = nil

			-- Store the offset from the touch/mouse to the center of the handle
			local HandleCenter = ResizeHandle.AbsolutePosition + (ResizeHandle.AbsoluteSize / 2)
			ResizeOffset = Vector2.new(input.Position.X - HandleCenter.X, input.Position.Y - HandleCenter.Y)
			ResizeInput = input

			-- On mobile, sink touch inputs so the camera does not pan while resizing the GUI
			local isTouch = input.UserInputType == Enum.UserInputType.Touch
			if isTouch then
				ContextActionService:BindActionAtPriority(
					"_AncestorResizeSink",
					function() return Enum.ContextActionResult.Sink end,
					false,
					Enum.ContextActionPriority.High.Value,
					Enum.UserInputType.Touch
				)
			end

			repeat RunService.RenderStepped:wait() until input.UserInputState == Enum.UserInputState.End

			Resizing = false
			if isTouch then
				pcall(function() ContextActionService:UnbindAction("_AncestorResizeSink") end)
			end
			if Util.Imports.Settings and Util.Imports.Settings.UI then
				Util.Imports.Settings.UI.GuiSize = {CurrentMainSize.X, CurrentMainSize.Y}
				if writefile then
					pcall(writefile, "Ancestor/Games/" .. tostring(Util.GameId) .. "/ClientSettings.json", Util.Services.HttpService:JSONEncode(Util.Imports.Settings))
				end
			end
		end
	end)

	ResizeHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			ResizeInput = input
		end
	end)

	local function update(input)
		local delta = (input.Position - dragStart) / UIScale.Scale
		Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end

	local function isDragInput(inputType)
		return inputType == Enum.UserInputType.MouseButton1
			or inputType == Enum.UserInputType.Touch
	end
	local function isMoveInput(inputType)
		return inputType == Enum.UserInputType.MouseMovement
			or inputType == Enum.UserInputType.Touch
	end

	Main.InputBegan:Connect(function(input)
		if isDragInput(input.UserInputType) then
			local Position = input.Position
			local HandlePosition = ResizeHandle.AbsolutePosition
			local HandleSize = ResizeHandle.AbsoluteSize
			local MainPosition = Main.AbsolutePosition
			local MainSize = Main.AbsoluteSize
			local InResizeZone = Position.X >= MainPosition.X + MainSize.X - 32 and Position.Y >= MainPosition.Y + MainSize.Y - 32
			if Resizing or InResizeZone or (Position.X >= HandlePosition.X and Position.X <= HandlePosition.X + HandleSize.X and Position.Y >= HandlePosition.Y and Position.Y <= HandlePosition.Y + HandleSize.Y) then
				return
			end
			dragging = true
			dragStart = input.Position
			startPos = Main.Position

			-- On mobile, sink touch inputs so the camera does not pan while dragging the GUI
			local isTouch = input.UserInputType == Enum.UserInputType.Touch
			if isTouch then
				ContextActionService:BindActionAtPriority(
					"_AncestorDragSink",
					function() return Enum.ContextActionResult.Sink end,
					false,
					Enum.ContextActionPriority.High.Value,
					Enum.UserInputType.Touch
				)
			end

			repeat RunService.RenderStepped:wait() until input.UserInputState == Enum.UserInputState.End
			dragging = false

			if isTouch then
				pcall(function() ContextActionService:UnbindAction("_AncestorDragSink") end)
			end
		end
	end)

	Main.InputChanged:Connect(function(input)
		if isMoveInput(input.UserInputType) then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == ResizeInput and Resizing then
			-- Target handle center in screen pixels
			local TargetHandleCenter = Vector2.new(input.Position.X - ResizeOffset.X, input.Position.Y - ResizeOffset.Y)

			-- Calculate new unscaled size
			-- (TargetPos - UIStartPos + HalfHandleSize) / Scale
			local NewSize = (TargetHandleCenter - Main.AbsolutePosition + (ResizeHandle.AbsoluteSize / 2)) / UIScale.Scale

			SetMainSize(NewSize.X, NewSize.Y)
			return
		end
		if input == dragInput and dragging then
			update(input)
		end
	end)

