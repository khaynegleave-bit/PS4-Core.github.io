function Ancestor:ModWood(Sawmill, Tree, IsAutofarm)
	if self.ModdingWood then
		return Util.Imports.CoreFramework:Notice("You're already modding wood.")
	end

	local OldPosition = Util.Client.Character:GetPivot()

	local Sawmill = Sawmill or Util.Imports.Ancestor:SelectSawmill('Mod Wood')
	if not Sawmill then
		return Util.Imports.CoreFramework:Notice("You did not select a sawmill, aborted.")
	end

	local Tree = Tree or Util.Imports.Ancestor:SelectTree("To Mod")
	if not Tree then
		return Util.Imports.CoreFramework:Notice("You did not select a tree, aborted.")
	end

	local BestAxe, AxeData = Util.Imports.CoreFramework:GetBestAxe(Tree.TreeClass.Value, true)
	if not (BestAxe and AxeData) then
		return Util.Imports.CoreFramework:Notice(
			(Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes)
				and "No axe available — nobody in the server has one you can use."
				or  "You need an axe to use this feature."
		)
	end

	self.ModdingWood = true

	local WoodSections = Tree:QueryDescendants("#WoodSection")
	local SmallestWoodSection, Size, MainSection = nil, 9e9, nil
	local IsConifer = (Tree.TreeClass.Value == 'Pine' or Tree.TreeClass.Value == 'Fir')

	for _, WoodSection in WoodSections do
		if IsConifer then
			if WoodSection.Size.X <= Size and (WoodSection.Size.X >= .5 and WoodSection.Size.Y > .3) then
				Size = WoodSection.Size.X
				SmallestWoodSection = WoodSection
			end
		else
			if WoodSection.ID.Value >= 3 and WoodSection:FindFirstChild('ParentID') then
				SmallestWoodSection = WoodSection
			end
		end
	end

	if not SmallestWoodSection then
		self.ModdingWood = false
		return Util.Imports.CoreFramework:Notice("This tree is not moddable.")
	end

	local SellJointPiece
	for _, WoodSection in WoodSections do
		if WoodSection.ID.Value == SmallestWoodSection.ParentID.Value and WoodSection.Parent == SmallestWoodSection.Parent then
			SellJointPiece = WoodSection
		end
	end

	if not SellJointPiece then
		self.ModdingWood = false
		return Util.Imports.CoreFramework:Notice("This tree is not moddable.")
	end

	for _, WoodSection in WoodSections do
		if WoodSection.ID.Value == 1 then
			MainSection = WoodSection
		end
	end

	local Conveyor = Sawmill.Conveyor.Conveyor
	local Main = Sawmill.Main
	local OriginalSize = Main.Size

	-- Main.Size += Vector3.new(0, (Conveyor.Position.Y - Main.Position.Y) * 2, 0)

	Util.Imports.CoreFramework:Fly()
	if not IsAutofarm then Util.Imports.CoreFramework:LockUI("Mod Wood") end

	SmallestWoodSection.BrickColor = BrickColor.new("Really green")
	SmallestWoodSection.Material = Enum.Material.Neon
	local SmallSectionId = SmallestWoodSection.ID.Value
	SellJointPiece.BrickColor = BrickColor.new("Really red")
	SellJointPiece.Material = Enum.Material.Neon

	Tree.PrimaryPart = MainSection

	Util.Imports.CoreFramework:Teleport(MainSection.CFrame + Vector3.new(0, 5, 7))

	local LavaPart = self:GetLava()
	repeat Util.Imports.Maid:Wait()
		Util.Imports.CoreFramework:TeleportObject(Tree, CFrame.new(-1675, 280, 1284), nil, nil, MainSection, SellJointPiece)
		firetouchinterest(LavaPart.Lava, SellJointPiece, 0)
		firetouchinterest(LavaPart.Lava, SellJointPiece, 1)
	until SellJointPiece:FindFirstChild('LavaFire') or not Util.Imports.CoreFramework.Status.GUI_LOADED

	SellJointPiece:FindFirstChild('LavaFire'):Destroy()

	Util.Imports.CoreFramework:TeleportObject(Tree, CFrame.new(-1055, 291, -458), nil, nil, MainSection)
	Util.Imports.CoreFramework:Teleport(CFrame.new(-1055, 291, -458) * CFrame.new(0, 5, 5))

	local SellPieceSold
	Util.Imports.Maid:register("ModWood_AncestryChanged", SellJointPiece.AncestryChanged:Connect(function()
		SellPieceSold = true
		Util.Imports.Maid:deregister("ModWood_AncestryChanged")
	end))

	task.spawn(function()
		Tree.PrimaryPart = SellJointPiece
		repeat Util.Imports.Maid:Wait()
			Util.Imports.CoreFramework:TeleportObject(Tree, CFrame.new(1279, 49, 2328), nil, nil, SellJointPiece, SellJointPiece)
		until not SellJointPiece or SellPieceSold or not Util.Imports.CoreFramework.Status.GUI_LOADED
	end)

	repeat Util.Imports.Maid:Wait() until not SellJointPiece or SellPieceSold or not Util.Imports.CoreFramework.Status.GUI_LOADED

	Util.Imports.CoreFramework:Teleport(SmallestWoodSection.CFrame)

	for _, WoodSection in WoodSections do
		if WoodSection ~= SmallestWoodSection then
			Tree.PrimaryPart = WoodSection
		end
	end

	if not Sawmill:IsDescendantOf(Util.Imports.Paths.PlayerModels) then
		self.ModdingWood = false
		if not IsAutofarm then Util.Imports.CoreFramework:UnlockUI() end
		return Util.Imports.CoreFramework:Notice("Mod Wood failed — did you reload?")
	end

	Tree.PrimaryPart = MainSection
	Util.Imports.CoreFramework:Teleport(CFrame.new(Tree.PrimaryPart.CFrame.p + Vector3.new(0, 5, 4)))

	local ModWoodFinished
	local ModWoodFailed
	Util.Imports.CoreFramework.Status._endModWood = function()
		ModWoodFailed = true
	end
	Util.Imports.Maid:register("ModWood_Success",
		Util.Imports.Paths.LogModels.ChildAdded:Connect(function(Log)
			local Owner = Log:WaitForChild('Owner', 10)
			if Owner and Owner.Value == Util.Client then
				Util.Imports.Maid:deregister("ModWood_Success")
				ModWoodFinished = true
			end
		end)
	)

	Util.Imports.Maid:register("ModWood_Sell",
		Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Plank)
			local Owner = Plank:WaitForChild('Owner', 120)
			local WoodSection = Plank:WaitForChild("WoodSection", 120)
			if (Owner and WoodSection) and Owner.Value == Util.Client then
				-- Main.Size = OriginalSize
				if not IsAutofarm then Util.Imports.CoreFramework:UnlockUI("Mod Wood completed") end
				local ChildIds = Plank:FindFirstChild("ChildIDs", true)
				if not ChildIds then
					repeat Util.Imports.Maid:Wait()
						ChildIds = Plank:FindFirstChild("ChildIDs", true)
					until ChildIds ~= nil
				end

				local shouldSell
				if IsAutofarm then
					shouldSell = Util.Imports.Settings.ModWood.AutofarmSell == true
				else
					shouldSell = Util.Imports.Settings.ModWood.SellAfterMod == true
				end
				if not shouldSell then
					return Util.Imports.Maid:deregister("ModWood_Sell")
				end
				Plank.PrimaryPart = Plank.WoodSection
				Util.Imports.Ancestor:SellPlank(Plank)
				Util.Imports.Maid:deregister("ModWood_Sell")
			end
		end)
	)

	task.spawn(function()
		for i = 1, 9e9 do
			Util.Imports.Maid:Wait()
			if not (Util.Imports.CoreFramework.Status.GUI_LOADED and Sawmill:IsDescendantOf(Util.Imports.Paths.PlayerModels) and SmallestWoodSection and SmallestWoodSection.Parent) then break end
			Util.Imports.CoreFramework:TeleportObject(Tree, Sawmill.Particles.CFrame, nil, nil, SmallestWoodSection, SmallestWoodSection)
		end
		if Util.Imports.CoreFramework.Status.GUI_LOADED and not ModWoodFinished then
			ModWoodFailed = true
		end
	end)

	local chopStart = os.clock()
	repeat Util.Imports.Maid:Wait()
		Util:FireServer("ClientIsDragging", Tree)
		MainSection.Anchored = true
		if Util.Imports.CoreFramework:GetMagnitude(Util.Client.Character.Head, MainSection) > 15 then
			Util.Imports.CoreFramework:Teleport(CFrame.new(MainSection.CFrame.p + Vector3.new(0, 5, 4)))
		end
		Util.Imports.CoreFramework:AttemptChop(Tree, BestAxe, AxeData)
		if os.clock() - chopStart > 120 then
			ModWoodFailed = true
		end
	until ModWoodFinished or ModWoodFailed or not Util.Imports.CoreFramework.Status.GUI_LOADED

	if ModWoodFailed then
		Util.Imports.Maid:deregister("ModWood_Success")
		Util.Imports.Maid:deregister("ModWood_Sell")
		if IsAutofarm then
			Util.Imports.CoreFramework:Notice("Sawmill failed, trying next tree.", 3)
		end
		local HumanoidRootPart = Util.Client.Character:FindFirstChild("HumanoidRootPart")
		if HumanoidRootPart then
			HumanoidRootPart.Velocity = Vector3.zero
			HumanoidRootPart.RotVelocity = Vector3.zero
		end
		Util.Imports.CoreFramework:Teleport(OldPosition + Vector3.new(0, 4, 0))
		Util.Imports.CoreFramework:NoFly()
		self.IsClientFlying = false
		Util.Imports.CoreFramework.Status._endModWood = nil
		self.ModdingWood = false
		if not IsAutofarm then Util.Imports.CoreFramework:UnlockUI() end
		return false
	end

	local HumanoidRootPart = Util.Client.Character:FindFirstChild("HumanoidRootPart")
	if HumanoidRootPart then
		HumanoidRootPart.Velocity = Vector3.zero
		HumanoidRootPart.RotVelocity = Vector3.zero
	end

	Util.Imports.CoreFramework:Teleport(OldPosition + Vector3.new(0, 4, 0))
	Util.Imports.CoreFramework:NoFly()
	self.IsClientFlying = false
	Util.Imports.CoreFramework.Status._endModWood = nil
	self.ModdingWood = false

	repeat Util.Imports.Maid:Wait() until not Util.Imports.Maid:verify("ModWood_Sell")
	return true
end

