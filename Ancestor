function CoreFramework:TreeFarm()
	local OldCF = Util.Client.Character:GetPivot()

	local ok, err = pcall(function()
		while task.wait() and self.Status.Autofarm.TreeAutofarm and self.Status.GUI_LOADED do
			local LemonTrees = workspace:QueryDescendants("#LemonTree")

			for _, Tree in LemonTrees do
				if not self.Status.Autofarm.TreeAutofarm or not self.Status.GUI_LOADED then break end

				local Character = Util.Client.Character
				if not (Character and Character.Parent) then continue end
				if not (Tree and Tree.Parent) then continue end

				Character:PivotTo(Tree:GetPivot())

				local ClickDetectors = Tree:QueryDescendants("ClickDetector")
				if #ClickDetectors <= 0 then continue end

				for _, ClickDetector in ClickDetectors do
					local ClickPart = ClickDetector.Parent
					while ClickPart and ClickPart.Parent and ClickDetector.Parent do
						if not self.Status.Autofarm.TreeAutofarm or not self.Status.GUI_LOADED then break end
						task.wait()
						if not (Character and Character.Parent) then continue end
						if not (Tree and Tree.Parent) then continue end
						Character:PivotTo(Tree:GetPivot())
						pcall(fireclickdetector, ClickDetector)
					end
				end
			end
		end
	end)

	-- runs on clean exit AND on error
	local char = Util.Client.Character
	if char then char:PivotTo(OldCF) end

	if not ok then warn("[TreeFarm] died:", err) end
