	local function SetMainSize(Width, Height)
		Width = math.clamp(Width, MinimumMainSize.X, MaximumMainSize.X)
		Height = math.clamp(Height, MinimumMainSize.Y, MaximumMainSize.Y)
		Main.Size = UDim2.new(0, Width, 0, Height)
