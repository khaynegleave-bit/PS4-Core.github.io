local _Get = function(path) return _JSON[path] or "" end

local function _Loading(status, progress, module)
    if getgenv().AncestorLoadingUpdate then
        getgenv().AncestorLoadingUpdate(status, progress, module)
    end
end

local function _DeepCopy(v)
    if type(v) ~= "table" then return v end
    local out = {}
    for k, sub in v do out[k] = _DeepCopy(sub) end
    return out
end

-- Merge user's saved values onto the remote schema:
--   * Every key from `remote` is included at any depth (new fields land with defaults).
--   * Existing user values in `localTbl` are preserved when their type still matches.
--   * Anything in `localTbl` that's no longer in `remote` is dropped (stale fields purged).
--   * Type mismatches (e.g., field changed from bool to table) fall back to the remote default.
-- Returns (merged, changes) where `changes` lists "+ path", "- path", "~ path" entries.
local function _MergeSettings(remote, localTbl, prefix, changes)
    prefix  = prefix  or ""
    changes = changes or {}

    if type(remote) ~= "table" then
        return _DeepCopy(remote), changes
    end
    if type(localTbl) ~= "table" then
        return _DeepCopy(remote), changes
    end

    local result = {}
    for k, defaultVal in remote do
        local userVal = localTbl[k]
        local path = prefix == "" and tostring(k) or tostring(prefix) .. "." .. tostring(k)

        if type(defaultVal) == "table" then
            if type(userVal) == "table" then
                result[k] = _MergeSettings(defaultVal, userVal, path, changes)
            else
                if userVal ~= nil then
                    table.insert(changes, "~ " .. tostring(path))
                else
                    table.insert(changes, "+ " .. tostring(path))
                end
                result[k] = _DeepCopy(defaultVal)
            end
        elseif userVal == nil then
            table.insert(changes, "+ " .. tostring(path))
            result[k] = _DeepCopy(defaultVal)
        elseif type(userVal) ~= type(defaultVal) then
            table.insert(changes, "~ " .. tostring(path))
            result[k] = _DeepCopy(defaultVal)
        else
            result[k] = userVal
        end
    end

    -- Note removed keys at this level
    for k in localTbl do
        if remote[k] == nil then
            local path = prefix == "" and tostring(k) or tostring(prefix) .. "." .. tostring(k)
            table.insert(changes, "- " .. tostring(path))
        end
    end

    return result, changes
end

-- Always pull the remote schema so new fields/removed fields propagate immediately,
-- but keep any user values for keys that still exist. Result is written back to disk
-- so the on-disk file always mirrors the latest schema. Future updates of any shape —
-- new keys, removed keys, renamed keys (treated as remove+add), nested structure
-- changes, type changes — are absorbed automatically without manual migrations.
local function _LoadSettings(localPath, remotePath)
    local remoteContent = _Get(remotePath)
    local remote = Util.Services.HttpService:JSONDecode(remoteContent)

    local localTbl = {}
    if isfile and isfile(localPath) then
        local ok, decoded = pcall(function()
            return Util.Services.HttpService:JSONDecode(readfile(localPath))
        end)
        if ok and type(decoded) == "table" then
            localTbl = decoded
        end
    end

    local merged, changes = _MergeSettings(remote, localTbl)
    -- Store a clean copy of the remote defaults so the UI can reset to them later.
    Util.Imports.DefaultSettings = _DeepCopy(remote)
    if writefile then
        pcall(writefile, localPath, Util.Services.HttpService:JSONEncode(merged))
    end
    if #changes > 0 then
        print("[Ancestor] Settings schema updated (" .. tostring(localPath) .. "):")
        for _, line in changes do print("  " .. tostring(line)) end
    end
    return merged
end
