function CoreFramework:AttemptRebirth()
	local Tycoon = Util.Imports.Environments.Tycoon.getLocal()
	local Component  = Tycoon:GetComponent(Util.Imports.Environments.ClientTycoonBalances)
	local Component2 = Tycoon:GetComponent(Util.Imports.Environments.ClientTycoonRebirth)

	local Current   = math.round(Util.Imports.Environments.Huge.toNumber(Component:GetInvestors()))
	local Potential = math.round(Util.Imports.Environments.Huge.toNumber(Component2:GetPotentialInvestors()))

	-- persistent per-run tracking
	local T = self._rebirthTracker
	if not T then
		self._rebirthTracker = {
			startT = os.clock(), lastP = Potential, lastT = os.clock(),
			peakRate = 0, emaRate = 0,
		}
		return
	end

	local now = os.clock()
	local dt  = now - T.lastT
	if dt < 0.25 then return end                        -- sample ~4x/sec, not every tick

	local rate = (Potential - T.lastP) / dt
	T.lastP, T.lastT = Potential, now
	if rate ~= rate or math.abs(rate) == math.huge then return end   -- NaN / inf guard

	-- smooth the rate, track its peak for this run
	local ALPHA = 0.3
	T.emaRate  = ALPHA * rate + (1 - ALPHA) * T.emaRate
	T.peakRate = math.max(T.peakRate, T.emaRate)

	-- knobs
	local DECAY_THRESHOLD = 0.25                         -- rebirth once rate drops below 25% of peak
	local MIN_RUN_TIME    = 5                            -- ignore the first 5s (ramp-up noise)

	local matured    = (now - T.startT) > MIN_RUN_TIME
	local stalled    = T.peakRate > 0 and T.emaRate < T.peakRate * DECAY_THRESHOLD
	local worthwhile = Potential > Current              -- net positive, no config floor

	if matured and stalled and worthwhile then
		self._rebirthTracker = nil                      -- reset for the next run
		return Tycoon.Remotes.Rebirth:InvokeServer()
	end
end

