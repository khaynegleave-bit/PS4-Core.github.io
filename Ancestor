function CoreFramework:BypassAnticheat()
	local SuspectActions = {"GetUpdate", "SetUpdate", "GetSetting", "FireProjectile", "Invoke"}
	local SuspectEvents = {"Character", "Item", "Inventory", "Challenges", "Settings", "Prestige", "Shop", "ClientSuccessLogs"}

	local OldNamecall
	OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(Self, ...)
		local Method = getnamecallmethod()
		local Args = {...}

		if Method == "FireServer" then
			local IsSuspectEvent = table.find(SuspectEvents, Self.Name) or table.find(SuspectEvents, tostring(Self))
			local IsSuspectAction = table.find(SuspectActions, Args[1])

			local ViolationKeywords = {
				"Unsafe", "Geometry", "Camera", "Fallback", "Int check",
				"Thawed", "Unbound gloop", "_G", "Shooting hard", 
				"Deleted remote", "Alternate mode", "Hitbox extender", 
				"Floating", "Root", "OnError"
			}

			local ContainsViolation = false
			for _, Value in pairs(Args) do
				if type(Value) == "string" then
					for _, Keyword in ipairs(ViolationKeywords) do
						if Value:lower():find(Keyword:lower()) then
							ContainsViolation = true
							break
						end
					end
				end
				if ContainsViolation then break end
			end

			if IsSuspectEvent and (IsSuspectAction or ContainsViolation) then
				if self.Status.DEBUG_MODE then
					warn("🛑 Anti-Cheat Ban Blocked: " .. Self.Name .. " -> " .. tostring(Args[1]))
				end
				return nil 
			end
		end

		return OldNamecall(Self, ...)
	end))

	local function HookByeFunction()
		local Connection = getconnection(workspace.Geometry.DescendantRemoving, 1)
		local Connection2 = getconnection(workspace.Geometry.AncestryChanged, 1)
		local Connection3 = getconnection(workspace.CurrentCamera.ChildAdded, 1)

		Connection:Disable()
		Connection2:Disable()
		Connection3:Disable()
	end

	HookByeFunction()

	--Game fallbacks and crashes the client after two minutes once the .error is disabled
	for i, Connection in getconnections(game:GetService("ScriptContext").Error) do
		if typeof(Connection.Function) == "function" then
			local Upvalues = getupvalues(Connection.Function)
			if typeof(rawget(Upvalues, 1)) == "number" then
				setupvalue(Connection.Function, 1, 9e9)
				Connection:Disable()
			end
		end
	end

	--Destroy snitching ass script
	local ACScript = Util.Client.PlayerScripts:FindFirstChild("LocalScript")
	if ACScript then
		ACScript:Destroy()
	end

	--Destroy snitching ass remotes
	for i, v in Util.Services.ReplicatedStorage:GetChildren() do
		if v.Name == "" then
			v:Destroy()
		end
	end

	--Not needed but removes the annoying integrity check error
	local old = getrenv().error
	hookfunction(getrenv().error, function(...)
		local Args = {...}
		local Err = rawget(Args, 1)
		if Err:find("integrity") then return end
		return old(...)
	end)


    --Anticheat successfully bypassed
    self.TS = require(Util.Services.ReplicatedStorage.TS)()
    self.TS.Timer:UnbindFromStep("CharacterAnimate")
    if self.Status.DEBUG_MODE then
        warn("[ANCESTOR]: Loaded Bad Business Anticheat Bypass [" .. tostring(self.TS.Version) .. "] " .. tostring(self.TS.Kitty))
    end

	task.defer(function()
		self:MainThread()
	end)
end

