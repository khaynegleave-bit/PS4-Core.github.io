local vehicleCollisionMemory = setmetatable({}, { __mode = "k" })

function CoreFramework:SetVehicleProperties(Vehicle, Properties)
    local turningOff = Properties.CanCollide == false
    local turningOn  = Properties.CanCollide == true

    if turningOff then
        local recorded = vehicleCollisionMemory[Vehicle] or {}
        for _, v in Vehicle:GetDescendants() do
            if v:IsA("BasePart") and v.CanCollide then
                recorded[v] = true
            end
        end
        vehicleCollisionMemory[Vehicle] = recorded
    end

    local memory = vehicleCollisionMemory[Vehicle]
    for _, v in Vehicle:GetDescendants() do
        pcall(function()
            for o, p in Properties do
                if turningOn and o == "CanCollide" and memory and not memory[v] then
                    continue
                end
                v[o] = p
            end
        end)
    end

    if turningOn then
        vehicleCollisionMemory[Vehicle] = nil
    end
end
function CoreFramework:TeleportVehicle_Autobuy(CF, Vehicle)
    local VehicleCFrame, Size = Vehicle:GetBoundingBox()

    Vehicle:PivotTo(CF * CFrame.new(0, 0, -Size.X / 2))

    for _, v in Vehicle:GetDescendants() do
        if v:IsA("BasePart") then
            v.AssemblyLinearVelocity = Vector3.zero
            v.AssemblyAngularVelocity = Vector3.zero
        end
    end

    Util:InvokeServer("TestPing")

    local PrimaryPart = Vehicle.PrimaryPart
    local Attachment = Instance.new("Attachment", PrimaryPart)

    local AlignPosition = Instance.new("AlignPosition")
    AlignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
    AlignPosition.Position = PrimaryPart.Position
    AlignPosition.MaxForce = math.huge
    AlignPosition.Responsiveness = 200
    AlignPosition.RigidityEnabled = true
    AlignPosition.Attachment0 = Attachment
    AlignPosition.Parent = PrimaryPart

    local AlignOrientation = Instance.new("AlignOrientation")
    AlignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment

    -- Extract the forward direction and flatten it on the Y-axis
    local currentLook = PrimaryPart.CFrame.LookVector
    local flatLook = Vector3.new(currentLook.X, 0, currentLook.Z).Unit

    -- Create a new CFrame looking forward, but perfectly level
    AlignOrientation.CFrame = CFrame.lookAt(PrimaryPart.Position, PrimaryPart.Position + flatLook)

    AlignOrientation.MaxTorque = math.huge
    AlignOrientation.Responsiveness = 200
    AlignOrientation.RigidityEnabled = true
    AlignOrientation.Attachment0 = Attachment
    AlignOrientation.Parent = PrimaryPart

    return Attachment, AlignPosition, AlignOrientation
end

function CoreFramework:LocateStoreObject(Object, Quantity)
    local QuantityProvided = Quantity ~= nil
    Quantity = Quantity or 1
    local ignored = Util.DetectedGame.Properties.IgnoredStoreItems
    local list = {}
    for _, store in Util.DetectedGame.Properties.Stores do
        if Object == "Wire" then
            local hasXOR = false
            for _, name in store:QueryDescendants("StringValue#BoxItemName") do
                if name.Value == "GateXOR" then
                    hasXOR = true
                    break
                end
            end
            if not hasXOR then continue end
        end
        for _, storeItem in store:GetChildren() do
            if ignored[storeItem] then continue end

            local boxItemName = storeItem:FindFirstChild("BoxItemName")
            if not boxItemName or boxItemName.Value ~= Object then continue end

            local Owner = storeItem:FindFirstChild("Owner")
            if not Owner or (Owner.Value ~= nil and Owner.Value ~= Util.Client) then continue end

            local OwnerString = storeItem:FindFirstChild("OwnerString")
            if OwnerString and OwnerString.Value ~= "" and OwnerString.Value ~= nil then continue end

            if #list < Quantity then
                table.insert(list, storeItem)
            end
        end
    end
    if QuantityProvided then
        return list
    end
    return list[1] or false
end

