function CoreFramework:Fly(vfly)
	local char = Util.Client.Character or Util.Client.CharacterAdded:Wait()
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		repeat task.wait() until char:FindFirstChildOfClass("Humanoid")
		humanoid = char:FindFirstChildOfClass("Humanoid")
	end

	if self.flyKeyDown then self.flyKeyDown:Disconnect() end
	if self.flyKeyUp then self.flyKeyUp:Disconnect() end

	local T = char:FindFirstChild("HumanoidRootPart")
	if not T then return end

	local CONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
	local lCONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
	local SPEED = 0
	local session = {}
	self._flySession = session

	local function FLY()
		self.FLYING = true

        hookfunction(Util.Imports.Environments.CharacterFloat.isInWater, function()
            return 1
        end)

		local SeatPart = humanoid and humanoid.SeatPart
		local SeatWeldA, SeatWeldB
		if SeatPart then
			SeatWeldA = Instance.new("Weld")
			SeatWeldA.Part0 = T
			SeatWeldA.Part1 = SeatPart
			SeatWeldA.Parent = SeatPart

			SeatWeldB = Instance.new("Weld")
			SeatWeldB.Part0 = T
			SeatWeldB.Part1 = SeatPart
			SeatWeldB.Parent = T
		end

		local BG = Instance.new('BodyGyro')
		local BV = Instance.new('BodyVelocity')
		BG.P = 9e4
		BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		BG.CFrame = T.CFrame
		BG.Parent = T
		BV.Velocity = Vector3.new(0, 0, 0)
		BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		BV.Parent = T
		task.spawn(function()
			repeat task.wait()
				if self._flySession ~= session then break end
				local camera = workspace.CurrentCamera

				if SeatPart and humanoid and humanoid.SeatPart ~= SeatPart then
					pcall(function() if SeatWeldA then SeatWeldA:Destroy() end end)
					pcall(function() if SeatWeldB then SeatWeldB:Destroy() end end)
					SeatWeldA, SeatWeldB, SeatPart = nil, nil, nil
				end

				if not vfly and not SeatPart and humanoid then
					humanoid.PlatformStand = true
				end
				if CONTROL.L + CONTROL.R ~= 0 or CONTROL.F + CONTROL.B ~= 0 or CONTROL.Q + CONTROL.E ~= 0 then
					SPEED = Util.Imports.Settings.Character.FlySpeed
				elseif SPEED ~= 0 then
					SPEED = 0
				end
				if (CONTROL.L + CONTROL.R) ~= 0 or (CONTROL.F + CONTROL.B) ~= 0 or (CONTROL.Q + CONTROL.E) ~= 0 then
					local horizontal = (camera.CFrame.LookVector * (CONTROL.F + CONTROL.B))
						+ ((camera.CFrame * CFrame.new(CONTROL.L + CONTROL.R, 0, 0)).p - camera.CFrame.p)
					local vertical = Vector3.new(0, CONTROL.Q + CONTROL.E, 0)
					BV.Velocity = (horizontal + vertical) * SPEED
					lCONTROL = {F = CONTROL.F, B = CONTROL.B, L = CONTROL.L, R = CONTROL.R, Q = CONTROL.Q, E = CONTROL.E}
				elseif (CONTROL.L + CONTROL.R) == 0 and (CONTROL.F + CONTROL.B) == 0 and (CONTROL.Q + CONTROL.E) == 0 and SPEED ~= 0 then
					local horizontal = (camera.CFrame.LookVector * (lCONTROL.F + lCONTROL.B))
						+ ((camera.CFrame * CFrame.new(lCONTROL.L + lCONTROL.R, 0, 0)).p - camera.CFrame.p)
					local vertical = Vector3.new(0, lCONTROL.Q + lCONTROL.E, 0)
					BV.Velocity = (horizontal + vertical) * SPEED
				else
					BV.Velocity = Vector3.new(0, 0, 0)
				end
				BG.CFrame = camera.CFrame
			until not self.FLYING or self._flySession ~= session
			CONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
			lCONTROL = {F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0}
			SPEED = 0
			pcall(function() BG:Destroy() end)
			pcall(function() BV:Destroy() end)
			pcall(function() if SeatWeldA then SeatWeldA:Destroy() end end)
			pcall(function() if SeatWeldB then SeatWeldB:Destroy() end end)

            restorefunction(Util.Imports.Environments.CharacterFloat.isInWater)
			if humanoid and not SeatPart then humanoid.PlatformStand = false end
		end)
	end

	self.flyKeyDown = Util.Services.UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.W then
			CONTROL.F = 1
		elseif input.KeyCode == Enum.KeyCode.S then
			CONTROL.B = -1
		elseif input.KeyCode == Enum.KeyCode.A then
			CONTROL.L = -1
		elseif input.KeyCode == Enum.KeyCode.D then
			CONTROL.R = 1
		elseif input.KeyCode == Enum.KeyCode[Util.Imports.Settings.Character.FlyUpKey] then
			CONTROL.E = 1
		elseif input.KeyCode == Enum.KeyCode[Util.Imports.Settings.Character.FlyDownKey] then
			CONTROL.Q = -1
		end
		pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Track end)
	end)

	self.flyKeyUp = Util.Services.UserInputService.InputEnded:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.W then CONTROL.F = 0
		elseif input.KeyCode == Enum.KeyCode.S then CONTROL.B = 0
		elseif input.KeyCode == Enum.KeyCode.A then CONTROL.L = 0
		elseif input.KeyCode == Enum.KeyCode.D then CONTROL.R = 0
		elseif input.KeyCode == Enum.KeyCode[Util.Imports.Settings.Character.FlyDownKey] then CONTROL.Q = 0
		elseif input.KeyCode == Enum.KeyCode[Util.Imports.Settings.Character.FlyUpKey] then CONTROL.E = 0
		end
	end)

	local UIS = Util.Services.UserInputService
	if UIS:IsKeyDown(Enum.KeyCode.W) then CONTROL.F = 1 end
	if UIS:IsKeyDown(Enum.KeyCode.S) then CONTROL.B = -1 end
	if UIS:IsKeyDown(Enum.KeyCode.A) then CONTROL.L = -1 end
	if UIS:IsKeyDown(Enum.KeyCode.D) then CONTROL.R = 1 end
	if UIS:IsKeyDown(Enum.KeyCode[Util.Imports.Settings.Character.FlyUpKey]) then CONTROL.E = 1 end
	if UIS:IsKeyDown(Enum.KeyCode[Util.Imports.Settings.Character.FlyDownKey]) then CONTROL.Q = -1 end

	FLY()
end

function CoreFramework:NoFly()
	self.FLYING = false
	self._flySession = nil
	if self.flyKeyDown then self.flyKeyDown:Disconnect() self.flyKeyDown = nil end
	if self.flyKeyUp then self.flyKeyUp:Disconnect() self.flyKeyUp = nil end
	local char = Util.Client.Character
	if char then
		local humanoid = char:FindFirstChildOfClass('Humanoid')
		if humanoid then humanoid.PlatformStand = false end
	end
	pcall(function() workspace.CurrentCamera.CameraType = Enum.CameraType.Custom end)
end

