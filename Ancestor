-- Recognised sub-buckets inside each 2D_WA / 3D_WA folder.
local SUB_BUCKETS = { "Capital_WA", "Lowercase_WA", "Numbers_WA", "Special_WA" }

-- Subfolder-aware path index:
--   index[bucket][lowercasedStem] = "/full/path/to/X.acwire"
-- Plus index["_all"] = flat fallback for any bucket that doesn't fit the four
-- canonical names (e.g. files placed directly at the root).
WireArt._textPathIndex = WireArt._textPathIndex or { ["2D_WA"] = nil, ["3D_WA"] = nil }

local function _emptyBucketIndex()
	local out = { _all = {} }
	for _, b in ipairs(SUB_BUCKETS) do out[b] = {} end
	return out
end

-- Detects which sub-bucket a path belongs to by inspecting the path string
-- (case-insensitive). Returns nil if it doesn't sit under one of the known
-- bucket names (caller falls back to _all).
local function _detectBucket(pathLower)
	for _, b in ipairs(SUB_BUCKETS) do
		if pathLower:find("/" .. string.lower(b) .. "/", 1, true) then
			return b
		end
	end
end

-- Strips "_2d" / "_3d" (and "_2D" / "_3D") suffixes from a stem so files like
-- "A_2D.acwire" or "n_3d.acwire" still match a single character.
local function _stripModeSuffix(stem)
	return (stem:gsub("[_%-][23][Dd]$", ""))
end

local function _buildPathIndex(root)
	if not listfiles then return _emptyBucketIndex() end
	local index   = _emptyBucketIndex()
	local visited = {}
	local function walk(dir)
		if visited[dir] then return end
		visited[dir] = true
		local ok, entries = pcall(listfiles, dir)
		if not ok or type(entries) ~= "table" then return end
		for _, full in ipairs(entries) do
			local normalised = full:gsub("\\", "/"):gsub("/+$", "")
			if normalised:sub(-7):lower() == ".acwire" then
				local stem = normalised:match(".*/(.-)%.acwire$")
					or normalised:match("(.-)%.acwire$")
				if stem then
					-- Strip the _2D / _3D suffix BEFORE lowercasing so the
					-- index key is the bare character ("A_2D" → "A" → "a").
					local stripped = _stripModeSuffix(stem)
					local stemLc   = string.lower(stripped)
					local bucket   = _detectBucket(string.lower(normalised))
					if bucket then
						index[bucket][stemLc] = normalised
					end
					index._all[stemLc] = normalised
				end
			else
				walk(normalised)  -- treat anything else as a folder
			end
		end
	end
	local ok = pcall(walk, root)
	if not ok then return _emptyBucketIndex() end
	return index
end

local function _getPathIndex(threeD)
	local key = _textFolderName(threeD)
	if not WireArt._textPathIndex[key] then
		WireArt._textPathIndex[key] = _buildPathIndex(_textLocalDir(threeD))
	end
	return WireArt._textPathIndex[key]
end

-- Public: invalidate the cached path index so the next lookup re-scans the
-- local folders. Called after a fresh download.
function WireArt:InvalidateTextWireIndex()
	self._textPathIndex = { ["2D_WA"] = nil, ["3D_WA"] = nil }
end

-- Dead-simple direct lookup: each character is mapped to a file in a known
-- bucket. Letters / digits use the lowercased character as the key (so an
-- uppercase letter looks up in Capital_WA by its own lowercased char, and a
-- lowercase letter looks up in Lowercase_WA the same way). Special chars
-- use the TextCharMap → Special_WA.
local function _bucketFor(char)
	local b = string.byte(char) or 0
	if b >= 65 and b <= 90  then return "Capital_WA"   end  -- A-Z
	if b >= 97 and b <= 122 then return "Lowercase_WA" end  -- a-z
	if b >= 48 and b <= 57  then return "Numbers_WA"   end  -- 0-9
	return "Special_WA"
end

function WireArt:GetTextCharWires(char, threeD)
	local index = _getPathIndex(threeD)
	if not index or not next(index._all or {}) then
		self:InvalidateTextWireIndex()
		index = _getPathIndex(threeD)
	end

	local bucket = _bucketFor(char)
	local key
	if bucket == "Special_WA" then
		key = WireArt.TextCharMap[char]
		if not key then return nil, "no special mapping for '" .. tostring(char) .. "'" end
		key = string.lower(key)
	else
		key = string.lower(char)
	end

	local bucketIdx = index[bucket] or {}
	local localPath = bucketIdx[key]
	if not localPath then
		local sample, n = {}, 0
		for k in pairs(bucketIdx) do
			n += 1
			if n <= 8 then table.insert(sample, k) end
		end
		return nil, "'" .. tostring(char) .. "' (key '" .. tostring(key) .. "') not in " .. tostring(bucket) .. " — keys=[" .. tostring(table.concat(sample, ",")) .. "]"
	end
	if not isfile or not isfile(localPath) then
		return nil, "path missing: " .. tostring(localPath)
	end

	local content = readfile(localPath)
	if not content then return nil, "empty file: " .. tostring(localPath) end
	local ok, wires = pcall(function() return loadstring(content)() end)
	if not ok or type(wires) ~= "table" then
		return nil, "parse failed: " .. tostring(localPath)
	end
	return wires
end

-- Returns the number of entries in the flat (all-bucket) index for the given
-- mode. Used by error messages so we can tell if the index is empty.
function WireArt:GetTextWireIndexSize(threeD)
	local idx = _getPathIndex(threeD)
	local n = 0
	for _ in pairs(idx and idx._all or {}) do n += 1 end
	return n
end

-- Returns a per-bucket summary string for diagnostics:
-- "Cap=26 Low=26 Num=10 Spe=3 All=65"
function WireArt:DescribeTextWireIndex(threeD)
	local idx = _getPathIndex(threeD)
	if not idx then return "no index" end
	local function n(t) local c = 0; for _ in pairs(t or {}) do c += 1 end; return c end
	return "Cap=" .. tostring(n(idx.Capital_WA)) .. " Low=" .. tostring(n(idx.Lowercase_WA)) .. " Num=" .. tostring(n(idx.Numbers_WA)) .. " Spe=" .. tostring(n(idx.Special_WA)) .. " All=" .. tostring(n(idx._all))
end

-- Recursively walks a wires structure (nested tables of Vector3s, possibly
-- with sentinel separators like Vector3.new() or Vector3.new(0,3,0)) to find
-- the X- and Y-spans of real points. Sentinels are skipped.
local function _wireBounds(node)
	local minX, maxX = math.huge, -math.huge
	local minY, maxY = math.huge, -math.huge
	local function walk(n)
		if typeof(n) ~= "table" then return end
		for _, item in ipairs(n) do
			local t = typeof(item)
			if t == "Vector3" then
				if not (item == Vector3.new() or item == Vector3.new(0, 3, 0)) then
					if item.X < minX then minX = item.X end
					if item.X > maxX then maxX = item.X end
					if item.Y < minY then minY = item.Y end
					if item.Y > maxY then maxY = item.Y end
				end
			elseif t == "table" then
				walk(item)
			end
		end
	end
	walk(node)
	if minX == math.huge then return 0, 0, 0, 0, 0 end
	return maxX - minX, minX, maxX, minY, maxY
end

-- Backwards-compatible wrapper (X-only).
local function _wireWidth(node)
	local w, minX, maxX = _wireBounds(node)
	return w, minX, maxX
end

-- Deep-copies a wires structure, transforming every non-sentinel Vector3 with
-- the given scale, X-shift, and Y-shift. Sentinels are preserved as-is so
-- segmentation breaks survive.
local function _transformWires(node, scale, xShift, yShift, zScale)
	yShift = yShift or 0
	zScale = zScale or 1
	if typeof(node) ~= "table" then return nil end
	local out = {}
	for _, item in ipairs(node) do
		local t = typeof(item)
		if t == "Vector3" then
			if item == Vector3.new() or item == Vector3.new(0, 3, 0) then
				table.insert(out, item)
			else
				table.insert(out, Vector3.new(
					item.X * scale + xShift,
					item.Y * scale + yShift,
					item.Z * scale * zScale
				))
			end
		elseif t == "table" then
			local sub = _transformWires(item, scale, xShift, yShift, zScale)
			if sub then table.insert(out, sub) end
		end
	end
	return out
end

local function _charStyle(char)
	return 1.0, 0, true
end



-- Renders a Roblox image asset as a wire grid. Accepts either a numeric asset
-- id or an rbxassetid:// content URI. Pixels darker than `threshold` (0–1)
-- become "on" cells; each on cell gets a horizontal wire to its right
-- neighbour and a vertical wire to its below neighbour (when those are also
-- on), producing a wireframe silhouette of the image at the requested
-- `resolution` (number of cells per side).
function WireArt:BuildFromImage(assetId, scale, threeD, threshold, resolution, fill)
	scale      = tonumber(scale)      or 1
	threshold  = tonumber(threshold)  or 0.5
	resolution = math.clamp(math.floor(tonumber(resolution) or 96), 4, 1024)
	if scale <= 0 then scale = 1 end

	-- Normalise the input. We accept:
	--   • bare numeric ids       ("12345")
	--   • rbxassetid:// URIs     ("rbxassetid://12345")
	--   • rbxthumb:// URIs       (avatars / game thumbnails)
	--   • full http(s) URLs      (any external image)
	-- HTTP URLs go through getcustomasset() — most executors expose this to
	-- expose a local file as an rbxasset content id that EditableImage can read.
	local input = tostring(assetId or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if input == "" then return nil, "empty image input" end

	local contentId
	if input:match("^local:") then
		-- Local file from Ancestor/Games/<id>/Image Art folder.
		local fileName = input:sub(7)  -- strip "local:" prefix
		local folder   = "Ancestor/Games/" .. tostring(Util.GameId) .. "/Image Art"
		local fullPath = tostring(folder) .. "/" .. tostring(fileName)
		if not (isfile and isfile(fullPath)) then
			return nil, "local image not found: " .. fileName
		end
		local getCustomAsset = getcustomasset or getsynasset
		if not getCustomAsset then
			return nil, "executor doesn't support local images (need getcustomasset)"
		end
		local okConv, asset = pcall(getCustomAsset, fullPath)
		if not okConv or not asset or tostring(asset) == "" then
			return nil, "couldn't load local image (" .. tostring(asset) .. ")"
		end
		contentId = asset
	elseif input:match("^rbxasset") then
		contentId = input
	elseif input:match("^https?://") then
		local getCustomAsset = getcustomasset or getsynasset
		if not (writefile and getCustomAsset) then
			return nil, "executor doesn't support external image URLs (need writefile + getcustomasset)"
		end

		-- URL-decode helper for query-param extraction.
		local function urlDecode(s)
			s = s:gsub("+", " ")
			s = s:gsub("%%(%x%x)", function(h)
				return string.char(tonumber(h, 16))
			end)
			return s
		end

		-- Google Images "copy link" usually gives the result viewer page
		-- (google.*/imgres?...&imgurl=<real>...) which serves HTML, not the
		-- image. Extract the actual image URL so the user doesn't have to
		-- upload to Discord/imgur first.
		local function extractImageUrl(url)
			if url:match("google%.[%w%.]+/imgres") or url:match("google%.[%w%.]+/url%?") then
				local target = url:match("[?&]imgurl=([^&]+)")
					or url:match("[?&]url=([^&]+)")
					or url:match("[?&]q=([^&]+)")
				if target then
					local decoded = urlDecode(target)
					if decoded:match("^https?://") then return decoded end
				end
			end
			return url
		end

		input = extractImageUrl(input)

		-- Pick a sensible Referer per host. Google's image CDNs (gstatic,
		-- googleusercontent) commonly 403 hot-link requests without one.
		local function refererFor(url)
			if url:match("gstatic%.com") or url:match("googleusercontent%.com") then
				return "https://www.google.com/"
			end
			return nil
		end

		-- Try the executor's request() function FIRST — it handles binary
		-- content correctly, follows redirects, and works across image CDNs
		-- that strip whitespace etc. from HttpGet responses. Falls back to
		-- game when no request function is available.
		local function downloadBytes(url)
			-- Common executor request entry points.
			local req = (typeof(rawget(getfenv(), "request")) == "function" and rawget(getfenv(), "request"))
				or (typeof(http_request) == "function" and http_request)
				or (syn and syn.request)
				or (http and http.request)
				or (fluxus and fluxus.request)
			local headers = {
				["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
				["Accept"]     = "image/avif,image/webp,image/png,image/*,*/*;q=0.8",
			}
			local ref = refererFor(url)
			if ref then headers["Referer"] = ref end
			if typeof(req) == "function" then
				local ok, resp = pcall(req, {
					Url     = url,
					Method  = "GET",
					Headers = headers,
				})
				if ok and typeof(resp) == "table" and resp.Body and #resp.Body > 0 then
					return resp.Body, (typeof(resp.StatusCode) == "number" and resp.StatusCode) or 0
				end
			end
			-- HttpGet fallback.
			local ok, body = pcall(function() return game:HttpGet(url, true) end)
			if ok and typeof(body) == "string" and #body > 0 then
				return body, 200
			end
			return nil, 0
		end

		local bytes, status = downloadBytes(input)
		if not bytes then
			return nil, "failed to download URL (no executor request API or HttpGet failed)"
		end
		if status >= 400 then
			return nil, "URL returned HTTP " .. tostring(status)
		end
		if #bytes < 16 then
			return nil, "URL returned only " .. tostring(#bytes) .. " bytes (not an image)"
		end

		-- Detect the REAL image format from magic bytes.
		local function detectFormat(b)
			local h1, h2, h3, h4 = b:byte(1, 4)
			if h1 == 0x89 and h2 == 0x50 and h3 == 0x4E and h4 == 0x47 then return "png" end
			if h1 == 0xFF and h2 == 0xD8 and h3 == 0xFF                    then return "jpg" end
			if b:sub(1, 4) == "GIF8"                                       then return "gif" end
			if b:sub(1, 2) == "BM"                                         then return "bmp" end
			if b:sub(1, 4) == "RIFF" and b:sub(9, 12) == "WEBP"            then return "webp" end
			if b:sub(1, 4) == "II*\0" or b:sub(1, 4) == "MM\0*"            then return "tiff" end
			return nil
		end

		local ext = detectFormat(bytes)
		if not ext then
			-- Bytes don't match any known image format. Most common cause:
			-- the URL returned an HTML page (anti-bot, 404 page, login wall).
			local snippet = bytes:sub(1, 60):lower()
			if snippet:find("<html") or snippet:find("<!doctype") then
				return nil, "URL returned an HTML page, not an image (anti-bot or 404 wall)"
			end
			-- Last resort: try the URL's own extension.
			local urlExt = input:match("%.(%w+)$")
			if urlExt then urlExt = urlExt:lower() end
			if urlExt == "png" or urlExt == "jpg" or urlExt == "jpeg"
			   or urlExt == "bmp" or urlExt == "gif" or urlExt == "webp" then
				ext = urlExt
			else
				-- Try every common extension by writing the same bytes — some
				-- executors are picky about the suffix.
				ext = "png"
			end
		end
		if ext == "jpeg" then ext = "jpg" end

		pcall(function()
			if makefolder and not (isfolder and isfolder("Ancestor/cache")) then
				makefolder("Ancestor/cache")
			end
		end)

		-- Some executors / Roblox client versions accept rbxasset only for
		-- specific suffix sets, so if the detected extension doesn't yield a
		-- working contentId we retry with the alternative common extensions.
		local tryExts = { ext }
		for _, candidate in ipairs({ "png", "jpg", "bmp" }) do
			if candidate ~= ext then table.insert(tryExts, candidate) end
		end

		local lastWriteErr, lastConvErr
		for _, e in ipairs(tryExts) do
			local path = string.format("Ancestor/cache/img_%d_%s.%s", os.time(), e, e)
			local okWrite, writeErr = pcall(function() writefile(path, bytes) end)
			if not okWrite then
				lastWriteErr = tostring(writeErr)
				continue
			end
			local okConv, asset = pcall(getCustomAsset, path)
			if okConv and asset and tostring(asset) ~= "" then
				contentId = asset
				break
			end
			lastConvErr = tostring(asset)
		end

		if not contentId then
			return nil, "couldn't save / convert image — "
				.. (lastConvErr or lastWriteErr or "executor refused all extensions")
		end
	else
		-- Bare digits → wrap as rbxassetid.
		local digits = input:gsub("%D", "")
		if digits == "" then return nil, "asset id has no digits" end
		contentId = "rbxassetid://" .. digits
	end

	-- Load via EditableImage. Roblox has shipped three different APIs for this
	-- over the past two years; try them in order so the feature works across
	-- both old and new Roblox client versions and across executors that may
	-- have patched one variant but not the others.
	local AssetService = game:GetService("AssetService")
	local editableImage, loadErr

	-- API 1 (modern, 2024+): Content object + CreateEditableImageAsync.
	if not editableImage then
		local ok, img = pcall(function()
			local ContentLib = (rawget(getfenv(), "Content") or Content)
			local content = ContentLib.fromUri(contentId)
			return AssetService:CreateEditableImageAsync(content)
		end)
		if ok and img then editableImage = img else loadErr = tostring(img) end
	end

	-- API 2 (legacy 2023): string content id + CreateEditableImageAsync.
	if not editableImage then
		local ok, img = pcall(function()
			return AssetService:CreateEditableImageAsync(contentId)
		end)
		if ok and img then editableImage = img else loadErr = tostring(img) end
	end

	-- API 3 (oldest): manual EditableImage instance + AssetUri property.
	if not editableImage then
		local ok, img = pcall(function()
			local e = Instance.new("EditableImage")
			e.AssetUri = contentId
			return e
		end)
		if ok and img and img.Size and img.Size.X > 0 then editableImage = img end
	end

	if not editableImage then
		return nil, "could not load image — " .. (loadErr or "EditableImage API unavailable on this client")
	end

	local size = editableImage.Size
	if not size or size.X < 2 or size.Y < 2 then return nil, "image too small or failed to load" end

	-- Always trace at the image's native resolution (capped at 1920 per axis
	-- to keep wire counts manageable). The `resolution` parameter is ignored —
	-- using a single grid value would either upsample one axis or throw away
	-- detail on the other.
	local MAX_AXIS = 1920
	local cols     = math.min(math.floor(size.X), MAX_AXIS)
	local rows     = math.min(math.floor(size.Y), MAX_AXIS)

	-- Read all pixels. The modern API returns a buffer; the older returned an
	-- array of numbers. Handle both.
	local okPx, pixelsRaw = pcall(function()
		return editableImage:ReadPixels(Vector2.new(0, 0), size)
	end)
	if not okPx or not pixelsRaw then
		-- Try newer ReadPixelsBuffer variant.
		local okBuf, buf = pcall(function() return editableImage:ReadPixelsBuffer(Vector2.new(0, 0), size) end)
		if okBuf and buf then pixelsRaw = buf end
	end
	if not pixelsRaw then return nil, "could not read pixel data" end

	-- Normalise into a function `getPixel(i)` returning RGBA 0..1.
	-- Modern Roblox/Luau returns a `buffer` value (bytes 0..255); older
	-- returns a flat table of floats already 0..1.
	-- IMPORTANT: in Luau `type(buf)` is "buffer", not "userdata".
	local pixelsType = type(pixelsRaw)
	local getR, getG, getB, getA
	if pixelsType == "buffer" then
		getR = function(i) return buffer.readu8(pixelsRaw, (i - 1) * 4)     / 255 end
		getG = function(i) return buffer.readu8(pixelsRaw, (i - 1) * 4 + 1) / 255 end
		getB = function(i) return buffer.readu8(pixelsRaw, (i - 1) * 4 + 2) / 255 end
		getA = function(i) return buffer.readu8(pixelsRaw, (i - 1) * 4 + 3) / 255 end
	elseif pixelsType == "table" then
		-- Modern table form is also a byte stream (0..255 ints, not floats).
		-- Older floating-point form is normalised below by detecting any value > 1.
		local sample = pixelsRaw[1] or 0
		local isByteStream = sample > 1
		local divisor = isByteStream and 255 or 1
		getR = function(i) return (pixelsRaw[(i - 1) * 4 + 1] or 0) / divisor end
		getG = function(i) return (pixelsRaw[(i - 1) * 4 + 2] or 0) / divisor end
		getB = function(i) return (pixelsRaw[(i - 1) * 4 + 3] or 0) / divisor end
		getA = function(i) return (pixelsRaw[(i - 1) * 4 + 4] or 0) / divisor end
	else
		return nil, "unexpected pixel data type: " .. tostring(pixelsType)
	end

	-- ── Greyscale conversion robust to coloured images ────────────────────────
	-- Pure luminance can't separate two coloured regions of similar brightness
	-- (red on green, blue on orange, etc.). We instead binarise each source
	-- pixel by its RGB distance from the image's background colour, then
	-- downsample by counting "subject" pixels per cell.
	--
	-- Background colour is sampled from the 4 corners (almost always bg) — the
	-- per-pixel "blackness" is the chroma distance to that colour, normalised
	-- and inverted so subject → 0 (black) and background → 1 (white).
	local W, H = math.floor(size.X), math.floor(size.Y)

	-- Average corner colour as background reference.
	local function pixelRGB(px, py)
		local i = (py - 1) * W + px
		return getR(i), getG(i), getB(i), getA(i)
	end
	local cR, cG, cB, cN = 0, 0, 0, 0
	for _, p in ipairs({ {1,1}, {W,1}, {1,H}, {W,H} }) do
		local r, g, b, a = pixelRGB(p[1], p[2])
		if a > 0.05 then
			cR += r; cG += g; cB += b; cN += 1
		end
	end
	if cN == 0 then cR, cG, cB, cN = 1, 1, 1, 1 end
	local bgR, bgG, bgB = cR / cN, cG / cN, cB / cN

	-- First pass: per-source-pixel "subject distance" (0 = exact background,
	-- 1 = maximally distant). Distance is RGB Euclidean / sqrt(3) which bounds
	-- it to [0, 1]. We then auto-stretch so the brightest pixel hits 1.
	-- Transparent pixels are marked with -1 and skipped during downsample.
	local maxDist = 0
	local distRow = table.create(H)
	for py = 1, H do
		local dr = table.create(W, -1)
		for px = 1, W do
			local r, g, b, a = pixelRGB(px, py)
			if a > 0.05 then
				local d = math.sqrt((r - bgR)^2 + (g - bgG)^2 + (b - bgB)^2) / math.sqrt(3)
				dr[px] = d
				if d > maxDist then maxDist = d end
			end
		end
		distRow[py] = dr
	end
	local distNorm = (maxDist > 1e-3) and (1 / maxDist) or 1

	-- Second pass: downsample. Cell value = average normalised subject
	-- distance, then INVERTED so subject is dark (low value) and background
	-- is light — keeps the downstream threshold semantics unchanged.
	local grid = {}
	for ry = 1, rows do
		grid[ry] = {}
		local srcY0 = math.floor((ry - 1) * H / rows) + 1
		local srcY1 = math.floor(ry * H / rows)
		for rx = 1, cols do
			local srcX0 = math.floor((rx - 1) * W / cols) + 1
			local srcX1 = math.floor(rx * W / cols)
			local sum, count = 0, 0
			for py = srcY0, srcY1 do
				local dr = distRow[py]
				for px = srcX0, srcX1 do
					local d = dr[px]
					if d >= 0 then
						sum += d * distNorm
						count += 1
					end
				end
			end
			-- Invert: bg colour → 1 (white), far from bg → 0 (black).
			grid[ry][rx] = (count > 0) and (1 - sum / count) or 1
		end
	end

	-- Auto-detect subject orientation. Sample the 4 corners — those are almost
	-- always background. If corners are DARK, the subject is light (logos on
	-- black backgrounds) → "on" means brightness > threshold. Otherwise the
	-- subject is dark (drawings on white) → "on" means brightness < threshold.
	local cornerLum = (grid[1][1] + grid[1][cols] + grid[rows][1] + grid[rows][cols]) / 4
	local subjectIsLight = cornerLum < 0.5

	local function isSubject(b)
		if subjectIsLight then
			return b > threshold
		else
			return b < threshold
		end
	end

	-- Solid subject grid first.
	local on = {}
	for ry = 1, rows do
		on[ry] = {}
		for rx = 1, cols do
			on[ry][rx] = isSubject(grid[ry][rx])
		end
	end

	-- ── Phase 1: Marching squares → raw {a, b} segment pairs ───────────────────
	-- Linearly interpolate the iso-contour crossing on each 2×2 cell edge so
	-- curved boundaries come out as smooth curves, not pixel staircases.
	local rawSegs = {}

	local function crossPt(ac, ar, bc, br, va, vb)
		local t = 0.5
		local dv = vb - va
		if math.abs(dv) > 1e-6 then
			t = math.clamp((threshold - va) / dv, 0, 1)
		end
		-- +0.5 offset keeps every point away from the (0,0,0) sentinel
		return Vector3.new(
			(ac + (bc - ac) * t + 0.5) * scale,
			-(ar + (br - ar) * t + 0.5) * scale,
			0
		)
	end

	for ry = 1, rows - 1 do
		for rx = 1, cols - 1 do
			local bTL = grid[ry    ][rx    ]
			local bTR = grid[ry    ][rx + 1]
			local bBL = grid[ry + 1][rx    ]
			local bBR = grid[ry + 1][rx + 1]

			local cTL = isSubject(bTL) and 1 or 0
			local cTR = isSubject(bTR) and 1 or 0
			local cBL = isSubject(bBL) and 1 or 0
			local cBR = isSubject(bBR) and 1 or 0

			local config = cTL * 8 + cTR * 4 + cBR * 2 + cBL * 1
			if config ~= 0 and config ~= 15 then
				local c0, r0 = rx - 1, ry - 1
				local c1, r1 = rx,     ry - 1
				local c2, r2 = rx,     ry
				local c3, r3 = rx - 1, ry

				local T = crossPt(c0, r0, c1, r1, bTL, bTR)
				local R = crossPt(c1, r1, c2, r2, bTR, bBR)
				local B = crossPt(c3, r3, c2, r2, bBL, bBR)
				local L = crossPt(c0, r0, c3, r3, bTL, bBL)

				if     config == 1  then table.insert(rawSegs, {L, B})
				elseif config == 2  then table.insert(rawSegs, {B, R})
				elseif config == 3  then table.insert(rawSegs, {L, R})
				elseif config == 4  then table.insert(rawSegs, {T, R})
				elseif config == 5  then table.insert(rawSegs, {T, R}); table.insert(rawSegs, {L, B})
				elseif config == 6  then table.insert(rawSegs, {T, B})
				elseif config == 7  then table.insert(rawSegs, {T, L})
				elseif config == 8  then table.insert(rawSegs, {T, L})
				elseif config == 9  then table.insert(rawSegs, {T, B})
				elseif config == 10 then table.insert(rawSegs, {T, L}); table.insert(rawSegs, {R, B})
				elseif config == 11 then table.insert(rawSegs, {T, R})
				elseif config == 12 then table.insert(rawSegs, {L, R})
				elseif config == 13 then table.insert(rawSegs, {B, R})
				elseif config == 14 then table.insert(rawSegs, {L, B})
				end
			end
		end
	end

	-- ── Phase 2: Chain raw segments into polylines ────────────────────────────
	-- Build an endpoint map so we can greedily stitch adjacent segments into
	-- long continuous paths. Because crossPt uses deterministic float arithmetic,
	-- shared edge-crossings have bit-exact equal coordinates — keying to 4
	-- decimal places is more than sufficient to collapse them.
	local function epKey(v)
		return string.format("%.4f|%.4f", v.X, v.Y)
	end

	local epMap = {}   -- key -> list of { segIdx, whichEnd (1|2) }
	for i, seg in ipairs(rawSegs) do
		local k1 = epKey(seg[1])
		local k2 = epKey(seg[2])
		if not epMap[k1] then epMap[k1] = {} end
		if not epMap[k2] then epMap[k2] = {} end
		table.insert(epMap[k1], { i, 1 })
		table.insert(epMap[k2], { i, 2 })
	end

	local used   = table.create(#rawSegs, false)
	local chains = {}

	local function greedyExtend(chain, tip, forward)
		-- `forward` = true → append to end; false → prepend to start
		while true do
			local nexts = epMap[epKey(tip)]
			if not nexts then break end
			local found = false
			for _, n in ipairs(nexts) do
				local nIdx, nEnd = n[1], n[2]
				if not used[nIdx] then
					used[nIdx] = true
					local ns = rawSegs[nIdx]
					-- nEnd is the end of ns that touches `tip`; we exit from the other end
					local newTip = (nEnd == 1) and ns[2] or ns[1]
					if forward then
						table.insert(chain, newTip)
					else
						table.insert(chain, 1, newTip)
					end
					tip   = newTip
					found = true
					break
				end
			end
			if not found then break end
		end
	end

	for startIdx = 1, #rawSegs do
		if not used[startIdx] then
			used[startIdx] = true
			local seg   = rawSegs[startIdx]
			local chain = { seg[1], seg[2] }
			greedyExtend(chain, seg[2], true)   -- grow forward
			greedyExtend(chain, seg[1], false)  -- grow backward
			table.insert(chains, chain)
		end
	end

	-- ── Phase 3: Douglas-Peucker simplification ───────────────────────────────
	-- Reduce each polyline to the minimum number of points that stay within
	-- `dpEpsilon` world-units of the original curve. Half a pixel at the given
	-- scale keeps the outline visually perfect while collapsing long near-straight
	-- arcs into just two endpoints — dramatically cutting DrawLine calls.
	local dpEpsilon = 0.5 * scale

	local function dpSimplify(pts, lo, hi, keep)
		if hi - lo < 2 then return end
		local a, b  = pts[lo], pts[hi]
		local ab    = b - a
		local abMag = ab.Magnitude
		local maxDist, maxIdx = 0, lo
		for i = lo + 1, hi - 1 do
			local ap   = pts[i] - a
			local dist
			if abMag < 1e-8 then
				dist = ap.Magnitude
			else
				local t      = math.clamp(ap:Dot(ab) / (abMag * abMag), 0, 1)
				local proj   = a + ab * t
				dist = (pts[i] - proj).Magnitude
			end
			if dist > maxDist then
				maxDist = dist
				maxIdx  = i
			end
		end
		if maxDist > dpEpsilon then
			keep[maxIdx] = true
			dpSimplify(pts, lo,     maxIdx, keep)
			dpSimplify(pts, maxIdx, hi,     keep)
		end
	end

	local combined = {}
	local placed   = 0

	for _, chain in ipairs(chains) do
		if #chain < 2 then continue end
		local keep  = table.create(#chain, false)
		keep[1]     = true
		keep[#chain] = true
		dpSimplify(chain, 1, #chain, keep)
		local simplified = {}
		for i = 1, #chain do
			if keep[i] then table.insert(simplified, chain[i]) end
		end
		if #simplified >= 2 then
			table.insert(combined, simplified)
			placed += 1
		end
	end

	-- Fill mode: only fill truly solid black regions, not thin outline strokes.
	-- Separable box erosion with a small fixed radius removes features narrower
	-- than (2R+1) pixels (typical outline strokes) while keeping large solid areas.
	-- Row spacing is derived from the actual wire thickness so fill lines sit
	-- flush against each other with no gap or overlap.
	if fill then
		-- Fetch wire thickness so we can space rows correctly.
		local wireInfo  = Util.Imports.Paths.ClientItemInfo:FindFirstChild(
			self.Settings.Preview.SelectedWireType, true)
		local thickness = (wireInfo and wireInfo.OtherInfo
			and wireInfo.OtherInfo.Thickness
			and wireInfo.OtherInfo.Thickness.Value) or 0.2

		-- Density-based interior detection.
		-- A pixel counts as "filled region" if it itself is on AND the local
		-- neighbourhood is mostly on. This keeps the full extent of solid black
		-- areas (including their edges) while excluding thin outline strokes
		-- whose surrounding neighbourhood is mostly background.
		--
		-- Implementation: separable box sum via row prefix sums, then column
		-- prefix sums, gives the count of "on" pixels in any axis-aligned
		-- window in O(1). We use a 5x5 window and require ≥ 60% on.
		local R = 2
		local minRatio = 0.6
		-- Row-wise integral (prefix sum) of on[][]
		local rowSum = table.create(rows)
		for ry = 1, rows do
			local rs = table.create(cols + 1, 0)
			local acc = 0
			for rx = 1, cols do
				if on[ry][rx] then acc += 1 end
				rs[rx + 1] = acc
			end
			rowSum[ry] = rs
		end
		local interior = table.create(rows)
		for ry = 1, rows do
			interior[ry] = table.create(cols, false)
		end
		for ry = 1, rows do
			if not on[ry] then continue end
			for rx = 1, cols do
				if not on[ry][rx] then continue end
				local x0 = math.max(1, rx - R)
				local x1 = math.min(cols, rx + R)
				local y0 = math.max(1, ry - R)
				local y1 = math.min(rows, ry + R)
				local count = 0
				for yy = y0, y1 do
					local rs = rowSum[yy]
					count += rs[x1 + 1] - rs[x0]
				end
				local area = (x1 - x0 + 1) * (y1 - y0 + 1)
				if count / area >= minRatio then
					interior[ry][rx] = true
				end
			end
		end

		local rowStepF = 1

		-- Pass 1: collect every sampled row's runs in original L→R coords.
		local rowRuns = {}
		local rowF    = 1.0
		while rowF <= rows do
			local ry   = math.round(rowF)
			local y    = -(ry - 0.5) * scale
			local runs = {}
			local runStart = nil
			for rx = 1, cols + 1 do
				local isOn = rx <= cols and interior[ry][rx] or false
				if isOn and not runStart then
					runStart = rx - 1
				elseif not isOn and runStart then
					local x1 = runStart * scale
					local x2 = (rx - 1) * scale
					if x2 - x1 > 1e-4 then table.insert(runs, { x1, x2 }) end
					runStart = nil
				end
			end
			if #runs > 0 then
				table.insert(rowRuns, { y = y, runs = runs })
			end
			rowF += rowStepF
		end

		-- Pass 2: boustrophedon snake, connecting only horizontally-overlapping
		-- runs across adjacent rows (same filled region).  Runs with no overlap
		-- above them start fresh chains.
		-- Each active chain tracks the last run's [x1,x2] span for overlap tests.
		local activeChains  = {}   -- { chain, lastRun={x1,x2} }
		local finishedChains = {}

		for rowIdx, rowData in ipairs(rowRuns) do
			local y           = rowData.y
			local runs        = rowData.runs
			local leftToRight = (rowIdx % 2 == 1)
			local newActive   = {}
			local usedChain   = {}

			for _, run in ipairs(runs) do
				local x1, x2 = run[1], run[2]

				-- Find the active chain whose last run most overlaps this one.
				local bestIdx, bestOverlap = nil, 0
				for i, ac in ipairs(activeChains) do
					if not usedChain[i] then
						local lr  = ac.lastRun
						local ov  = math.min(x2, lr[2]) - math.max(x1, lr[1])
						if ov > bestOverlap then
							bestOverlap = ov
							bestIdx     = i
						end
					end
				end

				local ptA = leftToRight and Vector3.new(x1, y, 0) or Vector3.new(x2, y, 0)
				local ptB = leftToRight and Vector3.new(x2, y, 0) or Vector3.new(x1, y, 0)

				if bestIdx then
					usedChain[bestIdx] = true
					local ac = activeChains[bestIdx]
					table.insert(ac.chain, ptA)
					table.insert(ac.chain, ptB)
					ac.lastRun = run
					table.insert(newActive, ac)
				else
					table.insert(newActive, {
						chain   = { ptA, ptB },
						lastRun = run,
					})
				end
			end

			-- Flush chains that had no matching run this row.
			for i, ac in ipairs(activeChains) do
				if not usedChain[i] then
					table.insert(finishedChains, ac.chain)
				end
			end
			activeChains = newActive
		end

		for _, ac in ipairs(activeChains) do
			table.insert(finishedChains, ac.chain)
		end

		-- Store fill chains separately so they bypass BuildChainedSegments in
		-- Optimize (which would decompose them back into edges and corrupt the
		-- outline routing). They still get wire-length split there.
		local fillChains = {}
		for _, chain in ipairs(finishedChains) do
			if #chain >= 2 then
				table.insert(fillChains, chain)
				placed += 1
			end
		end
		self.Settings.Properties.FillChains = fillChains
	end

	if placed == 0 then
		return nil, "no pixels passed the threshold — try raising or lowering it"
	end

	-- Optional thin extrusion in 3D mode so the wires aren't co-planar.
	if threeD then
		local depth = 0.2 * scale
		local extruded = {}
		for _, seg in ipairs(combined) do
			local a, b = seg[1], seg[2]
			table.insert(extruded, { a, b })
			table.insert(extruded, {
				a + Vector3.new(0, 0, depth),
				b + Vector3.new(0, 0, depth),
			})
		end
		combined = extruded
	end

	return combined
end
-- Builds a wire structure from ASCII-art-style text. The input is treated as a
-- 2D grid: each row goes on its own line (split by "\n" or real newlines), and
-- every non-space character is rendered using its real wire-art glyph (the same
-- .acwire files BuildFromText uses) placed at its grid coordinate. Spaces leave
-- an empty cell. All characters share a uniform cell width / row height so the
-- output preserves the shape of the original ASCII art.
function WireArt:BuildFromAscii(text, scale, threeD)
	scale = tonumber(scale) or 1
	if scale <= 0 then scale = 1 end

	-- Split input into rows on "\n" (literal two-char) or real newlines
	local lines = {}
	local current = ""
	local i = 1
	while i <= #text do
		local c = string.sub(text, i, i)
		if c == "\\" and string.sub(text, i + 1, i + 1) == "n" then
			table.insert(lines, current)
			current = ""
			i += 2
		elseif c == "\n" then
			table.insert(lines, current)
			current = ""
			i += 1
		else
			current = current .. c
			i += 1
		end
	end
	table.insert(lines, current)

	-- Pass 1: measure every unique character in the input. Each glyph in the
	-- wire-art font has its own natural width/height, so we record them all and
	-- use the maxima as a uniform monospace cell. Centering glyphs in this cell
	-- gives evenly-spaced columns and rows regardless of which characters appear.
	local glyphMetrics = {}  -- char -> { wires, minX, minY, w, h }
	local cellW, cellH = 0, 0
	for _, line in ipairs(lines) do
		for c = 1, #line do
			local char = string.sub(line, c, c)
			if char ~= " " and not glyphMetrics[char] then
				local wires = self:GetTextCharWires(char, threeD)
				if wires and next(wires) ~= nil then
					local w, minX, _, minY, maxY = _wireBounds(wires)
					local h = maxY - minY
					glyphMetrics[char] = {
						wires = wires, minX = minX, minY = minY, w = w, h = h,
					}
					local gw = w * scale
					local gh = h * scale
					if gw > cellW then cellW = gw end
					if gh > cellH then cellH = gh end
				end
			end
		end
	end
	if cellW <= 0 or cellH <= 0 then return nil, "no renderable characters in ASCII art" end

	local combined  = {}
	local placed    = 0
	local firstFail = nil

	for row, line in ipairs(lines) do
		for col = 1, #line do
			local char = string.sub(line, col, col)
			if char ~= " " then
				local m = glyphMetrics[char]
				if m then
					-- Center each glyph horizontally in its cell so narrow chars
					-- like '|' sit equidistant from their neighbours. Vertically
					-- keep each glyph's NATURAL baseline position — wire-art
					-- glyphs already encode this correctly (e.g. '_' sits at the
					-- baseline, '|' extends up to cap height, '(' has a tiny
					-- descender), so all we do is shift rows down by cellH.
					local glyphW = m.w * scale
					local cellCx = (col - 1) * cellW + cellW * 0.5
					local xShift = cellCx - (m.minX * scale) - glyphW * 0.5
					local yShift = -(row - 1) * cellH
					local shifted = _transformWires(m.wires, scale, xShift, yShift, 1)
					if shifted and next(shifted) ~= nil then
						table.insert(combined, shifted)
						placed += 1
					end
				else
					if not firstFail then firstFail = "'" .. tostring(char) .. "': not renderable" end
				end
			end
		end
	end

	if placed == 0 then return nil, firstFail or "no characters resolved" end
	return combined
end
-- Builds a combined wires structure from a string. Each character is loaded
-- from /2D_WA or /3D_WA, scaled, and laid out left-to-right with `padding`
-- studs between characters.
-- wordWrap: spaces become line breaks, stacking words downward.
-- alignment: "Left" | "Center" | "Right" — how lines are aligned when word-
--            wrapping. Ignored when wordWrap is false.
-- Returns the combined wires table or nil on failure.
function WireArt:BuildFromText(text, scale, padding, threeD, zScale, wordWrap, alignment)
	scale     = tonumber(scale)   or 1
	padding   = tonumber(padding) or 0
	zScale    = tonumber(zScale)  or 1
	alignment = alignment or "Left"
	if scale  <= 0 then scale  = 1 end
	if zScale <= 0 then zScale = 1 end

	local combined  = {}
	local placed    = 0
	local firstFail = nil
	local capHeight = nil

	-- ── Word-wrap path (two-pass for alignment) ──────────────────────────────
	if wordWrap then
		-- Pass 1: split on the two-character sequence "\n" (backslash + n) and
		-- measure each line. Spaces are treated as normal characters.
		local lines = {}           -- { chars = { { wires, es, xShift, yShift } }, width }
		local lineY   = 0
		local lineMaxH = 0

		local function buildLine(lineText)
			local chars     = {}
			local lineCursorX = 0
			local lineCapH  = nil

			local i = 1
			while i <= #lineText do
				local char = string.sub(lineText, i, i)
				local wires, why = self:GetTextCharWires(char, threeD)
				if wires and next(wires) ~= nil then
					local csm, lift, _ = _charStyle(char)
					local es = scale * csm
					local width, minX, _, minY, maxY = _wireBounds(wires)
					local charHeight = maxY - minY
					if not lineCapH  and csm >= 0.99 then lineCapH  = charHeight * scale end
					if not capHeight and csm >= 0.99 then capHeight = charHeight * scale end
					local refCap = lineCapH or capHeight or (charHeight * scale)
					local glyphH = charHeight * es
					if glyphH > lineMaxH then lineMaxH = glyphH end
					local xShift = lineCursorX - (minX * es)
					local yShift = (minY * scale) - (minY * es) + (lift * refCap) + lineY
					table.insert(chars, { wires = wires, es = es, xShift = xShift, yShift = yShift })
					lineCursorX += (width * es) + padding
				else
					if not firstFail then firstFail = "'" .. tostring(char) .. "': " .. tostring(why or "?") end
					local isSpace = char:match("%s") ~= nil
					lineCursorX += ((isSpace and 1.1 or 1) * scale) + padding
				end
				i += 1
			end

			local lineWidth = math.max(0, lineCursorX - padding)
			table.insert(lines, { chars = chars, width = lineWidth })

			-- Advance Y for next line
			if lineMaxH > 0 then
				lineY   -= lineMaxH * 1.3
				lineMaxH = 0
			end
		end

		-- Split on the literal two-character sequence "\" + "n"
		local current = ""
		local i = 1
		while i <= #text do
			local char = string.sub(text, i, i)
			if char == "\\" and string.sub(text, i + 1, i + 1) == "n" then
				buildLine(current)
				current = ""
				i += 2
			else
				current = current .. char
				i += 1
			end
		end
		buildLine(current)  -- flush last line

		-- Pass 2: find max line width, apply alignment offset, emit wires.
		local maxWidth = 0
		for _, line in ipairs(lines) do
			if line.width > maxWidth then maxWidth = line.width end
		end

		for _, line in ipairs(lines) do
			local xOff = 0
			if alignment == "Center" then
				xOff = (maxWidth - line.width) / 2
			elseif alignment == "Right" then
				xOff = maxWidth - line.width
			end
			for _, cd in ipairs(line.chars) do
				local shifted = _transformWires(cd.wires, cd.es, cd.xShift + xOff, cd.yShift, threeD and zScale or 1)
				if shifted and next(shifted) ~= nil then
					table.insert(combined, shifted)
					placed += 1
				end
			end
		end

	-- ── Normal single-line path ───────────────────────────────────────────────
	else
		local cursorX = 0
		for i = 1, #text do
			local char = string.sub(text, i, i)
			local isSpace = char:match("%s") ~= nil
			local wires, why = self:GetTextCharWires(char, threeD)
			if wires and next(wires) ~= nil then
				local csm, lift, _ = _charStyle(char)
				local es = scale * csm
				local width, minX, _, minY, maxY = _wireBounds(wires)
				local charHeight = maxY - minY
				if not capHeight and csm >= 0.99 then capHeight = charHeight * scale end
				local refCap = capHeight or (charHeight * scale)
				local xShift = cursorX - (minX * es)
				local yShift = (minY * scale) - (minY * es) + (lift * refCap)
				local shifted = _transformWires(wires, es, xShift, yShift, threeD and zScale or 1)
				if shifted and next(shifted) ~= nil then
					table.insert(combined, shifted)
					placed += 1
				end
				cursorX += (width * es) + padding
			else
				if not firstFail then firstFail = "'" .. tostring(char) .. "': " .. tostring(why or "?") end
				if isSpace then
					cursorX += (1.1 * scale) + padding
				else
					cursorX += (1 * scale) + padding
				end
			end
		end
	end

	if placed == 0 then return nil, firstFail or "no characters resolved" end
	return combined
end

function WireArt:Dump( Preview)
	if self.Settings.Properties.PreviewModel == Preview and self.Settings.Properties.PreviewVectors then
		local Wires = {}
		local pivot = Preview:GetPivot()

		for _, points in ipairs(self.Settings.Properties.PreviewVectors) do
			local Vectors = {}
			for _, point in ipairs(points) do
				table.insert(Vectors, pivot:PointToWorldSpace(point))
			end
			table.insert(Wires, Vectors)
		end

		return Wires
	end

	local Wires = {}
	for i,v in ipairs(Preview:GetChildren()) do
		if v:IsA("Model") and v:FindFirstChild("End1") and v:FindFirstChild("End2") then
			local Vectors = {}
			local Points = {}
			table.insert(Vectors, v.End1.CFrame.p)

			for _, child in ipairs(v:GetChildren()) do
				local index = child.Name:match("^Point(%d+)$")
				if index then
					table.insert(Points, {
						Index = tonumber(index),
						Position = child.CFrame.p
					})
				end
			end

			table.sort(Points, function(a, b)
				return a.Index < b.Index
			end)

			for _, point in ipairs(Points) do
				table.insert(Vectors, point.Position)
			end

			table.insert(Vectors, v.End2.CFrame.p)
			table.insert(Wires, Vectors)
		end
	end
	return Wires
end

function WireArt:IsSentinelPoint( p)
	return p == Vector3.new() or p == Vector3.new(0, 3, 0)
end

function WireArt:CollectSegments( node, outSegments)
	if typeof(node) ~= "table" then
		return
	end

	local current = {}
	local function flushCurrent()
		if #current >= 2 then
			table.insert(outSegments, current)
		end
		current = {}
	end

	for _, item in ipairs(node) do
		local t = typeof(item)
		if t == "Vector3" then
			if self:IsSentinelPoint(item) then
				flushCurrent()
			else
				table.insert(current, item)
			end
		elseif t == "table" then
			flushCurrent()
			self:CollectSegments(item, outSegments)
		else
			flushCurrent()
		end
	end

	flushCurrent()
end

function WireArt:SimplifyPolyline( points)
	if #points <= 2 then
		return points
	end

	local deduped = { points[1] }
	for i = 2, #points do
		if (points[i] - deduped[#deduped]).Magnitude > 1e-4 then
			table.insert(deduped, points[i])
		end
	end

	if #deduped <= 2 then
		return deduped
	end

	local result = { deduped[1] }
	local cosThreshold = math.cos(math.rad(4))

	for i = 2, #deduped - 1 do
		local a = result[#result]
		local b = deduped[i]
		local c = deduped[i + 1]

		local ab = b - a
		local bc = c - b
		local abMag = ab.Magnitude
		local bcMag = bc.Magnitude

		if abMag < 1e-5 or bcMag < 1e-5 then
		else
			local straightness = ab.Unit:Dot(bc.Unit)
			if straightness < cosThreshold then
				table.insert(result, b)
			end
		end
	end

	table.insert(result, deduped[#deduped])
	return result
end

function WireArt:ReversePoints( points)
	local out = table.create(#points)
	for i = #points, 1, -1 do
		table.insert(out, points[i])
	end
	return out
end

function WireArt:PointKey( p, tolerance)
	local decimals = math.max(3, math.min(8, math.floor(-math.log10(math.max(tolerance, 1e-8)))))
	local fmt = "%." .. tostring(decimals) .. "f"
	return string.format(fmt .. "|" .. fmt .. "|" .. fmt, p.X, p.Y, p.Z)
end

function WireArt:BuildChainedSegments( segments, tolerance)
	if #segments <= 1 then
		return segments
	end

	local keyToNode = {}
	local nodePositions = {}
	local adjacency = {}
	local degree = {}
	local edges = {}
	local edgeSeen = {}

	local function getNodeId(p)
		local key = self:PointKey(p, tolerance)
		local id = keyToNode[key]
		if not id then
			id = #nodePositions + 1
			keyToNode[key] = id
			nodePositions[id] = p
			adjacency[id] = {}
			degree[id] = 0
		end
		return id
	end

	local function edgeKey(a, b)
		local minV = math.min(a, b)
		local maxV = math.max(a, b)
		return tostring(minV) .. "|" .. tostring(maxV)
	end

	local function addEdge(a, b)
		if a == b then
			return
		end
		local ek = edgeKey(a, b)
		if edgeSeen[ek] then
			return
		end
		edgeSeen[ek] = true
		table.insert(edges, { a, b })
		adjacency[a][b] = (adjacency[a][b] or 0) + 1
		adjacency[b][a] = (adjacency[b][a] or 0) + 1
		degree[a] += 1
		degree[b] += 1
	end

	for _, seg in ipairs(segments) do
		if #seg >= 2 then
			for i = 1, #seg - 1 do
				local a = getNodeId(seg[i])
				local b = getNodeId(seg[i + 1])
				addEdge(a, b)
			end
		end
	end

	local remaining = {}
	for _, e in ipairs(edges) do
		remaining[edgeKey(e[1], e[2])] = true
	end

	local function consumeEdge(a, b)
		local ek = edgeKey(a, b)
		if not remaining[ek] then
			return false
		end
		remaining[ek] = nil
		return true
	end

	local function hasRemainingFrom(nodeId)
		for neighbor, _ in pairs(adjacency[nodeId]) do
			if remaining[edgeKey(nodeId, neighbor)] then
				return true
			end
		end
		return false
	end

	local function buildTrail(startNode)
		local trail = { startNode }
		local current = startNode
		local prevDir = nil
		while true do
			local nextNode = nil
			local bestScore = -math.huge
			for n, _ in pairs(adjacency[current]) do
				if remaining[edgeKey(current, n)] then
					-- Base score: prefer lower degree (Fleury's rule)
					local score = -degree[n]
					-- Strongly prefer continuing in the same direction so
					-- straight pixel-boundary runs don't zigzag.
					if prevDir then
						local curPos = nodePositions[current]
						local nPos   = nodePositions[n]
						local diff   = nPos - curPos
						local mag    = diff.Magnitude
						if mag > 1e-6 then
							score += prevDir:Dot(diff / mag) * 1000
						end
					end
					if score > bestScore then
						bestScore = score
						nextNode  = n
					end
				end
			end
			if not nextNode then
				break
			end
			if not consumeEdge(current, nextNode) then
				break
			end
			local diff = nodePositions[nextNode] - nodePositions[current]
			local mag  = diff.Magnitude
			if mag > 1e-6 then prevDir = diff / mag end
			table.insert(trail, nextNode)
			current = nextNode
		end
		return trail
	end

	local chained = {}

	for nodeId, d in pairs(degree) do
		if (d % 2 == 1) and hasRemainingFrom(nodeId) then
			local trailNodes = buildTrail(nodeId)
			local pts = {}
			for _, nid in ipairs(trailNodes) do
				table.insert(pts, nodePositions[nid])
			end
			pts = self:SimplifyPolyline(pts)
			if #pts >= 2 then
				table.insert(chained, pts)
			end
		end
	end

	for nodeId, _ in pairs(degree) do
		while hasRemainingFrom(nodeId) do
			local trailNodes = buildTrail(nodeId)
			local pts = {}
			for _, nid in ipairs(trailNodes) do
				table.insert(pts, nodePositions[nid])
			end
			pts = self:SimplifyPolyline(pts)
			if #pts >= 2 then
				table.insert(chained, pts)
			end
		end
	end

	return chained
end

function WireArt:Optimize( Preview, PreviewWires)
	local wireLength = self.Settings.Preview.SelectedWireType == "Wire" and 69.5 or 64.5
	self.Settings.Properties.MaxWireLength = wireLength

	local rootPosition = Preview.PrimaryPart.Position
	local scale = self:GetValidScale()
	local scaledMinDist = self.Settings.Preview.MinNodeDistance / math.max(scale, 1e-6)

	local segments = {}
	local raw = PreviewWires or self.Settings.Properties.Wires
	if typeof(raw) == "table" then
		self:CollectSegments(raw, segments)
	end

	local allSegments = {}

	local minBounds = Vector3.new(math.huge, math.huge, math.huge)
	local maxBounds = Vector3.new(-math.huge, -math.huge, -math.huge)
	local hasPts = false

	for _, pts in ipairs(segments) do
		for _, p in ipairs(pts) do
			minBounds = minBounds:Min(p)
			maxBounds = maxBounds:Max(p)
			hasPts = true
		end
	end

	local center = hasPts and (minBounds + maxBounds) / 2 or Vector3.new()
	local preOptimized = {}

	for _, pts in ipairs(segments) do
		pts = self:SimplifyPolyline(pts)
		pts = self:SpreadNodes(pts, scaledMinDist)
		pts = self:SimplifyPolyline(pts)
		if #pts >= 2 then
			table.insert(preOptimized, pts)
		end
	end

	local boundsSize = (maxBounds - minBounds).Magnitude
	local stitchTolerance = math.max(1e-6, math.min(boundsSize * 0.00002, scaledMinDist * 0.005, 0.0001))
	local chainedSegments = self:BuildChainedSegments(preOptimized, stitchTolerance)
	local optimizedSegments = #chainedSegments <= #preOptimized and chainedSegments or preOptimized

	-- Append fill chains AFTER chaining so they are never decomposed into
	-- edges by BuildChainedSegments (which would corrupt outline routing).
	-- They still go through the wire-length split below.
	local fillChains = self.Settings.Properties.FillChains
	if fillChains then
		for _, fc in ipairs(fillChains) do
			if #fc >= 2 then table.insert(optimizedSegments, fc) end
		end
		self.Settings.Properties.FillChains = nil
	end

	for _, pts in ipairs(optimizedSegments) do
		if #pts < 2 then continue end

		local worldPts = {}
		for _, p in ipairs(pts) do
			local localP = p - center
			local scaledP = localP * scale
			table.insert(worldPts, rootPosition + scaledP)
		end

		local current = { worldPts[1] }
		local currentLength = 0

		for i = 1, #worldPts - 1 do
			local a = worldPts[i]
			local b = worldPts[i + 1]
			local segMag = (b - a).Magnitude

			if segMag > wireLength then
				local splits = math.ceil(segMag / wireLength)
				local from = a

				for splitIndex = 1, splits do
					local target = a:Lerp(b, splitIndex / splits)
					local partMag = (target - from).Magnitude

					if currentLength + partMag > wireLength then
						if #current > 1 then
							table.insert(allSegments, current)
						end
						current = { from }
						currentLength = 0
					end

					table.insert(current, target)
					currentLength += partMag

					if currentLength >= wireLength - 1e-4 then
						if #current > 1 then
							table.insert(allSegments, current)
						end
						current = { target }
						currentLength = 0
					end

					from = target
				end

				if #current == 1 and current[1] == b then
					currentLength = 0
				end
			elseif currentLength + segMag > wireLength then
				if #current > 1 then
					table.insert(allSegments, current)
				end
				current = { a, b }
				currentLength = segMag
			else
				table.insert(current, b)
				currentLength += segMag
			end
		end

		if #current > 1 then
			table.insert(allSegments, current)
		end
	end
	return #allSegments, allSegments
end

--MARK: Wire Art Preview

function WireArt:PreparePreview()
	self.Settings.Preview.Scale = self:GetValidScale()

	local preview = Instance.new("Model")
	preview.Name = "Preview"

	local primaryPart = Instance.new("Part")
	primaryPart.Anchored = true
	primaryPart.Transparency = 1
	primaryPart.CanCollide = false
	primaryPart.Parent = preview
	preview.PrimaryPart = primaryPart

	local _, Vectors = self:Optimize(preview, self.Settings.Properties.Wires)
	self.Settings.Properties.PreviewModel = preview
	self.Settings.Properties.PreviewVectors = Vectors

	local wireInfo = Util.Imports.Paths.ClientItemInfo:FindFirstChild(self.Settings.Preview.SelectedWireType, true)
	local thickness    = wireInfo and wireInfo.OtherInfo.Thickness.Value    or 0.2
	local endThickness = wireInfo and wireInfo.OtherInfo.EndThickness.Value or 0.2

	-- Weld every visual part to primaryPart so the whole preview moves by
	-- setting only PrimaryPart.CFrame — O(1) per frame instead of O(N parts).
	local function weldToPrimary(part)
		part.Anchored = false
		local wc = Instance.new("WeldConstraint")
		wc.Part0  = primaryPart
		wc.Part1  = part
		wc.Parent = part
	end

	-- Cache the local-space bounding box so Placement can do cheap property
	-- checks and bottom-Y calculations without iterating parts each frame.
	local localMin = Vector3.new( math.huge,  math.huge,  math.huge)
	local localMax = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, pts in ipairs(Vectors) do
		for _, p in ipairs(pts) do
			localMin = localMin:Min(p)
			localMax = localMax:Max(p)
		end
	end
	self.Settings.Properties.LocalBoundsMin = localMin
	self.Settings.Properties.LocalBoundsMax = localMax

	for _, points in ipairs(Vectors) do
		local model = Instance.new("Model")
		model.Name = "Wire"

		local firstLine, lastLine
		for i, point in ipairs(points) do
			if i > 1 and i < #points and (i % 4 == 0) then
				local ball = self:DrawBall(point, nil, thickness)
				ball.Name = "Point"..i
				weldToPrimary(ball)
				ball.Parent = model
			end

			if i < #points then
				local line = self:DrawLine(point, points[i + 1], nil, thickness)
				line.Name = "Line"..i
				if i == 1          then firstLine = line end
				if i == #points-1  then lastLine  = line end
				weldToPrimary(line)
				line.Parent = model
			end
		end

		local rotEnd1 = firstLine.CFrame
		rotEnd1 = (rotEnd1 - rotEnd1.p) * CFrame.Angles(0, 0, -math.pi/2)
		local End1 = self:DrawEnd(points[1], rotEnd1, nil, endThickness)
		End1.Name = "End1"
		weldToPrimary(End1)
		End1.Parent = model

		local rotEnd2 = lastLine.CFrame * CFrame.Angles(0, 0, math.pi/2)
		rotEnd2 = rotEnd2 - rotEnd2.p
		local End2 = self:DrawEnd(points[#points], rotEnd2, nil, endThickness)
		End2.Name = "End2"
		weldToPrimary(End2)
		End2.Parent = model

		model.Parent = preview
	end

	preview.Parent = workspace
	Util.Mouse.TargetFilter = preview

	-- Selection box highlights the full preview bounding box so the user can
	-- clearly see the extent of the wire art before placing it.
	local selBox = Instance.new("SelectionBox")
	selBox.Adornee             = preview
	selBox.Color3              = self.Settings.Preview.Colours.Secondary
	selBox.LineThickness       = 0.04
	selBox.SurfaceTransparency = 0.85
	selBox.SurfaceColor3       = self.Settings.Preview.Colours.Secondary
	selBox.Parent              = preview

	return preview
end

--MARK: Main Function

function WireArt:GetSegmentLength( points)
	local length = 0
	for i = 1, #points - 1 do
		length += (points[i] - points[i + 1]).Magnitude
	end
	return length
end

function WireArt:PrepareBuildWires( Wires)
	local maxLen = self.Settings.Properties.MaxWireLength or (self.Settings.Preview.SelectedWireType == "Wire" and 69 or 64)
	local minDist = self.Settings.Preview.MinNodeDistance
	local out = {}

	for _, points in ipairs(Wires) do
		if #points < 2 then
			continue
		end

		local cleaned = { points[1] }
		for i = 2, #points do
			local prev = cleaned[#cleaned]
			local dist = (points[i] - prev).Magnitude

			if dist >= minDist then
				table.insert(cleaned, points[i])
			elseif i == #points and #cleaned > 1 then
				cleaned[#cleaned] = points[i]
			elseif i == #points then
				table.insert(cleaned, points[i])
			elseif i < #points then
				-- Short edge from prev — normally we'd drop this point as
				-- redundant interpolation. But if it's a sharp directional
				-- turn (e.g. the 180° corners of a snake fill), the point
				-- represents structure and must be preserved or the chain
				-- collapses into diagonals that miss the actual rows.
				local nxt = points[i + 1]
				local v1 = points[i] - prev
				local v2 = nxt - points[i]
				local m1 = v1.Magnitude
				local m2 = v2.Magnitude
				if m1 > 1e-6 and m2 > 1e-6 then
					local cosA = v1:Dot(v2) / (m1 * m2)
					if cosA < 0.7 then   -- ≥ ~45° turn → structural corner
						table.insert(cleaned, points[i])
					end
				end
			end
		end

		local current = { cleaned[1] }
		local currentLength = 0

		for i = 1, #cleaned - 1 do
			local a = cleaned[i]
			local b = cleaned[i + 1]
			local edgeLength = (b - a).Magnitude

			if edgeLength > maxLen then
				local splits = math.ceil(edgeLength / maxLen)
				local from = a

				for splitIndex = 1, splits do
					local target = a:Lerp(b, splitIndex / splits)
					local partLength = (target - from).Magnitude

					if currentLength + partLength > maxLen and #current > 1 then
						table.insert(out, current)
						current = { from }
						currentLength = 0
					end

					table.insert(current, target)
					currentLength += partLength

					if currentLength >= maxLen - 1e-4 then
						if #current > 1 then
							table.insert(out, current)
						end
						current = { target }
						currentLength = 0
					end

					from = target
				end
			elseif currentLength + edgeLength > maxLen then
				if #current > 1 then
					table.insert(out, current)
				end
				current = { a, b }
				currentLength = edgeLength
			else
				table.insert(current, b)
				currentLength += edgeLength
			end
		end

		if #current > 1 then
			table.insert(out, current)
		end
	end

	return out
end

function WireArt:Create(Wires)
	Wires = self:PrepareBuildWires(Wires)

	local wirePlayer = Util.Imports.WireArt.Settings.Properties.WireSource or Util.Client
	local Boxed = Util.Imports.WireArt.Settings.BoxedWiresOnly
	local PlayerWireCount = Util.Imports.CoreFramework:CountItemAmount(wirePlayer, Util.Imports.WireArt.Settings.Preview.SelectedWireType, Boxed)
	if PlayerWireCount < #Wires then
		local needed = #Wires - PlayerWireCount
		local endFn = Util.Imports.CoreFramework.Status._endWireArt
		if endFn then
			endFn(true)
		else
			Util.Imports.CoreFramework.Status.WireArtBuilding = false
		end
		return Util.Imports.CoreFramework:Notice("Wire Art aborted: you don't have enough " .. tostring(Boxed and "boxed wires" or "wires") .. " (need " .. tostring(needed) .. " more)")
	end

	local totalWires = #Wires
	local placedWires = 0
	local skippedWires = 0
	local session = {}
	local progressNotice
	local startedAt = os.clock()

	local function formatDuration(seconds)
		seconds = math.max(0, math.floor(seconds + 0.5))
		local minutes = math.floor(seconds / 60)
		local remainder = seconds % 60
		if minutes > 0 then
			return tostring(minutes) .. "m " .. tostring(remainder) .. "s"
		end
		return tostring(remainder) .. "s"
	end

	local function noticeProgress()
		if totalWires <= 0 then
			return
		end

		local remaining = math.max(totalWires - placedWires - skippedWires, 0)
		local completed = placedWires + skippedWires
		local etaText = "calculating"
		if completed > 0 then
			local elapsed = os.clock() - startedAt
			etaText = formatDuration((elapsed / completed) * remaining)
		end
		local message = "Wire Art: placed " .. tostring(placedWires) .. "/" .. tostring(totalWires) .. ", " .. tostring(remaining) .. " left, ETA " .. tostring(etaText)
		if progressNotice and progressNotice:IsActive() then
			progressNotice:Set(message)
		else
			progressNotice = Util.Imports.CoreFramework:Notice(message, false)
		end
		progressNotice:SetProgress(completed / totalWires)
	end

	local function EndWireArt(aborted)
		if not Util.Imports.CoreFramework.Status.WireArtBuilding then return end
		Util.Imports.CoreFramework.Status.WireArtBuilding = false
		Util.Imports.CoreFramework.Status._wireArtSession = nil
		Util.Imports.CoreFramework.Status._endWireArt = nil
		Util.Imports.Maid:deregister("ClientPlacedWire")
		if Util.Imports.Library.Buttons["Build Wire Art"] then
			Util.Imports.Library.Buttons["Build Wire Art"]:Set("Build Wire Art")
		end
		if progressNotice then
			progressNotice:Dismiss()
			progressNotice = nil
		end

		local remaining = math.max(totalWires - placedWires - skippedWires, 0)
		if aborted then
			Util.Imports.CoreFramework:Notice("Wire Art aborted: placed " .. tostring(placedWires) .. "/" .. tostring(totalWires) .. ", " .. tostring(remaining) .. " left", 5)
		elseif skippedWires > 0 then
			Util.Imports.CoreFramework:Notice("Wire Art completed: placed " .. tostring(placedWires) .. "/" .. tostring(totalWires) .. ", skipped " .. tostring(skippedWires), 5)
		else
			Util.Imports.CoreFramework:Notice("Wire Art completed: placed " .. tostring(placedWires) .. "/" .. tostring(totalWires), 5)
		end
	end

	Util.Imports.CoreFramework.Status.WireArtBuilding = true
	Util.Imports.CoreFramework.Status._wireArtSession = session
	Util.Imports.CoreFramework.Status._endWireArt = EndWireArt
	if Util.Imports.Library.Buttons["Build Wire Art"] then
		Util.Imports.Library.Buttons["Build Wire Art"]:Set("Abort")
	end
	noticeProgress()

	Util.Imports.Maid:register("ClientPlacedWire", Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Wire)
		task.spawn(function()
			local WireActivate = Wire:WaitForChild("WireActivate", 5)
			local Owner = Wire:WaitForChild("Owner", 5)
			if Owner and Owner:IsA("ObjectValue") and Owner.Value == Util.Client and WireActivate then
				table.insert(self.Settings.Properties.PlacedWires, Wire)
			end
		end)
	end))

	local maxLen         = self.Settings.Properties.MaxWireLength or 69.5
	local placementDelay = self.Settings.PlacementDelay or .15
	local itemInfo = Util.Imports.Paths.ClientItemInfo:FindFirstChild(
		Util.Imports.WireArt.Settings.Preview.SelectedWireType, true
	)

	for _, Segment in ipairs(Util:Shuffle(Wires)) do
		if not Util.Imports.Maid:verify("ClientPlacedWire") or Util.Imports.CoreFramework.Status._wireArtSession ~= session or not Util.Imports.CoreFramework.Status.WireArtBuilding then
			break
		end

		local segLen = 0
		for i = 1, #Segment - 1 do
			segLen += (Segment[i] - Segment[i + 1]).Magnitude
		end
		if segLen > maxLen + 1e-3 then
			warn("Skipping segment: length " .. tostring(segLen) .. " exceeds max " .. tostring(maxLen))
			skippedWires += 1
			noticeProgress()
			continue
		end

		local Wire = Util.Imports.CoreFramework:GetPlayerObject(wirePlayer, Util.Imports.WireArt.Settings.Preview.SelectedWireType, Util.Imports.WireArt.Settings.BoxedWiresOnly)
		if not Wire then
			for i = 1, 100 do
				if Wire or not Util.Imports.CoreFramework.Status.WireArtBuilding or Util.Imports.CoreFramework.Status._wireArtSession ~= session then
					break
				end
				Wire = Util.Imports.CoreFramework:GetPlayerObject(Util.Client, Util.Imports.WireArt.Settings.Preview.SelectedWireType, Util.Imports.WireArt.Settings.BoxedWiresOnly)
				task.wait(.1)
			end
		end

		if not Wire then
			EndWireArt(true)
			return Util.Imports.CoreFramework:Notice("Wire Art aborted: no wire object available. Placed " .. tostring(placedWires) .. "/" .. tostring(totalWires) .. ".", 4)
		end

		repeat
			if not Util.Imports.CoreFramework.Status.WireArtBuilding or Util.Imports.CoreFramework.Status._wireArtSession ~= session then
				break
			end
			Util:FireServer("ClientPlacedWire", itemInfo, Segment, Util.Client, Wire, true)
			task.wait(placementDelay)
		until Wire.Parent == nil

		if not Util.Imports.CoreFramework.Status.WireArtBuilding or Util.Imports.CoreFramework.Status._wireArtSession ~= session then
			break
		end

		if Wire.Parent == nil then
			placedWires += 1
			noticeProgress()
		end
	end

	EndWireArt(placedWires + skippedWires < totalWires)
	self.Settings.Properties.PlacedWires = {}
	return
end

return WireArt

end)()

