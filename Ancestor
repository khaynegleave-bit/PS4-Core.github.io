    local modelData = {}

    local function resolveClass(raw)
        if TreeProperties[raw] then return raw end
        local a = ALIASES[raw]
        return (a and TreeProperties[a]) and a or nil
    end

    local function fmt(n)
        n = math.ceil(n)
        if n >= 1000000 then return string.format("$%.2fM", n / 1000000)
        elseif n >= 1000   then return string.format("$%.1fK", n / 1000)
        else                    return string.format("$%d", n) end
    end

    local function calcVolume(model)
        local vol = 0
        for _, p in ipairs(model:GetDescendants()) do
            if p.Name == "WoodSection" and p:IsA("BasePart") then
                vol += p.Size.X * p.Size.Y * p.Size.Z
            end
        end
        return vol
    end

    local function calcValues(model)
        local cv = model:FindFirstChild("TreeClass")
        if not cv then return nil, nil end
        local class = resolveClass(cv.Value)
        local props = class and TreeProperties[class]
        if not props then return nil, nil end
        local vol = calcVolume(model)
        return math.ceil(vol * props.LogValue), math.ceil(vol * props.PlankValue)
    end

    local function measureText(text, textSize)
        local b = TextService:GetTextSize(text, textSize, FONT, Vector2.new(math.huge, math.huge))
        return math.ceil(b.X), math.ceil(b.Y)
    end

    local function rowHeight() return math.max(TEXT_SIZE_ROW + 4, ICON_SIZE) end

    local function measureRow(rowName, text)
        local textW = measureText(text, TEXT_SIZE_ROW)
        local iconW = (ICONS[rowName] and ICONS[rowName] ~= "" and (ICON_SIZE + ICON_GAP) or 0)
        return iconW + textW, iconW, textW
    end

    local function measureBillboard(nameText, logText, plankText)
        local nameW, nameH = measureText(nameText, TEXT_SIZE_NAME)
        local logRowW   = measureRow("Log",   logText)
        local plankRowW = measureRow("Plank", plankText)
        local contentW = math.max(nameW, logRowW, plankRowW)
        local rowH    = rowHeight()
        local totalH  = PAD_Y * 2 + nameH + DIVIDER_HEIGHT + (rowH * 2) + (INNER_GAP * 3)
        return contentW + PAD_X * 2, totalH, rowH, nameH, logRowW, plankRowW
    end

    local function destroyBillboard(model)
        local d = modelData[model]
        if not d then return end
        for _, c in ipairs(d.connections) do
            if c.Connected then c:Disconnect() end
        end
        if d.billboard  and d.billboard.Parent  then d.billboard:Destroy()  end
        if d.attachment and d.attachment.Parent then d.attachment:Destroy() end
        modelData[model] = nil
    end

    local function getRelevantAnchorParts(model)
        local woodParts = {}
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "WoodSection" then
                table.insert(woodParts, obj)
            end
        end
        if #woodParts > 0 then return woodParts end
        if model.PrimaryPart then return { model.PrimaryPart } end
        local allParts = {}
        for _, obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BasePart") then table.insert(allParts, obj) end
        end
        return allParts
    end

    local function getWeightedCenter(parts)
        local totalWeight, weightedSum = 0, Vector3.zero
        for _, part in ipairs(parts) do
            local w = part.Size.X * part.Size.Y * part.Size.Z
            totalWeight += w
            weightedSum += part.Position * w
        end
        if totalWeight <= 0 then return nil end
        return weightedSum / totalWeight
    end

    local function getCenterAttachment(model)
        local parts = getRelevantAnchorParts(model)
        if #parts == 0 then return nil, nil end
        local center = getWeightedCenter(parts)
        if not center then return nil, nil end
        local anchor = parts[1]
        local bestD = (anchor.Position - center).Magnitude
        for _, part in ipairs(parts) do
            local d = (part.Position - center).Magnitude
            if d < bestD then bestD = d; anchor = part end
        end
        local att = Instance.new("Attachment")
        att.Name     = TREE_VALUE_TAG .. "_Anchor"
        att.Position = anchor.CFrame:PointToObjectSpace(center)
        att.Parent   = anchor
        return att, anchor
    end

    local function updateModelCenterAttachment(d)
        local parts = getRelevantAnchorParts(d.model)
        if #parts == 0 then return end
        local center = getWeightedCenter(parts)
        if not center then return end
        local anchor = parts[1]
        local bestD = (anchor.Position - center).Magnitude
        for _, part in ipairs(parts) do
            local dist = (part.Position - center).Magnitude
            if dist < bestD then bestD = dist; anchor = part end
        end
        if not d.attachment or not d.attachment.Parent or d.attachment.Parent ~= anchor then
            if d.attachment then d.attachment:Destroy() end
            d.attachment = Instance.new("Attachment")
            d.attachment.Name   = TREE_VALUE_TAG .. "_Anchor"
            d.attachment.Parent = anchor
        end
        d.anchorPart = anchor
        d.attachment.Position = anchor.CFrame:PointToObjectSpace(center)
    end

    local function applyBillboardSize(d)
        local width, height, rowH, nameH, logRowW, plankRowW = measureBillboard(d.nameText, d.logText, d.plankText)
        d.billboard.Size  = UDim2.fromOffset(width, height)
        d.card.Size       = UDim2.fromOffset(width, height)
        d.nameLabel.Size  = UDim2.new(1, 0, 0, nameH)
        d.divider.Size    = UDim2.new(1, 0, 0, DIVIDER_HEIGHT)
        d.logRow.Size     = UDim2.fromOffset(logRowW, rowH)
        d.plankRow.Size   = UDim2.fromOffset(plankRowW, rowH)
        if d.logIcon   then d.logIcon.Position   = UDim2.fromOffset(0, math.floor((rowH - ICON_SIZE) / 2)) end
        if d.plankIcon then d.plankIcon.Position = UDim2.fromOffset(0, math.floor((rowH - ICON_SIZE) / 2)) end
        if d.logPrice then
            d.logPrice.Size     = UDim2.fromOffset(measureText(d.logText, TEXT_SIZE_ROW), rowH)
            d.logPrice.Position = UDim2.fromOffset(d.logPriceOffset or 0, 0)
        end
        if d.plankPrice then
            d.plankPrice.Size     = UDim2.fromOffset(measureText(d.plankText, TEXT_SIZE_ROW), rowH)
            d.plankPrice.Position = UDim2.fromOffset(d.plankPriceOffset or 0, 0)
        end
        d.rowHeight  = rowH
        d.nameHeight = nameH
    end

    local function refreshBillboard(model)
        local d = modelData[model]; if not d then return end
        local lv, pv = calcValues(model)
        d.logText   = lv and fmt(lv) or "?"
        d.plankText = pv and fmt(pv) or "?"
        updateModelCenterAttachment(d)
        d.logPrice.Text   = d.logText
        d.plankPrice.Text = d.plankText
        applyBillboardSize(d)
    end

    local function makeRow(parent, order, keyText, valText, d)
        local row = Instance.new("Frame")
        row.Name = keyText .. "Row"
        row.BackgroundTransparency = 1
        row.BorderSizePixel        = 0
        row.LayoutOrder            = order
        local rowW = measureRow(keyText, valText)
        row.Size = UDim2.fromOffset(rowW, d.rowHeight)
        row.Parent = parent

        local iconId = ICONS[keyText]
        local iconOffset = iconId and iconId ~= "" and (ICON_SIZE + ICON_GAP) or 0
        local icon
        if iconId and iconId ~= "" then
            icon = Instance.new("ImageLabel")
            icon.Name        = keyText .. "Icon"
            icon.BackgroundTransparency = 1
            icon.BorderSizePixel        = 0
            icon.Size        = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
            icon.Position    = UDim2.fromOffset(0, math.floor((d.rowHeight - ICON_SIZE) / 2))
            icon.Image       = iconId
            icon.ImageColor3 = WHITE
            icon.ScaleType   = Enum.ScaleType.Fit
            icon.Parent      = row
        end

        local price = Instance.new("TextLabel")
        price.BackgroundTransparency = 1
        price.BorderSizePixel        = 0
        price.Position       = UDim2.fromOffset(iconOffset, 0)
        price.Size           = UDim2.fromOffset(measureText(valText, TEXT_SIZE_ROW), d.rowHeight)
        price.Text           = valText
        price.TextColor3     = PRICE_GREEN
        price.TextSize       = TEXT_SIZE_ROW
        price.Font           = FONT
        price.TextXAlignment = Enum.TextXAlignment.Left
        price.Parent         = row

        return row, icon, price, iconOffset
    end

    local function buildBillboard(model)
        if modelData[model] then return end
        local cv = model:FindFirstChild("TreeClass"); if not cv then return end

        local lv, pv = calcValues(model)
        local nameText  = tostring(cv.Value)
        local logText   = lv and fmt(lv) or "?"
        local plankText = pv and fmt(pv) or "?"

        local width, height, rowH, nameH = measureBillboard(nameText, logText, plankText)
        local attachment, anchorPart = getCenterAttachment(model)
        if not attachment or not anchorPart then return end

        local bb = Instance.new("BillboardGui")
        bb.Name              = TREE_VALUE_TAG
        bb.Size              = UDim2.fromOffset(width, height)
        bb.StudsOffset       = Vector3.new(0, -model:GetExtentsSize().Y / 4, 0)
        bb.AlwaysOnTop       = true
        bb.MaxDistance       = BILLBOARD_MAX_DISTANCE
        bb.ClipsDescendants  = false
        bb.Adornee           = attachment
        bb.Parent            = attachment

        local card = Instance.new("Frame")
        card.Name = "Card"
        card.BackgroundColor3      = Color3.fromRGB(20, 20, 20)
        card.BackgroundTransparency = 0
        card.BorderSizePixel       = 0
        card.Size                  = UDim2.fromOffset(width, height)
        card.Parent                = bb
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 8)

        local pad = Instance.new("UIPadding")
        pad.PaddingTop    = UDim.new(0, PAD_Y)
        pad.PaddingBottom = UDim.new(0, PAD_Y)
        pad.PaddingLeft   = UDim.new(0, PAD_X)
        pad.PaddingRight  = UDim.new(0, PAD_X)
        pad.Parent = card

        local layout = Instance.new("UIListLayout")
        layout.SortOrder           = Enum.SortOrder.LayoutOrder
        layout.FillDirection       = Enum.FillDirection.Vertical
        layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
        layout.VerticalAlignment   = Enum.VerticalAlignment.Center
        layout.Padding             = UDim.new(0, INNER_GAP)
        layout.Parent              = card

        local state = {
            billboard = bb, attachment = attachment, anchorPart = anchorPart, card = card,
            model = model, nameText = nameText, logText = logText, plankText = plankText,
            rowHeight = rowH, nameHeight = nameH, connections = {},
        }

        local nameLabel = Instance.new("TextLabel")
        nameLabel.Name                  = "Name"
        nameLabel.BackgroundTransparency = 1
        nameLabel.BorderSizePixel       = 0
        nameLabel.LayoutOrder           = 0
        nameLabel.Size                  = UDim2.new(1, 0, 0, nameH)
        nameLabel.Text                  = nameText
        nameLabel.TextColor3            = WHITE
        nameLabel.TextSize              = TEXT_SIZE_NAME
        nameLabel.Font                  = FONT
        nameLabel.TextXAlignment        = Enum.TextXAlignment.Left
        nameLabel.Parent                = card
        state.nameLabel = nameLabel

        local div = Instance.new("Frame")
        div.Name                = "Divider"
        div.LayoutOrder         = 1
        div.Size                = UDim2.new(1, 0, 0, DIVIDER_HEIGHT)
        div.BackgroundColor3    = WHITE
        div.BackgroundTransparency = 0.25
        div.BorderSizePixel     = 0
        div.Parent              = card
        state.divider = div

        state.logRow,   state.logIcon,   state.logPrice,   state.logPriceOffset   = makeRow(card, 2, "Log",   logText,   state)
        state.plankRow, state.plankIcon, state.plankPrice, state.plankPriceOffset = makeRow(card, 3, "Plank", plankText, state)

        table.insert(state.connections, model.DescendantRemoving:Connect(function(desc)
            if desc.Name == "WoodSection" and desc:IsA("BasePart") then
                task.defer(function()
                    if not model.Parent then destroyBillboard(model)
                    else refreshBillboard(model) end
                end)
            end
        end))
        table.insert(state.connections, model.AncestryChanged:Connect(function()
            if not model.Parent then destroyBillboard(model) end
        end))

        modelData[model] = state
    end

    -- Initial sweep
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("TreeClass") then
            if obj.Parent and obj.Parent:IsA("Model") and obj.Parent.Name == "TreeRegion" then
                buildBillboard(obj)
            elseif workspace:FindFirstChild("LogModels") and obj.Parent == workspace.LogModels then
                buildBillboard(obj)
            end
        end
    end

    -- Watch for new trees/logs spawning
    table.insert(connections, workspace.DescendantAdded:Connect(function(obj)
        if not _treeValueState.running then return end
        if not obj:IsA("Model") then return end
        task.delay(0.15, function()
            if not _treeValueState.running then return end
            if not obj.Parent or not obj:FindFirstChild("TreeClass") then return end
            if (obj.Parent:IsA("Model") and obj.Parent.Name == "TreeRegion")
               or (workspace:FindFirstChild("LogModels") and obj.Parent == workspace.LogModels) then
                buildBillboard(obj)
            end
        end)
    end))

    local logModels = workspace:FindFirstChild("LogModels")
    if logModels then
        table.insert(connections, logModels.ChildAdded:Connect(function(obj)
            if not _treeValueState.running then return end
            task.delay(0.15, function()
                if not _treeValueState.running then return end
                if obj:IsA("Model") and obj:FindFirstChild("TreeClass") then
                    buildBillboard(obj)
                end
            end)
        end))
    end

    _treeValueState.cleanup = function()
        for _, c in ipairs(connections) do
            if c.Connected then pcall(function() c:Disconnect() end) end
        end
        for model, _ in pairs(modelData) do destroyBillboard(model) end
    end
end

