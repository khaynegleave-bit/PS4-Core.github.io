	local function NormalizeSearchText(Value)
		return tostring(Value or ""):lower():gsub("^%s+", ""):gsub("%s+$", "")
	end

	local function MatchesSearch(Value, Query)
		return NormalizeSearchText(Value):find(Query, 1, true) ~= nil
	end

	local ActiveTabName
	local TabCount = 0

	local function RefreshSearch()
		local Query = NormalizeSearchText(TextBox.Text)
		local FirstMatchTab
		local AllSections = {}

		for TabName, Tab in Library.Tabs do
			local Container = Tab.Container
			local TabMatches = Query ~= "" and MatchesSearch(TabName, Query)
			local TabHasMatch = false

			if Container then
				for _, Section in Container:GetChildren() do
					if Section:IsA("GuiObject") and Section.Name == "Section" then
						table.insert(AllSections, Section)
						local SectionMatches = Query == "" or TabMatches or MatchesSearch(Section:GetAttribute("SearchText"), Query)
						local HasMatch = SectionMatches

						for _, Child in Section:GetChildren() do
							if Child:IsA("GuiObject") and Child.Name ~= "Title" then
								local SearchText = Child:GetAttribute("SearchText")
								if SearchText then
									local isSelfManaged = Child:GetAttribute("SelfManaged")
									local Visible = Query == "" or SectionMatches or MatchesSearch(SearchText, Query)

									-- SH for SelfManaged is kept up-to-date by SetVisible.
									-- For normal elements, save once on first encounter.
									if not isSelfManaged and not Child:GetAttribute("SH") then
										Child:SetAttribute("SH", Child.Size.Y.Offset)
									end

									if Query == "" then
										-- Clearing search: restore each child to its natural state
										if isSelfManaged then
											-- ColorPicker: restore to user's open/closed preference
											local isOpen = Child:GetAttribute("PickerOpen") == true
											Child.Visible = isOpen
											Child.Size = UDim2.new(1, 0, 0, Child:GetAttribute("SH") or 0)
										else
											Child.Visible = true
											Child.Size = UDim2.new(1, 0, 0, Child:GetAttribute("SH") or Child.Size.Y.Offset)
										end
									else
										-- Searching: show/hide and collapse size to trigger AutomaticSize
										if isSelfManaged then
											-- ColorPicker: if visible, restore to its natural open/closed size
											if Visible then
												local isOpen = Child:GetAttribute("PickerOpen") == true
												Child.Visible = isOpen
												Child.Size = UDim2.new(1, 0, 0, Child:GetAttribute("SH") or 0)
											else
												Child.Visible = false
												Child.Size = UDim2.new(1, 0, 0, 0)
											end
										else
											Child.Visible = Visible
											Child.Size = UDim2.new(1, 0, 0, Visible and (Child:GetAttribute("SH") or Child.Size.Y.Offset) or 0)
										end
									end

									HasMatch = HasMatch or Visible
								end
							end
						end

						local Title = Section:FindFirstChild("Title")
						if Title and Title:IsA("GuiObject") then
							Title.Visible = HasMatch
						end

						Section.Visible = HasMatch

						if Query == "" then
							-- Restore native automatic sizing when not searching
							Section.AutomaticSize = Enum.AutomaticSize.Y
						end

						TabHasMatch = TabHasMatch or HasMatch
					end
				end
			end

			local TabButton = Tab.Button
			if Query == "" then
				if TabButton and TabButton:IsA("GuiObject") and TabButton.Parent then
					TabButton.Visible = true
				end
				if Container then
					Container.Visible = TabName == ActiveTabName
				end
			else
				if TabButton and TabButton:IsA("GuiObject") and TabButton.Parent then
					TabButton.Visible = TabHasMatch
				end
				if Container then
					Container.Visible = false
				end
				if TabHasMatch and not FirstMatchTab then
					FirstMatchTab = Tab
				end
			end
		end

		NoResults.Visible = Query ~= "" and not FirstMatchTab

		if Query ~= "" and FirstMatchTab and FirstMatchTab.Container then
			FirstMatchTab.Container.Visible = true
			FirstMatchTab.Container.CanvasPosition = Vector2.new(0, 0)
		elseif Query ~= "" and not FirstMatchTab then
			for TabName, Tab in Library.Tabs do
				if Tab.Button and Tab.Button:IsA("GuiObject") then
					Tab.Button.Visible = true
				end
				if Tab.Container then
					Tab.Container.Visible = false
				end
			end
		end
	end

