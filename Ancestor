			end

			local ScrollTween
			local function EnsureControlVisible(Control, Margin, SkipRetry)
				if not Control or not Control.Parent or not Holder then
					return
				end

				Margin = Margin or 8
				local Epsilon = 2
				local ScaleObj = Holder:FindFirstAncestorOfClass("ScreenGui") and Holder:FindFirstAncestorOfClass("ScreenGui"):FindFirstChildOfClass("UIScale")
				local Scale = ScaleObj and ScaleObj.Scale or 1
				if Scale <= 0 then Scale = 1 end

				local CanvasY = Holder.CanvasPosition.Y
				local ViewTop = CanvasY
				local ViewBottom = CanvasY + (Holder.AbsoluteSize.Y / Scale)

				local ControlTop = math.floor(((Control.AbsolutePosition.Y - Holder.AbsolutePosition.Y) / Scale) + CanvasY)
				local ControlBottom = math.ceil(ControlTop + (Control.AbsoluteSize.Y / Scale))

				local TargetY = CanvasY
				if ControlTop < ViewTop then
					TargetY = ControlTop - Margin - Epsilon
				elseif ControlBottom > ViewBottom then
					TargetY = ControlBottom - (Holder.AbsoluteSize.Y / Scale) + Margin + Epsilon
				else
					return
				end

				local MaxY = math.max(0, Holder.AbsoluteCanvasSize.Y - (Holder.AbsoluteSize.Y / Scale))
				TargetY = math.clamp(math.ceil(TargetY), 0, MaxY)

				if ScrollTween then
					ScrollTween:Cancel()
				end

				ScrollTween = TweenService:Create(Holder, TweenInfo.new(.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					CanvasPosition = Vector2.new(Holder.CanvasPosition.X, TargetY)
				})
				ScrollTween:Play()

				if not SkipRetry then
					task.delay(0.2, function()
						EnsureControlVisible(Control, Margin, true)
					end)
				end
			end

