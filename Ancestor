function Library:ColorToTable(Color)
	return { math.floor(Color.R * 255), math.floor(Color.G * 255), math.floor(Color.B * 255) }
end

function Library:TableToColor(Value)
	if typeof(Value) == "Color3" then
		return Value
	end
	return Color3.fromRGB(tonumber(Value[1]) or 255, tonumber(Value[2]) or 255, tonumber(Value[3]) or 255)
end

function Library:SerializeTheme(Theme)
	local Serialized = {}
	for Key, Value in Theme do
		Serialized[Key] = self:ColorToTable(Value)
	end
	return Serialized
end

function Library:DeserializeTheme(Theme)
	local Deserialized = {}
	for Key, Value in Theme do
		Deserialized[Key] = self:TableToColor(Value)
	end

	-- Fallback for older themes missing split component keys
	-- Fallback for granular themes migrating back to element
	if Deserialized.Button and not Deserialized.Element then
		Deserialized.Element = Deserialized.Button
	end
	if Deserialized.ToggleDark and not Deserialized.ElementDark then
		Deserialized.ElementDark = Deserialized.ToggleDark
	end

	-- Failsafe: Any entirely missing keys inherit from the Default preset theme
	-- This prevents crashes if a theme was corrupted or saved improperly.
	local DefaultTheme = self.Themes["Default"]
	if DefaultTheme then
		for Key, DefaultColor in DefaultTheme do
			if Deserialized[Key] == nil then
				Deserialized[Key] = DefaultColor
			end
		end
	end

	return Deserialized
end

function Library:SaveThemes()
	if not writefile then
		return
	end
	if makefolder then
		if type(isfolder) == "function" then
			if not isfolder("Ancestor") then
				makefolder("Ancestor")
			end
		else
			pcall(makefolder, "Ancestor")
		end
	end

	local CustomThemes = {}
	local PresetMap = {}
	for _, name in self.Presets do PresetMap[name] = true end
	for name, theme in self.Themes do
		if not PresetMap[name] then
			CustomThemes[name] = self:SerializeTheme(theme)
		end
	end

	local Data = {
		ActiveTheme = self.ActiveTheme,
		Themes = CustomThemes
	}

	local function FormatJSON(Data)
		local res = "{\n"
		res = res .. "  \"ActiveTheme\": \"" .. tostring(Data.ActiveTheme) .. "\",\n"
		res = res .. "  \"Themes\": {\n"

		local ThemeNames = {}
		for Name in Data.Themes do table.insert(ThemeNames, Name) end
		table.sort(ThemeNames)

		for i, Name in ipairs(ThemeNames) do
			local Theme = Data.Themes[Name]
			res = res .. "    \"" .. Name .. "\": {\n"
			local Keys = {"Side", "Strip", "Element", "ElementDark", "Main", "Section", "MutedText", "Text", "Accent"}
			for j, Key in ipairs(Keys) do
				local Val = Theme[Key]
				if Val then
					res = res .. "      \"" .. Key .. "\": [" .. table.concat(Val, ", ") .. "]"
					if j < #Keys then res = res .. "," end
					res = res .. "\n"
				end
			end
			res = res .. "    }"
			if i < #ThemeNames then res = res .. "," end
			res = res .. "\n"
		end
		res = res .. "  }\n"
		res = res .. "}"
		return res
	end

	writefile(self.ThemeFile, FormatJSON(Data))
end

function Library:LoadThemes()
	if not readfile or not isfile or not isfile(self.ThemeFile) then
		return
	end
	local Success, Data = pcall(function()
		return HttpService:JSONDecode(readfile(self.ThemeFile))
	end)
	if not Success or typeof(Data) ~= "table" or typeof(Data.Themes) ~= "table" then
		return
	end
	for Name, Theme in Data.Themes do
		self.Themes[Name] = self:DeserializeTheme(Theme)
	end
	if Data.ActiveTheme and self.Themes[Data.ActiveTheme] then
		self.ActiveTheme = Data.ActiveTheme
	end
end

function Library:GetThemeNames()
	local Names = {}
	for Name in self.Themes do
		table.insert(Names, Name)
	end
	return Names
end

function Library:ExportTheme(Name)
	local ThemeName = Name or self.ActiveTheme
	local Theme = self.Themes[ThemeName]
	if not Theme then
		return ""
	end
	return HttpService:JSONEncode({
		Name = ThemeName,
		Theme = self:SerializeTheme(Theme),
	})
end

function Library:ImportTheme(Text)
	local Success, Data = pcall(function()
		return HttpService:JSONDecode(Text)
	end)
	if not Success or typeof(Data) ~= "table" or typeof(Data.Theme) ~= "table" then
		return false
	end
	local Name = tostring(Data.Name or "Imported Theme")
	self.Themes[Name] = self:DeserializeTheme(Data.Theme)
	self:ApplyTheme(Name)
	self:SaveThemes()
	return true, Name
end

function Library:RenameTheme(NewName)
	NewName = tostring(NewName or ""):gsub("^%s+", ""):gsub("%s+$", "")
	local CurrentName = self.ActiveTheme
	local PresetMap = {}
	for _, name in self.Presets do PresetMap[name] = true end

	if NewName == "" or PresetMap[CurrentName] or self.Themes[NewName] then
		return false
	end

	self.Themes[NewName] = self.Themes[CurrentName]
	self.Themes[CurrentName] = nil
	self.ActiveTheme = NewName
	self:SaveThemes()
	return true
end

function Library:GetTheme()
	return self.Themes[self.ActiveTheme] or self.Themes.Default
end

function Library:RegisterThemeObject(Object, Property, ThemeKey)
	local Theme = self:GetTheme()
	if Theme and Theme[ThemeKey] then
		Object[Property] = Theme[ThemeKey]
	end
	table.insert(self.ThemeObjects, {
		Object   = Object,
		Property = Property,
		ThemeKey = ThemeKey,
	})
end

function Library:ApplyTheme(Name, Save)
	if Name and self.Themes[Name] then
		self.ActiveTheme = Name
	end
	local Theme = self:GetTheme()
	local alive = {}
	for _, Info in self.ThemeObjects do
		if not (Info.Object and Info.Object.Parent) then continue end
		table.insert(alive, Info)
		if Theme[Info.ThemeKey] then
			TweenService:Create(Info.Object, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				[Info.Property] = Theme[Info.ThemeKey]
			}):Play()
		end
	end
	self.ThemeObjects = alive
	if self.Tabs then
		for TabName, Tab in self.Tabs do
			if Tab.Container and Tab.Icon and Tab.Title then
				local IsActive = (Tab.Container.Visible)
				TweenService:Create(Tab.Icon, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					ImageColor3 = IsActive and Theme.Accent or Theme.Text
				}):Play()
				TweenService:Create(Tab.Title, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TextColor3 = IsActive and Theme.Accent or Theme.Text
				}):Play()
			end
		end
	end
	if self.Dropdowns then
		for _, Dropdown in self.Dropdowns do
			if Dropdown.Selection then
				for _, info in Dropdown.Selection do
					if info.Button and info.Button.Parent then
						info.Button.TextColor3 = Theme.Accent
					end
				end
			end
		end
	end
	if self.Toggles then
		for _, Toggle in self.Toggles do
			if Toggle.Inner and Toggle.Inner.Parent then
				local InnerColor = Toggle:GetState() and Theme.Accent or Theme.ElementDark
				local Luminance = (0.299 * InnerColor.R) + (0.587 * InnerColor.G) + (0.114 * InnerColor.B)
				local CircleColor = Luminance > 0.6 and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)

				TweenService:Create(Toggle.Inner, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageColor3 = InnerColor }):Play()
				if Toggle.Circle then
					TweenService:Create(Toggle.Circle, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageColor3 = CircleColor }):Play()
				end
			end
		end
	end
	if self.ColourPickers then
		for _, Picker in self.ColourPickers do
			if Picker.RainbowToggle and Picker.RainbowToggle.Parent then
				local InnerColor = Picker.Properties.Rainbow and Theme.Accent or Theme.ElementDark
				local Luminance = (0.299 * InnerColor.R) + (0.587 * InnerColor.G) + (0.114 * InnerColor.B)
				local CircleColor = Luminance > 0.6 and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)

				TweenService:Create(Picker.RainbowToggle, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageColor3 = InnerColor }):Play()
				if Picker.RainbowCircle then
					TweenService:Create(Picker.RainbowCircle, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageColor3 = CircleColor }):Play()
				end
			end
		end
	end
	if self.Sliders then
		local AccentLuminance = (0.299 * Theme.Accent.R) + (0.587 * Theme.Accent.G) + (0.114 * Theme.Accent.B)
		local BallColor = AccentLuminance > 0.6 and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)
		for _, Slider in self.Sliders do
			if Slider.Ball and Slider.Ball.Parent then
				TweenService:Create(Slider.Ball, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageColor3 = BallColor }):Play()
			end
		end
	end
	if Save ~= false then
		self:SaveThemes()
	end
end

function Library:CreateSettingsTab()
	self.IsCreatingSettings = true
	local SettingsTab = self:CreateTab("rbxthumb://type=Asset&id=83286411045443&w=150&h=150", "Settings")
	SettingsTab.Button.LayoutOrder = 999

	local function _SaveSettings()
		if writefile then
			pcall(writefile, "Ancestor/Games/" .. tostring(Util.GameId) .. "/ClientSettings.json", Util.Services.HttpService:JSONEncode(Util.Imports.Settings))
		end
	end

	-- Keybind refresh registry entry is a function that re-reads its
	-- setting and pushes the value to the keybind chip.
	local _kbRefreshers = {}
	local function _trackKeybind(kb, getter)
		table.insert(_kbRefreshers, function()
			if kb and kb.Set then pcall(kb.Set, kb, getter()) end
		end)
	end

	function self:RefreshSettingsTab()
		for _, fn in ipairs(_kbRefreshers) do fn() end
	end

	-- MARK: General Section
	local GeneralSection = SettingsTab:CreateSection("General")
	GeneralSection:CreateToggle("Lock UI During Tasks", function(value)
		Util.Imports.Settings.UI.LockDuringTasks = value
		_SaveSettings()
	end, Util.Imports.Settings.UI.LockDuringTasks)

	GeneralSection:CreateToggle("RGB Tycoon", function(value)
		Util.Imports.CoreFramework.Status.Autofarm.RGBTycoon = value
		Util.Imports.CoreFramework:RGBTycoon()
	end, false)

	do
		local _useOtherAxes = GeneralSection:CreateToggle(
			"Use Other People's Axes where Possible",
			function(value)
				if Util.Imports.Settings.BringTree then
					Util.Imports.Settings.BringTree.UseOtherPlayersAxes = value
				end
				_SaveSettings()
			end,
			Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes or false
		)
		-- Show the toggle only when the local player has no Backpack (i.e. the
		-- game has removed it, meaning they can't equip their own axes and may
		-- want to fall back to someone else's).
		task.spawn(function()
			while not (_useOtherAxes and _useOtherAxes.Instance) do task.wait(0.1) end
			local row = _useOtherAxes.Instance
			local function refresh()
				row.Visible = getgenv().AncestorInitLoaded
			end
			Util.Client.ChildAdded:Connect(function(c)
				if c.Name == "Backpack" then refresh() end
			end)
			Util.Client.ChildRemoved:Connect(function(c)
				if c.Name == "Backpack" then refresh() end
			end)
			refresh()
		end)
	end
	GeneralSection:CreateButton("Delete Settings", function()
		local defaults = Util.Imports.DefaultSettings
		if not defaults then
			Util.Imports.CoreFramework:Notice("Default settings not available.", 4)
			return
		end
		-- Reapply defaults into the live settings table (handles Color3 deserialisation).
		Util.Imports.ConfigController:ApplyPayload(Util.Imports.Settings, defaults)
		_SaveSettings()
		-- Refresh all feature UI elements.
		if Util.Imports.Features and Util.Imports.Features.RefreshUI then
			Util.Imports.Features:RefreshUI()
		end
		self:RefreshSettingsTab()
		Util.Imports.CoreFramework:Notice("Settings reset to defaults.", 4)
	end)

	-- MARK: Keybinds Section
	local KeybindsSection = SettingsTab:CreateSection("Keybinds")
	do
		local function kb(name, getter, setter)
			local inst = KeybindsSection:CreateKeybind(name, Enum.KeyCode[getter()], function(key)
				setter(key)
				_SaveSettings()
			end)
			_trackKeybind(inst, getter)
		end
		local UI = Util.Imports.Settings.UI
		local C  = Util.Imports.Settings.Character
		kb("Toggle UI", function() return UI.ToggleUI  end, function(k) UI.ToggleUI  = k end)
		if C then
			kb("Sprint",   function() return C.SprintKey  end, function(k) C.SprintKey  = k end)
			kb("Fly",      function() return C.FlyKey     end, function(k) C.FlyKey     = k end)
			kb("Fly Up",   function() return C.FlyUpKey   end, function(k) C.FlyUpKey   = k end)
			kb("Fly Down", function() return C.FlyDownKey end, function(k) C.FlyDownKey = k end)
			kb("Noclip",   function() return C.NoclipKey  end, function(k) C.NoclipKey  = k end)
		end
		local P = Util.Imports.Settings.Player
		if P and P.HardDraggerKey then
			kb("Hard Dragger", function() return P.HardDraggerKey end, function(k) P.HardDraggerKey = k end)
		end
		if P and P.FreeCameraKey then
			kb("Free Camera", function() return P.FreeCameraKey end, function(k) P.FreeCameraKey = k end)
		end
	end

	local PresetsSection = SettingsTab:CreateSection("Preset Themes")
	local CustomSection = SettingsTab:CreateSection("Custom Theme Creation")

	local ThemeKeys = { "Main", "Side", "Strip", "Section", "Element", "ElementDark", "Accent", "Text", "MutedText" }
	local ThemePickers = {}
	local RenameTextbox

	local function GetCustomThemes()
		local Custom = {}
		local PresetMap = {}
		for _, name in self.Presets do PresetMap[name] = true end
		for name in self.Themes do
			if not PresetMap[name] then
				table.insert(Custom, name)
			end
		end
		table.sort(Custom)
		return Custom
	end

	local PresetDropdown
	local CustomDropdown

	local function UpdatePickers(Name)
		local Theme = self.Themes[Name]
		if Theme then
			for Key, Picker in ThemePickers do
				Picker:Set("All", Theme[Key], true)
			end
			if RenameTextbox then
				RenameTextbox:Set(Name)
				local PresetMap = {}
				for _, p in self.Presets do PresetMap[p] = true end
				RenameTextbox.Frame.Visible = not PresetMap[Name]
			end
		end
	end

	local function SelectTheme(Name, Source)
		if Name and self.Themes[Name] and Name ~= "None" then
			self:ApplyTheme(Name)
			UpdatePickers(Name)
			self:SaveThemes()
			if Source == "Preset" then
				CustomDropdown:Set({ "None" })
			elseif Source == "Custom" then
				PresetDropdown:Set({ "None" })
			end
		end
	end

	PresetsSection:CreateTitle("Preset Selection")

	PresetDropdown = PresetsSection:CreateDropdown(function(Selected)
		SelectTheme(Selected[1], "Preset")
	end, self.Presets, table.find(self.Presets, self.ActiveTheme) and self.ActiveTheme or "None", false)

	CustomSection:CreateTitle("Custom Themes")

	CustomDropdown = CustomSection:CreateDropdown(function(Selected)
		SelectTheme(Selected[1], "Custom")
	end, GetCustomThemes(), not table.find(self.Presets, self.ActiveTheme) and self.ActiveTheme or "None", false)

	local function RefreshDropdowns()
		CustomDropdown:Refresh(GetCustomThemes())
	end

	CustomSection:CreateTitle("Theme Colors")

	for _, Key in ThemeKeys do
		ThemePickers[Key] = CustomSection:CreateCompactColourPicker(Key, function(Color)
			if self.IsCreatingSettings then return end
			local PresetMap = {}
			for _, name in self.Presets do PresetMap[name] = true end

			if PresetMap[self.ActiveTheme] then
				local NewName = "Custom " .. self.ActiveTheme
				local NewThemeData = {}
				for k, v in self.Themes[self.ActiveTheme] do NewThemeData[k] = v end
				self.Themes[NewName] = NewThemeData
				self:ApplyTheme(NewName)
				RefreshDropdowns()
				CustomDropdown:Set({ NewName })
				PresetDropdown:Set({ "None" })
				UpdatePickers(NewName)
			end

			local Theme = self:GetTheme()
			if Theme then
				Theme[Key] = Color
				self:ApplyTheme(nil, false)
			end
		end, self:GetTheme()[Key])
	end

	-- Group 1: Manage Current Theme
	CustomSection:CreateTitle("Manage Theme")

	RenameTextbox = CustomSection:CreateTextbox("Rename Active Theme", function(NewName)
		if self:RenameTheme(NewName) then
			RefreshDropdowns()
			CustomDropdown:Set({ self.ActiveTheme })
		end
	end, self.ActiveTheme)

	-- Set initial visibility for rename box
	local PresetMap = {}
	for _, p in self.Presets do PresetMap[p] = true end
	RenameTextbox.Frame.Visible = not PresetMap[self.ActiveTheme]

	CustomSection:CreateButton("Save Current Theme", function()
		self:SaveThemes()
	end)

	CustomSection:CreateButton("Delete Current Theme", function()
		local PresetMap = {}
		for _, name in self.Presets do PresetMap[name] = true end
		if not PresetMap[self.ActiveTheme] then
			self.Themes[self.ActiveTheme] = nil
			SelectTheme("Default", "Preset")
			PresetDropdown:Set({ "Default" })
			RefreshDropdowns()
			self:SaveThemes()
		end
	end)

	-- Group 2: Create New Theme
	CustomSection:CreateTitle("Create Theme")

	local NewThemeNameInput = CustomSection:CreateTextbox("New Theme Name", function(Text) end, "My Theme")

	CustomSection:CreateButton("Create New from Current", function()
		local NewName = NewThemeNameInput:Get() or ("Theme " .. math.random(100, 999))
		if NewName == "" or self.Themes[NewName] then
			NewName = NewName .. " " .. math.random(100, 999)
		end
		local CurrentTheme = self:GetTheme()
		local NewThemeData = {}
		for k, v in CurrentTheme do NewThemeData[k] = v end
		self.Themes[NewName] = NewThemeData
		self:ApplyTheme(NewName)
		self:SaveThemes()
		RefreshDropdowns()
		CustomDropdown:Set({ NewName })
		PresetDropdown:Set({ "None" })
		UpdatePickers(NewName)
	end)

	-- Group 3: Porting & Sharing
	CustomSection:CreateTitle("Import / Export")

	CustomSection:CreateButton("Export Theme to Clipboard", function()
		local Exported = self:ExportTheme()
		if setclipboard then
			setclipboard(Exported)
		end
	end)

	local ImportTextbox = CustomSection:CreateTextbox("Paste Theme JSON", function(Text)
	end, "")

	CustomSection:CreateButton("Import Theme from JSON", function()
		local JSONText = ImportTextbox:Get() or ""
		if JSONText ~= "" then
			local Success, Name = self:ImportTheme(JSONText)
			if Success then
				RefreshDropdowns()
				CustomDropdown:Set({ Name })
				PresetDropdown:Set({ "None" })
				UpdatePickers(Name)
			end
		end
	end)

	self.IsCreatingSettings = false

	task.defer(function()
		local PresetMap = {}
		for _, p in self.Presets do PresetMap[p] = true end

		if PresetMap[self.ActiveTheme] then
			PresetDropdown:Set({ self.ActiveTheme })
			CustomDropdown:Set({ "None" })
		else
			CustomDropdown:Set({ self.ActiveTheme })
			PresetDropdown:Set({ "None" })
		end
		UpdatePickers(self.ActiveTheme)
	end)

	return SettingsTab
end

