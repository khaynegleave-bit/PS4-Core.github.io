    label:SetVisible(true)
end

function CoreFramework:LassoSelectItem(model)
    if table.find(self.Status.LassoSelectedItems, model) then return end
    table.insert(self.Status.LassoSelectedItems, model)

    if not self._lassoBoxes then self._lassoBoxes = {} end
    local box = Instance.new("SelectionBox")
    box.Name = "AncestorLassoBox"
    local woodSection = model:FindFirstChild("WoodSection")
    box.Adornee = woodSection or model
    box.Color3 = Color3.fromRGB(0, 162, 255)
    box.LineThickness = 0.05
    box.SurfaceTransparency = 0.6
    box.SurfaceColor3 = Color3.fromRGB(0, 162, 255)
    box.Parent = model
    self._lassoBoxes[model] = box

    local primaryPart = model.PrimaryPart
    if not primaryPart then
        model.PrimaryPart = model:FindFirstChild("Main") or model:FindFirstChild("WoodSection")
    end

    self:_LassoUpdateLabel()
end

function CoreFramework:LassoDeselectItem(model)
    local idx = table.find(self.Status.LassoSelectedItems, model)
    if not idx then return end
    table.remove(self.Status.LassoSelectedItems, idx)

    if self._lassoBoxes and self._lassoBoxes[model] then
        pcall(function() self._lassoBoxes[model]:Destroy() end)
        self._lassoBoxes[model] = nil
    end

    self:_LassoUpdateLabel()
end

function CoreFramework:LassoClearSelection()
    for _, model in ipairs(self.Status.LassoSelectedItems) do
        if self._lassoBoxes and self._lassoBoxes[model] then
            pcall(function() self._lassoBoxes[model]:Destroy() end)
        end
    end
    self._lassoBoxes = {}
    self.Status.LassoSelectedItems = {}
    self:_LassoUpdateLabel()
end

