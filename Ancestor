    Util.Imports.Placement     = (function()
--MARK: Include Utility


local Placement = {}
Placement.__index = Placement

--MARK: Placement Settings

Placement.Settings = {
    GridSize       = .5,
    YGridOffset    = 1,
    Rotations      = {
        X          = 0,
        Y          = 0,
        Z          = 0
    }
}

function Placement:ResolveScale()
    return Util.Imports.WireArt:GetValidScale()
end

--MARK: Grid

function Placement:GetRotationCFrame()
    return CFrame.Angles(
        math.rad(Util.Imports.Placement.Settings.Rotations.X),
        math.rad(Util.Imports.Placement.Settings.Rotations.Y),
        math.rad(Util.Imports.Placement.Settings.Rotations.Z)
    )
end

-- Cache the ground-hit RaycastParams so we're not re-allocating every frame.
local _groundParams     = RaycastParams.new()
_groundParams.FilterType = Enum.RaycastFilterType.Exclude
local _groundParamsPreview  = nil  -- track which preview is currently filtered

function Placement:GetGroundHit(Preview, Position)
    -- Rebuild filter only when the preview model changes (start/stop placement).
    if _groundParamsPreview ~= Preview then
        _groundParamsPreview = Preview
        local filter = { Preview, Util.Imports.Paths.Properties, Util.Imports.Paths.PlayerModels }
        if Util.Client.Character then
            table.insert(filter, Util.Client.Character)
        end
        local playersFolder = game:GetService("Players")
        for _, plr in playersFolder:GetPlayers() do
            if plr.Character then table.insert(filter, plr.Character) end
        end
        _groundParams.FilterDescendantsInstances = filter
    end

    return workspace:Raycast(
        Vector3.new(Position.X, 10000, Position.Z),
        Vector3.new(0, -20000, 0),
        _groundParams
    )
end

-- Returns the world Y of the preview's lowest point at its current rotation.
-- Uses the cached local-space bounding box (set in PreparePreview) so it never
-- iterates descendant parts — safe even when parts are weld-driven.
function Placement:GetPreviewBottomY(Preview)
    local wa      = Util.Imports.WireArt.Settings.Properties
    local lMin    = wa.LocalBoundsMin
    local lMax    = wa.LocalBoundsMax
    local pivotCF = Preview:GetPivot()
    if lMin and lMax then
        local minY = math.huge
        -- Transform the 8 AABB corners through the current rotation to find the
        -- lowest world-Y.  Translation cancels out in the Y comparison.
        for _, cx in ipairs({lMin.X, lMax.X}) do
            for _, cy in ipairs({lMin.Y, lMax.Y}) do
                for _, cz in ipairs({lMin.Z, lMax.Z}) do
                    local wy = pivotCF:PointToWorldSpace(Vector3.new(cx, cy, cz)).Y
                    if wy < minY then minY = wy end
                end
            end
        end
        return minY
    end
    return pivotCF.Position.Y
end

-- World-aligned grid sized by the toolbar's current grid state (1 / 0.5 / 0).
-- Mimics the in-game placement script's parity-based bucketing:
--   even rounded size → snap centre to multiples of g starting at 0
--   odd  rounded size → snap centre to multiples of g offset by g/2
-- Falls back to no-snap when the preview is rotated off the cardinal axes or
-- when the toolbar is in the "No Grid" state.
function Placement:SnapXZ(x, z, preview)
    if not (preview and typeof(preview) == "Instance" and preview:IsA("Model")) then
        return x, z
    end

    local g = Placement.Settings.GridSize
    if not g or g <= 0 then return x, z end

    local rot = Placement.Settings.Rotations
    local EPS = 0.01
    local function alignedDeg(d) return math.abs(((d % 90) + 90) % 90) < EPS end
    if not (alignedDeg(rot.X) and alignedDeg(rot.Y) and alignedDeg(rot.Z)) then
        return x, z
    end

    local ok, ext = pcall(function() return preview:GetExtentsSize() end)
    if not ok or not ext then return x, z end

    local function snap(pos, size)
        local rounded = math.floor(size + 0.5)
        if rounded < 1 then rounded = 1 end
        local offset = (rounded % 2 == 0) and 0 or (g * 0.5)
        return offset + math.floor((pos - offset) / g + 0.5) * g
    end

    return snap(x, ext.X), snap(z, ext.Z)
end

-- Caches the property's bounding-box corner (minimum XZ) as the snap reference.
-- This guarantees the snap aligns with the visual grid drawn on every square,
-- since each square's grid texture starts at the same min-corner-relative offset.
function Placement:RefreshSnapAnchor()
    Placement._snapAnchor = nil
    local target   = Util.Imports.BuildMode and Util.Imports.BuildMode:GetTargetPlayer() or Util.Client
    local property = Util.Imports.CoreFramework:GetProperty(target)
        or Util.Imports.CoreFramework:GetProperty(Util.Client)
    if not property then return end
    local minX, minZ = math.huge, math.huge
    for _, p in property:GetDescendants() do
        if p:IsA("BasePart") and (p.Name == "Square" or p.Name == "OriginSquare") then
            local px, pz = p.Position.X - p.Size.X / 2, p.Position.Z - p.Size.Z / 2
            if px < minX then minX = px end
            if pz < minZ then minZ = pz end
        end
    end
    if minX ~= math.huge then
        Placement._snapAnchor = Vector3.new(minX, 0, minZ)
    end
end

function Placement:SnapToGrid(Preview, Position)
    if not Position then return Vector3.new(0, -50, 0) end
    local sx, sz = self:SnapXZ(Position.X, Position.Z, Preview)
    local snappedPosition = Vector3.new(sx, Position.Y, sz)
    local raycastResult = Util.Imports.Placement:GetGroundHit(Preview, snappedPosition)

    if raycastResult then
        return Vector3.new(sx, raycastResult.Position.Y, sz)
    end
    return Vector3.new(0, -50, 0)
end

--MARK: Property Bounds Check

local _propertyRayParams = RaycastParams.new()
_propertyRayParams.FilterType = Enum.RaycastFilterType.Include

-- Instead of raycasting from every single part (can be thousands), sample the
-- 8 corners of the local-space bounding box transformed to world space.  For
-- wire art on a flat property this is both sufficient and ~1000× cheaper.
local function IsPreviewOnProperty(preview)
    local ownProperty = Util.Imports.CoreFramework:GetProperty(Util.Client)
    local target      = Util.Imports.BuildMode and Util.Imports.BuildMode:GetTargetPlayer()
    local targetProperty = target and target ~= Util.Client
        and Util.Imports.CoreFramework:GetProperty(target) or nil
    local filterList = {}
    if ownProperty    then table.insert(filterList, ownProperty) end
    if targetProperty then table.insert(filterList, targetProperty) end
    if #filterList == 0 then return false end
    _propertyRayParams.FilterDescendantsInstances = filterList

    local wa      = Util.Imports.WireArt.Settings.Properties
    local lMin    = wa.LocalBoundsMin
    local lMax    = wa.LocalBoundsMax
    local pivotCF = preview:GetPivot()
    local rayDir  = Vector3.new(0, -90000, 0)

    local checkPoints
    if lMin and lMax then
        checkPoints = {}
        for _, cx in ipairs({lMin.X, lMax.X}) do
            for _, cz in ipairs({lMin.Z, lMax.Z}) do
                -- Use the mid-Y so the ray origin is above the model
                local cy = (lMin.Y + lMax.Y) / 2
                local wp = pivotCF:PointToWorldSpace(Vector3.new(cx, cy, cz))
                table.insert(checkPoints, wp)
            end
        end
        -- Also check the centre
        local mid = pivotCF:PointToWorldSpace((lMin + lMax) / 2)
        table.insert(checkPoints, mid)
    else
        checkPoints = { pivotCF.Position }
    end

    for _, pt in ipairs(checkPoints) do
        local origin = pt + Vector3.new(0, 200, 0)
        local result = workspace:Raycast(origin, rayDir, _propertyRayParams)
        if not (result and result.Instance) then return false end
    end
    return true
end

-- Public wrapper so other modules (e.g. CoreFramework stacker) can validate.
function Placement:IsOnProperty(preview)
    if not preview then return false end
    return IsPreviewOnProperty(preview)
end

function Placement:UpdatePlacementPart()
    -- When the preview is locked, freeze position entirely.
    if Util.Imports.Placement._locked then return end
    -- On mobile, ignore frame updates briefly after a toolbar button is tapped
    -- so the button's touch position doesn't teleport the preview.
    if Util.Imports.Placement._touchGuard then return end

    local Preview = Util.Imports.Placement.PreviewModel
    if Preview then
        local resolvedScale = Util.Imports.Placement:ResolveScale()
        if Util.Imports.WireArt.Settings.Preview.Scale ~= resolvedScale then
            Util.Imports.WireArt.Settings.Preview.Scale = resolvedScale
        end

        local currentScale = Util.Imports.WireArt:GetValidScale()
        if Util.Imports.Placement._LastAppliedScale ~= currentScale then
            local previousPivot = Preview:GetPivot()
            Preview:Destroy()

            local rebuiltPreview = Util.Imports.WireArt:PreparePreview()
            Util.Imports.Placement.PreviewModel = rebuiltPreview
            rebuiltPreview:PivotTo(previousPivot)
            Preview = rebuiltPreview
            Util.Imports.Placement._LastAppliedScale = currentScale
            Util.Imports.Placement._BottomOffsetRotKey = nil
        end

        local Hit = Util.Mouse.Hit
        local MousePosition = typeof(Hit) == "CFrame" and Hit.Position
            or typeof(Hit) == "Vector3" and Hit
            or Hit and (Hit.Position or Hit.p)
        if not Preview.PrimaryPart then
           return Util.Imports.Placement:ExitPlacement()
        end
        if not MousePosition then return end
        local snappedPosition = Util.Imports.Placement:SnapToGrid(Preview, MousePosition)
        local rotation = Util.Imports.Placement:GetRotationCFrame()

        -- Moving PrimaryPart.CFrame is O(1) — WeldConstraints propagate to all
        -- child parts via the physics engine instead of Lua iterating every part.
        local targetCF = CFrame.new(snappedPosition) * rotation
        Preview.PrimaryPart.CFrame = targetCF

        local rot    = Util.Imports.Placement.Settings.Rotations
        local rotKey = rot.X .. "_" .. rot.Z
        if Util.Imports.Placement._BottomOffsetRotKey ~= rotKey then
            local pivotY    = snappedPosition.Y
            local rawBottomY = Util.Imports.Placement:GetPreviewBottomY(Preview)
            Util.Imports.Placement._BottomOffset     = pivotY - rawBottomY
            Util.Imports.Placement._BottomOffsetRotKey = rotKey
        end

        local groundHit = Util.Imports.Placement:GetGroundHit(Preview, snappedPosition)
        if groundHit then
            local effectiveBottomY = snappedPosition.Y - Util.Imports.Placement._BottomOffset
            local lift = groundHit.Position.Y - effectiveBottomY
            Preview.PrimaryPart.CFrame = targetCF + Vector3.new(0, lift, 0)
        end

        -- Property check: only re-evaluate when the XZ position changes by at
        -- least one grid cell — avoids raycasting every single frame on mobile.
        local p         = Util.Imports.Placement
        local curXZ     = Vector2.new(snappedPosition.X, snappedPosition.Z)
        local lastXZ    = p._lastPropertyCheckXZ
        local rotChanged = p._lastPropertyCheckRot ~= rotKey
        if rotChanged or not lastXZ or (curXZ - lastXZ).Magnitude >= Placement.Settings.GridSize then
            p._lastPropertyCheckXZ  = curXZ
            p._lastPropertyCheckRot = rotKey
            p._lastPropertyOnResult = IsPreviewOnProperty(Preview)
        end

        if p._lastPropertyOnResult then
            p._lastValidPivot = Preview:GetPivot()
        else
            if not p._lastValidPivot then
                local char = Util.Client.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    p._lastValidPivot = CFrame.new(root.Position)
                end
            end
            if p._lastValidPivot then
                Preview.PrimaryPart.CFrame = p._lastValidPivot
            end
        end
    end
end

--MARK: Main Function

-- Prepares/refreshes the wire art preview and registers all placement connections.
-- Does NOT touch the toolbar — call this when the toolbar is already visible.
function Placement:StartPlacement()
    -- Disable any active selection tools before entering placement.
    pcall(function() Util.Imports.CoreFramework:LassoStop() end)
    pcall(function() Util.Imports.CoreFramework:LassoClickStop() end)
    -- Clean up any existing preview before starting a fresh one.
    self:ExitPlacement()
    Util.Imports.Placement._locked = false
    Util.Imports.Placement._lastValidPivot = nil
    -- If this placement was initiated from Text To Wire, consume the pending flag
    -- and re-assert _textToWireActive (ExitPlacement clears it, so we set it here
    -- after ExitPlacement has already run).
    local BM = Util.Imports.BuildMode
    if BM and BM._t2wPending then
        BM._t2wPending = false
        BM._textToWireActive = true
        local state = BM.TextToWire
        Util.Imports.WireArt.Settings.Preview.Scale = state.Scale
        if state.WireType and state.WireType ~= "" then
            Util.Imports.WireArt.Settings.Preview.SelectedWireType = state.WireType
        end
    end
    -- Align the snap anchor with the player's property so snapping matches the visual grid.
    self:RefreshSnapAnchor()
    
    local Preview = Util.Imports.WireArt:PreparePreview()
    Util.Imports.Placement.PreviewModel = Preview
    Util.Imports.Placement._LastAppliedScale = Util.Imports.WireArt:GetValidScale()

    -- Snap the preview to the centre of the player's property so frame 1 is
    -- guaranteed on-property. This seeds _lastValidPivot so any subsequent
    -- off-property movement reverts cleanly.
    local target      = Util.Imports.BuildMode and Util.Imports.BuildMode:GetTargetPlayer() or Util.Client
    local ownProperty = Util.Imports.CoreFramework:GetProperty(target)
        or Util.Imports.CoreFramework:GetProperty(Util.Client)
    if ownProperty then
        local center = ownProperty:GetPivot()
        if Util.Client.Character and Util.Client.Character:FindFirstChild("HumanoidRootPart") then
            center = Util.Client.Character.HumanoidRootPart.CFrame
        end
        Preview:PivotTo(CFrame.new(center.Position))
        if IsPreviewOnProperty(Preview) then
            Util.Imports.Placement._lastValidPivot = Preview:GetPivot()
        end
    end

    local dumped = Util.Imports.WireArt:Dump(Preview)
    if dumped then
        local plannedWires = Util.Imports.WireArt:PrepareBuildWires(dumped)
        local boxedOnly = Util.Imports.WireArt.Settings.BoxedWiresOnly
        local wirePlayer = Util.Imports.WireArt.Settings.Properties.WireSource or Util.Client
        local playerWireCount = Util.Imports.CoreFramework:CountItemAmount(
            wirePlayer,
            Util.Imports.WireArt.Settings.Preview.SelectedWireType,
            boxedOnly
        )

        -- if playerWireCount < #plannedWires then
        --     local needed = #plannedWires - playerWireCount
        --     Util.Imports.Placement:ExitPlacement()
        --     return Util.Imports.CoreFramework:Notice(
        --         `Wire Art aborted: you don't have enough {boxedOnly and "boxed wires" or "wires"} (need {needed} more)`
        --     )
        -- end
    end

    Util.Imports.Placement:RefreshKeybinds()

    Util.Imports.Maid:register("StructurePlacement", Util.Services.RunService.PreSimulation:Connect(Util.Imports.Placement.UpdatePlacementPart, Util.Imports.Placement))
end

-- Commits the current preview to the world. Safe to call when no preview exists.
function Placement:ConfirmPlacement()
    local activePreview = Util.Imports.Placement.PreviewModel
    if not activePreview then return end

    local Wires = Util.Imports.WireArt:Dump(activePreview)

    local retarded_shit = activePreview:Clone()
    Util.Imports.Placement:ExitPlacement()
    pcall(function() Util.Imports.BuildMode:RefreshLockVisual() end)
    if Wires then
        if not IsPreviewOnProperty(retarded_shit) then
            retarded_shit:Destroy()
            Util.Imports.Placement.PreviewModel = nil
            return Util.Imports.CoreFramework:Notice("Wire Art cancelled — placement is outside your property.")
        end
