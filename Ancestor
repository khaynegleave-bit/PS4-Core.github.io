function Ancestor:BringTree(Quantity, Silent, RequireModdable, TreeTypeOverride)
	local TreeReturn
	local OriginalPosition = Util.Client.Character:GetPivot().Position
	local bringNotice
	local function EndBringTree()
		if not Util.Imports.CoreFramework.Status.BringingTree then return end
		Util.Imports.CoreFramework.Status.BringingTree = false
		Util.Imports.CoreFramework.Status._endBringTree = nil
		Util.Imports.CoreFramework.Status._lastNotifiedAxe = nil
		Util.Imports.Maid:deregister("Pickup_EndTimes")
		Util.Imports.Library.Buttons["Bring Tree/s"]:Set("Bring Tree/s")
		Util.Imports.CoreFramework:Teleport(CFrame.new(OriginalPosition))
		Util.Imports.CoreFramework:ToggleHumanoidStates(true)
		if bringNotice then bringNotice:Dismiss() bringNotice = nil end
		if not Silent then Util.Imports.CoreFramework:UnlockUI("Bring Tree completed") end
	end

	if not Util.Imports.CoreFramework.Status.BringTreeSelectedTrees or #Util.Imports.CoreFramework.Status.BringTreeSelectedTrees < 1 then
		return Util.Imports.CoreFramework:Notice("No tree selected!")
	end

	local firstTree = Util.Imports.CoreFramework.Status.BringTreeSelectedTrees[1]
	if not Util.Imports.CoreFramework:GetBestAxe(firstTree) then
		return Util.Imports.CoreFramework:Notice(
			(Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes)
				and "No axe available — nobody in the server has one you can use."
				or  "You need an axe to use this feature!"
		)
	end

	Util.Imports.CoreFramework:ToggleHumanoidStates(true)
	Util.Imports.Library.Buttons["Bring Tree/s"]:Set("Abort")
	Util.Imports.CoreFramework.Status.BringingTree = true
	Util.Imports.CoreFramework.Status._endBringTree = EndBringTree
	if not Silent then Util.Imports.CoreFramework:LockUI("Bring Tree") end
	local List = TreeTypeOverride and { TreeTypeOverride } or (Quantity and { Util.Imports.CoreFramework.Status.BringTreeSelectedTrees[1] } or Util.Imports.CoreFramework.Status.BringTreeSelectedTrees)
	local treeQuantity = Quantity or Util.Imports.CoreFramework.Status.BringTreeQuantity
	local bringTotal = #List * treeQuantity
	local bringDone = 0
	local function updateBringNotice()
		local message = "Bring Tree: " .. tostring(bringDone) .. "/" .. tostring(bringTotal)
		if bringNotice and bringNotice:IsActive() then
			bringNotice:Set(message)
		else
			bringNotice = Util.Imports.CoreFramework:Notice(message, false)
		end
		bringNotice:SetProgress(bringDone / math.max(bringTotal, 1))
	end
	if not Silent then updateBringNotice() end
	for index, tree in List do

		for i = 1, treeQuantity do

			if not Util.Imports.CoreFramework.Status.BringingTree then
				EndBringTree()
				break
			end
			local BestAxe, AxeData = Util.Imports.CoreFramework:GetBestAxe(tree)
			if not BestAxe then
				EndBringTree()
				return Util.Imports.CoreFramework:Notice(
			(Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes)
				and "No axe available — nobody in the server has one you can use."
				or  "You need an axe to use this feature!"
		)
			end


			local Tree = Util.Imports.CoreFramework:FindTree(tree, RequireModdable)
			if Tree then
				if tree == "LoneCave" then
					if BestAxe.ToolName.Value ~= "EndTimesAxe" then
						EndBringTree()
						return Util.Imports.CoreFramework:Notice("You need an End Times Axe to use this feature!")
					end

					if Util.Client.leaderstats.Money.Value < 100 then
						EndBringTree()
						return Util.Imports.CoreFramework:Notice("You need $100 to bring the LoneCave tree!")
					end

					Util.Imports.CoreFramework:ConfirmPurchaseWithCashier(Util.DetectedGame.Properties.Cashiers.Seranok)

					Util.Imports.Maid:register("Pickup_EndTimes", Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Model)
						local Owner = Model:WaitForChild("Owner", 5)
						local ToolName = Model:WaitForChild("ToolName", 5)
						if (Owner and ToolName) and (ToolName.Value == "EndTimesAxe" and Owner.Value == Util.Client) then
							repeat Util.Imports.Maid:Wait()
								local Character = Util.Client.Character
								if (Character) then
									local Humanoid = Character:FindFirstChildOfClass("Humanoid")
									if (Humanoid and Humanoid.Health > 0) then
										Util:FireServer("ClientInteracted", Model, "Pick up tool")
									end
								end
							until not (Model and Model.Parent)
						end
					end))
				end

				local Trunk = Util.Imports.CoreFramework:GetTrunkFromTree(Tree)
				Trunk.CanCollide = false

				local TreeChopped = "BringTree" .. tostring(Util.Services.HttpService:GenerateGUID(false))
				Util.Imports.Maid:register(TreeChopped, Util.Imports.Paths.LogModels.ChildAdded:Connect(function(Tree)
					local Owner = Tree:WaitForChild("Owner", 5)
					local WoodSection = Tree:WaitForChild("WoodSection", 5)
					if (Owner and WoodSection) and (Owner.Value == Util.Client or Owner.Value == nil) then

						Tree.PrimaryPart = WoodSection
						TreeReturn = Tree

						repeat
							Util.Imports.Maid:Wait()
							Util:FireServer("ClientIsDragging", Tree)
						until Tree.Owner.Value == Util.Client

						for _ = 1, 45 do
							Util.Imports.Maid:Wait()
							Util:FireServer("ClientIsDragging", Tree)
							Tree:PivotTo(CFrame.new(OriginalPosition))
						end
						Util.Imports.Maid:deregister(TreeChopped)
					end
				end))

				repeat task.wait()
					if not Util.Imports.CoreFramework.Status.BringingTree then
						EndBringTree()
						break
					end

					if not Util.Imports.CoreFramework.Status.GUI_LOADED then
						break
					end

					-- Re-resolve the axe when our cached reference is gone OR when
					-- a borrowed axe has moved out of any valid Character/Backpack.
					if not BestAxe
					   or not BestAxe.Parent
					   or not Util.Imports.CoreFramework:IsAxeStillValid(BestAxe) then
						BestAxe, AxeData = Util.Imports.CoreFramework:GetBestAxe(tree)
					end

					-- No axe available anywhere — abort Bring Tree cleanly.
					if not (BestAxe and AxeData) then
						local msg = (Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes)
							and "Bring Tree aborted — no axe available (yours or anyone else's)."
							or  "Bring Tree aborted — you have no axe."
						Util.Imports.CoreFramework:Notice(msg, 4)
						EndBringTree()
						break
					end

					-- When the "Use Other People's Axes" toggle is on, notify on
					-- every axe change so the user knows which one (and whose)
					-- is currently being used. Tracked across iterations via
					-- _lastNotifiedAxe so we don't spam the same axe repeatedly.
					if Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes then
						local lastTool = Util.Imports.CoreFramework.Status._lastNotifiedAxe
						if lastTool ~= BestAxe then
							Util.Imports.CoreFramework.Status._lastNotifiedAxe = BestAxe
							local owner    = Util.Imports.CoreFramework:GetAxeOwner(BestAxe)
							local axeName  = (AxeData and AxeData.name) or (BestAxe:FindFirstChild("ToolName") and BestAxe.ToolName.Value) or "axe"
							local ownerStr = (not owner or owner == Util.Client)
								and "your"
								or  tostring(owner.Name) .. "'s"
							Util.Imports.CoreFramework:Notice("Using " .. tostring(ownerStr) .. " " .. tostring(axeName) .. " axe.", 3)
						end
					end

					if not Trunk.Anchored then
						break
					end
					local Humanoid = Util.Client.Character:FindFirstChild("Humanoid")
					if Humanoid then
						Humanoid:UnequipTools()
					end
					Util.Imports.CoreFramework:Teleport(Trunk.CFrame)

					Util.Imports.CoreFramework:AttemptChop(Tree, BestAxe, AxeData)
				until not Util.Imports.Maid:verify(TreeChopped)
			end
			bringDone += 1
			if not Silent then updateBringNotice() end
		end
	end
	if bringNotice then bringNotice:Dismiss() end
	EndBringTree()
	return TreeReturn
end 

