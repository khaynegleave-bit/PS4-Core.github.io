function CoreFramework:GetProperty(PropertyOwner)
    local Max, NearestProperty = 9e9, nil
    for _, Property in Util.Imports.Paths.Properties:GetChildren() do
        local Owner = Property:FindFirstChild("Owner")
        if Owner and Owner.Value == PropertyOwner then
            if not PropertyOwner then
                local Magnitude = (Util.Client.Character:GetPivot().p - Property:GetPivot().p).Magnitude
                if Max > Magnitude then
                    Max = Magnitude
                    NearestProperty = Property
                end
            else
                return Property
            end
        end
    end
    return not PropertyOwner and NearestProperty or false
end

