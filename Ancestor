local _textToWireCounter = 0

-- ── Text To Wire panel (toolbar textToWire button) ───────────────────────────
local function makeTextToWirePanel(parent, T)
    _textToWireCounter += 1
    local Library = Util.Imports.Library

    -- Forward-declare the visible panel/section so the button callbacks
    -- (created BEFORE they're assigned) capture the right upvalues.
    local panel
    local section

    -- References to each UILib control object so the Build button can read
    -- their live state directly via :Get() (textbox) or stored values.
    local txtboxRef, toggleRef, scaleRef, paddingRef

    -- Build a private hidden UILib section that owns the real controls;
    -- they'll be reparented into our panel after creation.
    local ok, hiddenTab = pcall(function()
        return Library:CreateTab("", "__t2w_" .. _textToWireCounter)
    end)
    local libSection
    if ok and hiddenTab then
        pcall(function() hiddenTab.Button.Parent = nil end)
        hiddenTab.Container.Visible = false
        local secOk, sec = pcall(function() return hiddenTab:CreateSection("Text To Wire") end)
        if secOk then libSection = sec end
    end

    -- Applies the Text To Wire's own scale and wire type to WireArt settings so
    -- they are fully independent from the Wire Art controls panel.
    -- Sets _t2wPending so StartPlacement can re-apply after the Destroy/ExitPlacement
    -- cycle that EnterPlacement triggers (which would otherwise clear _textToWireActive).
    local function applyT2WSettings()
        local WireArt = Util.Imports.WireArt
        local state   = BuildMode.TextToWire
        BuildMode._t2wPending = true
        WireArt.Settings.Preview.Scale = state.Scale
        if state.WireType and state.WireType ~= "" then
            WireArt.Settings.Preview.SelectedWireType = state.WireType
        end
        -- Push T2W's own BoxedWiresOnly so it doesn't share state with Wire Art
        WireArt.Settings.BoxedWiresOnly = state.BoxedWiresOnly
    end

    -- Rebuilds the wire-art preview from the current Text To Wire state,
    -- but only if a wire art preview is already active. Used by every
    -- callback so editing text / 3D / scale / padding / wire type live-updates the preview.
    local function refreshPreviewIfActive()
        local WireArt   = Util.Imports.WireArt
        local Placement = Util.Imports.Placement
        if not (WireArt and Placement and Placement.HasPreview and Placement:HasPreview()) then
            return
        end
        local state = BuildMode.TextToWire
        if not state.Text or #state.Text == 0 then return end
        local ok, result = pcall(function()
            return WireArt:BuildFromText(state.Text, state.Scale, state.Padding, state.ThreeD, state.Thickness3D, state.WordWrap, state.Alignment)
        end)
        if ok and result then
            WireArt.Settings.Properties.Wires = result
            applyT2WSettings()
            pcall(function() Placement:StartPlacement() end)
        end
    end

    -- Reference to the 3D Thickness slider row so the 3D toggle can show/hide it.
    local thickness3DRow = nil

    if libSection then
        -- 1. Text input
        pcall(function()
            txtboxRef = libSection:CreateTextbox("Text", function(value)
                BuildMode.TextToWire.Text = value or ""
                refreshPreviewIfActive()
            end, BuildMode.TextToWire.Text, "Type the text to convert", false, false)
            -- Force white text regardless of theme so it's always readable
            if txtboxRef and txtboxRef.Instance then
                local inputBox = txtboxRef.Instance:FindFirstChild("Input")
                if inputBox then
                    inputBox.TextColor3        = Color3.fromRGB(255, 255, 255)
                    inputBox.PlaceholderColor3 = Color3.fromRGB(200, 200, 200)
                end
            end
        end)
        -- 2. Wire Type dropdown
        pcall(function()
            local wireTypes = Util.Imports.WireArt:GetWireTypes()
            local defaultWire = BuildMode.TextToWire.WireType
            local defaultDisplay = defaultWire
            for displayName, wireId in pairs(Util.Imports.WireArt.Settings.Properties.WireConversions) do
                if wireId == defaultWire then defaultDisplay = displayName break end
            end
            libSection:CreateDropdown(function(value)
                local selected = (type(value) == "table" and value[1]) or value
                if not selected or selected == "" then return end
                local wireId = Util.Imports.WireArt.Settings.Properties.WireConversions[selected]
                if wireId then
                    BuildMode.TextToWire.WireType = wireId
                    refreshPreviewIfActive()
                end
            end, wireTypes, defaultDisplay, false)
        end)
        -- 3. 3D toggle
        pcall(function()
            toggleRef = libSection:CreateToggle("3D", function(value)
                BuildMode.TextToWire.ThreeD = value
                if thickness3DRow then thickness3DRow.Visible = value end
                refreshPreviewIfActive()
            end, BuildMode.TextToWire.ThreeD)
        end)
        -- 3b. Text Wrapping toggle + Alignment dropdown (only visible when wrap is on)
        local alignmentRow = nil
        pcall(function()
            libSection:CreateToggle('Text Wrapping  (use "\\n" to wrap)', function(value)
                BuildMode.TextToWire.WordWrap = value
                if alignmentRow then alignmentRow.Visible = value end
                refreshPreviewIfActive()
            end, BuildMode.TextToWire.WordWrap)
        end)
        pcall(function()
            libSection:CreateDropdown(function(value)
                local selected = (type(value) == "table" and value[1]) or value
                if selected and selected ~= "" then
                    BuildMode.TextToWire.Alignment = selected
                    refreshPreviewIfActive()
                end
            end, { "Left", "Center", "Right" }, BuildMode.TextToWire.Alignment, false)
            -- Capture the row so we can show/hide it with the Word Wrap toggle
            local srcFrame = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
            if srcFrame then
                for _, child in srcFrame:GetChildren() do
                    if child:IsA("GuiObject") and child:GetAttribute("SearchText") == "Left" then
                        alignmentRow = child
                        child.Visible = BuildMode.TextToWire.WordWrap
                        break
                    end
                end
            end
        end)
        -- 4. Scale slider
        pcall(function()
            scaleRef = libSection:CreateSlider("Scale", function(value)
                BuildMode.TextToWire.Scale = value
                refreshPreviewIfActive()
            end, 0.1, 5, BuildMode.TextToWire.Scale, true)
        end)
        -- 5. Padding slider
        pcall(function()
            paddingRef = libSection:CreateSlider("Padding", function(value)
                BuildMode.TextToWire.Padding = value
                refreshPreviewIfActive()
            end, 0, 10, BuildMode.TextToWire.Padding, true)
        end)
        -- 6. 3D Thickness slider (only visible when 3D is on)
        pcall(function()
            libSection:CreateSlider("3D Thickness", function(value)
                BuildMode.TextToWire.Thickness3D = value
                refreshPreviewIfActive()
            end, 0.1, 5, BuildMode.TextToWire.Thickness3D, true)
            -- Capture the row and hide it initially if 3D is off.
            local srcFrame = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
            if srcFrame then
                for _, child in srcFrame:GetChildren() do
                    if child:IsA("GuiObject") and child:GetAttribute("SearchText") == "3D Thickness" then
                        thickness3DRow = child
                        child.Visible = BuildMode.TextToWire.ThreeD
                        break
                    end
                end
            end
        end)
        -- 6b. Boxed Wires Only toggle (standalone — separate from Wire Art's setting)
        pcall(function()
            libSection:CreateToggle("Boxed Wires Only", function(value)
                BuildMode.TextToWire.BoxedWiresOnly = value
            end, BuildMode.TextToWire.BoxedWiresOnly)
        end)
        -- 7. Build button
        pcall(function()
            libSection:CreateButton("Build Wire Art", function()
                local WireArt   = Util.Imports.WireArt
                local Placement = Util.Imports.Placement
                local cf        = Util.Imports.CoreFramework
                if not (WireArt and WireArt.BuildFromText) then
                    pcall(function() cf:Notice("Text-to-wire builder not available.", 3) end)
                    return
                end
                if WireArt:GetTextWireIndexSize(BuildMode.TextToWire.ThreeD) == 0 then
                    pcall(function() cf:Notice("No text wire files found — press Download Text Wires first.", 5) end)
                    return
                end
                local state = BuildMode.TextToWire

                -- ── Live-read the textbox ──────────────────────────────────────
                -- UILib's textbox callback only fires on FocusLost. Walk the
                -- borrowed tree looking specifically for a TextBox named "Input"
                -- (UILib textbox child) or one whose parent has SearchText
                -- "Text" — never a slider's "Number" TextBox.
                local function findInputText()
                    local roots = {
                        section,
                        panel,
                        hiddenTab and hiddenTab.Container,
                    }
                    for _, root in ipairs(roots) do
                        if root then
                            for _, d in ipairs(root:GetDescendants()) do
                                if d:IsA("TextBox") and d.Name == "Input"
                                   and d.Parent and d.Parent:GetAttribute("SearchText") == "Text" then
                                    return d.Text, "exact:" .. d:GetFullName()
                                end
                            end
                        end
                    end
                    for _, root in ipairs(roots) do
                        if root then
                            for _, d in ipairs(root:GetDescendants()) do
                                if d:IsA("TextBox") and d.Name == "Input" then
                                    return d.Text, "loose:" .. d:GetFullName()
                                end
                            end
                        end
                    end
                    return nil, "none"
                end
                local liveText = findInputText()
                if liveText ~= nil then state.Text = liveText end

                if not state.Text or #state.Text == 0 then
                    pcall(function() cf:Notice("Please enter some text first.", 4) end)
                    return
                end
                local okBuild, result = pcall(function()
                    return WireArt:BuildFromText(state.Text, state.Scale, state.Padding, state.ThreeD, state.Thickness3D, state.WordWrap, state.Alignment)
                end)
                if not okBuild then
                    pcall(function() cf:Notice("Something went wrong building the wire art — please try again.", 5) end)
                    return
                end
                if not result then
                    pcall(function() cf:Notice("Couldn't build the text wire art. Make sure you've downloaded the text wires first.", 6) end)
                    return
                end
                WireArt.Settings.Properties.Wires = result
                applyT2WSettings()
                pcall(function() Placement:EnterPlacement() end)
            end)
        end)
        -- 8. Download button
        pcall(function()
            libSection:CreateButton("Download Text Wires", function()
                Util.Imports.CoreFramework:DownloadTextWires()
            end)
        end)
    end

    -- Collect borrowed rows from the hidden section.
    local rows, rowHome, rowLO, rowZ = {}, {}, {}, {}
    local srcSection = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
    if srcSection then
        for _, child in srcSection:GetChildren() do
            if child:IsA("GuiObject") and child.Name ~= "Title" then
                table.insert(rows, child)
                rowHome[child] = srcSection
                rowLO[child]   = child.LayoutOrder
                rowZ[child]    = child.ZIndex
            end
        end
        table.sort(rows, function(a, b) return a.LayoutOrder < b.LayoutOrder end)
    end

    -- Build the visible panel shell (panel/section were forward-declared
    -- above so the libSection callbacks capture the right upvalue).
    panel = Instance.new("Frame")
    panel.Name                   = "TextToWirePanel"
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel        = 0
    panel.AnchorPoint            = Vector2.new(0.5, 0.5)
    panel.Position               = UDim2.new(0.5, 0, 0.5, 0)
    panel.AutomaticSize          = Enum.AutomaticSize.Y
    panel.Size                   = UDim2.new(0, 380, 0, 0)
    panel.Visible                = false
    panel.ZIndex                 = 20
    panel.Parent = parent

    section = Instance.new("Frame")
    section.Name                   = "Section"
    section.BackgroundColor3       = T.Section
    section.BackgroundTransparency = 1
    section.BorderSizePixel        = 0
    section.AutomaticSize          = Enum.AutomaticSize.Y
    section.Size                   = UDim2.new(1, 0, 0, 0)
    section.ZIndex                 = 20
    section.Parent = panel
    Instance.new("UICorner", section).CornerRadius = UDim.new(0, 7)
    local ll = Instance.new("UIListLayout", section)
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Padding   = UDim.new(0, 10)
    local pad = Instance.new("UIPadding", section)
    pad.PaddingTop    = UDim.new(0, 7)
    pad.PaddingBottom = UDim.new(0, 7)
    pad.PaddingLeft   = UDim.new(0, 7)
    pad.PaddingRight  = UDim.new(0, 7)

    local title = Instance.new("TextLabel")
    title.Name                   = "Title"
    title.BackgroundTransparency = 1
    title.BorderSizePixel        = 0
    title.Size                   = UDim2.new(1, -16, 0, 29)
    title.Text                   = " Text To Wire"
    title.TextColor3             = T.Text
    title.TextTransparency       = 1
    title.TextSize               = 18
    title.Font                   = Enum.Font.SourceSansBold
    title.TextXAlignment         = Enum.TextXAlignment.Left
    title.LayoutOrder            = 0
    title.ZIndex                 = 21
    title.Parent                 = section

    -- Helper: sub-header styled identically to UILib section titles
    local function makeHdr(text, lo)
        local h = Instance.new("TextLabel")
        h.Name                   = "Hdr_" .. text:gsub("%s+", "_")
        h.BackgroundTransparency = 1
        h.BorderSizePixel        = 0
        h.Size                   = UDim2.new(1, -16, 0, 29)
        h.Text                   = " " .. text
        h.TextColor3             = T.Text
        h.TextSize               = 18
        h.Font                   = Enum.Font.SourceSansBold
        h.TextXAlignment         = Enum.TextXAlignment.Left
        h.LayoutOrder            = lo
        h.ZIndex                 = 21
        h.Parent                 = section
        return h
    end

    -- ── Players ───────────────────────────────────────────────────────────────
    makeHdr("Build For", 11)
    local _t2wTargetRestore = borrowTargetPlayerRow(section, 12)
    makeHdr("Use Selected Players Wires", 13)
    local _t2wWireSourceRestore = borrowWireSourceRow(section, 14)

    -- ── Text ─────────────────────────────────────────────────────────────────
    makeHdr("Text", 20)
    -- borrowed rows 1–2: Text input, Wire Type

    -- ── Display ──────────────────────────────────────────────────────────────
    makeHdr("Display", 30)
    -- borrowed rows 3–5: 3D, Word Wrap, Alignment

    -- ── Sizing ───────────────────────────────────────────────────────────────
    makeHdr("Sizing", 40)
    -- borrowed rows 6–8: Scale, Padding, 3D Thickness

    -- ── Actions ──────────────────────────────────────────────────────────────
    makeHdr("Actions", 50)
    -- borrowed rows 10–11: Build Wire Art, Download Text Wires

    -- Map each borrowed row index to its LayoutOrder slot so it sits under
    -- the correct group header.
    -- 1=Text, 2=WireType (Text group)
    -- 3=3D, 4=WordWrap, 5=Alignment (Display group)
    -- 6=Scale, 7=Padding, 8=3DThickness, 9=BoxedWiresOnly (Sizing group)
    -- 10=Build, 11=Download (Actions group)
    local ROW_ORDERS = { 21, 22, 31, 32, 33, 41, 42, 43, 44, 51, 52 }

    local function borrow()
        for i, row in ipairs(rows) do
            row.LayoutOrder = ROW_ORDERS[i] or (50 + i)
            row.ZIndex      = 21
            row.Parent      = section
        end
    end
    local function restore()
        for _, row in ipairs(rows) do
            if row.Parent == section and rowHome[row] then
                row.LayoutOrder = rowLO[row]
                row.ZIndex      = rowZ[row]
                row.Parent      = rowHome[row]
            end
        end
    end

    makeScrollable(panel, section, T, 800)
    local show, hide, reset = makePanelFade(panel, section, title, borrow, restore)
    return panel, show, hide, function()
        restore()
        if _t2wTargetRestore     then pcall(_t2wTargetRestore)     end
        if _t2wWireSourceRestore then pcall(_t2wWireSourceRestore) end
        pcall(function()
            if hiddenTab and hiddenTab.Container then hiddenTab.Container:Destroy() end
            if hiddenTab and hiddenTab.Button then hiddenTab.Button:Destroy() end
        end)
        reset()
    end
end


local _asciiArtCounter = 0

-- ── ASCII Art panel (toolbar asciiArt button) ─────────────────────────────────
-- Renders the textbox content as a 2D character grid using each char's wire-art
-- glyph. Spaces leave gaps, "\n" (or real newlines) start a new row.
local function makeAsciiArtPanel(parent, T)
    _asciiArtCounter += 1
    local Library = Util.Imports.Library

    local panel
    local section

    local txtboxRef
    local thickness3DRow = nil

    local ok, hiddenTab = pcall(function()
        return Library:CreateTab("", "__ascii_" .. _asciiArtCounter)
    end)
    local libSection
    if ok and hiddenTab then
        pcall(function() hiddenTab.Button.Parent = nil end)
        hiddenTab.Container.Visible = false
        local secOk, sec = pcall(function() return hiddenTab:CreateSection("ASCII Art") end)
        if secOk then libSection = sec end
    end

    -- Pushes the ASCII-specific scale / wire type into WireArt before placement
    -- and signals StartPlacement (via _t2wPending) that T2W-mode guards apply,
    -- so Wire Art's own scale slider stays decoupled from this preview.
    local function applyAsciiSettings()
        local WireArt = Util.Imports.WireArt
        local state   = BuildMode.AsciiArt
        BuildMode._t2wPending = true
        WireArt.Settings.Preview.Scale = state.Scale
        if state.WireType and state.WireType ~= "" then
            WireArt.Settings.Preview.SelectedWireType = state.WireType
        end
        -- Push ASCII Art's own BoxedWiresOnly so it doesn't share state with Wire Art
        WireArt.Settings.BoxedWiresOnly = state.BoxedWiresOnly
    end

    local function refreshPreviewIfActive()
        local WireArt   = Util.Imports.WireArt
        local Placement = Util.Imports.Placement
        if not (WireArt and Placement and Placement.HasPreview and Placement:HasPreview()) then
            return
        end
        local state = BuildMode.AsciiArt
        if not state.Text or #state.Text == 0 then return end
        local ok, result = pcall(function()
            return WireArt:BuildFromAscii(state.Text, state.Scale, state.ThreeD)
        end)
        if ok and result then
            WireArt.Settings.Properties.Wires = result
            applyAsciiSettings()
            pcall(function() Placement:StartPlacement() end)
        end
    end

    -- Decodes HTML entities (named + numeric) so the rendered ASCII matches
    -- the original page source exactly.
    local function decodeHtmlEntities(s)
        s = s:gsub("&#x(%x+);", function(hex)
            local n = tonumber(hex, 16); return n and utf8.char(n) or ""
        end)
        s = s:gsub("&#(%d+);", function(dec)
            local n = tonumber(dec); return n and utf8.char(n) or ""
        end)
        s = s:gsub("&lt;",   "<")
        s = s:gsub("&gt;",   ">")
        s = s:gsub("&quot;", '"')
        s = s:gsub("&apos;", "'")
        s = s:gsub("&nbsp;", " ")
        s = s:gsub("&amp;",  "&")  -- decode last so other entities aren't broken
        return s
    end

    -- Fetches the ASCII art from an asciiart.eu URL by extracting the contents
    -- of the page's <pre> block. Returns the text on success or
    -- (nil, errorMessage) on failure.
    local function fetchAsciiFromUrl(url)
        url = url and url:gsub("^%s+", ""):gsub("%s+$", "") or ""
        if url == "" then return nil, "URL is empty" end
        if not url:match("^https?://") then
            return nil, "URL must start with http:// or https://"
        end
        local okFetch, body = pcall(function() return game:HttpGet(url, true) end)
        if not okFetch or type(body) ~= "string" or #body == 0 then
            return nil, "failed to fetch URL"
        end
        local lower = body:lower()
        if lower:find("<html") or lower:find("<!doctype") then
            local pre =
                   body:match('<pre[^>]-id="art%-page%-ascii"[^>]*>(.-)</pre>')
                or body:match('<pre[^>]-class="[^"]-art%-page%-ascii[^"]-"[^>]*>(.-)</pre>')
                or body:match("<pre[^>]*>(.-)</pre>")
            if not pre then
                return nil, "page does not contain ASCII art"
            end
            body = decodeHtmlEntities(pre)
        end
        return body
    end

    if libSection then
        -- 0. How To Use button (first so it's at the very top of the panel)
        pcall(function()
            libSection:CreateButton("How To Use", function()
                local cf = Util.Imports.CoreFramework
                pcall(function() cf:Notice("Option A — Paste a URL:", 8) end)
                pcall(function() cf:Notice("1. Go to https://www.asciiart.eu/", 8) end)
                pcall(function() cf:Notice("2. Pick any ASCII art.", 8) end)
                pcall(function() cf:Notice("3. Copy the page URL and paste it into the textbox.", 8) end)
                pcall(function() cf:Notice("Option B — Paste the art directly:", 8) end)
                pcall(function() cf:Notice("Just paste any ASCII art, e.g. \\,,/(^_^)\\,,/", 8) end)
                pcall(function() cf:Notice("Then click Build ASCII Art.", 8) end)
            end)
        end)
        -- 1. URL input — fetched from asciiart.eu on build
        pcall(function()
            txtboxRef = libSection:CreateTextbox("ASCII", function(value)
                BuildMode.AsciiArt.Url = value or ""
            end, BuildMode.AsciiArt.Url, "Paste URL or ASCII art", false, false)
            if txtboxRef and txtboxRef.Instance then
                local inputBox = txtboxRef.Instance:FindFirstChild("Input")
                if inputBox then
                    inputBox.TextColor3        = Color3.fromRGB(255, 255, 255)
                    inputBox.PlaceholderColor3 = Color3.fromRGB(200, 200, 200)
                end
            end
        end)
        -- 2. Wire Type dropdown
        pcall(function()
            local wireTypes = Util.Imports.WireArt:GetWireTypes()
            local defaultWire = BuildMode.AsciiArt.WireType
            local defaultDisplay = defaultWire
            for displayName, wireId in pairs(Util.Imports.WireArt.Settings.Properties.WireConversions) do
                if wireId == defaultWire then defaultDisplay = displayName break end
            end
            libSection:CreateDropdown(function(value)
                local selected = (type(value) == "table" and value[1]) or value
                if not selected or selected == "" then return end
                local wireId = Util.Imports.WireArt.Settings.Properties.WireConversions[selected]
                if wireId then
                    BuildMode.AsciiArt.WireType = wireId
                    refreshPreviewIfActive()
                end
            end, wireTypes, defaultDisplay, false)
        end)
        -- 3. 3D toggle
        pcall(function()
            libSection:CreateToggle("3D", function(value)
                BuildMode.AsciiArt.ThreeD = value
                if thickness3DRow then thickness3DRow.Visible = value end
                refreshPreviewIfActive()
            end, BuildMode.AsciiArt.ThreeD)
        end)
        -- 4. Scale slider
        pcall(function()
            libSection:CreateSlider("Scale", function(value)
                BuildMode.AsciiArt.Scale = value
                refreshPreviewIfActive()
            end, 0.1, 1, BuildMode.AsciiArt.Scale, true)
        end)
        -- 5. 3D Thickness slider (only visible when 3D is on)
        pcall(function()
            libSection:CreateSlider("3D Thickness", function(value)
                BuildMode.AsciiArt.Thickness3D = value
                refreshPreviewIfActive()
            end, 0.1, 5, BuildMode.AsciiArt.Thickness3D, true)
            local srcFrame = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
            if srcFrame then
                for _, child in srcFrame:GetChildren() do
                    if child:IsA("GuiObject") and child:GetAttribute("SearchText") == "3D Thickness" then
                        thickness3DRow = child
                        child.Visible = BuildMode.AsciiArt.ThreeD
                        break
                    end
                end
            end
        end)
        -- 5b. Boxed Wires Only toggle (standalone — separate from Wire Art's setting)
        pcall(function()
            libSection:CreateToggle("Boxed Wires Only", function(value)
                BuildMode.AsciiArt.BoxedWiresOnly = value
            end, BuildMode.AsciiArt.BoxedWiresOnly)
        end)
        -- 6. Build button
        pcall(function()
            libSection:CreateButton("Build ASCII Art", function()
                local WireArt   = Util.Imports.WireArt
                local Placement = Util.Imports.Placement
                local cf        = Util.Imports.CoreFramework
                if not (WireArt and WireArt.BuildFromAscii) then
                    pcall(function() cf:Notice("ASCII art builder not available.", 3) end)
                    return
                end
                if WireArt:GetTextWireIndexSize(BuildMode.AsciiArt.ThreeD) == 0 then
                    pcall(function() cf:Notice("No text wire files found — press Download Text Wires first.", 5) end)
                    return
                end
                local state = BuildMode.AsciiArt
                -- Live-read the URL textbox in case FocusLost hasn't fired yet
                local liveUrl
                local roots = { section, panel, hiddenTab and hiddenTab.Container }
                for _, root in ipairs(roots) do
                    if root then
                        for _, d in ipairs(root:GetDescendants()) do
                            if d:IsA("TextBox") and d.Name == "Input"
                               and d.Parent and d.Parent:GetAttribute("SearchText") == "ASCII" then
                                liveUrl = d.Text
                                break
                            end
                        end
                    end
                    if liveUrl then break end
                end
                if liveUrl ~= nil then state.Url = liveUrl end

                if not state.Url or state.Url:gsub("%s+", "") == "" then
                    pcall(function() cf:Notice("Please paste an ASCII art URL or the art itself.", 4) end)
                    return
                end

                -- Detect: URL → fetch; otherwise treat the input as the raw
                -- ASCII art directly (e.g. \,,/(^_^)\,,/). This lets the user
                -- paste either an asciiart.eu link OR small one-liner art.
                local trimmed = state.Url:gsub("^%s+", ""):gsub("%s+$", "")
                if trimmed:match("^https?://") then
                    pcall(function() cf:Notice("Fetching ASCII art…", 2) end)
                    local fetched, fetchErr = fetchAsciiFromUrl(state.Url)
                    if not fetched then
                        pcall(function() cf:Notice("Couldn't load ASCII art — " .. tostring(fetchErr) .. ".", 5) end)
                        return
                    end
                    state.Text = fetched
                else
                    -- Raw ASCII input — use it verbatim.
                    state.Text = state.Url
                end

                local okBuild, result = pcall(function()
                    return WireArt:BuildFromAscii(state.Text, state.Scale, state.ThreeD)
                end)
                if not okBuild then
                    pcall(function() cf:Notice("Something went wrong building the ASCII art — please try again.", 5) end)
                    return
                end
                if not result then
                    pcall(function() cf:Notice("Couldn't build the ASCII art. Make sure you've downloaded the text wires first.", 6) end)
                    return
                end
                WireArt.Settings.Properties.Wires = result
                applyAsciiSettings()
                pcall(function() Placement:EnterPlacement() end)
            end)
        end)
        -- 7. Download button
        pcall(function()
            libSection:CreateButton("Download Text Wires", function()
                Util.Imports.CoreFramework:DownloadTextWires()
            end)
        end)
    end

    -- Collect borrowed rows from the hidden section.
    local rows, rowHome, rowLO, rowZ = {}, {}, {}, {}
    local srcSection = hiddenTab and hiddenTab.Container:FindFirstChildWhichIsA("Frame")
    if srcSection then
        for _, child in srcSection:GetChildren() do
            if child:IsA("GuiObject") and child.Name ~= "Title" then
