			-- Keep enforcing 0 in case something else changed it mid-lock.
			hum.WalkSpeed = 0
		elseif (not should) and locked then
			if savedSpeed then
				pcall(function() hum.WalkSpeed = savedSpeed end)
			end
			locked     = false
			savedSpeed = nil
		end
	end
end)

return Ancestor
