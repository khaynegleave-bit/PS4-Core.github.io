function Ancestor:PurchaseItem(ItemList, CustomCallback, Flag, Quantity)

	local OriginalPosition = Util.Client.Character:GetPivot().Position
	local session = {}

	local itemsToProcess = ItemList or Util.Imports.CoreFramework.Status.AutobuySelectedItems
	if not itemsToProcess or #itemsToProcess < 1 then
		return Util.Imports.CoreFramework:Notice("No items selected!")
	end

	local autobuyQuantity = Quantity or Util.Imports.CoreFramework.Status.AutobuyQuantity
	local purchasedItems = 0
	local totalItems = #itemsToProcess * autobuyQuantity
	local progressNotice
	local startedAt = os.clock()

	local function formatDuration(seconds)
		seconds = math.max(0, math.floor(seconds + 0.5))
		local minutes = math.floor(seconds / 60)
		local remainder = seconds % 60
		if minutes > 0 then
			return tostring(minutes) .. "m " .. tostring(remainder) .. "s"
		end
		return tostring(remainder) .. "s"
	end

	local function isActive()
		return Util.Imports.CoreFramework.Status._autobuySession == session
	end

	local function noticeProgress()
		if not isActive() then return end
		local remaining = math.max(totalItems - purchasedItems, 0)
		local etaText = "calculating"
		if purchasedItems > 0 then
			local elapsed = os.clock() - startedAt
			etaText = formatDuration((elapsed / purchasedItems) * remaining)
		end
		local message = "Autobuy: purchased " .. tostring(purchasedItems) .. "/" .. tostring(totalItems) .. ", " .. tostring(remaining) .. " left, ETA " .. tostring(etaText)
		if progressNotice and progressNotice:IsActive() then
			progressNotice:Set(message)
		else
			progressNotice = Util.Imports.CoreFramework:Notice(message, false)
		end
		progressNotice:SetProgress(purchasedItems / math.max(totalItems, 1))
	end
	local function EndPurchase()
		if not Util.Imports.CoreFramework.Status.Autobuying then return end
		Util.Imports.CoreFramework.Status.Autobuying = false
		Util.Imports.CoreFramework.Status._endPurchase = nil
		Util.Imports.CoreFramework.Status._autobuySession = nil
		for i = 1, autobuyQuantity do
			Util.Imports.Maid:deregister("AutobuyCompleted_" .. tostring(i))
		end
		Util.Imports.Library.Buttons[Flag]:Set(Flag)
		Util.Imports.CoreFramework:Teleport(CFrame.new(OriginalPosition))
		-- Util.Imports.CoreFramework:ToggleHumanoidStates(true)
		if progressNotice then
			progressNotice:Dismiss()
			progressNotice = nil
		end
		Util.Imports.CoreFramework:UnlockUI("Autobuy completed")
	end

	local MaxPrice = Util.Imports.CoreFramework:CalculatePrice(itemsToProcess)
	local CanAfford, NeededCash = Util.Imports.CoreFramework:CanAfford(MaxPrice)
	if not CanAfford then
		return Util.Imports.CoreFramework:Notice(NeededCash, 2)
	end

	Util.Imports.CoreFramework.Status.Autobuying = true
	Util.Imports.CoreFramework.Status._autobuySession = session
	Util.Imports.CoreFramework.Status._endPurchase = EndPurchase
	Util.Imports.CoreFramework:LockUI("Autobuy")
	noticeProgress()

	local InVehicle = Util.Client.Character.Humanoid.SeatPart ~= nil
	if InVehicle then
		Util.Client.Character.Humanoid.Jump = true
		task.wait(.1)
	end

	for index, item in itemsToProcess do
		if item == "Rukiryaxe" then
			-- The inner PurchaseItem creates its own progress notice.
			-- Dismiss the outer one immediately so it doesn't duplicate/hang.
			if progressNotice then
				progressNotice:Dismiss()
				progressNotice = nil
			end
			local prevDropTool = nil
			for i = 1, autobuyQuantity do
				if prevDropTool then Util.Imports.Maid:deregister(prevDropTool) end

				local Positions = {
					BagOfSand =  CFrame.new(318.9, 43, 1914.5),
					LightBulb = CFrame.new(322.3, 43, 1916.4),
				}
				local _rukiryRunning = true

				local DropTool = "Rukiryaxe_Awarding" .. tostring(Util.Services.HttpService:GenerateGUID(false))
				Util.Imports.Maid:register(DropTool, Util.Client.Character.ChildAdded:Connect(function(Axe)
					local Owner = Axe:WaitForChild("Owner", 5)
					local ToolName = Axe:WaitForChild("ToolName", 5)
					if not (Owner and ToolName) then return end
					if not ((Owner.Value == Util.Client) and ToolName.Value == "Rukiryaxe") then return end
					repeat Util.Imports.Maid:Wait()
						Util.Client.Character.Humanoid:UnequipTools()
						Util:FireServer("ClientInteracted", Axe, "Drop tool", CFrame.new(OriginalPosition + Vector3.new((i-1) * 4, 0, 0)))
					until not (Axe and Axe.Parent)
					
					for i = 1, 3 do
						Util:InvokeServer("TestPing")
					end
					Util.Imports.Maid:deregister(DropTool)
				end))

				local UUID = "Rukiryaxe_Awarding" .. tostring(Util.Services.HttpService:GenerateGUID(false))
				Util.Imports.Maid:register(UUID, Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Axe)
					local Owner = Axe:WaitForChild("Owner", 5)
					local ToolName = Axe:WaitForChild("ToolName", 5)
					if not (Owner and ToolName) then return end
					if not ((Owner.Value == nil or Owner.Value == Util.Client) and ToolName.Value == "Rukiryaxe") then return end
					Util.Imports.CoreFramework:TeleportObject(Axe, CFrame.new(OriginalPosition))
					Util.Imports.CoreFramework:Teleport(CFrame.new(OriginalPosition))
					repeat Util.Imports.Maid:Wait()
						Util:FireServer("ClientInteracted", Axe, "Pick up tool")
					until not (Axe and Axe.Parent)
					Util.Imports.Maid:deregister(UUID)
				end))

				local UUID2 = "Rukiryaxe_Awarding" .. tostring(Util.Services.HttpService:GenerateGUID(false))
				Util.Imports.Maid:register(UUID2, Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Model)
					local Owner = Model:WaitForChild("Owner", 5)
					local ItemName = Model:WaitForChild("ItemName", 5)
					if not (Owner and ItemName) then return end
					if not ((Owner.Value == nil or Owner.Value == Util.Client)) then return end

					if (ItemName.Value == "BagOfSand" or ItemName.Value == "LightBulb") then
						Util.Imports.CoreFramework:TeleportObject(Model, Positions[ItemName.Value])
						for i = 1, 3 do
							Util:InvokeServer("TestPing")
						end
						Model.Main.Anchored = true
						if ItemName.Value == "BagOfSand" then
							Positions.BagOfSand = CFrame.new(319.7, 43, 1914)
						end
						
						repeat Util.Imports.Maid:Wait() until not (Model and Model.Parent)
						Util.Imports.Maid:deregister(UUID2)
					end
				end))

				self:PurchaseItem({"LightBulb", "BagOfSand", "BagOfSand"}, function(Box, i)
					local ItemName = Box:WaitForChild("PurchasedBoxItemName", 5)
					if not ItemName then return end

					repeat Util.Imports.Maid:Wait()
						task.spawn(Util.FireServer, Util, "ClientInteracted", Box, "Open box")
					until not (Box and Box.Parent)
					Util.Imports.Maid:deregister("AutobuyCompleted_" .. tostring(i), true)
				end, "Purchase Item/s", 1)

				Util.Imports.CoreFramework.Status.Autobuying = true
				Util.Imports.CoreFramework.Status._autobuySession = session
				Util.Imports.CoreFramework.Status._endPurchase = EndPurchase

				repeat Util.Imports.Maid:Wait()
					if not Util.Imports.CoreFramework.Status.GUI_LOADED then break end
				until not Util.Imports.Maid:verify(DropTool)

				purchasedItems += 1
				noticeProgress()
				_rukiryRunning = false
				prevDropTool = DropTool
			end
			if prevDropTool then Util.Imports.Maid:deregister(prevDropTool) end
			continue
		end

		Util.Imports.Library.Buttons[Flag]:Set("Abort")

		for i = 1, autobuyQuantity do
			if not isActive() then return end

			local ItemInfo = ItemList and item or Util.Imports.CoreFramework:GetItemInfo(item)

			local Item
			repeat Util.Imports.Maid:Wait()
				if not Util.Imports.CoreFramework.Status.GUI_LOADED then
					EndPurchase()
					break
				end
				if not isActive() then return end
				Item = Util.Imports.CoreFramework:LocateStoreObject(tostring(ItemInfo))
			until Item

			Util.DetectedGame.Properties.IgnoredStoreItems[Item] = true

			local ItemOrigin = Item:GetPivot()
			if Util.Imports.CoreFramework:GetMagnitude(Util.Client.Character.Head, Item.PrimaryPart) > 10 then
				Util.Imports.CoreFramework:Teleport(CFrame.new(ItemOrigin.p + Vector3.new(-5, 0, 0)))
			end

			local purchaseInformation = Util.Imports.CoreFramework:GetPurchaseInformation()
			local IsCounterClear = false
			repeat Util.Imports.Maid:Wait()
				if not Util.Imports.CoreFramework.Status.GUI_LOADED then
					EndPurchase()
					break
				end
				if not isActive() then return end
				IsCounterClear = Util.Imports.CoreFramework:CanPurchase(purchaseInformation.Counter, Item.Parent)
			until IsCounterClear

			if purchaseInformation then

				Util.Imports.CoreFramework:TeleportObject(Item, CFrame.new(purchaseInformation.Counter.CFrame.p) * CFrame.new(0, purchaseInformation.Counter.Size.Y / 2, 0), ItemOrigin)
				Util.Imports.Maid:register("AutobuyCompleted_" .. tostring(i), Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Object)
					local Owner, ItemName = Object:WaitForChild("Owner", 1), Object:WaitForChild("PurchasedBoxItemName", 1)
					if Owner and Owner.Value == Util.Client and ItemName then
						if not isActive() then
							Util.Imports.Maid:deregister("AutobuyCompleted_" .. tostring(i), true)
							return
						end
						if not CustomCallback then
							Util.Imports.CoreFramework:TeleportObject(Object, CFrame.new(OriginalPosition + Vector3.new(0, 0, 5)))
							for i = 1, 5 do
								Util:InvokeServer("TestPing")
							end
							Util.Imports.Maid:deregister("AutobuyCompleted_" .. tostring(i), true)
						else
							CustomCallback(Object, i)
						end
					end
				end))

				repeat Util.Imports.Maid:Wait()
					if not Util.Imports.CoreFramework.Status.GUI_LOADED then
						EndPurchase()
						break
					end
					task.spawn(function()
						Util.Imports.CoreFramework:ConfirmPurchaseWithCashier(purchaseInformation)
					end)
				until not Util.Imports.Maid:verify("AutobuyCompleted_" .. tostring(i)) or not isActive()
				if not isActive() then return end
				purchasedItems += 1
				noticeProgress()
			end
		end
	end
	EndPurchase()
end

function Ancestor:VehiclePurchaseItem(_, ItemList, _CustomCallback, Flag)

	local OriginalPosition = Util.Client.Character:GetPivot().Position
	local session = {}

	local itemsToProcess = ItemList or Util.Imports.CoreFramework.Status.AutobuySelectedItems
	if not itemsToProcess or #itemsToProcess < 1 then
		return Util.Imports.CoreFramework:Notice("No items selected!")
	end

	local quantityNeeded = Util.Imports.CoreFramework.Status.AutobuyQuantity
	local purchasedItems = 0
	local totalItems = #itemsToProcess * quantityNeeded
	local progressNotice
	local startedAt = os.clock()

	local Vehicle
	local OldVehiclePosition
	local _vehConstraints = {}
	local function clearVehicleLock()
		for _, obj in _vehConstraints do
			pcall(function() obj:Destroy() end)
		end
		table.clear(_vehConstraints)
	end

	local function formatDuration(seconds)
		seconds = math.max(0, math.floor(seconds + 0.5))
		local minutes = math.floor(seconds / 60)
		local remainder = seconds % 60
		if minutes > 0 then
			return tostring(minutes) .. "m " .. tostring(remainder) .. "s"
		end
		return tostring(remainder) .. "s"
	end

	local function isActive()
		return Util.Imports.CoreFramework.Status._autobuySession == session
	end

	local function noticeProgress()
		if not isActive() then return end
		local remaining = math.max(totalItems - purchasedItems, 0)
		local etaText = "calculating"
		if purchasedItems > 0 then
			local elapsed = os.clock() - startedAt
			etaText = formatDuration((elapsed / purchasedItems) * remaining)
		end
		local message = "Autobuy: purchased " .. tostring(purchasedItems) .. "/" .. tostring(totalItems) .. ", " .. tostring(remaining) .. " left, ETA " .. tostring(etaText)
		if progressNotice and progressNotice:IsActive() then
			progressNotice:Set(message)
		else
			progressNotice = Util.Imports.CoreFramework:Notice(message, false)
		end
		progressNotice:SetProgress(purchasedItems / math.max(totalItems, 1))
	end

	local function EndPurchase()
		if not Util.Imports.CoreFramework.Status.Autobuying then return end
		Util.Imports.CoreFramework.Status.Autobuying = false
		Util.Imports.CoreFramework.Status._endPurchase = nil
		Util.Imports.CoreFramework.Status._autobuySession = nil
		Util.Imports.CoreFramework.Status.FlyLocked = false
		self.LastPurchasedItemType = nil
		Util.Imports.Maid:deregister("VehicleAutobuy_Listener")
		Util:FireServer("DestroyStructure", Vehicle)
		clearVehicleLock()
		Util.Imports.CoreFramework:SetHumanoidState(Enum.HumanoidStateType.Jumping, true)
		if Vehicle and Vehicle.Parent then
			pcall(function()
				 Util.Imports.CoreFramework:SetVehicleProperties(Vehicle, { CanCollide = true })
			end)
			if OldVehiclePosition then
				Vehicle:PivotTo(CFrame.new(OldVehiclePosition))
			end
		end
		Util.Imports.Library.Buttons[Flag]:Set(Flag)
		Util.Imports.CoreFramework:Teleport(CFrame.new(OriginalPosition))
		if progressNotice then
			progressNotice:Dismiss()
			progressNotice = nil
		end
		Util.Imports.CoreFramework:UnlockUI("Autobuy completed")
	end

	local MaxPrice = Util.Imports.CoreFramework:CalculatePrice(itemsToProcess)
	local CanAfford, NeededCash = Util.Imports.CoreFramework:CanAfford(MaxPrice)
	if not CanAfford then
		return Util.Imports.CoreFramework:Notice(NeededCash, 2)
	end

	Vehicle = Util.Imports.Ancestor:SelectVehicle()
	if not Vehicle then
		return Util.Imports.CoreFramework:Notice("You did not select a vehicle, aborted.")
	end
	OldVehiclePosition = Vehicle:GetPivot().Position

	Util.Imports.CoreFramework.Status.Autobuying = true
	Util.Imports.CoreFramework.Status._autobuySession = session
	Util.Imports.CoreFramework.Status._endPurchase = EndPurchase
	Util.Imports.CoreFramework.Status.FlyLocked = true
	if Util.Imports.Settings.Character.Fly then
		Util.Imports.Settings.Character.Fly = false
		Util.Imports.CoreFramework:NoFly()
	end
	Util.Imports.CoreFramework:LockUI("Autobuy")
	noticeProgress()

	Util.Imports.Ancestor:ForceSitInVehicle(Vehicle)
	repeat Util.Imports.Maid:Wait()
		if not isActive() then return end
	until Util.Client.Character.Humanoid.SeatPart ~= nil

	Util.Imports.CoreFramework:SetHumanoidState(Enum.HumanoidStateType.Jumping, false)

	for index, item in itemsToProcess do
		if not isActive() then return end

		Util.Imports.Library.Buttons[Flag]:Set("Abort")

		local itemsThisType = 0
		repeat
			if not isActive() then return end
			if not Util.Imports.CoreFramework.Status.GUI_LOADED then
				EndPurchase()
				return
			end

			local ItemInfo = ItemList and item or Util.Imports.CoreFramework:GetItemInfo(item)

			local Items
			repeat Util.Imports.Maid:Wait()
				if not Util.Imports.CoreFramework.Status.GUI_LOADED then
					EndPurchase()
					return
				end
				if not isActive() then return end
				Items = Util.Imports.CoreFramework:LocateStoreObject(tostring(ItemInfo), quantityNeeded - itemsThisType)
			until (Items and typeof(Items) == "table" and rawget(Items, 1))

			table.sort(Items, function(a, b)
				return (a:GetPivot().Position.Y) < (b:GetPivot().Position.Y)
			end)

			local VehicleCFrame, Size = Vehicle:GetBoundingBox()
			local OriginItem = rawget(Items, 1)
			local Position = item:lower():match("bed") and OriginItem:GetPivot() * CFrame.new(0, -OriginItem.Main.Size.Y / 2, -Size.X / 2) * CFrame.Angles(0, math.rad(90), 0) or OriginItem:GetPivot() * CFrame.new(0, -OriginItem.Main.Size.Y / 2, -Size.X / 2)

			if not isnetworkowner(OriginItem.PrimaryPart) or (VehicleCFrame.Position - Position.Position).Magnitude >= 25 then
				clearVehicleLock()
				local att, pos, ori = Util.Imports.CoreFramework:TeleportVehicle_Autobuy(Position, Vehicle)
				table.insert(_vehConstraints, att)
				table.insert(_vehConstraints, pos)
				table.insert(_vehConstraints, ori)
			end

			self.LastPurchasedItemType = item
			repeat Util.Imports.Maid:Wait()
				pcall(function()
					Util.Imports.CoreFramework:SetVehicleProperties(Vehicle, { CanCollide = false })
				end)
				if not isActive() then EndPurchase() return end
				if not Util.Imports.CoreFramework.Status.GUI_LOADED then EndPurchase() return end
			until isnetworkowner(OriginItem.Main)

			local PurchaseInformation = Util.Imports.CoreFramework:GetPurchaseInformation()
			repeat Util.Imports.Maid:Wait()
				if not Util.Imports.CoreFramework.Status.GUI_LOADED then EndPurchase() return end
				if not isActive() then EndPurchase() return end
			until Util.Imports.CoreFramework:CanPurchase(PurchaseInformation.Counter, OriginItem.Parent)

			if not PurchaseInformation then break end

			local TeleportList = {}
			Util.Imports.Maid:register("VehicleAutobuy_Listener", Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(Object)
				local Owner, ItemName = Object:WaitForChild("Owner", 1), Object:WaitForChild("PurchasedBoxItemName", 1)
				if Owner and Owner.Value == Util.Client and ItemName then
					if not isActive() then
						Util.Imports.Maid:deregister("VehicleAutobuy_Listener", true)
						return
					end
					table.insert(TeleportList, Object)
					if #TeleportList >= #Items then
						Util.Imports.Maid:deregister("VehicleAutobuy_Listener", true)
					end
				end
			end))

			local function GetItemRotation(model)
				local size = model.Main.Size
				local ry = size.X > size.Z and 90 or 0
				return CFrame.Angles(0, math.rad(ry), 0)
			end

			local function GetItemFootprint(model)
				local size = model.Main.Size
				return math.min(size.X, size.Z), size.Y
			end

			local Counter = PurchaseInformation.Counter
			local CounterCFrame = Counter:GetPivot()
			local CurrentCFrame = CounterCFrame * CFrame.new(-Counter.Size.X / 2, Counter.Size.Y / 2, 0)
			
			local Clone = Util:DeepCopy(Items)
			for _, Item in Clone do
				local PrimaryPart = Item.PrimaryPart or Item:FindFirstChild("Main")
				if not isnetworkowner(PrimaryPart) then table.remove(Items, table.find(Items, Item)) continue end
				local Rotation = GetItemRotation(Item)
				local Depth, Height = GetItemFootprint(Item)

				local PlaceCFrame = (CurrentCFrame * CFrame.new(Depth / 2, Height / 2, 0)) * Rotation
				Item:PivotTo(PlaceCFrame)

				CurrentCFrame = CurrentCFrame * CFrame.new(Depth, 0, 0)
			end

			repeat Util.Imports.Maid:Wait()
				if not Util.Imports.CoreFramework.Status.GUI_LOADED then EndPurchase() return end
				if not isActive() then EndPurchase() return end
				task.spawn(function()
					Util.Imports.CoreFramework:ConfirmPurchaseWithCashier(PurchaseInformation)
				end)
			until not Util.Imports.Maid:verify("VehicleAutobuy_Listener")

			if not isActive() then EndPurchase() return end

			for i, Box in TeleportList do
				local PrimaryPart = Box.PrimaryPart or Box:FindFirstChild("Main")
				if not isnetworkowner(PrimaryPart) then continue end
				Box:PivotTo(CFrame.new(OriginalPosition + Vector3.new((i - 1) * 2, 0, 5)))
			end
			Util:InvokeServer("TestPing")

			itemsThisType += #Items
			purchasedItems += #Items
			noticeProgress()
		until itemsThisType >= quantityNeeded or not isActive()
	end
	EndPurchase()
end

