function CoreFramework:LassoCanSelect(model)
    if not model:IsA("Model") then return false end
    local owner = model:FindFirstChild("Owner")
    local PrimaryPart = model.PrimaryPart or model:FindFirstChild("WoodSection")
    local Boxed = model:FindFirstChild("BoxItemName") or model:FindFirstChild("PurchasedBoxItemName")
    local Type = model:FindFirstChild("Type")

    local IsGift = Type and Type.Value == "Gift"

    if not (Boxed or IsGift) and Util.Imports.CoreFramework._boxedOnly then
        return false
    end

    if (Boxed or IsGift) and Util.Imports.CoreFramework._unboxedOnly then
        return false
    end

    if not (PrimaryPart and not PrimaryPart.Anchored) then
        return false
    end

    -- Allow selection of items owned by EITHER the local client OR the
    -- BuildMode target player (the target check is whitelist-gated upstream).
    if not (owner and owner.Value) then return false end
    if owner.Value == Util.Client then return true end
    local target = Util.Imports.BuildMode and Util.Imports.BuildMode:GetTargetPlayer()
    if target and target ~= Util.Client and owner.Value == target then return true end
    return false
end

