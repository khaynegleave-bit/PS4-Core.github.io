-- Apply the current rotation to the preview at its frozen position.
-- Used so rotate/tilt/flip work even while locked.
function Placement:ApplyRotationInPlace()
    local p       = Util.Imports.Placement
    local Preview = p.PreviewModel
    if not Preview then return end

    local pos   = Preview:GetPivot().Position
    local newCF = CFrame.new(pos) * p:GetRotationCFrame()
    Preview.PrimaryPart.CFrame = newCF

    -- Invalidate the cached bottom offset so it is recomputed next frame.
    p._BottomOffsetRotKey = nil

    local groundHit = self:GetGroundHit(Preview, pos)
    if groundHit then
        local rawBottomY = self:GetPreviewBottomY(Preview)
        local lift = groundHit.Position.Y - rawBottomY
        Preview.PrimaryPart.CFrame = newCF + Vector3.new(0, lift, 0)
        p._BottomOffset = pos.Y - rawBottomY
        local rot = p.Settings.Rotations
        p._BottomOffsetRotKey = rot.X .. "_" .. rot.Z
    end

    p._BottomOffset       = nil
    p._BottomOffsetRotKey = nil

    if IsPreviewOnProperty(Preview) then
        p._lastValidPivot = Preview:GetPivot()
