function CoreFramework:Triggerbot()
    if not Util.Imports.Settings.Aimbot.Triggerbot then return end

	if self.LockedTarget and Util.Imports.Settings.Aimbot.SilentAim then
        self:Fire()
		return
	end
    
    local Camera = workspace.CurrentCamera
    local MouseLocation = Util.Services.UserInputService:GetMouseLocation()
    local UnitRay = Camera:ViewportPointToRay(MouseLocation.X, MouseLocation.Y)
    local Character = self.TS.Characters:GetCharacter(Util.Client)
    local Weapon = Util.Imports.Ancestor:GetEquippedWeapon()
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = { Character, Weapon, workspace.Arms }
    Params.IgnoreWater = true

    local Result = workspace:Raycast(UnitRay.Origin, UnitRay.Direction * 5000, Params)
    if Result and Result.Instance then
        local Current = Result.Instance
        while Current and Current ~= workspace do
            if Current:FindFirstChild("Root") and Current:FindFirstChild("Hitbox") then
                local Player = self.TS.Characters:GetPlayerFromCharacter(Current)
                if not Player or Player == Util.Client then break end
				local Health = Current:FindFirstChild("Health", true)
				if (Health and Health.Value <= 0) then return end
                local IsFriendly = self.TS.Teams:ArePlayersFriendly(Util.Client, Player)
