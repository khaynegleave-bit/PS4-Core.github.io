				function NewColourPicker:UpdateSaturation(X, Y)
					local RelativeX = X / Saturation.AbsoluteSize.X
					local RelativeY = Y / Saturation.AbsoluteSize.Y
					self.Properties.Saturation = math.clamp(RelativeX, 0, 1)
					self.Properties.Brightness = math.clamp(1 - RelativeY, 0, 1)
					return Color3.fromHSV(self.Properties.Hue, self.Properties.Saturation, self.Properties.Brightness)
				end

				function NewColourPicker:Set(Type, Colour, TextInput)
					local UpdateFromMouse = (Colour == nil)

					if Colour then
						local _Hue, _Saturation, Value = Colour:ToHSV()
						self.Properties.Hue = _Hue
						self.Properties.Saturation = _Saturation
						self.Properties.Brightness = Value
					end

					if Type == "All" or Type == "Saturation" then
						if not UpdateFromMouse then
							TweenService:Create(Circle, TweenInfo.new(.2), {
								Position = UDim2.new(self.Properties.Saturation, 0, 1 - self.Properties.Brightness, 0)
							}):Play()
						else
							local MousePosition = Vector2.new(Mouse.X, Mouse.Y)
							local Position = Vector2.new(MousePosition.X - Saturation.AbsolutePosition.X, MousePosition.Y - Saturation.AbsolutePosition.Y)
							local X = math.clamp(Position.X, 0, Saturation.AbsoluteSize.X)
							local Y = math.clamp(Position.Y, 0, Saturation.AbsoluteSize.Y)
							Colour = NewColourPicker:UpdateSaturation(X, Y)
							Circle.Position = UDim2.new(0, X - (Circle.Size.X.Offset / 2), 0, Y - (Circle.Size.Y.Offset / 2))
						end
					end

					if Type == "All" or Type == "Hue" then
						if not UpdateFromMouse then
							TweenService:Create(Circle_2, TweenInfo.new(.2), {
								Position = UDim2.new(0.5, 0, 1 - self.Properties.Hue, -Circle_2.AbsoluteSize.Y / 2)
							}):Play()
						else
							local MousePosition = Vector2.new(Mouse.X, Mouse.Y)
							local Y = math.clamp(MousePosition.Y - Hue.AbsolutePosition.Y, 0, Hue.AbsoluteSize.Y)
							self.Properties.Hue = math.clamp(1 - (Y / Hue.AbsoluteSize.Y), 0, 1)
							Circle_2.Position = UDim2.new(0.5, 0, Y / Hue.AbsoluteSize.Y, -Circle_2.AbsoluteSize.Y / 2)
							Colour = Color3.fromHSV(self.Properties.Hue, self.Properties.Saturation, self.Properties.Brightness)
						end
						Saturation.BackgroundColor3 = Color3.fromHSV(self.Properties.Hue, 1, 1)
					end

					local Color2 = Colour or Color3.fromHSV(self.Properties.Hue, self.Properties.Saturation, self.Properties.Brightness)
					if Color2 then
						Color.BackgroundColor3 = Color2
						UpdateColorPreviewStroke(ColorStroke, Color2)
						local R, G, B = math.floor(Color2.R * 255 + 0.5), math.floor(Color2.G * 255 + 0.5), math.floor(Color2.B * 255 + 0.5)
						Input_2.Text = string.format("%d, %d, %d", R, G, B)
						Input.Text = string.format("#%02X%02X%02X", R, G, B)
						if Callback and not TextInput then
							task.spawn(Callback, Color2)
						end
					end
				end

				function NewColourPicker:SetRainbow(Enabled)
					if not SupportsRainbow then
						self.Properties.Rainbow = false
						return
					end
					self.Properties.Rainbow = Enabled and true or false
					local Theme = Library:GetTheme()
					local InnerColor = self.Properties.Rainbow and Theme.Accent or Theme.ElementDark
					local Luminance = (0.299 * InnerColor.R) + (0.587 * InnerColor.G) + (0.114 * InnerColor.B)
					local CircleColor = Luminance > 0.6 and Color3.fromRGB(0, 0, 0) or Color3.fromRGB(255, 255, 255)

					TweenService:Create(RainbowCircle, TweenInfo.new(.1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
						Position = self.Properties.Rainbow and UDim2.new(.75, 0, .5, 0) or UDim2.new(.25, 0, .5, 0),
						ImageColor3 = CircleColor
					}):Play()
					TweenService:Create(RainbowToggle, TweenInfo.new(.1, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut), {
						ImageColor3 = InnerColor
					}):Play()
					if RainbowCallback then
						task.spawn(RainbowCallback, self.Properties.Rainbow)
					end
				end

				if SupportsRainbow then
					Util.Imports.Maid:register("ColourPicker_Callback" .. tostring(HttpService:GenerateGUID(false)), RainbowToggle.Activated:Connect(function()
						NewColourPicker:SetRainbow(not NewColourPicker.Properties.Rainbow)
