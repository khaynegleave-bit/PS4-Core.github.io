        local ItemName = Object:FindFirstChild("ItemName") or Object:FindFirstChild("BoxItemName") or Object:FindFirstChild("PurchasedBoxItemName")
        if (Owner and ItemName) and Owner.Value == Player and ItemName.Value == RequestedType then
            if Boxed and not Object:FindFirstChild("PurchasedBoxItemName") then
                continue
            end
            TypeAmount += 1
        end
    end
    return TypeAmount
end

function CoreFramework:GetPlayerObject(Player, Item, Boxed)
    local PlayerModels = Util.Imports.Paths.PlayerModels:GetChildren()

    for i, Wire in Util.Imports.WireArt.Settings.Properties.PlacedWires do
        table.remove(PlayerModels, table.find(PlayerModels, Wire))
    end

    for _, Object in PlayerModels do
        local Owner = Object:FindFirstChild("Owner")
        local ItemName = not Boxed and Object:FindFirstChild("ItemName") or Object:FindFirstChild("PurchasedBoxItemName")
        if (Owner and ItemName) and Owner.Value == Player and ItemName.Value == Item then
           return Object
        end
    end
    return false
end

function CoreFramework:TeleportObject(Object, CF, OriginPivot, TeleportPlayerBack, WoodSection, OtherPart)
    local Origin = WoodSection and WoodSection.Position or Object:GetPivot().p

    local function IsNetworkOwner()
        local parts = Object:QueryDescendants("Part")
        local mains = Object:QueryDescendants("#Main")

        if #parts > 0 or #mains > 0 then
            for _, v in parts do
                v.Velocity = Vector3.zero
                if isnetworkowner(v) then return true end
            end
            for _, v in mains do
                v.Velocity = Vector3.zero
                if isnetworkowner(v) then return true end
            end
        else
            local part = Object.PrimaryPart or Object:FindFirstChildWhichIsA("BasePart", true)
            if part then
                part.Velocity = Vector3.zero
                return isnetworkowner(part)
            end
        end

        return false
    end

    if not IsNetworkOwner() then
        local Magnitude = ((OriginPivot and OriginPivot.p or Origin) - Util.Client.Character:GetPivot().p).Magnitude
        if Magnitude >= 10 then
            self:Teleport(CFrame.new((OriginPivot and OriginPivot.p or Origin)) * CFrame.new(0, 5, 5))
        end

        repeat
            Util.Services.RunService.Heartbeat:Wait()
            if not (Util.Imports.CoreFramework.Status.GUI_LOADED and Object) then
                break
            end
            Util:FireServer("ClientIsDragging", Object)
        until IsNetworkOwner()
    end

    if OtherPart then
        OtherPart:PivotTo(CF)
    else
        Object:PivotTo(CF)
    end

    if TeleportPlayerBack then
        self:Teleport(CF)
    end
end

