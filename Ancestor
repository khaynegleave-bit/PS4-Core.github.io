function CoreFramework:CanPurchase(counter, ShopItems)
    if counter.Parent == Util.Imports.Paths.Stores.FineArt then
        return true
    end
    
    local expansion = Vector3.new(18, 900, 18)
    local checkSize = counter.Size + expansion
    local checkCFrame = counter.CFrame
    
    local params = OverlapParams.new()
    params.FilterDescendantsInstances = {ShopItems}
    params.FilterType = Enum.RaycastFilterType.Include
    
    local nearbyParts = workspace:GetPartBoundsInBox(checkCFrame, checkSize, params)
    
    for _, part in nearbyParts do
        local object = part.Parent
        local Owner = object:FindFirstChild("Owner")
        if Owner and Owner.Value ~= nil and Owner.Value ~= Util.Client then
            return false
        end
    end
    return true
end

