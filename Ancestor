function CoreFramework:IsVisible(TargetPart)
    local Character = Util.Client.Character
    local Camera = workspace.CurrentCamera
    if not Character or not TargetPart then return false end

    -- Define the start and end points
    local StartPos = Camera.CFrame.Position
    local EndPos = TargetPart.Position
    local Direction = EndPos - StartPos

    -- Setup Raycast Parameters
    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = {Character, TargetPart.Parent}
    Params.IgnoreWater = true

    -- Fire the ray
    local Result = workspace:Raycast(StartPos, Direction, Params)

    -- If Result is nil, it means the ray hit nothing on the way to the target
    return Result == nil
end

