function CoreFramework:Aimbot()
	
    local AimbotKeyHeld = Util.Services.UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
	local MaxDistance = Util.Imports.Settings.Aimbot.FOVSize
	local ClosestTarget
	local Centre = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)

    -- Implement Target Stickiness
    if CoreFramework.LockedTarget and CoreFramework.LockedTarget.Parent then

        local Character = CoreFramework.LockedTarget:FindFirstAncestorOfClass("Model")
        local Health = Character.Parent:FindFirstChild("Health", true)
        local IsVisible = CoreFramework:IsVisible(CoreFramework.LockedTarget)
        
        local InFOV = false
        local Position, OnScreen = CoreFramework:W2S(CoreFramework.LockedTarget.Position)
        if OnScreen then
            local ScreenDist = (Position - Centre).Magnitude
            if ScreenDist <= Util.Imports.Settings.Aimbot.FOVSize then
                InFOV = true
            end
        end

        local IsValid = Character
            and InFOV
			and (not Health or Health.Value > 0)
            and (not Util.Imports.Settings.Aimbot.VisibilityCheck or IsVisible)
			and not self:HasShield(Character)
        if IsValid then
            ClosestTarget = CoreFramework.LockedTarget
        else
            CoreFramework.LockedTarget = nil
        end
    end

    -- If no sticky target, find closest
    if not ClosestTarget then
        for _, Player in Util.Services.Players:GetPlayers() do
            if Player == Util.Client then continue end
            local IsFriendly = self.TS.Teams:ArePlayersFriendly(Util.Client, Player)
            if IsFriendly and Util.Imports.Settings.Aimbot.TeamCheck then continue end
            
            local Character = self.TS.Characters:GetCharacter(Player)
            if not Character then continue end
			local Health = Character.Parent:FindFirstChild("Health", true)
			if (Health and Health.Value <= 0) then continue end
			if self:HasShield(Character) then return end
            
            local Part = Character:FindFirstChild(ResolveAimPart(), true)
            if not Part then continue end
            
            local IsVisible = CoreFramework:IsVisible(Part)
            if Util.Imports.Settings.Aimbot.VisibilityCheck and not IsVisible then continue end

            local Position, OnScreen = CoreFramework:W2S(Part.Position)
            if not OnScreen then continue end
            
            local Distance = (Position - Centre).Magnitude
            if Distance < MaxDistance then
                MaxDistance = Distance
                ClosestTarget = Part
            end
        end
    end

	if not ClosestTarget then
        CoreFramework.LockedTarget = nil
        return
    end
    CoreFramework.LockedTarget = ClosestTarget

	if not (Util.Imports.Settings.Aimbot.Enabled and AimbotKeyHeld) then 
        return 
    end

    local Camera = workspace.CurrentCamera
    local Smoothing = math.clamp(Util.Imports.Settings.Aimbot.Smoothing, 0.01, 1)

    if Util.Imports.Settings.Aimbot.AimbotLockMode == "Mouse Lock" then
        local sp    = CoreFramework:W2S(ClosestTarget.Position)
        local mLoc  = Util.Services.UserInputService:GetMouseLocation()
        
        local dx    = (sp.X - mLoc.X) * Smoothing
        local dy    = (sp.Y - mLoc.Y) * Smoothing
        pcall(mousemoverel, dx, dy)
    elseif Util.Imports.Settings.Aimbot.AimbotLockMode == "Camera Lock" then
        local TargetCF = CFrame.new(Camera.CFrame.Position, ClosestTarget.Position)
        Camera.CFrame = Camera.CFrame:Lerp(TargetCF, Smoothing)
    end
end

