function CoreFramework:FindAxe(RequestedAxe, Tree, ReturnBestOtherThanSpecial)
    -- Backpack can be nil when the game destroys it. Guard so callers don't
    -- error out, which would prevent the borrowed-axe fallback from running.
    local charChildren = (Util.Client.Character and Util.Client.Character:GetChildren()) or {}
    local backpack     = Util.Client:FindFirstChildOfClass("Backpack")
    local bpChildren   = (backpack and backpack:GetChildren()) or {}
    local Axes = Util:CombineTables(charChildren, bpChildren)
    for index, Axe in Axes do
        local ToolName = Axe:FindFirstChild("ToolName")
        if ToolName and ToolName.Value == RequestedAxe then
            return Axe
        end
    end

    if Util.Imports.Settings.BringTree.PickupBestAxe then

        Util.Client.Character.Humanoid:UnequipTools()

        local function DropTool()
            if #Util.Client.Backpack:GetChildren() >= 9 then
                for index, Axe in Util.Client.Backpack:GetChildren() do
                    local ToolName = Axe:FindFirstChild("ToolName")
                    if ToolName then
                        local Property = self:GetProperty(Util.Client)
                        return true, Util:FireServer("ClientInteracted", Axe, "Drop tool", Property and Property:GetPivot() * CFrame.new(0, 5, 0) or Util.Client.Character:GetPivot())
                    end
                end
            end 
            return false
        end
        
        local function find(RequestedAxe)
            local AxesOnProperty = self:GetItemListByPlayer(Util.Client, RequestedAxe)
            if #AxesOnProperty > 0 then
                local Axe = AxesOnProperty[1]
                DropTool()
                repeat task.wait(.2)
                    if not Util.Imports.CoreFramework.Status.GUI_LOADED then
                        break
                    end
                    Util:FireServer("ClientInteracted", Axe, "Pick up tool")
                until Util.Client.Character:FindFirstChild("Tool")
            
                return self:GetBestAxe(Tree, true)
            end
            return false
        end

        if not RequestedAxe then
            for index, axe in ipairs(self.Status.BestAxeList) do
                local found = find(axe.name)
                if found then
                    return found
                end
            end
        end
        return find(RequestedAxe)
    end
    return false
end

-- Returns the Player who owns `tool` based on where it's currently parented,
-- or nil if the tool isn't inside any player's Character or Backpack.
function CoreFramework:GetAxeOwner(tool)
    if not tool or not tool.Parent then return nil end
     return tool.Owner.Value
end

-- True when `tool` is still parented somewhere we can use it from: any player's
-- Character (equipped) or Backpack (unequipped). Returns false for tools that
-- were dropped to workspace, destroyed, or whose owning player left the server.
function CoreFramework:IsAxeStillValid(tool)
    if not tool or not tool.Parent then return false end
    -- Local client always counts.
    if Util.Client.Character and tool.Parent == Util.Client.Character then return true end
    local localBp = Util.Client:FindFirstChildOfClass("Backpack")
    if localBp and tool.Parent == localBp then return true end
    -- Any other player's Character or Backpack.
    for _, plr in ipairs(Util.Services.Players:GetPlayers()) do
        if plr == Util.Client then continue end
        if plr.Character and tool.Parent == plr.Character then return true end
        local bp = plr:FindFirstChildOfClass("Backpack")
        if bp and tool.Parent == bp then return true end
    end
    return false
end

-- Scans every player's Character + Backpack for axe tools and returns the
-- best-ranked (Tool, AxeData) pair. Pass `includeSelf = true` to include the
-- local client in the pool — used by the "Use Other People's Axes" toggle so
-- the absolute best axe in the server wins, even if you happen to own it.
function CoreFramework:FindBestAxeFromAnyPlayer(Tree, includeSelf)
    local best, bestData, bestEff = nil, nil, -math.huge
    local dataByName = {}
    for _, info in ipairs(self.Status.BestAxeList or {}) do
        dataByName[info.name] = info
    end

    local treeClass
    if typeof(Tree) == "string" then
        treeClass = Tree
    elseif typeof(Tree) == "Instance" then
        local tc = Tree:FindFirstChild("TreeClass")
        treeClass = tc and tc.Value or nil
    end

    for _, plr in ipairs(Util.Services.Players:GetPlayers()) do
        if plr == Util.Client and not includeSelf then continue end
        local containers = {}
        if plr.Character then table.insert(containers, plr.Character) end
        local bp = plr:FindFirstChildOfClass("Backpack")
        if bp then table.insert(containers, bp) end

        for _, container in ipairs(containers) do
            for _, tool in ipairs(container:GetChildren()) do
                local toolName = tool:FindFirstChild("ToolName")
                if not toolName then continue end
                local data = dataByName[toolName.Value]
                if not data then continue end

                -- Prefer the tree's SpecialAxe match if any, otherwise rank by
                -- raw efficiency. Tree-specific damage in `specialTrees` beats
                -- generic damage so swampy-axes-on-swampy etc. still wins.
                local eff = data.efficiency or 0
                if treeClass and data.specialTrees and data.specialTrees[treeClass] then
                    eff = eff + 1e6
                end
                if eff > bestEff then
                    bestEff  = eff
                    best     = tool
                    bestData = data
                end
            end
        end
    end

    return best, bestData
end

-- Backwards-compatible alias for callers that only want OTHER players.
function CoreFramework:FindBestAxeFromOtherPlayers(Tree)
    return self:FindBestAxeFromAnyPlayer(Tree, false)
end

function CoreFramework:GetBestAxe(Tree)
    -- When the "Use Other People's Axes" toggle is ON, ALWAYS scan every
    -- player (including ourselves) and return the single best axe across the
    -- whole server. This wins over the local-only path even if you own an axe.
    local useEveryone = Util.Imports.Settings.BringTree
        and Util.Imports.Settings.BringTree.UseOtherPlayersAxes
    if useEveryone then
        local ok, best, bestData = pcall(function()
            return self:FindBestAxeFromAnyPlayer(Tree, true)
        end)
        if ok and best and bestData then
            return best, bestData
        end
        -- Fall through to the local path if the scan errored or found nothing.
    end

    -- Borrowed-only fallback path (used when toggle is off and local has none).
    local function tryBorrowed()
        if not useEveryone then return end
        local ok, borrowed, borrowedData = pcall(function()
            return self:FindBestAxeFromOtherPlayers(Tree)
        end)
        if ok and borrowed and borrowedData then
            return borrowed, borrowedData
        end
    end

    local function fallback()
        for index, axe in ipairs(self.Status.BestAxeList) do
            local okFind, tool = pcall(self.FindAxe, self, axe.name, Tree)
            local data = self:GetAxeFromList(axe.name)
            if okFind and tool and data then
                return tool, data
            end
        end
        local okAny, axe = pcall(self.FindAxe, self, nil, Tree)
        if okAny and axe then
            local tn = axe:FindFirstChild("ToolName")
            local data = tn and self:GetAxeFromList(tn.Value)
            if data then return axe, data end
        end
        return tryBorrowed()
    end
    if Tree then
        local Axe = self.Status.SpecialAxes[Tree]
        if Axe then
            local axe, data = self:FindAxe(Axe, Tree), self:GetAxeFromList(Axe)
            if axe and data then
                return axe, data
            else
               return fallback()
            end
        else
           return fallback()
        end
    end
    return false
end

function CoreFramework:OrderAxesBestToWorst(special, planks)
    local function GetEfficiency(axe)
        local best_damage = axe.Damage or 0
        local best_cooldown = axe.SwingCooldown or math.huge
        return best_damage / best_cooldown, best_damage, best_cooldown
    end

    self.Status.BestAxeList = {}
    for name, axe in pairs(Util.Imports.AxeData) do
        local efficiency, damage, cooldown = GetEfficiency(axe)
        table.insert(self.Status.BestAxeList, {name = name:gsub("AxeClass_", ""), efficiency = efficiency, damage = damage, specialTrees = axe.SpecialTrees, cooldown = cooldown})
    end

    table.sort(self.Status.BestAxeList, function(a, b)
        return a.efficiency > b.efficiency
    end)
    return self.Status.BestAxeList
end

