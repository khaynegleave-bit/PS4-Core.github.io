function CoreFramework:ESP()
	for Player, List in CoreFramework.ESP_LIST do
		local Character = self:GetCharacter(Player)
		if not Character then
            CoreFramework:HideAll(Player)
            continue 
        end
        
        local Root = Character.Parent:FindFirstChild("Root")
        if not Root then
            CoreFramework:HideAll(Player)
            continue 
        end

		local WorldPosition = Root.Position - Vector3.new(0, Character:GetExtentsSize().Y / 2, 0)
		local Position, OnScreen = CoreFramework:W2S(WorldPosition)
		local x1,y1,x2,y2 = CoreFramework:CharacterBounds(Character.Parent)
		local function ResolveESPColor(CustomColor, Rainbow)
			if Rainbow then
				return Color3.fromHSV((tick() * 0.25) % 1, 1, 1)
			end
			if typeof(CustomColor) == "table" then
				local R = CustomColor.R or CustomColor[1] or 255
				local G = CustomColor.G or CustomColor[2] or 255
				local B = CustomColor.B or CustomColor[3] or 255
				CustomColor = Color3.fromRGB(R, G, B)
			end
			return typeof(CustomColor) == "Color3" and CustomColor
		end

		local TracerColor = ResolveESPColor(Util.Imports.Settings.ESP.TracersColor, Util.Imports.Settings.ESP.TracersRainbow)
		local BoxColor = ResolveESPColor(Util.Imports.Settings.ESP.BoxesColor, Util.Imports.Settings.ESP.BoxesRainbow)
		local SkeletonColor = ResolveESPColor(Util.Imports.Settings.ESP.SkeletonsColor, Util.Imports.Settings.ESP.SkeletonsRainbow)
		local NameColor = ResolveESPColor(Util.Imports.Settings.ESP.NamesColor, Util.Imports.Settings.ESP.NamesRainbow)

        if not (Character and x1 and Root) then
            CoreFramework:HideAll(Player)
            continue
        end

        local IsVisible = CoreFramework:IsVisible(Root)
        local FailedVisibility = Util.Imports.Settings.ESP.VisibilityCheck and not IsVisible
        local IsFriendly = Util.Imports.Settings.ESP.TeamCheck and self.TS.Teams:ArePlayersFriendly(Util.Client, Player)
        local Disabled = not Util.Imports.Settings.ESP.Enabled

        if FailedVisibility or IsFriendly or Disabled then
            CoreFramework:HideAll(Player)
            continue
        end

		local Draw = OnScreen
        
		if Util.Imports.Settings.ESP.Tracers then
			CoreFramework:DrawTracer(List.Lines[1], x1, y1, x2, y2, TracerColor, Draw)
		else
			CoreFramework:Hide(List.Lines)
		end

		if Util.Imports.Settings.ESP.Boxes then
			CoreFramework:DrawBox(List.BoxLines, x1, y1, x2, y2, BoxColor, Draw)
		else
			CoreFramework:Hide(List.BoxLines)
		end

		if Util.Imports.Settings.ESP.Skeletons then
			CoreFramework:DrawSkeleton(List.SkeletonLines, Character, "BB", SkeletonColor)
		else
			CoreFramework:Hide(List.SkeletonLines)
		end

		if Util.Imports.Settings.ESP.Names then
			CoreFramework:DrawName(List.Name, Player.DisplayName, NameColor, x1, x2, y1)
		else
			CoreFramework:Hide({ List.Name })
		end
	end
end

