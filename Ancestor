local UpdateNotifPosition  -- forward declaration so InitNotifier can reference it

function CoreFramework:InitNotifier()
    local LibUI = Util.Imports.Library.UI
    local MainFrame = Util.Imports.Library.MainFrame
    local parent = MainFrame or LibUI
    local existing = parent:FindFirstChild("NotifContainer")
    local oldExisting = LibUI and LibUI:FindFirstChild("NotifContainer")
    if existing then existing:Destroy() end
    if oldExisting and oldExisting ~= existing then oldExisting:Destroy() end

    local Container = Instance.new("Frame")
    Container.Name = "NotifContainer"
    Container.AnchorPoint = Vector2.new(0, 0)
    Container.Size = UDim2.new(0, 240, 0, 600)
    Container.Position = UDim2.new(1, 6, 0, 0)
    Container.BackgroundTransparency = 1
    Container.ClipsDescendants = false
    Container.ZIndex = 200
    Container.Parent = parent
    if MainFrame then
        MainFrame.ClipsDescendants = false
    end

    local Layout = Instance.new("UIListLayout")
    Layout.Name = "NotifLayout"
    Layout.FillDirection = Enum.FillDirection.Vertical
    Layout.VerticalAlignment = Enum.VerticalAlignment.Top
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Padding = UDim.new(0, 6)
    Layout.Parent = Container

    self._notifContainer = Container
    self._notifCount = 0

    local MainFrame = Util.Imports.Library and Util.Imports.Library.MainFrame
    if MainFrame then
        MainFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
            UpdateNotifPosition(Container)
        end)
    end
end

UpdateNotifPosition = function(Container)
    if not (Container and Container.Parent) then return end

    local CF = Util.Imports.CoreFramework
    local host = CF and CF._externalNotifHost
    local Layout = Container:FindFirstChild("NotifLayout")

    -- External host (e.g. build mode) — anchor at bottom-right of the screen.
    if host and host.Parent then
        if Container.Parent ~= host then
            Container.Parent = host
        end
        Container.AnchorPoint = Vector2.new(1, 1)
        Container.Position    = UDim2.new(1, -16, 1, -16)
        if Layout then Layout.VerticalAlignment = Enum.VerticalAlignment.Bottom end
        return
    end

    -- Flip to left when the right side of the window + notification would overflow the screen.
    local LibUI = Util.Imports.Library.UI
    local MainFrame = Util.Imports.Library.MainFrame
    if not (LibUI and MainFrame) then return end
    if Container.Parent ~= MainFrame then
        Container.Parent = MainFrame
    end

    local NOTIF_WIDTH   = 240
    local NOTIF_GAP     = 6
    local viewportWidth = workspace.CurrentCamera.ViewportSize.X
    local rightEdge     = MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X + NOTIF_GAP + NOTIF_WIDTH
    if rightEdge > viewportWidth then
        Container.AnchorPoint = Vector2.new(1, 0)
        Container.Position    = UDim2.new(0, -NOTIF_GAP, 0, 0)
    else
        Container.AnchorPoint = Vector2.new(0, 0)
        Container.Position    = UDim2.new(1, NOTIF_GAP, 0, 0)
    end
    if Layout then Layout.VerticalAlignment = Enum.VerticalAlignment.Top end
end

-- Public API for redirecting notifications to a different ScreenGui
-- (e.g. BuildMode's toolbar gui). Pass nil to revert to the default placement.
function CoreFramework:SetNotifHost(gui)
    self._externalNotifHost = gui
    if self._notifContainer and self._notifContainer.Parent then
        UpdateNotifPosition(self._notifContainer)
    end
end

function CoreFramework:Notice(Text, Duration)
    local notifier = self
    if not (self._notifContainer and self._notifContainer.Parent) then
        self:InitNotifier()
    end

    UpdateNotifPosition(self._notifContainer)

    Text = tostring(Text or "")

    local Theme = Util.Imports.Library:GetTheme()
    local TS = Util.Services.TweenService
    local TI_In  = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local TI_Out = TweenInfo.new(0.3,  Enum.EasingStyle.Quad, Enum.EasingDirection.In)

    self._notifCount += 1

    local Wrapper = Instance.new("Frame")
    Wrapper.Name = "Notif"
    Wrapper.BackgroundTransparency = 1
    Wrapper.Size = UDim2.new(1, 0, 0, 0)
    Wrapper.AutomaticSize = Enum.AutomaticSize.Y
    Wrapper.ClipsDescendants = false
    Wrapper.LayoutOrder = self._notifCount
    Wrapper.ZIndex = 200
    Wrapper.Parent = self._notifContainer

    local Card = Instance.new("Frame")
    Card.Name = "Card"
    Card.BackgroundColor3 = Theme.Section
    Card.BackgroundTransparency = 1
    Card.BorderSizePixel = 0
    Card.Size = UDim2.new(1, -2, 0, 0)
    Card.AutomaticSize = Enum.AutomaticSize.Y
    Card.Position = UDim2.new(0.08, 0, 0, 0)
    Card.ZIndex = 201
    Card.Parent = Wrapper

    local CardCorner = Instance.new("UICorner")
    CardCorner.CornerRadius = UDim.new(0, 8)
    CardCorner.Parent = Card

    local CardPadding = Instance.new("UIPadding")
    CardPadding.PaddingTop = UDim.new(0, 11)
    CardPadding.PaddingBottom = UDim.new(0, 11)
    CardPadding.PaddingLeft = UDim.new(0, 14)
    CardPadding.PaddingRight = UDim.new(0, 14)
    CardPadding.Parent = Card

    local CardLayout = Instance.new("UIListLayout")
    CardLayout.FillDirection = Enum.FillDirection.Vertical
    CardLayout.HorizontalAlignment = Enum.HorizontalAlignment.Left
    CardLayout.VerticalAlignment = Enum.VerticalAlignment.Top
    CardLayout.SortOrder = Enum.SortOrder.LayoutOrder
    CardLayout.Padding = UDim.new(0, 8)
    CardLayout.Parent = Card

    local Label = Instance.new("TextLabel")
    Label.BackgroundTransparency = 1
    Label.Size = UDim2.new(1, 0, 0, 0)
    Label.AutomaticSize = Enum.AutomaticSize.Y
    Label.Text = Text
    Label.TextColor3 = Theme.Text
    Label.TextTransparency = 1
    Label.TextSize = 16
    Label.Font = Enum.Font.SourceSansBold
    Label.TextWrapped = true
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.TextYAlignment = Enum.TextYAlignment.Center
    Label.ZIndex = 203
    Label.LayoutOrder = 1
    Label.Parent = Card

    local ProgressBG = Instance.new("Frame")
    ProgressBG.AnchorPoint = Vector2.new(0, 0)
    ProgressBG.BackgroundColor3 = Theme.ElementDark
    ProgressBG.BackgroundTransparency = 1
    ProgressBG.BorderSizePixel = 0
    ProgressBG.Size = UDim2.new(1, 0, 0, 4)
    ProgressBG.ZIndex = 202
    ProgressBG.LayoutOrder = 2
    ProgressBG.Parent = Card

    local ProgressBGCorner = Instance.new("UICorner")
    ProgressBGCorner.CornerRadius = UDim.new(0, 6)
    ProgressBGCorner.Parent = ProgressBG

    local Bar = Instance.new("Frame")
    Bar.BackgroundColor3 = Theme.Accent
    Bar.BackgroundTransparency = 1
    Bar.BorderSizePixel = 0
    Bar.Size = UDim2.new(1, 0, 1, 0)
    Bar.ZIndex = 203
    Bar.Parent = ProgressBG

    local BarCorner = Instance.new("UICorner")
    BarCorner.CornerRadius = UDim.new(0, 6)
    BarCorner.Parent = Bar

    local persistent = Duration == false
    if not persistent then Duration = Duration or 4 end
    if persistent then
        Label.TextXAlignment = Enum.TextXAlignment.Center
        Label.TextYAlignment = Enum.TextYAlignment.Center
        CardPadding.PaddingLeft = UDim.new(0, 10)
        CardPadding.PaddingRight = UDim.new(0, 10)
        CardLayout.Padding = UDim.new(0, 0)
        ProgressBG.Visible = false
    end

    local lib = Util.Imports.Library
    if lib and lib.RegisterThemeObject then
        lib:RegisterThemeObject(Card,       "BackgroundColor3", "Section")
        lib:RegisterThemeObject(Label,      "TextColor3",       "Text")
        lib:RegisterThemeObject(ProgressBG, "BackgroundColor3", "ElementDark")
        lib:RegisterThemeObject(Bar,        "BackgroundColor3", "Accent")
    end

    local handle = {}
    local dismissed = false
    function handle:Dismiss()
        if dismissed then return end
        dismissed = true
        if not (Wrapper and Wrapper.Parent) then return end
        TS:Create(Card, TI_Out, { BackgroundTransparency = 1, Position = UDim2.new(0.08, 0, 0, 0) }):Play()
        TS:Create(Label, TI_Out, { TextTransparency = 1 }):Play()
        TS:Create(ProgressBG, TI_Out, { BackgroundTransparency = 1 }):Play()
        TS:Create(Bar, TI_Out, { BackgroundTransparency = 1 }):Play()
        task.delay(0.35, function()
            if Wrapper and Wrapper.Parent then Wrapper:Destroy() end
        end)
    end

    function handle:Set(newText)
        if dismissed or not (Label and Label.Parent) then return end
        Label.Text = tostring(newText or "")
        if notifier._notifContainer and notifier._notifContainer.Parent then
            UpdateNotifPosition(notifier._notifContainer)
        end
    end

    function handle:IsActive()
        return not dismissed and Wrapper and Wrapper.Parent ~= nil
    end

    function handle:SetProgress(fraction)
        if dismissed or not (Bar and Bar.Parent) then return end
        fraction = math.clamp(fraction or 0, 0, 1)
        if not ProgressBG.Visible then
            ProgressBG.Visible = true
            Bar.Size = UDim2.new(0, 0, 1, 0)
            CardLayout.Padding = UDim.new(0, 8)
            TS:Create(ProgressBG, TI_In, { BackgroundTransparency = 0.5 }):Play()
            TS:Create(Bar, TI_In, { BackgroundTransparency = 0 }):Play()
        end
        TS:Create(Bar, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(fraction, 0, 1, 0) }):Play()
    end

    local dismiss = function()
        handle:Dismiss()
    end

    -- Slide + fade in
    TS:Create(Card, TI_In, { BackgroundTransparency = 0.02, Position = UDim2.new(0, 0, 0, 0) }):Play()
    TS:Create(Label, TI_In, { TextTransparency = 0 }):Play()

    if not persistent then
        TS:Create(ProgressBG, TI_In, { BackgroundTransparency = 0.5 }):Play()
        TS:Create(Bar, TI_In, { BackgroundTransparency = 0 }):Play()
        Bar.Size = UDim2.new(1, 0, 1, 0)
        TS:Create(Bar, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 1, 0) }):Play()
        task.delay(Duration + 0.25, dismiss)
    else
        ProgressBG.BackgroundTransparency = 1
        Bar.BackgroundTransparency = 1
    end

    return setmetatable(handle, {
        __call = function(self)
            self:Dismiss()
        end
    })
end

