function BuildMode:Show(callbacks, layoutOverride)
    self:Destroy()
    BuildMode._active = true
    pcall(function()
        game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
    end)

    local activeLayout = layoutOverride or LAYOUT
    local T   = Util.Imports.Library:GetTheme()
    local bW  = barWidth(activeLayout)
    local offY = BAR_H + 30

    gui = Instance.new("ScreenGui")
    gui.Name           = "AncestorBuildMode"
    gui.ResetOnSpawn   = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder   = 25
    gui.IgnoreGuiInset = true
    pcall(function() gui.Parent = game:GetService("CoreGui") end)

    local uiScale = Instance.new("UIScale", gui)
    local camera  = workspace.CurrentCamera
    local function updateScale()
        local vp = camera.ViewportSize
        -- 1920×1080 reference (1× there). Scale down proportionally on smaller
        -- screens but keep a slight floor so the bar never gets unreadably tiny.
        local s = math.min(vp.X / 1920, vp.Y / 1080)
        uiScale.Scale = math.clamp(s, 0.6, 1)
        _currentScale = uiScale.Scale
    end
    updateScale()
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

    -- Redirect notifications to our gui so they stay visible while the main UI is hidden.
    pcall(function() Util.Imports.CoreFramework:SetNotifHost(gui) end)

    bar = Instance.new("Frame")
    bar.Name                  = "Bar"
    bar.BackgroundColor3      = T.Section
    bar.BorderSizePixel       = 0
    bar.AnchorPoint           = Vector2.new(0.5, 1)
    bar.Position              = UDim2.new(0.5, 0, 1, offY)
    bar.Size                  = UDim2.new(0, bW, 0, BAR_H)
    Instance.new("UICorner", bar).CornerRadius = BAR_RADIUS
    bar.Parent = gui


    -- Shared tooltip (one instance, repositioned per button)
    local tip, tipLabel = makeTooltip(bar, T)

    -- Reset active panel tracker for this new toolbar session
    _activeHide = nil

    -- Settings panel (created before buttons so buttons render on top)
    local settingsPanel, showSettings, hideSettings = makeSettingsPanel(bar, T)

    -- Wire art settings panel (gear button in wire art mode)
    local waPanel, waShow, waHide, waRestore = makeWireArtPanel(gui, T)
    BuildMode._waRestore = waRestore

    -- Wire art controls panel (new dedicated wire art button)
    local wcPanel, wcShow, wcHide, wcRestore = makeWireArtControlsPanel(gui, T)
    BuildMode._wcRestore = wcRestore

    -- Text to Wire panel (placeholder)
    local ttwPanel, ttwShow, ttwHide, ttwRestore = makeTextToWirePanel(gui, T)
    BuildMode._ttwRestore = ttwRestore

    -- ASCII Art panel
    local asciiPanel, asciiShow, asciiHide, asciiRestore = makeAsciiArtPanel(gui, T)
    BuildMode._asciiRestore = asciiRestore

    -- Image Art panel
    local imgPanel, imgShow, imgHide, imgRestore = makeImageArtPanel(gui, T)
    BuildMode._imgRestore = imgRestore

    -- Item stacker panel
    local stackPanel, stackShow, stackHide, stackRestore = makeStackPanel(gui, T)
    BuildMode._stackRestore = stackRestore

    -- Selection tools panel
    local selectPanel, selectShow, selectHide, selectRestore = makeSelectPanel(gui, T)
    BuildMode._selectRestore = selectRestore

    -- Shared abort: fully tears down everything — delete/unbox tasks, wire art
    -- placement, stacker preview, stacker queue, and the lasso selection. Always
    -- leaves the user with a clean slate.
    local cf = Util.Imports.CoreFramework
    local function doAbort()
        -- Snapshot what's actually active BEFORE we tear everything down, so
        -- the user-facing notice can be specific ("preview cancelled" vs
        -- "build aborted") instead of a generic catch-all.
        local hadPreview     = false
        pcall(function() hadPreview = Util.Imports.Placement:HasPreview() end)
        local hadBuild       = cf.Status.WireArtBuilding == true
        local hadOps         = _currentOpsTask ~= nil
        if _currentOpsTask then
            task.cancel(_currentOpsTask)
            _currentOpsTask = nil
        end
        pcall(function() Util.Imports.Placement:ExitPlacement() end)
        -- Kill any in-progress wire art build session (wire-by-wire placement
        -- after Confirm). EndWireArt(true) already shows its own "placed X/Y,
        -- Z left" notice — we suppress our generic one in that case.
        pcall(function()
            local endWireArt = cf.Status._endWireArt
            if endWireArt then endWireArt(true) end
        end)
        -- Kill any queue FIRST so EndPlacement doesn't try to auto-advance to the
        -- next group (which would repopulate the selection we're about to clear).
        pcall(function() cf:ClearStackerQueue() end)
        pcall(function()
            local endFn = cf.Status._endLassoPlacement
            if endFn then endFn() end
        end)
        pcall(function() cf:LassoClearPreview() end)
        pcall(function() cf:LassoClearSelection() end)

        -- User-facing confirmation. Skip if EndWireArt already showed its own
        -- "placed X/Y" notice (hadBuild), otherwise pick the most relevant
        -- message based on what was actually torn down.
        if not hadBuild then
            local msg
            if hadPreview then
                msg = "Wire Art preview cancelled."
            elseif hadOps then
                msg = "Task aborted."
            else
                msg = "Aborted."
            end
            pcall(function() cf:Notice(msg, 3) end)
        end
    end

    -- Build contents
    local x = PAD_X
    for i, item in ipairs(activeLayout) do
        if item.sep then
            local sep = Instance.new("Frame")
            sep.BackgroundColor3       = T.Strip
            sep.BackgroundTransparency = 0.5
            sep.BorderSizePixel        = 0
            sep.Size                   = UDim2.new(0, SEP_W, 0, math.floor(BTN * 0.5))
            sep.Position               = UDim2.new(0, x + SEP_GAP, 0.5, -math.floor(BTN * 0.25))
            sep.Parent = bar
            x += SEP_W + SEP_GAP * 2
        else
            local btn = makeBtn(bar, x, item, T, callbacks, tip, tipLabel)
            local function wireToggle(showFn, hideFn)
                return function()
                    if _activeHide == hideFn then hideFn() else showFn() end
                end
            end
            if item.id == "settings" then
                bar:FindFirstChild("settings").Activated:Connect(wireToggle(showSettings, hideSettings))
            elseif item.id == "waSettings" then
                bar:FindFirstChild("waSettings").Activated:Connect(wireToggle(waShow, waHide))
            elseif item.id == "wireArt" then
                bar:FindFirstChild("wireArt").Activated:Connect(wireToggle(wcShow, wcHide))
            elseif item.id == "textToWire" then
                bar:FindFirstChild("textToWire").Activated:Connect(wireToggle(ttwShow, ttwHide))
            elseif item.id == "asciiArt" then
                bar:FindFirstChild("asciiArt").Activated:Connect(wireToggle(asciiShow, asciiHide))
            elseif item.id == "imageArt" then
                bar:FindFirstChild("imageArt").Activated:Connect(wireToggle(imgShow, imgHide))
            elseif item.id == "stack" then
                bar:FindFirstChild("stack").Activated:Connect(wireToggle(stackShow, stackHide))
            elseif item.id == "select" then
                bar:FindFirstChild("select").Activated:Connect(wireToggle(selectShow, selectHide))
            elseif item.id == "abort" then
                bar:FindFirstChild("abort").Activated:Connect(doAbort)
            elseif item.id == "lockPos" then
                -- Toggle lock on whichever preview is active (wire art OR stacker).
                local lockBtn = bar:FindFirstChild("lockPos")
                local lockIcon = lockBtn and lockBtn:FindFirstChild("Icon")
                local function refreshLockVisual()
                    if not lockIcon then return end
                    local Placement     = Util.Imports.Placement
                    local CoreFramework = Util.Imports.CoreFramework
                    local locked = (Placement.IsLocked and Placement:IsLocked())
                        or (CoreFramework.LassoIsLocked and CoreFramework:LassoIsLocked())
                    lockIcon.Image = locked and ICONS.lockPosLocked or ICONS.lockPos
                end
                lockBtn.Activated:Connect(function()
                    local Placement     = Util.Imports.Placement
                    local CoreFramework = Util.Imports.CoreFramework
                    if Placement.HasPreview and Placement:HasPreview() then
                        if Placement:IsLocked() then Placement:UnlockPreview()
                        else Placement:LockPreview() end
                    elseif CoreFramework.LassoHasPreview and CoreFramework:LassoHasPreview() then
                        if CoreFramework:LassoIsLocked() then CoreFramework:LassoUnlockPreview()
                        else CoreFramework:LassoLockPreview() end
                    end
                    refreshLockVisual()
                end)
            elseif item.id == "place" then
                -- Commit the active preview (wire art OR stacker).
                bar:FindFirstChild("place").Activated:Connect(function()
                    local Placement     = Util.Imports.Placement
                    local CoreFramework = Util.Imports.CoreFramework
                    if Placement.HasPreview and Placement:HasPreview() then
                        Placement:ConfirmPlacement()
                    elseif CoreFramework.LassoHasPreview and CoreFramework:LassoHasPreview() then
                        CoreFramework:LassoBeginPlacement()
                    end
                    -- Also close the stacker panel if it was open
                    if _activeHide == stackHide then stackHide() end
                end)
            end
            x += BTN + GAP
        end
    end

    -- Apply starting grid state
    local _gs = GRID_STATES[BuildMode.GridState]
    pcall(function() Util.Imports.Placement.Settings.GridSize = _gs.size end)
    task.spawn(function() applyGrid(_gs.size, _gs.studs) end)

    -- ── Keybind dispatch ──────────────────────────────────────────────────────
    -- BuildMode:OnKeybind(action, onPress, onRelease?)
    --   onPress(active, selection)  — fires on InputBegan; active toggles each press
    --   onRelease(selection)        — fires on InputEnded (optional, for hold-style binds)
    local keybindHandlers = {}  -- action → { onPress, onRelease, active }

    function BuildMode:OnKeybind(action, onPress, onRelease)
        keybindHandlers[action] = { onPress = onPress, onRelease = onRelease, active = false }
    end

    local UIS = game:GetService("UserInputService")

    local function selection()
        return Util.Imports.CoreFramework.LassoSelectedItems or {}
    end

    local connBegan = UIS.InputBegan:Connect(function(input, processed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if activeCapture then return end

        for _, kb in ipairs(BuildMode.Keybinds) do
            if input.KeyCode == kb.keyCode then
                -- Place must NEVER fire while a TextBox / other UI is processing
                -- the input (otherwise pressing "E" while typing in the text-to-wire
                -- textbox would commit placement).
                if kb.action == "Place" and processed then break end
                local h = keybindHandlers[kb.action]
                if h and h.onPress then
                    if h.onRelease then
                        -- hold-style: just fire, no toggle
                        h.onPress(true, selection())
                    else
                        -- toggle-style: flip active each press
                        h.active = not h.active
                        h.onPress(h.active, selection())
                    end
                end
                break
            end
        end
    end)

    local connEnded = UIS.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        for _, kb in ipairs(BuildMode.Keybinds) do
            if input.KeyCode == kb.keyCode then
                local h = keybindHandlers[kb.action]
                if h and h.onRelease then
                    h.onRelease(selection())
                end
                break
            end
        end
    end)

    -- Close the stacker panel when Place Items is activated
    local placeItemsBtn = Util.Imports.Library.Buttons["Place Items"]
    local placeConn = placeItemsBtn and placeItemsBtn.Instance and
        placeItemsBtn.Instance.Activated:Connect(function()
            if _activeHide == stackHide then stackHide() end
        end)

    -- Abort gets its own direct connection so it fires regardless of activeCapture state.
    local abortConn = UIS.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        for _, kb in ipairs(BuildMode.Keybinds) do
            if kb.action == "Abort" and input.KeyCode == kb.keyCode then
                doAbort()
                break
            end
        end
    end)

    -- Lock Position also gets its own direct connection — bypasses the keybind
    -- dispatch guards (incl. `processed`, since L is sometimes eaten by other
    -- UIs) so it always fires regardless of capture/dispatch state.
    local lockConn = UIS.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        for _, kb in ipairs(BuildMode.Keybinds) do
            if kb.action == "Lock Position" and input.KeyCode == kb.keyCode then
                local Placement     = Util.Imports.Placement
                local CoreFramework = Util.Imports.CoreFramework
                -- Toggle whichever preview is active. Try both so a stale
                -- HasPreview on the wrong module doesn't swallow the press.
                local toggled = false
                if Placement.HasPreview and Placement:HasPreview() then
                    if Placement:IsLocked() then Placement:UnlockPreview()
                    else Placement:LockPreview() end
                    toggled = true
                end
                if not toggled and CoreFramework.LassoHasPreview and CoreFramework:LassoHasPreview() then
                    if CoreFramework:LassoIsLocked() then CoreFramework:LassoUnlockPreview()
                    else CoreFramework:LassoLockPreview() end
                end
                pcall(function() BuildMode:RefreshLockVisual() end)
                break
            end
        end
    end)

    BuildMode._keybindConns = { connBegan, connEnded, placeConn, abortConn, lockConn }

    -- Property-loss / target-leaves watchdog.
    --
    -- Behaviour:
    --   • LOCAL CLIENT loses property → exit build mode entirely.
    --   • TARGET player leaves the server      → reset target to self.
    --   • TARGET player loses their property   → reset target to self.
    -- Each branch latches once-per-event so we don't spam notices.
    local clientLossFired = false
    local propWatchConn
    propWatchConn = Util.Services.RunService.Heartbeat:Connect(function()
        if clientLossFired or not BuildMode._active then return end
        local cf = Util.Imports.CoreFramework

        -- Local client property check — fatal for build mode.
        if not cf:GetProperty(Util.Client) then
            clientLossFired = true
            pcall(function() propWatchConn:Disconnect() end)
            local cancel = callbacks and callbacks.cancel
            if cancel then pcall(cancel) else pcall(function() BuildMode:Hide() end) end
            cf:Notice("Build mode exited — you no longer own a property.", 4)
            return
        end

        -- Target validity — non-fatal: reset target to self, keep build mode.
        local target = BuildMode.TargetPlayer
        if target and target ~= Util.Client then
            local leftServer = (not target.Parent)
            local noProperty = (not leftServer) and (not cf:GetProperty(target))
            if leftServer or noProperty then
                local name = target.Name
                BuildMode.TargetPlayer = nil
                pcall(function() BuildMode:ResetTargetDropdowns() end)
                pcall(function() BuildMode:RebuildGrid() end)
                pcall(doAbort)
                cf:Notice(leftServer
                    and "Target reset — " .. tostring(name) .. " left the server."
                    or  "Target reset — " .. tostring(name) .. " no longer owns a property.",
                    4
                )
            end
        end
    end)
    table.insert(BuildMode._keybindConns, propWatchConn)

    -- Reload watchdog: abort active placement if EITHER the local client OR
    -- the current target player respawns (CharacterRemoving fires on reset,
    -- death, or kick). Target side is rebound whenever TargetPlayer changes.
    local function abortFromReload(name)
        pcall(doAbort)
        pcall(function()
            Util.Imports.CoreFramework:Notice("Placement aborted — " .. tostring(name) .. " reloaded.", 4)
        end)
    end

    local selfReloadConn = Util.Client.CharacterRemoving:Connect(function()
        if BuildMode._active then abortFromReload("you") end
    end)
    table.insert(BuildMode._keybindConns, selfReloadConn)

    local targetReloadConn
    local lastTarget
    local targetWatchConn = Util.Services.RunService.Heartbeat:Connect(function()
        if not BuildMode._active then return end
        local cur = BuildMode.TargetPlayer
        if cur == lastTarget then return end
        if targetReloadConn then
            pcall(function() targetReloadConn:Disconnect() end)
            targetReloadConn = nil
        end
        lastTarget = cur
        if cur and cur ~= Util.Client and cur.Parent then
            targetReloadConn = cur.CharacterRemoving:Connect(function()
                if BuildMode._active then abortFromReload(cur.Name) end
            end)
        end
    end)
    table.insert(BuildMode._keybindConns, targetWatchConn)
    -- Make sure the target-side reload connection is torn down on Destroy too.
    table.insert(BuildMode._keybindConns, {
        Disconnect = function()
            if targetReloadConn then
                pcall(function() targetReloadConn:Disconnect() end)
                targetReloadConn = nil
            end
        end,
    })

    -- Whitelist watchdog: every 5s revalidate the current target player. If
    -- they revoke our permissions, prune their items from the lasso selection,
    -- reset the target to self, and notify.
    task.spawn(function()
        while BuildMode._active do
            local target = BuildMode.TargetPlayer  -- only check if a real target is set
            if target and target.Parent and target ~= Util.Client then
                if not BuildMode:IsWhitelistedFor(target) then
                    BuildMode.TargetPlayer = nil
                    pcall(function() BuildMode:ResetTargetDropdowns() end)
                    pcall(function() BuildMode:RebuildGrid() end)
                    -- Abort any in-progress placement (wire art preview, stacker
                    -- preview, sorting, queue) before pruning the selection.
                    pcall(doAbort)
                    -- Prune anything owned by the now-unauthorized player.
                    local cf       = Util.Imports.CoreFramework
                    local selected = cf.Status.LassoSelectedItems
                    if selected and #selected > 0 then
                        local toRemove = {}
                        for _, m in ipairs(selected) do
                            local own = m and m:FindFirstChild("Owner")
                            if own and own.Value == target then
                                table.insert(toRemove, m)
                            end
                        end
                        for _, m in ipairs(toRemove) do
                            pcall(function() cf:LassoDeselectItem(m) end)
                        end
                    end
                    pcall(function()
                        cf:Notice(tostring(target.Name) .. " has revoked your whitelist — placement aborted.", 5)
                    end)
                end
            end
            task.wait(5)
        end
    end)

    -- Lasso: hold to select, release to stop — disabled in wire art mode
    if activeLayout ~= BuildMode.GridLayout then
        BuildMode:OnKeybind("Lasso Select",
            function(active, sel)
                Util.Imports.CoreFramework:LassoStart(nil)
            end,
            function(sel)
                Util.Imports.CoreFramework:LassoStop()
            end
        )
    end

    -- Delete: destroy every item in the current lasso selection
    BuildMode:OnKeybind("Delete", function(active)
        if _currentOpsTask then task.cancel(_currentOpsTask) end
        local items = table.clone(Util.Imports.CoreFramework.Status.LassoSelectedItems)
        _currentOpsTask = task.spawn(function()
            for _, item in ipairs(items) do
                local Main = item:FindFirstChild("Main")
                if not Main then continue end
                while Main and Main.Parent do task.wait() Util:FireServer("DestroyStructure", item) end
                pcall(function() Util.Imports.CoreFramework:LassoDeselectItem(item) end)
            end
            _currentOpsTask = nil
        end)
    end)

    BuildMode:OnKeybind("Unbox", function(active)
        if _currentOpsTask then task.cancel(_currentOpsTask) end
        local items = table.clone(Util.Imports.CoreFramework.Status.LassoSelectedItems)
        _currentOpsTask = task.spawn(function()
            for _, item in ipairs(items) do
                local Main = item:FindFirstChild("Main")
                local BoxItemName = item:FindFirstChild("BoxItemName") or item:FindFirstChild("PurchasedBoxItemName")
                local Type = item:FindFirstChild("Type")
                if not (Main and BoxItemName and Type) then continue end
                if not (Type.Value == "Structure" or Type.Value == "Furniture") and not Main.Anchored then
                    repeat
                        task.wait()
                        if not (Main and Main.Parent) then break end
                        Util:FireServer("ClientInteracted", item, "Open box")
                    until not (Main and Main.Parent) or not Main.CanCollide
                    pcall(function() Util.Imports.CoreFramework:LassoDeselectItem(item) end)
                end
            end
            _currentOpsTask = nil
        end)
    end)

    BuildMode:OnKeybind("Place", function()
        local Placement     = Util.Imports.Placement
        local CoreFramework = Util.Imports.CoreFramework
        if Placement.HasPreview and Placement:HasPreview() then
            Placement:ConfirmPlacement()
        elseif CoreFramework.LassoHasPreview and CoreFramework:LassoHasPreview() then
            CoreFramework:LassoBeginPlacement()
        end
        if _activeHide == stackHide then stackHide() end
    end)

    -- ── Wire toolbar buttons → keybind handlers ───────────────────────────────
    -- Maps toolbar button id → keybind action name.
    -- Hold-style handlers (onRelease present) are toggled by the button;
    -- toggle-style handlers flip their active state as normal.
    local BUTTON_KEYBIND = {
        destroy = "Delete",
        open    = "Unbox",
    }

    for btnId, action in pairs(BUTTON_KEYBIND) do
        local btn = bar:FindFirstChild(btnId)
        if not btn then continue end
        local h = keybindHandlers[action]
        if not h then continue end

        if h.onRelease then
            -- Hold-style: button acts as a toggle (click on → click off)
            local btnActive = false
            btn.Activated:Connect(function()
                btnActive = not btnActive
                if btnActive then
                    h.onPress(true, selection())
                else
                    h.onRelease(selection())
                end
            end)
        else
            -- Toggle-style: same behaviour as the keybind
            btn.Activated:Connect(function()
                h.active = not h.active
                h.onPress(h.active, selection())
            end)
        end
    end

    BuildMode:OnKeybind("Abort", doAbort)

    BuildMode:OnKeybind("Reset Rotation", function()
        pcall(function()
            local rot = Util.Imports.Placement.Settings.Rotations
            rot.X, rot.Y, rot.Z = 0, 0, 0
            if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace() end
        end)
    end)

    -- Lock Position is handled exclusively by lockConn (defined above) which
    -- bypasses all dispatch guards and fires in every mode. Registering it via
    -- OnKeybind too would cause a double-toggle (net: no change), so it is
    -- intentionally omitted here.

    -- Slide in
    local target = UDim2.new(0.5, 0, 1, -BOTTOM_PAD)
    local info   = TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    tw(bar, info, { Position = target }):Play()
end

function BuildMode:ClosePanel()
    if _activeHide then _activeHide() end
end

function BuildMode:RefreshLockVisual()
    if not bar then return end
    local lockBtn  = bar:FindFirstChild("lockPos")
    local lockIcon = lockBtn and lockBtn:FindFirstChild("Icon")
    if not lockIcon then return end
    local T         = Util.Imports.Library:GetTheme()
    local Placement = Util.Imports.Placement
    local CF        = Util.Imports.CoreFramework
    local locked    = (Placement and Placement.IsLocked and Placement:IsLocked())
        or (CF and CF.LassoIsLocked and CF:LassoIsLocked())
    lockIcon.Image = locked and ICONS.lockPosLocked or ICONS.lockPos
end

function BuildMode:Hide()
    if not bar then return end
    pcall(removeGrid)
    -- Stop lasso immediately so it doesn't linger during the slide-out animation.
    pcall(function() Util.Imports.CoreFramework:LassoStop() end)
    pcall(function() Util.Imports.CoreFramework:LassoClickStop() end)
    pcall(function() Util.Imports.CoreFramework:LassoClearSelection() end)
    -- Tear down any active previews so they don't linger after exit.
    pcall(function() Util.Imports.CoreFramework:LassoClearPreview() end)
    pcall(function() Util.Imports.CoreFramework:ClearStackerQueue() end)
    pcall(function() Util.Imports.Placement:ExitPlacement() end)
    local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    local t    = tw(bar, info, { Position = UDim2.new(0.5, 0, 1, BAR_H + 30) })
    t:Play()
    t.Completed:Connect(function() self:Destroy() end)
end

function BuildMode:Destroy()
    BuildMode._active = false
    activeCapture = nil
    if _currentOpsTask then task.cancel(_currentOpsTask) end
    _currentOpsTask = nil
    pcall(removeGrid)
    pcall(function()
        game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
    end)
    if self._keybindConns then
        for _, c in ipairs(self._keybindConns) do c:Disconnect() end
        self._keybindConns = nil
    end
    pcall(function() Util.Imports.CoreFramework:LassoStop() end)
    pcall(function() Util.Imports.CoreFramework:LassoClickStop() end)
    pcall(function() Util.Imports.CoreFramework:LassoClearSelection() end)
    pcall(function() Util.Imports.CoreFramework:LassoClearPreview() end)
    pcall(function() Util.Imports.CoreFramework:ClearStackerQueue() end)
    pcall(function() Util.Imports.Placement:ExitPlacement() end)
    -- Revert notification placement back to the main library window
    pcall(function() Util.Imports.CoreFramework:SetNotifHost(nil) end)
    -- Restore borrowed UILib controls before gui is destroyed
    if self._waRestore then
        pcall(self._waRestore)
        self._waRestore = nil
    end
    if self._wcRestore then
        pcall(self._wcRestore)
        self._wcRestore = nil
    end
    if self._ttwRestore then
        pcall(self._ttwRestore)
        self._ttwRestore = nil
    end
    if self._asciiRestore then
        pcall(self._asciiRestore)
        self._asciiRestore = nil
    end
    if self._imgRestore then
        pcall(self._imgRestore)
        self._imgRestore = nil
    end
    if self._lassoRestore then
        pcall(self._lassoRestore)
        self._lassoRestore = nil
    end
    if self._gridStepRestore then
        pcall(self._gridStepRestore)
        self._gridStepRestore = nil
    end
    if self._targetRestore then
        pcall(self._targetRestore)
        self._targetRestore = nil
    end
    -- Keep _targetDropdowns list fresh (the UI instances are being destroyed anyway).
    -- TargetPlayer and WireSource are intentionally NOT reset here — they persist
    -- across Show/Destroy cycles (e.g. EnterPlacement) and are only cleared by
    -- the watchdog when the player unwhitelists, loses their property, or leaves.
    BuildMode._targetDropdowns = {}
    if self._stackRestore then
        pcall(self._stackRestore)
        self._stackRestore = nil
    end
    if self._selectRestore then
        pcall(self._selectRestore)
        self._selectRestore = nil
    end
    if gui then gui:Destroy() gui = nil bar = nil end
end

-- ── Boot cleanup ──────────────────────────────────────────────────────────────
-- Runs once on module load. Cleans up artifacts from any previous execution
-- of this script (selection boxes, grid models, leftover ScreenGuis) so a
-- re-exec doesn't leave stale visuals in the world.
local function bootCleanup()
    -- Destroy any leftover BuildMode toolbar GUI from a previous execution.
    pcall(function()
        local CoreGui = game:GetService("CoreGui")
        local old = CoreGui:FindFirstChild("AncestorBuildMode")
        while old do
            old:Destroy()
            old = CoreGui:FindFirstChild("AncestorBuildMode")
        end
    end)

    -- Destroy any leftover grid model in workspace.Effects.
    pcall(function()
        local effects = workspace:FindFirstChild("Effects") or workspace
        local oldGrid = effects:FindFirstChild("AncestorBuildModeGrid")
        while oldGrid do
            oldGrid:Destroy()
            oldGrid = effects:FindFirstChild("AncestorBuildModeGrid")
        end
    end)

    -- Destroy any leftover wire art preview models in workspace.
    -- These are named "Preview" and are parented directly to workspace by
