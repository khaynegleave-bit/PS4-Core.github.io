function WireArt:GetImageArts()
    local folder = "Ancestor/Games/" .. tostring(Util.GameId) .. "/Image Art"
    if not isfolder(folder) then makefolder(folder) end
    local out = {}
    if not listfiles then return out end
    local ok, entries = pcall(listfiles, folder)
    if not ok or typeof(entries) ~= "table" then return out end
    for _, fullPath in ipairs(entries) do
        local normalised = fullPath:gsub("\\", "/")
        local name       = normalised:match(".*/(.+)$") or normalised
        local ext        = (name:match("%.(%w+)$") or ""):lower()
        if ext == "png" or ext == "jpg" or ext == "jpeg"
           or ext == "bmp" or ext == "gif" or ext == "webp" then
            table.insert(out, name)
        end
    end
    table.sort(out)
    return out
