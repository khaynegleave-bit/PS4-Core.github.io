function Ancestor:OneUnitCutter()

	if Util.Imports.CoreFramework.Status.OneUnitCutting then
		return Util.Imports.CoreFramework:Notice("1 Unit Cutter is already running.", 2)
	end

	local CUT_TIMEOUT  = 4
	local MIN_LENGTH   = 1.5

	local function lengthAxisOf(part)
		local s = part.Size
		if s.X >= s.Y and s.X >= s.Z then return "X" end
		if s.Y >= s.Z then return "Y" end
		return "Z"
	end

	local function isActive()
		return Util.Imports.CoreFramework.Status.OneUnitCutting
	end

	local function EndOneUnitCutter()
		if not Util.Imports.CoreFramework.Status.OneUnitCutting then return end
		Util.Imports.CoreFramework.Status.OneUnitCutting = false
		Util.Imports.CoreFramework.Status._endOneUnitCutter = nil
		Util.Imports.Maid:deregister("OneUnitCutter")
		Util.Imports.Library.Toggles["1 Unit Cutter"]:Set(false)
		Util.Imports.CoreFramework:Notice("1 Unit Cutter: stopped", 2)
	end

	local function awaitNextSection(current, getLength)
		local result = {}
		result.conn = Util.Imports.Paths.PlayerModels.ChildAdded:Connect(function(plank)
			local owner = plank:WaitForChild("Owner", 5)
			local ws    = plank:WaitForChild("WoodSection", 5)
			if not (owner and owner.Value == Util.Client and ws) then return end

			local newLen = getLength(ws)
			local curLen = (current and current.Parent) and getLength(current) or 0
			result.section = (newLen >= curLen) and ws or current
			result.ready   = true
		end)
		return result
	end

	local function formatDuration(seconds)
		seconds = math.max(0, math.floor(seconds + 0.5))
		local minutes = math.floor(seconds / 60)
		local remainder = seconds % 60
		if minutes > 0 then
			return tostring(minutes) .. "m " .. tostring(remainder) .. "s"
		end
		return tostring(remainder) .. "s"
	end

	local function chop(section, BestAxe, AxeData)
		local axis = lengthAxisOf(section)
		local function getLength(p) return p.Size[axis] end

		local totalPieces  = math.floor(getLength(section))
		local pieces       = 1
		local startedAt    = os.clock()
		local progressNotice

		local function noticeProgress()
			if not isActive() then return end
			local remaining = math.max(totalPieces - pieces, 0)
			local etaText = "calculating"
			if pieces > 1 then
				local elapsed = os.clock() - startedAt
				etaText = formatDuration((elapsed / (pieces - 1)) * remaining)
			end
			local message = "1 Unit Cutter: " .. tostring(pieces) .. "/" .. tostring(totalPieces) .. " 1x1s, " .. tostring(remaining) .. " left, ETA " .. tostring(etaText)
			if progressNotice and progressNotice:IsActive() then
				progressNotice:Set(message)
			else
				progressNotice = Util.Imports.CoreFramework:Notice(message, false)
			end
			progressNotice:SetProgress(pieces / math.max(totalPieces, 1))
		end

		noticeProgress()

		while isActive() and section and section.Parent and getLength(section) > MIN_LENGTH do
			Util.Imports.Maid:Wait()

			if Util.Imports.CoreFramework:GetMagnitude(Util.Client.Character.Head, section) > 15 then
				Util.Imports.CoreFramework:Teleport(CFrame.new(section.Position + Vector3.new(0, 5, 5)))
			end

			local result = awaitNextSection(section, getLength)

			local deadline = os.clock() + CUT_TIMEOUT
			repeat Util.Imports.Maid:Wait()
				Util.Imports.CoreFramework:AttemptChop(section.Parent, BestAxe, AxeData, 1)
			until result.ready or os.clock() > deadline or not isActive()

			result.conn:Disconnect()
			if not isActive() or not result.ready then break end
			section = result.section

			pieces += 1
			noticeProgress()
		end

		if progressNotice then
			progressNotice:Dismiss()
			progressNotice = nil
		end
	end

	Util.Imports.CoreFramework.Status.OneUnitCutting = true
	Util.Imports.CoreFramework.Status._endOneUnitCutter = EndOneUnitCutter

	Util.Imports.Maid:register("OneUnitCutter", Util.Mouse.Button1Down:Connect(function()
		if not isActive() then return end

		local Target = Util.Mouse.Target
		if not Target then return end

		local Model = Target:FindFirstAncestorOfClass("Model")
		local TreeClass = Model and Model:FindFirstChild("TreeClass")
		local WoodSection = Model and Model:FindFirstChild("WoodSection")
		if not (Model and TreeClass and WoodSection) then
			return Util.Imports.CoreFramework:Notice("Click a log or plank to cut.")
		end

		local BestAxe, AxeData = Util.Imports.CoreFramework:GetBestAxe(TreeClass.Value, true)
		if not (BestAxe and AxeData) then
			return Util.Imports.CoreFramework:Notice(
			(Util.Imports.Settings.BringTree and Util.Imports.Settings.BringTree.UseOtherPlayersAxes)
				and "No axe available — nobody in the server has one you can use."
				or  "You need an axe to use this feature."
		)
		end

		task.spawn(chop, WoodSection, BestAxe, AxeData)
	end))
end

function Ancestor:Autofarm()
	local Sawmill = Util.Imports.Ancestor:SelectSawmill('Mod Wood')
	if not Sawmill then
		return Util.Imports.CoreFramework:Notice("You did not select a sawmill, aborted.")
	end

	local existingEnd = Util.Imports.CoreFramework.Status._endAutofarm
	if existingEnd then pcall(existingEnd) end

	task.spawn(function()
		local _maid    = Util.Imports.Maid
		local session  = {}
		local startMoney = Util.Client.leaderstats.Money.Value
		local startTime  = os.clock()
		local progressNotice
		local running = true

		local function formatDuration(seconds)
			seconds = math.max(0, math.floor(seconds + 0.5))
			local minutes = math.floor(seconds / 60)
			local remainder = seconds % 60
			if minutes > 0 then
				return tostring(minutes) .. "m " .. tostring(remainder) .. "s"
			end
			return tostring(remainder) .. "s"
		end

		local function noticeProgress()
			local earned  = math.max(0, Util.Client.leaderstats.Money.Value - startMoney)
			local elapsed = formatDuration(os.clock() - startTime)
			local message = "Autofarm: $" .. tostring(earned) .. " earned, running " .. tostring(elapsed)
			if progressNotice and progressNotice:IsActive() then
				progressNotice:Set(message)
			else
				progressNotice = Util.Imports.CoreFramework:Notice(message, false)
				Util.Imports.CoreFramework.Status._autofarmNotice = progressNotice
			end
		end

		local function EndAutofarm()
			if Util.Imports.CoreFramework.Status._autofarmSession ~= session then return end
			Util.Imports.CoreFramework.Status._autofarmSession = nil
			Util.Imports.CoreFramework.Status._endAutofarm     = nil
			Util.Imports.CoreFramework.Status.Autofarming      = false
			running = false
			if progressNotice then
				progressNotice:Dismiss()
				progressNotice = nil
				Util.Imports.CoreFramework.Status._autofarmNotice = nil
			end
			local endBT = Util.Imports.CoreFramework.Status._endBringTree
			if endBT then pcall(endBT) end
			local endMW = Util.Imports.CoreFramework.Status._endModWood
			if endMW then pcall(endMW) end
		end

		Util.Imports.CoreFramework.Status._autofarmSession = session
		Util.Imports.CoreFramework.Status._endAutofarm     = EndAutofarm
		Util.Imports.CoreFramework.Status.Autofarming      = true

		task.spawn(function()
			while running do
				task.wait(1)
				if running then noticeProgress() end
			end
		end)

		Util.Imports.CoreFramework:LockUI("Autofarm")
		noticeProgress()

		while _maid == Util.Imports.Maid and Util.Imports.Maid:Wait() do
			if not Util.Imports.Settings.ModWood.Autofarm then break end
			if Util.Imports.CoreFramework.Status._autofarmSession ~= session then break end

			local selectedTypes = Util.Imports.CoreFramework.Status.BringTreeSelectedTrees or {}
			local treeType = nil
			for _, t in ipairs(selectedTypes) do
				if Util.Imports.CoreFramework:FindTree(t, true) then
					treeType = t
					break
				end
			end

			if not treeType then
				Util.Imports.CoreFramework:Notice("No valid tree found for any selected type, autofarm cancelled.")
				Util.Imports.Settings.ModWood.Autofarm = false
				Util.Imports.Library.Toggles["Autofarm"]:Set(false, true)
				break
			end

			local Tree = self:BringTree(1, true, true, treeType)
			if Util.Imports.CoreFramework.Status._autofarmSession ~= session then break end
			if not Tree then continue end
			local success = self:ModWood(Sawmill, Tree, true)
			if Util.Imports.CoreFramework.Status._autofarmSession ~= session then break end
			if success then noticeProgress() end
		end

		running = false
		Util.Imports.CoreFramework.Status._autofarmSession = nil
		Util.Imports.CoreFramework.Status._endAutofarm     = nil
		Util.Imports.CoreFramework.Status.Autofarming      = false
		if progressNotice then
			progressNotice:Dismiss()
			progressNotice = nil
		end
		Util.Imports.CoreFramework.Status._autofarmNotice = nil
		Util.Imports.CoreFramework:UnlockUI("Autofarm stopped")
	end)
end

