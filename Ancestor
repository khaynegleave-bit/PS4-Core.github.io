    pcall(function() hiddenTab.Button.Parent = nil end)
    hiddenTab.Container.Visible = false
    local secOk, libSection = pcall(function()
        return hiddenTab:CreateSection("Build For")
    end)
    if not secOk or not libSection then return nil end
    local dropdownRef
    pcall(function()
        dropdownRef = libSection:CreateDropdown(function(value)
            local selectedName = (type(value) == "table" and value[1]) or value
            if not selectedName or selectedName == "" then return end
            if selectedName == Util.Client.Name then
                BuildMode.TargetPlayer = nil  -- self
                pcall(function() Util.Imports.CoreFramework:Notice("Building for yourself.", 2) end)
                pcall(function() BuildMode:RebuildGrid() end)
                return
            end
            local target = _resolvePlayer(selectedName)
            if not target then
                pcall(function() Util.Imports.CoreFramework:Notice("Selected player has left the server.", 3) end)
                return
            end
            if not BuildMode:IsWhitelistedFor(target) then
                pcall(function() Util.Imports.CoreFramework:Notice(
                    tostring(target.Name) .. " has not whitelisted you.", 4
                ) end)
                return
            end
            BuildMode.TargetPlayer = target
            pcall(function() Util.Imports.CoreFramework:Notice(
                "Now building for " .. tostring(target.Name) .. ".", 3
            ) end)
            pcall(function() BuildMode:RebuildGrid() end)
        end, _playerList(), (BuildMode.TargetPlayer and BuildMode.TargetPlayer.Name) or Util.Client.Name, false)
    end)
    local secFrame = hiddenTab.Container:FindFirstChildWhichIsA("Frame")
    if not secFrame then return nil end
    local row
    for _, child in secFrame:GetChildren() do
        if child:IsA("GuiObject") and child.Name ~= "Title" then
            row = child; break
        end
    end
    if not row then return nil end
    row.LayoutOrder = layoutOrder
    row.ZIndex      = 21
    row.Parent      = section
    if dropdownRef then
        table.insert(BuildMode._targetDropdowns, { dropdown = dropdownRef, tab = hiddenTab })
    end
    return function()
        -- Remove from the dropdown registry first so the revert loop ignores it.
        for i = #BuildMode._targetDropdowns, 1, -1 do
            if BuildMode._targetDropdowns[i].tab == hiddenTab then
                table.remove(BuildMode._targetDropdowns, i)
            end
        end
        pcall(function()
            if hiddenTab and hiddenTab.Container then hiddenTab.Container:Destroy() end
            if hiddenTab and hiddenTab.Button then hiddenTab.Button:Destroy() end
        end)
    end
end

