local function GetValueFromPath(Table, Path)
    local Keys = string.split(Path, ".")
    local Current = Table
    for _, Key in ipairs(Keys) do
        if type(Current) ~= "table" then return nil end
        Current = Current[Key]
    end
    return Current
end

function Features:RefreshUI()
    for SectionName, FeatureList in next, self do
        if type(FeatureList) ~= "table" or SectionName == "Configs" then continue end
        for _, feature in ipairs(FeatureList) do
            if feature.Instance and feature.SettingPath then
                local Value = GetValueFromPath(Util.Imports.Settings, feature.SettingPath)
                if Value ~= nil then
                    if feature.Type == "ToggleColorPicker" then
                        feature.Instance:Set(Value)
                        if feature.Instance.ColorPicker and feature.Instance.ColorPicker.Set then
                            local ColorValue = GetValueFromPath(Util.Imports.Settings, feature.SettingPath .. "Color")
                            local RainbowValue = GetValueFromPath(Util.Imports.Settings, feature.SettingPath .. "Rainbow")
                            if ColorValue then feature.Instance.ColorPicker:Set("All", ColorValue) end
                            if RainbowValue ~= nil and feature.Instance.ColorPicker.SetRainbow then
                                feature.Instance.ColorPicker:SetRainbow(RainbowValue)
                            end
                        end
                    elseif feature.Type == "Dropdown" then
                        feature.Instance:Set({Value})
                    elseif feature.Type == "Slider" then
                        feature.Instance:Set(Value)
                    elseif feature.Type == "Keybind" then
                        -- Keybinds are a bit special, usually don't need sync unless they change
                        if feature.Instance.Set then feature.Instance:Set(Value) end
                    else
                        feature.Instance:Set(Value)
                    end
                end
            end
        end
    end

    -- Update Config Name box to current selection if loaded
    if ConfigState.Selected ~= "None" then
        ConfigState.Name = ConfigState.Selected
        for _, feature in ipairs(self.Configs) do
            if feature.Name == "Config Name" and feature.Instance then
                feature.Instance:Set(ConfigState.Selected)
            end
        end
    end
end

