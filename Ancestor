function CoreFramework:AutoUpgradeBulk()
	self.LastAutoUpgradeBulkTimestamp = self.LastAutoUpgradeBulkTimestamp or tick()
	if tick() - self.LastAutoUpgradeBulkTimestamp >= .2 then
		self.LastAutoUpgradeBulkTimestamp = tick()
		local Tycoon = Util.Imports.Environments.Tycoon.getLocal()
		local Component = Tycoon:GetComponent(Util.Imports.Environments.ClientTycoonBalances)
		
		local Huge    = Util.Imports.Environments.Huge
		local Balance  = Util.Imports.Environments.Balance

		local function getUpgradePrice(upgradeName, targetLevel)
			local prices = Balance.UpgradePrices[upgradeName]

			if targetLevel <= #prices then
				return prices[targetLevel]
			end

			local anchorIndex = #prices
			local powerFactor = Balance.UpgradePowerFactors[upgradeName][2]

			local exponent = math.pow(targetLevel - anchorIndex, 1.2) / powerFactor
			local scale    = Huge.pow(Huge.toHuge(2), exponent)

			return Huge.multiply(prices[anchorIndex], scale)
		end

		local function GetUpgradePrice(Name)
			local ascension = Tycoon:GetComponent(Util.Imports.Environments.TycoonAscension)
			local penalty   = Huge.pow(
				Huge.toHuge(ascension:GetAscensionPricePenalty()),
				ascension:GetAscension()
			)

			local level = Tycoon:GetComponent(Util.Imports.Environments.TycoonUpgrades):GetLevel(Name)
			local basePrice = getUpgradePrice(Name, level + 1)
			local price     = Huge.multiply(basePrice, penalty)

			return price
		end

		local function CanAfford(Name)
			local Price = GetUpgradePrice(Name)
			return Component:GetCash() >= Price
		end

		local Map = {
			LemonDepot = "Lemon Depot",
			LemonDash = "LemonDash",
			LemonLabs = "Lemon Labs",
			LemonRepublic = "Lemon Republic",
			LemonRobotics = "Lemon Robotics",
			LemonStand = "Lemon Stand",
			LemonTrading = "Lemon Trading",
			LemonX = "LemonX"
		}

		local Values = Tycoon.Instance.Values
		for _, Value in Values.Income.Streams:GetChildren() do
			if CanAfford(Value.Name) then
				local Upgrade = Tycoon.Instance.Purchases:FindFirstChild(Map[Value.Name]):FindFirstChild("Upgrade", true)
				if Upgrade then
					pcall(function()
						Upgrade:InvokeServer(1)
					end)
				end
			end 
		end
	end
	
end

