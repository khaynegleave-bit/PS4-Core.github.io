    local title = Instance.new("TextLabel")
    title.Name                   = "Title"
    title.BackgroundTransparency = 1
    title.BorderSizePixel        = 0
    title.Size                   = UDim2.new(1, -16, 0, 29)
    title.Text                   = " Settings"
    title.TextColor3             = T.Text
    title.TextTransparency       = 1
    title.TextSize               = 18
    title.Font                   = Enum.Font.SourceSansBold
    title.TextXAlignment         = Enum.TextXAlignment.Left
    title.LayoutOrder            = 0
    title.ZIndex                 = 21
    title.Parent = section

    -- ── Lasso toggle (mobile only) ────────────────────────────────────────────
    local UIS      = game:GetService("UserInputService")
    local isMobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
    local lassoToggleRow, lassoOrigParent, lassoOrigLayout, lassoOrigZ
    if isMobile then
        local lassoSection = ensureLassoSection()
        if lassoSection then
            for _, child in lassoSection:GetChildren() do
                if child:IsA("GuiObject") and child.Name ~= "Title" then
                    lassoToggleRow = child
                    break
                end
            end
        end
        if lassoToggleRow then
            lassoOrigParent = lassoToggleRow.Parent
            lassoOrigLayout = lassoToggleRow.LayoutOrder
            lassoOrigZ      = lassoToggleRow.ZIndex
            lassoToggleRow.LayoutOrder = 1
            lassoToggleRow.ZIndex      = 21
            lassoToggleRow.Parent      = section
        end
    end
    -- ── Target player dropdown ────────────────────────────────────────────────
    BuildMode._targetRestore = borrowTargetPlayerRow(section, 2)

    -- ── Grid Step slider ──────────────────────────────────────────────────────
    BuildMode._gridStepRestore = borrowGridStepRow(section, 3)

    -- Restore the borrowed toggle before the settings gui is destroyed,
    -- otherwise the cached `_lassoSection` ends up with a dead child.
    BuildMode._lassoRestore = function()
        if lassoToggleRow and lassoToggleRow.Parent == section and lassoOrigParent then
            lassoToggleRow.LayoutOrder = lassoOrigLayout
            lassoToggleRow.ZIndex      = lassoOrigZ
            lassoToggleRow.Parent      = lassoOrigParent
        end
    end

    -- "Keybinds" header — sits between the title and the keybind rows.
    local kbHeader = Instance.new("TextLabel")
    kbHeader.Name                   = "KeybindsHeader"
    kbHeader.BackgroundTransparency = 1
    kbHeader.BorderSizePixel        = 0
    kbHeader.Size                   = UDim2.new(1, -16, 0, 24)
    kbHeader.Text                   = " Keybinds"
    kbHeader.TextColor3             = T.Text
    kbHeader.TextSize               = 16
    kbHeader.Font                   = Enum.Font.SourceSansBold
    kbHeader.TextXAlignment         = Enum.TextXAlignment.Left
    kbHeader.LayoutOrder            = 4
    kbHeader.ZIndex                 = 21
    kbHeader.Parent                 = section
    if isMobile then kbHeader.Visible = false end

    -- Chip lookup table for resetting previous capture
    local chips = {}

    for i, entry in ipairs(BuildMode.Keybinds) do
        if isMobile then break end   -- no keybinds on mobile
        -- Row — styled like a UILib element button
        local row = Instance.new("Frame")
        row.Name                 = "Row_" .. entry.action
        row.BackgroundColor3     = T.Element
        row.BorderSizePixel      = 0
        row.Size                 = UDim2.new(1, 0, 0, 37)
        row.LayoutOrder          = i + 4
        row.ZIndex               = 21
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 7)
        row.Parent = section

        local actionLabel = Instance.new("TextLabel")
        actionLabel.BackgroundTransparency = 1
        actionLabel.BorderSizePixel        = 0
        actionLabel.Size                   = UDim2.new(1, -90, 1, 0)
        actionLabel.Position               = UDim2.new(0, 0, 0, 0)
        actionLabel.Text                   = "  " .. entry.action
        actionLabel.TextColor3             = T.Text
        actionLabel.TextSize               = 16
        actionLabel.Font                   = Enum.Font.SourceSansBold
        actionLabel.TextXAlignment         = Enum.TextXAlignment.Left
        actionLabel.ZIndex                 = 22
        actionLabel.Parent = row

        local chip = Instance.new("TextButton")
        chip.Name                   = "KeyChip_" .. entry.action
        chip.BackgroundColor3       = T.ElementDark
        chip.BackgroundTransparency = 0
        chip.BorderSizePixel        = 0
        chip.AnchorPoint            = Vector2.new(1, 0.5)
        chip.Position               = UDim2.new(1, -8, 0.5, 0)
        chip.Size                   = UDim2.new(0, 70, 0, 24)
        chip.Text                   = entry.display
        chip.TextColor3             = T.Text
        chip.TextSize               = 14
        chip.Font                   = Enum.Font.GothamBold
        chip.AutoButtonColor        = false
        chip.ZIndex                 = 23
        Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 7)
        chip.Parent = row
        chips[entry.action] = chip

        chip.Activated:Connect(function()
            if activeCapture == entry then
                activeCapture = nil
                tw(chip, fast, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                chip.Text = entry.display
                return
            end

            if activeCapture then
                local prevChip = chips[activeCapture.action]
                if prevChip then
                    tw(prevChip, med, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                    prevChip.Text = activeCapture.display
                end
            end

            activeCapture = entry
            chip.Text = "..."
            tw(chip, fast, { BackgroundColor3 = T.Accent, TextColor3 = Color3.new(1,1,1) }):Play()

            local conn
            conn = game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                conn:Disconnect()
                if activeCapture ~= entry then return end
                activeCapture = nil
                if input.KeyCode == Enum.KeyCode.Escape then
                    chip.Text = entry.display
                    tw(chip, med, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                    return
                end
                entry.keyCode = input.KeyCode
                entry.display = keyName(input.KeyCode)
                chip.Text     = entry.display
                tw(chip, med, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                local enumName = tostring(input.KeyCode):match("Enum%.KeyCode%.(.+)") or tostring(input.KeyCode)
                _bmSetSetting(entry.action, enumName)
                if writefile then
                    pcall(writefile, "Ancestor/Games/" .. tostring(Util.GameId) .. "/ClientSettings.json", Util.Services.HttpService:JSONEncode(Util.Imports.Settings))
                end
                -- Re-register keybind listeners so they pick up the new key immediately.
                pcall(function() Util.Imports.Placement:RefreshKeybinds() end)
                pcall(function() Util.Imports.CoreFramework:RefreshLassoKeybinds() end)
            end)
        end)
    end

    makeScrollable(panel, section, T, 900)
    local show, hide = makePanelFade(panel, section, title, nil, nil, function()
        activeCapture = nil
    end)
    return panel, show, hide
end

-- ── Tooltip ───────────────────────────────────────────────────────────────────
local TIP_PAD_X  = 10
local TIP_PAD_Y  = 5
local TIP_GAP    = 8   -- gap between bar top and tooltip bottom
local TIP_RADIUS = UDim.new(0, 6)

local function makeTooltip(parent, T)
    local tip = Instance.new("Frame")
    tip.Name                  = "Tooltip"
    tip.BackgroundColor3      = T.Element
    tip.BackgroundTransparency = 1
    tip.BorderSizePixel       = 0
    tip.AnchorPoint           = Vector2.new(0.5, 1)
    tip.Position              = UDim2.new(0, 0, 0, -TIP_GAP)
    tip.Size                  = UDim2.new(0, 80, 0, 26)
    tip.ZIndex                = 10
    Instance.new("UICorner", tip).CornerRadius = TIP_RADIUS
    tip.Parent = parent

    local label = Instance.new("TextLabel")
    label.Name                 = "Label"
    label.BackgroundTransparency = 1
    label.BorderSizePixel      = 0
    label.AnchorPoint          = Vector2.new(0.5, 0.5)
    label.Position             = UDim2.new(0.5, 0, 0.5, 0)
    label.Size                 = UDim2.new(1, -TIP_PAD_X * 2, 1, 0)
    label.Text                 = ""
    label.TextColor3           = T.Text
    label.TextSize             = 13
    label.Font                 = Enum.Font.GothamMedium
    label.TextXAlignment       = Enum.TextXAlignment.Center
    label.ZIndex               = 11
    label.Parent = tip

    return tip, label
end

local function showTooltip(tip, label, text, btnAbsPos, btnAbsSize, barAbsPos)
    label.Text = text
    local textSvc  = game:GetService("TextService")
    local textSize = textSvc:GetTextSize(text, 13, Enum.Font.GothamMedium, Vector2.new(400, 26))
    local tipW     = textSize.X + TIP_PAD_X * 2
    local tipH     = textSize.Y + TIP_PAD_Y * 2

    -- AbsolutePosition is in screen pixels; divide by UIScale to get bar-local logical px.
    local s          = _currentScale
    local btnCentreX = ((btnAbsPos.X + btnAbsSize.X * 0.5) - barAbsPos.X) / s
    tip.Size     = UDim2.new(0, tipW, 0, tipH)
    tip.Position = UDim2.new(0, btnCentreX, 0, -TIP_GAP)

    tw(tip,   fast, { BackgroundTransparency = 0 }):Play()
    tw(label, fast, { TextTransparency = 0 }):Play()
end

local function hideTooltip(tip, label)
    tw(tip,   med, { BackgroundTransparency = 1 }):Play()
    tw(label, med, { TextTransparency = 1 }):Play()
end

local function makeBtn(parent, xPos, item, T, callbacks, tip, tipLabel)
    local isCancel  = item.id == "cancel"

    local btn = Instance.new("ImageButton")
    btn.Name                   = item.id
    btn.BackgroundColor3       = T.Element
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel        = 0
    btn.AnchorPoint            = Vector2.new(0.5, 0.5)
    btn.Size                   = UDim2.new(0, BTN, 0, BTN)
    btn.Position               = UDim2.new(0, xPos + BTN / 2, 0.5, 0)
    btn.Image                  = ""
    btn.AutoButtonColor        = false
    Instance.new("UICorner", btn).CornerRadius = BTN_RADIUS
    btn.Parent = parent

    -- UIScale child drives the press-pop animation without touching layout.
    local btnScale = Instance.new("UIScale")
    btnScale.Scale  = 1
    btnScale.Parent = btn

    local icon = Instance.new("ImageLabel")
    icon.Name                    = "Icon"
    icon.BackgroundTransparency  = 1
    icon.BorderSizePixel         = 0
    icon.AnchorPoint             = Vector2.new(0.5, 0.5)
    icon.Position                = UDim2.new(0.5, 0, 0.5, 0)
    local iconPx = item.iconSize or ICON
    icon.Size                    = UDim2.new(0, iconPx, 0, iconPx)
    icon.Image                   = item.icon
    icon.ImageColor3             = isCancel and Color3.fromRGB(255, 90, 90) or T.MutedText
    icon.ScaleType               = Enum.ScaleType.Fit
    icon.Parent = btn

    local normalColor = icon.ImageColor3

    btn.MouseEnter:Connect(function()
        tw(btn,  fast, { BackgroundTransparency = 0, BackgroundColor3 = T.Element }):Play()
        tw(icon, fast, { ImageColor3 = isCancel and Color3.fromRGB(255, 90, 90) or T.Text }):Play()
        if item.tip then
            showTooltip(tip, tipLabel, item.tip, btn.AbsolutePosition, btn.AbsoluteSize, parent.AbsolutePosition)
        end
    end)

    btn.MouseLeave:Connect(function()
        tw(btn,  med, { BackgroundTransparency = 1, BackgroundColor3 = T.Element }):Play()
        tw(icon, med, { ImageColor3 = normalColor }):Play()
        tw(btnScale, fast, { Scale = 1 }):Play()
        hideTooltip(tip, tipLabel)
    end)

    -- Press feedback: shrink while held, snap back on release.
    btn.MouseButton1Down:Connect(function()
        tw(btnScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 0.88 }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        tw(btnScale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    end)

    btn.Activated:Connect(function()
        hideTooltip(tip, tipLabel)

        -- On mobile, briefly lock the placement preview so the touch that fired
        -- this button cannot snap the preview to the button's world position.
        pcall(function()
            local p = Util.Imports.Placement
            if p and game:GetService("UserInputService").TouchEnabled then
                p._touchGuard = true
                task.delay(0.3, function() p._touchGuard = nil end)
            end
        end)

        -- Grid button cycles through GRID_STATES and rebuilds the grid model
        if item.id == "grid" then
            BuildMode.GridState = (BuildMode.GridState % #GRID_STATES) + 1
            local state = GRID_STATES[BuildMode.GridState]
            icon.Image  = state.icon
            item.tip    = state.tip
            -- Keep placement snap in sync with the visual grid
            pcall(function() Util.Imports.Placement.Settings.GridSize = state.size end)
            task.spawn(function() applyGrid(state.size, state.studs) end)
        elseif item.id == "gridUp" then
            task.spawn(moveGrid, BuildMode.GridStep)
        elseif item.id == "gridDown" then
            task.spawn(moveGrid, -BuildMode.GridStep)
        elseif item.id == "rotate" then
            pcall(function()
                Util.Imports.Placement.Settings.Rotations.Y += 45
                if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace()
                elseif Util.Imports.CoreFramework:LassoIsLocked() then Util.Imports.CoreFramework:LassoApplyRotationInPlace() end
            end)
        elseif item.id == "tilt" then
            pcall(function()
                Util.Imports.Placement.Settings.Rotations.Z += 45
                if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace()
                elseif Util.Imports.CoreFramework:LassoIsLocked() then Util.Imports.CoreFramework:LassoApplyRotationInPlace() end
            end)
        elseif item.id == "flip" then
            pcall(function()
                Util.Imports.Placement.Settings.Rotations.X += 45
                if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace()
                elseif Util.Imports.CoreFramework:LassoIsLocked() then Util.Imports.CoreFramework:LassoApplyRotationInPlace() end
            end)
        elseif item.id == "resetRot" then
            pcall(function()
                local rot = Util.Imports.Placement.Settings.Rotations
                rot.X, rot.Y, rot.Z = 0, 0, 0
                if Util.Imports.Placement._locked then Util.Imports.Placement:ApplyRotationInPlace()
                elseif Util.Imports.CoreFramework:LassoIsLocked() then Util.Imports.CoreFramework:LassoApplyRotationInPlace() end
            end)
        end

        local flash = tw(btn, TweenInfo.new(0.06), { BackgroundColor3 = T.Accent, BackgroundTransparency = 0 })
        flash:Play()
        flash.Completed:Connect(function()
            tw(btn, med, { BackgroundColor3 = T.Element, BackgroundTransparency = 1 }):Play()
        end)
        if callbacks and callbacks[item.id] then
            task.spawn(callbacks[item.id])
        end
    end)
end

