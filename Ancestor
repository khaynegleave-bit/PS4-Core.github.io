Util.Imports.Maid             = (function()
--MARK: Include Utility

if not getgenv().Connections then
	getgenv().Connections = {}
end

-- A fresh table is assigned every time this module is loaded.
-- Any in-flight Wait that captured an older reference will see the mismatch
-- and break on the very next Stepped tick after re-execution.
getgenv()._MaidExecToken = {}

local Maid = { Connections = {}, Properties = {Debug = false}, _token = {} }

function Maid:verify(name)
	return rawget(Connections, name)
end

--> for debugging purposes <--
function Maid:traceback(...)
	if self.Properties.Debug then
		return warn("[MaidService]:", ...)
	end
end

--> registers a new connection to the Maid <--
function Maid:register(name, callback)
	if (self:verify(name)) then
		return self:traceback(tostring(name) .. " is already registered")
	end
	Connections[name] = callback
	local registered = self:verify(name)
	if registered then
		self:traceback(tostring(name) .. " was registered")
	end
	return registered
end

function Maid:Wait(Time)
	local execToken = getgenv()._MaidExecToken  -- invalidated on re-exec
	local instToken = self._token               -- invalidated by clearRegister
	local Start     = DateTime.now().UnixTimestamp
	local Time      = Time or 0
	while Util.Services.RunService.Stepped:Wait() do
		if getgenv()._MaidExecToken ~= execToken then break end
		if self._token              ~= instToken  then break end
		if Time <= DateTime.now().UnixTimestamp - Start then break end
	end
	return DateTime.now().UnixTimestamp - Start
end

function Maid:deregister(name)
	local connection = self:verify(name)
	if not connection then
		return
	end
	if typeof(connection) == 'RBXScriptConnection' then
		connection:Disconnect()
	end
	rawset(Connections, name, nil)
	self:traceback(tostring(name) .. " was deregistered")
	return self:verify(name)
end

function Maid:clearRegister()
	self._token = {}
	for Name in next, Connections do
		self:deregister(Name)
	end
	return true, self:traceback("register was cleared")
end

return Maid

end)()

