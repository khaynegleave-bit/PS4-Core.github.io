	while true do
		Util.Services.RunService.Heartbeat:Wait()
		local char = Util.Client.Character
		local hum  = char and char:FindFirstChildOfClass("Humanoid")
		if not hum then
			locked = false
			savedSpeed = nil
			continue
		end
		local shiftHeld = UIS:IsKeyDown(Enum.KeyCode.LeftShift)
			or UIS:IsKeyDown(Enum.KeyCode.RightShift)
		local dragger   = workspace:FindFirstChild("Dragger") ~= nil
		local should    = shiftHeld and dragger
		if should and not locked then
