                if MainFrame then
                    if MainFrame:IsA("CanvasGroup") then
                        MainFrame.GroupTransparency = 1
                        TweenService:Create(MainFrame, TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { GroupTransparency = 0 }):Play()
                    else
                        -- Sophisticated descendant fade that preserves layout transparency
                        local OriginalTransparencies = {}
                        local FadeInfo = TweenInfo.new(0.8, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                        
                        for _, child in ipairs(MainFrame:GetDescendants()) do
                            if child:IsA("TextLabel") then
                                OriginalTransparencies[child] = child.TextTransparency
                                child.TextTransparency = 1
                            elseif child:IsA("ImageLabel") then
                                OriginalTransparencies[child] = child.ImageTransparency
                                child.ImageTransparency = 1
                            elseif child:IsA("Frame") or child:IsA("CanvasGroup") then
                                OriginalTransparencies[child] = child.BackgroundTransparency
                                if child.BackgroundTransparency < 1 then
                                    child.BackgroundTransparency = 1
                                end
                            end
                        end
                        
                        -- Fade back to original values
                        for child, original in pairs(OriginalTransparencies) do
                            if child:IsA("TextLabel") then
                                TweenService:Create(child, FadeInfo, { TextTransparency = original }):Play()
                            elseif child:IsA("ImageLabel") then
                                TweenService:Create(child, FadeInfo, { ImageTransparency = original }):Play()
                            elseif child:IsA("Frame") or child:IsA("CanvasGroup") then
                                TweenService:Create(child, FadeInfo, { BackgroundTransparency = original }):Play()
                            end
                        end
                    end
                end
            end
        end)
        Gui:Destroy() 
    end)
