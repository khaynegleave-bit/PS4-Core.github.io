-- Tracks the hide function of whichever panel is currently open.
local _activeHide = nil

-- Walks every GUI descendant of a section and records the properties that need
-- fading (only those whose current value is < 1, i.e. actually visible).
-- Call this AFTER borrow() so borrowed controls are already in the section.
local function collectFadeTargets(section)
    local targets = {}
    for _, obj in section:GetDescendants() do
        if not obj:IsA("GuiObject") then continue end
        local show, hide = {}, {}
        local any = false

        if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox"))
            and obj.TextTransparency < 1 then
            show.TextTransparency = obj.TextTransparency
            hide.TextTransparency = 1
            any = true
        end
        if (obj:IsA("ImageLabel") or obj:IsA("ImageButton"))
            and obj.ImageTransparency < 1 then
            show.ImageTransparency = obj.ImageTransparency
            hide.ImageTransparency = 1
            any = true
        end
        if obj.BackgroundTransparency < 1 then
            show.BackgroundTransparency = obj.BackgroundTransparency
            hide.BackgroundTransparency = 1
            any = true
        end

        if any then
            table.insert(targets, { obj = obj, show = show, hide = hide })
        end
    end
    return targets
end

-- Builds show/hide closures for any panel that follows the section pattern.
-- borrowFn / restoreFn may be nil (e.g. settings panel).
-- onHideBegin runs synchronously at the start of hide (optional).
local function makePanelFade(panel, section, title, borrowFn, restoreFn, onHideBegin)
    local captured = nil  -- set once on first show, then reused
    local hideGen  = 0    -- incremented on every show() to cancel stale hide callbacks

    -- Resets all captured elements to their natural transparency.
    -- Called both from hide().Completed AND from Destroy() to handle the case
    -- where Destroy runs during an in-progress hide tween (Completed may not fire).
    local function resetTransparency()
        hideGen += 1  -- invalidate any in-flight hide tweens
        -- Also restore section and title to natural state
        pcall(function() section.BackgroundTransparency = 0 end)
        pcall(function() if title then title.TextTransparency = 0 end end)
        if not captured then return end
        for _, t in captured do
            if t.obj and t.obj.Parent then
                for k, v in pairs(t.show) do
                    pcall(function() t.obj[k] = v end)
                end
            end
        end
    end

    local function hide()
        if _activeHide == hide then _activeHide = nil end
        if onHideBegin then onHideBegin() end
        tw(title, med, { TextTransparency = 1 }):Play()
        if captured then
            for _, t in captured do
                if next(t.hide) then TweenService:Create(t.obj, med, t.hide):Play() end
            end
        end
        local gen  = hideGen
        local done = tw(section, med, { BackgroundTransparency = 1 })
        done:Play()
        done.Completed:Connect(function()
            if hideGen ~= gen then return end
            panel.Visible = false
            if restoreFn then restoreFn() end
            resetTransparency()
        end)
    end

    local function show()
        hideGen += 1
        if _activeHide and _activeHide ~= hide then _activeHide() end
        _activeHide = hide

        -- Reset elements to natural state before borrowing.
        -- Handles the case where a previous Destroy() left them at transparency=1.
        resetTransparency()

        if borrowFn then borrowFn() end

        -- Capture natural transparencies the first time (after borrow + reset).
        if not captured then
            captured = collectFadeTargets(section)
        end

        -- Instantly zero everything out while still invisible (no flash)
        section.BackgroundTransparency = 1
        title.TextTransparency         = 1
        if captured then
            for _, t in captured do
                for k in pairs(t.hide) do
                    pcall(function() t.obj[k] = 1 end)
                end
            end
        end

        panel.Visible = true
        tw(section, fast, { BackgroundTransparency = 0 }):Play()
        tw(title,   fast, { TextTransparency = 0 }):Play()
        if captured then
            for _, t in captured do
                if next(t.show) then TweenService:Create(t.obj, fast, t.show):Play() end
            end
        end
    end

    return show, hide, resetTransparency
end

