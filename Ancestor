		local defaultW = math.clamp(math.floor(vp.X * 0.82 / uiScale), MinimumMainSize.X, 600)
		local defaultH = math.clamp(math.floor(vp.Y * 0.82 / uiScale), MinimumMainSize.Y, 455)
		SetMainSize(defaultW, defaultH)
	end

