function NewColourPicker:SetVisible(IsVisible)
	self._Visible = IsVisible and true or false
	-- Track state as attributes so RefreshSearch can restore correctly
	ColorPicker:SetAttribute("PickerOpen", self._Visible)
	ColorPicker:SetAttribute("SH", self._Visible and PickerExpandedHeight or 0)
	if self._Visible then
		ColorPicker.Visible = true
		TweenService:Create(ColorPicker, TweenInfo.new(PickerTweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, 0, 0, PickerExpandedHeight)
		}):Play()
	else
		TweenService:Create(ColorPicker, TweenInfo.new(PickerTweenDuration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(1, 0, 0, 0)
		}):Play()
		task.delay(PickerTweenDuration, function()
			if not self._Visible then
				ColorPicker.Visible = false
			end
		end)
	end
	task.defer(RefreshSectionSize)
end

