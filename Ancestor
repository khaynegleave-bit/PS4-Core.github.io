-- ── Scrollable panel helper ───────────────────────────────────────────────────
-- Wraps `section` in a ScrollingFrame inside `panel` so the panel can scroll
-- when content exceeds MAX_PANEL_H. Call after section is fully built,
-- before makePanelFade. Returns the scroller for use in borrow() closures.
local MAX_PANEL_H = 700

local function makeScrollable(panel, section, T, maxH)
    maxH = maxH or MAX_PANEL_H
    panel.AutomaticSize = Enum.AutomaticSize.None

    local scroller = Instance.new("ScrollingFrame")
    scroller.Name                       = "Scroller"
    scroller.BackgroundTransparency     = 1
    scroller.BorderSizePixel            = 0
    scroller.Size                       = UDim2.new(1, 0, 1, 0)
    scroller.ScrollBarThickness         = 0
    scroller.ScrollBarImageTransparency = 1
    scroller.ScrollingDirection         = Enum.ScrollingDirection.Y
    scroller.AutomaticCanvasSize        = Enum.AutomaticSize.Y
    scroller.CanvasSize                 = UDim2.new(0, 0, 0, 0)
    scroller.ZIndex                     = section.ZIndex
    scroller.Parent                     = panel

    section.Parent = scroller

    local titleLabel = section:FindFirstChild("Title")
    local baseText   = titleLabel and titleLabel.Text or ""

    local function refreshHeight()
        -- AbsoluteSize is in screen pixels; divide by UIScale to get logical pixels
        -- so panel.Size (also logical) matches the content at any scale.
        local scale    = math.max(_currentScale, 0.01)
        local contentH = section.AbsoluteSize.Y / scale
        local h = math.clamp(contentH, 10, maxH)
        panel.Size = UDim2.new(0, 380, 0, h)
        if titleLabel then
            titleLabel.Text = contentH > maxH
                and (baseText .. "  (Scroll down for more)")
                or  baseText
        end
    end
    section:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshHeight)
    task.defer(refreshHeight)

    return scroller
end

local function makeStackPanel(parent, T)
    local stackFrame = ensureStackSection()

    local panel = Instance.new("Frame")
    panel.Name                   = "StackPanel"
    panel.BackgroundTransparency = 1
    panel.BorderSizePixel        = 0
    panel.AnchorPoint            = Vector2.new(0.5, 0.5)
    panel.Position               = UDim2.new(0.5, 0, 0.5, 0)
    panel.AutomaticSize          = Enum.AutomaticSize.None
    panel.Size                   = UDim2.new(0, 380, 0, 0)
    panel.Visible                = false
    panel.ZIndex                 = 20
    panel.Parent                 = parent

    -- Scroller created before borrow() so the closure captures it correctly.
    local scroller = Instance.new("ScrollingFrame")
    scroller.Name                       = "Scroller"
    scroller.BackgroundTransparency     = 1
    scroller.BorderSizePixel            = 0
    scroller.Size                       = UDim2.new(1, 0, 1, 0)
    scroller.ScrollBarThickness         = 0
    scroller.ScrollBarImageTransparency = 1
    scroller.ScrollingDirection         = Enum.ScrollingDirection.Y
    scroller.AutomaticCanvasSize        = Enum.AutomaticSize.Y
    scroller.CanvasSize                 = UDim2.new(0, 0, 0, 0)
    scroller.ZIndex                     = 20
    scroller.Parent                     = panel

    local stackFrameHome     = stackFrame and stackFrame.Parent
    local stackFrameOrigSize = stackFrame and stackFrame.Size

    local function borrow()
        if not stackFrame then return end
        stackFrame.Size   = UDim2.new(1, 0, 0, 0)
        stackFrame.Parent = scroller
    end

    local function restore()
        if not stackFrame then return end
        if stackFrame.Parent == scroller then
            stackFrame.Size   = stackFrameOrigSize
            stackFrame.Parent = stackFrameHome
        end
    end

    local title       = stackFrame and stackFrame:FindFirstChild("Title")
    local baseText    = title and title.Text or ""

    if stackFrame then
        stackFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            if stackFrame.Parent == scroller then
                local scale    = math.max(_currentScale, 0.01)
                local contentH = stackFrame.AbsoluteSize.Y / scale
                local h = math.clamp(contentH, 10, 900)
                panel.Size = UDim2.new(0, 380, 0, h)
                if title then
                    title.Text = contentH > MAX_PANEL_H
                        and (baseText .. "  (Scroll down for more)")
                        or  baseText
                end
            end
        end)
    end
    local show, hide, reset = makePanelFade(panel, stackFrame, title, borrow, restore)
    return panel, show, hide, function() restore() reset() end
end

