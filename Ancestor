                    return
                end
            end
        end, names, (Util.Imports.WireArt and Util.Imports.WireArt.Settings.Properties.WireSource and Util.Imports.WireArt.Settings.Properties.WireSource.Name) or Util.Client.Name, false)
    end)

    local secFrame = hiddenTab.Container:FindFirstChildWhichIsA("Frame")
