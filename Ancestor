function CoreFramework:EmergencyAbort()
    local status = self.Status
    if status._endAutofarm then pcall(status._endAutofarm) end
    if status._endPurchase then pcall(status._endPurchase) end
    if status._endBringTree then pcall(status._endBringTree) end
    if status._endModWood then pcall(status._endModWood) end
    if status._endSpawnVehicle then pcall(status._endSpawnVehicle) end
    if status._endOneUnitCutter then pcall(status._endOneUnitCutter) end
    if Util.Imports.Ancestor and Util.Imports.Ancestor.ModdingWood then
        Util.Imports.Ancestor.ModdingWood = false
    end
    if Util.Imports.Settings.ModWood then
        Util.Imports.Settings.ModWood.Autofarm = false
    end
    if status._autofarmNotice then
        pcall(function() status._autofarmNotice:Dismiss() end)
        status._autofarmNotice = nil
    end

    local lib = Util.Imports.Library
    if lib and lib.Toggles then
        for _, name in { "Autofarm", "1 Unit Cutter" } do
            local t = lib.Toggles[name]
            if t and t.GetState and t:GetState() then
                t:Set(false, true)
            end
        end
    end

    self:UnlockUI("Aborted")
end

