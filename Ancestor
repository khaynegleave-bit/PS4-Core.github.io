function Ancestor:BetterDonate()

	local SendUserNotice = Util.Services.ReplicatedStorage.Notices.SendUserNotice
	local DonateGUI = Util.Client.PlayerGui.DonateGUI
	local DonateClient = Util.Imports.Environments.DonateClient
	local SendDonation = DonateClient.sendDonation

	pcall(restorefunction, SendDonation)

	local OldSendDonation
	OldSendDonation = hookfunction(SendDonation, function(...)

		local Success1, ReceivingPlayer = pcall(getupvalue, OldSendDonation, 1)
		local Success2, Value = pcall(getupvalue, OldSendDonation, 2)

		if not (Success1 and Success2) or not (ReceivingPlayer and Value) then
			return
		end

		local SaveSlot = Util.Client.CurrentSaveSlot.Value
		local Money = Util.Client.leaderstats.Money.Value

		DonateClient.exitAll()

		local function Fail(reason)
			SendUserNotice:Fire("Transfer to " .. tostring(ReceivingPlayer.DisplayName) .. " failed; " .. tostring(reason))
			return false
		end

		local ClientSaving = Util.Client:FindFirstChild("CurrentlySavingOrLoading")
		local TargetSaving = ReceivingPlayer:FindFirstChild("CurrentlySavingOrLoading")

		if not ClientSaving or not TargetSaving or ClientSaving.Value or TargetSaving.Value then
			return Fail("Save in progress")
		end

		if SaveSlot <= 0 then
			return Fail("No active save slot")
		end

		if Value < 0 then
			return Fail("Invalid value")
		end

		if Value > Money then
			return Fail("Insufficient funds")
		end

		return OldSendDonation(...)
	end)
end

