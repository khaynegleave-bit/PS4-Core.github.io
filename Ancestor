Util.Imports.ConfigController = (function()
local ConfigController = {}

-- MARK: Internal Utilities
local function DeepCopy(Value)
    if typeof(Value) ~= "table" then
        return Value
    end

    local Result = {}
    for Key, Data in Value do
        Result[Key] = DeepCopy(Data)
    end
    return Result
end

local function IsArrayTable(Value)
    if typeof(Value) ~= "table" then
        return false
    end

    local Count = 0
    for Key in Value do
        if type(Key) ~= "number" then
            return false
        end
        Count += 1
    end

    return Count > 0 and Value[1] ~= nil
end

local function SerializeConfigValue(Value)
    if typeof(Value) == "Color3" then
        return {
            math.floor(Value.R * 255 + 0.5),
            math.floor(Value.G * 255 + 0.5),
            math.floor(Value.B * 255 + 0.5),
        }
    end

    if typeof(Value) ~= "table" then
        return Value
    end

    local Result = {}
    for Key, Data in Value do
        Result[Key] = SerializeConfigValue(Data)
    end
    return Result
end

local function DeserializeConfigValue(Value)
    if typeof(Value) ~= "table" then
        return Value
    end

    local R = Value.R or Value[1]
    local G = Value.G or Value[2]
    local B = Value.B or Value[3]
    if type(R) == "number" and type(G) == "number" and type(B) == "number" then
        local ExtraKeyFound = false
        for Key in Value do
            if Key ~= "R" and Key ~= "G" and Key ~= "B" and Key ~= 1 and Key ~= 2 and Key ~= 3 then
                ExtraKeyFound = true
                break
            end
        end
        if not ExtraKeyFound then
            return Color3.fromRGB(
                math.clamp(math.floor(R + 0.5), 0, 255),
                math.clamp(math.floor(G + 0.5), 0, 255),
                math.clamp(math.floor(B + 0.5), 0, 255)
            )
        end
    end

    local Result = {}
    for Key, Data in Value do
        Result[Key] = DeserializeConfigValue(Data)
    end
    return Result
end

function ConfigController:SanitizeName(Name)
    Name = tostring(Name or "")
    Name = Name:gsub("[\\/:*?\"<>|]", "_"):gsub("^%s+", ""):gsub("%s+$", "")
    return Name
end

function ConfigController:GetFolder(SubFolder)
    local Folder = "Ancestor/Configs"
    if SubFolder then
        Folder = tostring(Folder) .. "/" .. tostring(SubFolder)
    end
    
    if makefolder and isfolder and not isfolder(Folder) then
        local Parts = Folder:split("/")
        local Current = ""
        for _, Part in ipairs(Parts) do
            Current = Current == "" and Part or tostring(Current) .. "/" .. tostring(Part)
            if not isfolder(Current) then
                pcall(makefolder, Current)
            end
        end
    end
    return Folder
end

function ConfigController:GetList(SubFolder)
    local Names = { "None" }
    local Folder = self:GetFolder(SubFolder)

    if listfiles and isfolder and isfolder(Folder) then
        local Success, Files = pcall(listfiles, Folder)
        if Success and type(Files) == "table" then
            for _, FilePath in ipairs(Files) do
                local Name = tostring(FilePath):match("([^\\/]+)%.json$")
                if Name then
                    table.insert(Names, Name)
                end
            end
        end
    end

    table.sort(Names, function(a, b)
        if a == "None" then return true end
        if b == "None" then return false end
        return a < b
    end)

    return Names
end

function ConfigController:BuildJSON(Name, Payload, OrderMap)
    local function GetOrderedKeys(TableValue, PreferredOrder)
        local Ordered = {}
        local Seen = {}

        if PreferredOrder then
            for _, Key in ipairs(PreferredOrder) do
                if TableValue[Key] ~= nil then
                    table.insert(Ordered, Key)
                    Seen[Key] = true
                end
            end
        end

        local Extra = {}
        for Key in TableValue do
            if not Seen[Key] then
                table.insert(Extra, Key)
            end
        end
        table.sort(Extra, function(A, B)
            return tostring(A) < tostring(B)
        end)

        for _, Key in ipairs(Extra) do
            table.insert(Ordered, Key)
        end

        return Ordered
    end

    local function FormatValue(Value, IndentLevel, PreferredOrder)
        local Indent = string.rep("  ", IndentLevel)

        if typeof(Value) == "string" then
            return Util.Services.HttpService:JSONEncode(Value)
        elseif typeof(Value) == "number" or typeof(Value) == "boolean" then
            return tostring(Value)
        elseif Value == nil then
            return "null"
        elseif typeof(Value) ~= "table" then
            return Util.Services.HttpService:JSONEncode(Value)
        end

        if IsArrayTable(Value) then
            local ArrayParts = {}
            for Index = 1, #Value do
                table.insert(ArrayParts, FormatValue(Value[Index], IndentLevel + 1))
            end
            return "[" .. table.concat(ArrayParts, ", ") .. "]"
        end

        local Lines = {"{"}
        local Keys = GetOrderedKeys(Value, PreferredOrder)
        for Index, Key in ipairs(Keys) do
            local ChildOrder = OrderMap and OrderMap[Key]
            local FormattedValue = FormatValue(Value[Key], IndentLevel + 1, ChildOrder)
            local Comma = (Index < #Keys) and "," or ""
            table.insert(Lines, string.rep("  ", IndentLevel + 1) .. Util.Services.HttpService:JSONEncode(Key) .. ": " .. FormattedValue .. Comma)
        end
        table.insert(Lines, Indent .. "}")
        return table.concat(Lines, "\n")
    end

    local SerializedPayload = {}
    for Section, Data in Payload do
        SerializedPayload[Section] = SerializeConfigValue(Data)
    end

    local Data = {
        Name = Name,
        Data = SerializedPayload,
    }

    return FormatValue(Data, 0, { "Name", "Data" })
end

function ConfigController:ApplyPayload(TargetSettings, Payload)
    if typeof(Payload) ~= "table" then return false end

    for SectionName, SectionData in Payload do
        local TargetSection = TargetSettings[SectionName]
        if TargetSection and typeof(SectionData) == "table" then
            for Key, Value in SectionData do
                TargetSection[Key] = DeserializeConfigValue(Value)
            end
        end
    end
    return true
end

function ConfigController:Save(SubFolder, Name, Payload, OrderMap)
    if not writefile then return false end

    Name = self:SanitizeName(Name)
    if Name == "" then return false end

    local FilePath = tostring(self:GetFolder(SubFolder)) .. "/" .. tostring(Name) .. ".json"
    local JSON = self:BuildJSON(Name, Payload, OrderMap)

    local Success = pcall(function()
        writefile(FilePath, JSON)
    end)
    return Success, Name
end

function ConfigController:Load(SubFolder, Name, TargetSettings)
    if not readfile or not isfile then return false end

    Name = self:SanitizeName(Name)
    if Name == "" then return false end

    local FilePath = tostring(self:GetFolder(SubFolder)) .. "/" .. tostring(Name) .. ".json"
    if not isfile(FilePath) then return false end

    local Success, Decoded = pcall(function()
        return Util.Services.HttpService:JSONDecode(readfile(FilePath))
    end)
    if not Success or typeof(Decoded) ~= "table" then return false end

    return self:ApplyPayload(TargetSettings, Decoded.Data or Decoded)
end

function ConfigController:Delete(SubFolder, Name)
    if not delfile or not isfile then return false end

    Name = self:SanitizeName(Name)
    if Name == "" then return false end

    local FilePath = tostring(self:GetFolder(SubFolder)) .. "/" .. tostring(Name) .. ".json"
    if not isfile(FilePath) then return false end

    return pcall(delfile, FilePath)
end

function ConfigController:Export(SubFolder, Name, CurrentPayload)
    local ExportPayload = CurrentPayload
    local ExportName = Name and Name ~= "None" and Name or "Current"

    if Name and Name ~= "None" and readfile and isfile then
        local FilePath = tostring(self:GetFolder(SubFolder)) .. "/" .. tostring(self:SanitizeName(Name)) .. ".json"
        if isfile(FilePath) then
            local Success, Decoded = pcall(function()
                return Util.Services.HttpService:JSONDecode(readfile(FilePath))
            end)
            if Success and typeof(Decoded) == "table" then
                ExportPayload = Decoded.Data or Decoded
                ExportName = Decoded.Name or ExportName
            end
        end
    end

    local SerializedPayload = {}
    for Section, Data in ExportPayload do
        SerializedPayload[Section] = SerializeConfigValue(Data)
    end

    return Util.Services.HttpService:JSONEncode({
        Name = ExportName,
        Data = SerializedPayload,
    })
end

function ConfigController:Import(SubFolder, Text, TargetSettings, PreferredName)
    local Success, Decoded = pcall(function()
        return Util.Services.HttpService:JSONDecode(Text)
    end)
    if not Success or typeof(Decoded) ~= "table" then return false end

    local Payload = Decoded.Data or Decoded
    local Name = self:SanitizeName(PreferredName or Decoded.Name or "Imported Config")
    if Name == "" then Name = "Imported " .. tostring(math.random(100, 999)) end

    local Saved, SavedName = self:Save(SubFolder, Name, Payload)
    if not Saved then return false end

    self:ApplyPayload(TargetSettings, Payload)
    return true, SavedName
end

function ConfigController:GetDefaultPayload(ClientSettingsPath)
    if not readfile or not isfile(ClientSettingsPath) then return {} end
    
    local Success, Decoded = pcall(function()
        return Util.Services.HttpService:JSONDecode(readfile(ClientSettingsPath))
    end)
    
    if Success and typeof(Decoded) == "table" then
        return Decoded
    end
    return {}
end

return ConfigController

end)()

