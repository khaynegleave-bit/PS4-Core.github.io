    }

    local waActiveCapture = nil   -- local to this panel
    local waChips         = {}    -- name → chip TextButton

    -- Safely resolve a settings string to an Enum.KeyCode. Returns Unknown if
    -- the section/key is missing or the string isn't a valid KeyCode name.
    local function safeKeyCode(sectionName, keyName_)
        local sec  = Util.Imports.Settings[sectionName]
        local name = sec and sec[keyName_]
        if type(name) ~= "string" then return Enum.KeyCode.Unknown end
        local ok, kc = pcall(function() return Enum.KeyCode[name] end)
        if ok and typeof(kc) == "EnumItem" then return kc end
        return Enum.KeyCode.Unknown
    end

    for i, entry in ipairs(WA_KEYBINDS) do
        if _isMob_wa then break end   -- no keybinds on mobile
        local row = Instance.new("Frame")
        row.Name                 = "WAKey_" .. entry.name
        row.BackgroundColor3     = T.Element
        row.BorderSizePixel      = 0
        row.Size                 = UDim2.new(1, 0, 0, 37)
        row.LayoutOrder          = KB_HEADER_LO + i
