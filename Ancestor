    panel.AutomaticSize          = Enum.AutomaticSize.Y
    panel.Size                   = UDim2.new(0, 380, 0, 0)
    panel.Visible                = false
    panel.ZIndex                 = 20
    panel.Parent                 = gui

    -- Inner section — identical structure to UILib sections.
