function WireArt:SpreadNodes( points, minDist)
	if #points < 2 then return points end
	local result = { points[1] }
	for i = 2, #points do
		local prev = result[#result]
		local curr = points[i]
		if (curr - prev).Magnitude >= minDist then
			table.insert(result, curr)
		end
	end

	if result[#result] ~= points[#points] then
		table.insert(result, points[#points])
	end
	return result
end

