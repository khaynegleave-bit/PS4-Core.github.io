function CoreFramework:ESP_Setup()
	CoreFramework.ESP_LIST = {}

	local function setup(Player)
		if Player == Util.Client then return end;

		CoreFramework.ESP_LIST[Player] = {
			Lines    = {},
			BoxLines = {},
			SkeletonLines = {},
			Name = Drawing.new("Text"),
			Distance = Drawing.new("Text"),
		}

		local maxLines = 15
		for i = 1, maxLines do 
			table.insert(CoreFramework.ESP_LIST[Player].SkeletonLines, Drawing.new("Line"))
		end

		CoreFramework.ESP_LIST[Player].Lines = { Drawing.new("Line") }
		CoreFramework.ESP_LIST[Player].BoxLines = { Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line") }
	end

	local Players = Util.Services.Players:GetPlayers()
	for _, Player in Players do
		setup(Player)
	end

	Util.Imports.Maid:register("PlayerRemoving" .. tostring(Util.Services.HttpService:GenerateGUID(false)), Util.Services.Players.PlayerAdded:Connect(function(...)
		setup(...)
	end))

	Util.Imports.Maid:register("PlayerRemoving" .. tostring(Util.Services.HttpService:GenerateGUID(false)), Util.Services.Players.PlayerRemoving:Connect(function(Player)

		for _, Line in CoreFramework.ESP_LIST[Player].Lines do
			Line:Remove()
		end

		for _, Line in CoreFramework.ESP_LIST[Player].BoxLines do
			Line:Remove()
		end

		for _, Line in CoreFramework.ESP_LIST[Player].SkeletonLines do
			Line:Remove()
		end


		CoreFramework.ESP_LIST[Player].Name:Remove()
		CoreFramework.ESP_LIST[Player] = nil
	end))
end

function CoreFramework:DrawSkeleton(Lines, Character, RigType, Color)
	Color = Color or Color3.new(1, 1, 1)
	local Bones = CoreFramework.BONES[RigType] or (RigType == Enum.HumanoidRigType.R6 and CoreFramework.BONES.R6) or CoreFramework.BONES.R15
	local lineIndex = 1

	if RigType == Enum.HumanoidRigType.R15 or RigType == "BB" then
		-- R15 & BB: Simple bone-to-bone connections
		for _, Bone in ipairs(Bones) do
			local FromPart = Character:FindFirstChild(Bone[1])
			local ToPart = Character:FindFirstChild(Bone[2])

			if FromPart and ToPart then
				local fromPos, fromOn = CoreFramework:W2S(FromPart.Position)
				local toPos, toOn = CoreFramework:W2S(ToPart.Position)

				if Lines[lineIndex] then
					Lines[lineIndex].From = fromPos
					Lines[lineIndex].To = toPos
					Lines[lineIndex].Visible = fromOn and toOn
					Lines[lineIndex].Color = Color
					Lines[lineIndex].Thickness = 1
					lineIndex = lineIndex + 1
				end
			end
		end
	else
		-- R6: Complex joint handling
		local Torso = Character:FindFirstChild("Torso")
		if not Torso then return end

		local torsoCenter = Torso.Position

		for _, Bone in ipairs(Bones) do
			local ToPart = Character:FindFirstChild(Bone[2])
			if ToPart then
				if Bone[3] == "Joint" then
					-- 1. Calculate the Shoulder/Hip connection point on Torso edge
					local side = Bone[2]:find("Left") and -1 or 1
					local isLeg = Bone[2]:find("Leg")
					local jointOffset = isLeg and Vector3.new(0.5 * side, -1, 0) or Vector3.new(1 * side, 1, 0)
					local jointWorld = Torso.CFrame:PointToWorldSpace(jointOffset * (Torso.Size/2))

					-- 2. Define Elbow/Knee (Part Center) and Hand/Foot (Part Bottom)
					local midLimb = ToPart.Position
					local endLimb = ToPart.CFrame:PointToWorldSpace(Vector3.new(0, -ToPart.Size.Y/2, 0))

					-- SEGMENT A: Torso Center to Shoulder/Hip
					local s1, o1 = CoreFramework:W2S(torsoCenter)
					local s2, o2 = CoreFramework:W2S(jointWorld)
					if Lines[lineIndex] then
						Lines[lineIndex].From = s1; Lines[lineIndex].To = s2; Lines[lineIndex].Visible = o1 and o2
						Lines[lineIndex].Color = Color; Lines[lineIndex].Thickness = 1
						lineIndex = lineIndex + 1
					end

					-- SEGMENT B: Shoulder/Hip to Elbow/Knee
					local s3, o3 = CoreFramework:W2S(jointWorld)
					local s4, o4 = CoreFramework:W2S(midLimb)
					if Lines[lineIndex] then
						Lines[lineIndex].From = s3; Lines[lineIndex].To = s4; Lines[lineIndex].Visible = o3 and o4
						Lines[lineIndex].Color = Color; Lines[lineIndex].Thickness = 1
						lineIndex = lineIndex + 1
					end

					-- SEGMENT C: Elbow/Knee to Hand/Foot
					local s5, o5 = CoreFramework:W2S(midLimb)
					local s6, o6 = CoreFramework:W2S(endLimb)
					if Lines[lineIndex] then
						Lines[lineIndex].From = s5; Lines[lineIndex].To = s6; Lines[lineIndex].Visible = o5 and o6
						Lines[lineIndex].Color = Color; Lines[lineIndex].Thickness = 1
						lineIndex = lineIndex + 1
					end
				else
					-- Head Connection
					local sA, oA = CoreFramework:W2S(Torso.Position)
					local sB, oB = CoreFramework:W2S(ToPart.Position)
					if Lines[lineIndex] then
						Lines[lineIndex].From = sA; Lines[lineIndex].To = sB; Lines[lineIndex].Visible = oA and oB
						Lines[lineIndex].Color = Color; Lines[lineIndex].Thickness = 1
						lineIndex = lineIndex + 1
					end
				end
			end
		end
	end

	-- Cleanup unused lines
	for i = lineIndex, #Lines do Lines[i].Visible = false end
end

function CoreFramework:UpdateLine(Line, worldPosA, worldPosB)
	if not Line then return end
	local screenA, onScreenA = CoreFramework:W2S(worldPosA)
	local screenB, onScreenB = CoreFramework:W2S(worldPosB)

	if onScreenA and onScreenB then
		Line.From = screenA
		Line.To = screenB
		Line.Visible = true
		Line.Thickness = 1
		Line.Color = Color3.new(1, 1, 1)
	else
		Line.Visible = false
	end
end
function CoreFramework:CharacterBounds(Character)
	local hrp = Character:FindFirstChild("HumanoidRootPart") or Character:FindFirstChild("Root")
	if not hrp then return nil end

	local minY, maxY = math.huge, -math.huge
	for _, part in Character:GetChildren() do
		if part:IsA("BasePart") then
			local halfY = part.Size.Y / 2
			minY = math.min(minY, part.Position.Y - halfY)
			maxY = math.max(maxY, part.Position.Y + halfY)
		end
	end

	if minY == math.huge then return nil end

	local top = Vector3.new(hrp.Position.X, maxY, hrp.Position.Z)
	local bot = Vector3.new(hrp.Position.X, minY, hrp.Position.Z)

	local tSp, tOn = CoreFramework:W2S(top)
	local bSp, bOn = CoreFramework:W2S(bot)

	if not tOn and not bOn then return nil end

	local h = math.abs(tSp.Y - bSp.Y)
	local w = h * 0.6
	local cx = (tSp.X + bSp.X) / 2

	return cx - w/2, tSp.Y, cx + w/2, bSp.Y
end

