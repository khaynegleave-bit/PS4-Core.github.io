end

function Ancestor:SetCarSpeed(value)
	local Vehicle = self:GetVehicle()
	if not Vehicle then return end

	local config   = Vehicle:FindFirstChild("Configuration")
	local maxSpeed = config and config:FindFirstChild("MaxSpeed")
	local itemName = Vehicle:FindFirstChild("ItemName")
	if not (maxSpeed and itemName) then return end

	-- Cache the stock MaxSpeed per vehicle type once so we can restore it later.
	local cache = Util.Imports.CoreFramework.Status.DefaultVehicleSpeeds
	if not cache then
		cache = {}
		Util.Imports.CoreFramework.Status.DefaultVehicleSpeeds = cache
	end
	if cache[itemName.Value] == nil then
		cache[itemName.Value] = maxSpeed.Value
	end

	value = value or Util.Imports.Settings.Vehicle.CarSpeed or 1
	-- Slider at 1 = "use default"; anything higher overrides MaxSpeed.
	if value > 1 then
		maxSpeed.Value = value
	else
		maxSpeed.Value = cache[itemName.Value]
	end
end

function Ancestor:GetVehicle()
	local Character = Util.Client.Character
	local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
	local Seat = Humanoid and Humanoid.SeatPart
	return Seat and Seat.Parent
end

