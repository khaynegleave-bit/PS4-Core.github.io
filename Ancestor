    local function makeHdr(text, lo)
        local h = Instance.new("TextLabel")
        h.Name                   = "Hdr_" .. text:gsub("%s+", "_")
        h.BackgroundTransparency = 1
        h.BorderSizePixel        = 0
        h.Size                   = UDim2.new(1, -16, 0, 29)
        h.Text                   = " " .. text
        h.TextColor3             = T.Text
        h.TextSize               = 18
        h.Font                   = Enum.Font.SourceSansBold
        h.TextXAlignment         = Enum.TextXAlignment.Left
        h.LayoutOrder            = lo
        h.ZIndex                 = 21
        h.Parent                 = section
        return h
    end

    -- ── Players ──────────────────────────────────────────────────────────────
    makeHdr("Build For", 11)
    local _imgTargetRestore = borrowTargetPlayerRow(section, 12)
    makeHdr("Use Selected Players Wires", 13)
    local _imgWireSourceRestore = borrowWireSourceRow(section, 14)

    -- ── Image Source (How To Use, Image input, Local dropdown) ───────────────
    makeHdr("Image Source", 20)
    -- borrowed rows 1–3 land here

    -- ── Wire Style ───────────────────────────────────────────────────────────
    makeHdr("Wire Style", 25)
    -- borrowed row 4 (Wire Type dropdown)

    -- ── Sizing ───────────────────────────────────────────────────────────────
    makeHdr("Sizing", 30)
    -- borrowed rows 5–6 (Scale, Threshold sliders)

    -- ── Options ──────────────────────────────────────────────────────────────
    makeHdr("Options", 35)
    -- borrowed row 7 (Boxed Wires Only toggle)

    -- ── Actions ──────────────────────────────────────────────────────────────
    makeHdr("Actions", 40)
    -- borrowed row 8 (Build Image Art button)

    -- Map each borrowed row to a layout slot under the matching header.
    --   1 How To Use    → 21 (Image Source)
    --   2 Image input   → 22 (Image Source)
    --   3 Local dropdown→ 23 (Image Source)
    --   4 Wire Type     → 26 (Wire Style)
    --   5 Scale         → 31 (Sizing)
    --   6 Threshold     → 32 (Sizing)
    --   7 Boxed Wires   → 36 (Options)
    --   8 Build button  → 41 (Actions)
    local ROW_ORDERS = { 21, 22, 23, 26, 31, 32, 36, 41 }

    local function borrow()
        for i, row in ipairs(rows) do
            row.LayoutOrder = ROW_ORDERS[i] or (20 + i)
            row.ZIndex      = 21
            row.Parent      = section
        end
    end
    local function restore()
        for _, row in ipairs(rows) do
            if row.Parent == section and rowHome[row] then
                row.LayoutOrder = rowLO[row]
                row.ZIndex      = rowZ[row]
                row.Parent      = rowHome[row]
            end
        end
    end

    makeScrollable(panel, section, T, 800)
    local show, hide, reset = makePanelFade(panel, section, title, borrow, restore)
    return panel, show, hide, function()
        restore()
        if _imgTargetRestore     then pcall(_imgTargetRestore)     end
        if _imgWireSourceRestore then pcall(_imgWireSourceRestore) end
        pcall(function()
            if hiddenTab and hiddenTab.Container then hiddenTab.Container:Destroy() end
            if hiddenTab and hiddenTab.Button then hiddenTab.Button:Destroy() end
        end)
        reset()
    end
end

