local function _bmGetSetting(action)
    local m = BUILDMODE_ACTION_TO_SETTING[action]
    if not m then return nil end
    local sec = Util.Imports.Settings and Util.Imports.Settings[m.section]
    return sec and sec[m.key]
end

local function _bmSetSetting(action, value)
    local m = BUILDMODE_ACTION_TO_SETTING[action]
    if not m then return end
    local sec = Util.Imports.Settings and Util.Imports.Settings[m.section]
    if sec then sec[m.key] = value end
end

-- Apply any saved keybinds
do
    for _, entry in ipairs(BuildMode.Keybinds) do
        local name = _bmGetSetting(entry.action)
        if name and Enum.KeyCode[name] then
            entry.keyCode = Enum.KeyCode[name]
            entry.display = keyName(entry.keyCode)
        end
    end
end

