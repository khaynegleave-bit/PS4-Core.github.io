function CoreFramework:IsVisible(TargetPart)
    local Camera = workspace.CurrentCamera
    if not TargetPart then return false end

    local MyCharacter = self.TS.Characters:GetCharacter(Util.Client)
    local TargetCharacter = TargetPart.Parent
    for _ = 1, 5 do
        if TargetCharacter and TargetCharacter:FindFirstChild("Root") and TargetCharacter:FindFirstChild("Hitbox") then
            break
        end
        TargetCharacter = TargetCharacter and TargetCharacter.Parent
    end

    local StartPos = Camera.CFrame.Position
    local Direction = TargetPart.Position - StartPos

    local Params = RaycastParams.new()
    Params.FilterType = Enum.RaycastFilterType.Exclude
    Params.FilterDescendantsInstances = { MyCharacter, TargetCharacter }
    Params.IgnoreWater = true

    local Result = workspace:Raycast(StartPos, Direction, Params)
    return Result == nil
end

