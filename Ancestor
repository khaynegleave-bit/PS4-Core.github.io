function CoreFramework:ESP()
	for Player, List in CoreFramework.ESP_LIST do
		local Character = self:GetCharacter(Player)
		if not Character or not Character.Parent then
            CoreFramework:HideAll(Player)
            continue 
        end
        
        local Head = Character:FindFirstChild("Head")
        if not Head then
            CoreFramework:HideAll(Player)
            continue 
        end

		local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        local Head = Character:FindFirstChild("Head")
		local WorldPosition = Character:GetPivot().Position - Vector3.new(0, Character:GetExtentsSize().Y / 2, 0)
		local Position, OnScreen = CoreFramework:W2S(WorldPosition)
		local LocalTeamColor = Util:BrickColorToRGB(Util.Client.TeamColor)
		local EnemyTeamColor = Util:BrickColorToRGB(Player.TeamColor)
		local x1,y1,x2,y2 = CoreFramework:CharacterBounds(Character)

		local TeamColor = (CoreFramework:IsFriendly(Player) and LocalTeamColor or EnemyTeamColor) or (Util.Client.Neutral and Color3.fromRGB(255, 0, 0))

		local function ResolveESPColor(CustomColor, Rainbow)
			if Rainbow then
				return Color3.fromHSV((tick() * 0.25) % 1, 1, 1)
			end
			if typeof(CustomColor) == "table" then
				local R = CustomColor.R or CustomColor[1] or 255
				local G = CustomColor.G or CustomColor[2] or 255
				local B = CustomColor.B or CustomColor[3] or 255
				CustomColor = Color3.fromRGB(R, G, B)
			end
			return typeof(CustomColor) == "Color3" and CustomColor or TeamColor
		end

		local TracerColor = ResolveESPColor(Util.Imports.Settings.ESP.TracersColor, Util.Imports.Settings.ESP.TracersRainbow)
		local BoxColor = ResolveESPColor(Util.Imports.Settings.ESP.BoxesColor, Util.Imports.Settings.ESP.BoxesRainbow)
		local SkeletonColor = ResolveESPColor(Util.Imports.Settings.ESP.SkeletonsColor, Util.Imports.Settings.ESP.SkeletonsRainbow)
		local NameColor = ResolveESPColor(Util.Imports.Settings.ESP.NamesColor, Util.Imports.Settings.ESP.NamesRainbow)

        if not (Character and Humanoid and x1 and Head) then
            CoreFramework:HideAll(Player)
            continue
        end

        local IsVisible = CoreFramework:IsVisible(Head)
        local IsDead = Humanoid.Health <= 0
        local FailedVisibility = Util.Imports.Settings.VisibilityCheck and not IsVisible
        local IsFriendly = Util.Imports.Settings.TeamCheck and (LocalTeamColor == EnemyTeamColor)
        local Disabled = not Util.Imports.Settings.ESP.Enabled

        if IsDead or FailedVisibility or IsFriendly or Disabled then
            CoreFramework:HideAll(Player)
            continue
        end

		local Draw = OnScreen and Humanoid ~= nil
		local RigType = Humanoid.RigType

		if Util.Imports.Settings.ESP.Tracers then
			CoreFramework:DrawTracer(List.Lines[1], x1, y1, x2, y2, TracerColor, Draw)
		else
			CoreFramework:Hide(List.Lines)
		end

		if Util.Imports.Settings.ESP.Boxes then
			CoreFramework:DrawBox(List.BoxLines, x1, y1, x2, y2, BoxColor, Draw)
		else
			CoreFramework:Hide(List.BoxLines)
		end

		if Util.Imports.Settings.ESP.Skeletons then
			CoreFramework:DrawSkeleton(List.SkeletonLines, Character, RigType, SkeletonColor)
		else
			CoreFramework:Hide(List.SkeletonLines)
		end

		if Util.Imports.Settings.ESP.Names then
			CoreFramework:DrawName(List.Name, Player.DisplayName, NameColor, x1, x2, y1)
		else
			CoreFramework:Hide({ List.Name })
		end
	end
end

function CoreFramework:DrawFOVCircle()
	local Centre = Vector2.new(workspace.CurrentCamera.ViewportSize.X / 2, workspace.CurrentCamera.ViewportSize.Y / 2)
	CoreFramework.FOVCircle.Position = Centre
	CoreFramework.FOVCircle.Radius   = Util.Imports.Settings.Aimbot.FOVSize

	local FOVColor = Util.Imports.Settings.Aimbot.FOVColor
	if Util.Imports.Settings.Aimbot.FOVRainbow then
		FOVColor = Color3.fromHSV((tick() * 0.25) % 1, 1, 1)
	elseif typeof(FOVColor) == "table" then
		local R = FOVColor.R or FOVColor[1] or 255
		local G = FOVColor.G or FOVColor[2] or 255
		local B = FOVColor.B or FOVColor[3] or 255
		FOVColor = Color3.fromRGB(R, G, B)
	end

	CoreFramework.FOVCircle.Color    = typeof(FOVColor) == "Color3" and FOVColor or Color3.fromRGB(255, 255, 255)
	CoreFramework.FOVCircle.Visible  = Util.Imports.Settings.Aimbot.ShowFOV
end

function CoreFramework:Initiate()

	CoreFramework:ESP_Setup()

	Util.Imports.Maid:register("MainLoop", Util.Services.RunService.Stepped:Connect(function()

		CoreFramework:DrawFOVCircle()
		CoreFramework:ESP()
		CoreFramework:Aimbot()
        CoreFramework:Triggerbot()

		CoreFramework:UpdateNoclip()

		--Lighting
		Util.Services.Lighting.ClockTime = (Util.Imports.Settings.Environment.AlwaysDay and 12) or (Util.Imports.Settings.Environment.AlwaysNight and 0) or Util.Services.Lighting.ClockTime
		Util.Services.Lighting.FogEnd = not (Util.Imports.Settings.Environment.Fog) and 1000000 or Util.Services.Lighting.FogEnd
		Util.Services.Lighting.GlobalShadows = Util.Imports.Settings.Environment.Shadows
