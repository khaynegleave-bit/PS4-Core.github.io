function Util:DeepCopy(orig)
    local orig_type = typeof(orig)
    if orig_type == "table" then
        local copy = {}
        for key, value in next, orig do
            copy[self:DeepCopy(key)] = self:DeepCopy(value)
        end
        return copy
    elseif orig_type == "Vector3" or orig_type == "CFrame" or orig_type == "Color3" or orig_type == "UDim2" or orig_type == "NumberSequence" or orig_type == "ColorSequence" then
        return orig
    else
