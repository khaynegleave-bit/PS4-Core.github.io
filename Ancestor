    for _, v in ipairs(Card:GetDescendants()) do
        if v:IsA("TextLabel") then
            TweenService:Create(v, DismissInfo, { TextTransparency = 1 }):Play()
        elseif v:IsA("ImageLabel") then
            TweenService:Create(v, DismissInfo, { ImageTransparency = 1 }):Play()
        elseif v:IsA("Frame") then
            TweenService:Create(v, DismissInfo, { BackgroundTransparency = 1 }):Play()
        end
