function CoreFramework:LassoStart(countLabel)
    -- Only allowed inside build mode — refuse silently if not active.
    if not (Util.Imports.BuildMode and Util.Imports.BuildMode._active) then return end
    if self.Status.LassoActive then return end
    -- Destroy any leftover overlay from a previous run (re-exec safety).
    local oldGui = Util.Services.CoreGui:FindFirstChild("LassoOverlay")
    if oldGui then pcall(function() oldGui:Destroy() end) end
    -- Disconnect any lingering direct connections from a previous call.
    if self._lassoDragConns then
        for _, c in self._lassoDragConns do pcall(function() c:Disconnect() end) end
        self._lassoDragConns = nil
    end
    self.Status.LassoActive = true
    self._lassoCountLabel = countLabel
    self._lassoBoxes = self._lassoBoxes or {}

    -- Screen-space drag-rectangle overlay
    local gui = Instance.new("ScreenGui")
    gui.Name = "LassoOverlay"
    gui.ResetOnSpawn = false
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.IgnoreGuiInset = true
    gui.Parent = Util.Services.CoreGui
    self._lassoGui = gui

    local rect = Instance.new("Frame")
    rect.Name = "SelectionRect"
    rect.BackgroundColor3 = Color3.fromRGB(0, 162, 255)
    rect.BackgroundTransparency = 0.78
    rect.BorderSizePixel = 0
    rect.Visible = false
    rect.ZIndex = 100
    rect.Parent = gui

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(0, 162, 255)
    stroke.Thickness = 1.5
    stroke.Parent = rect

    local dragging = false
    local startPos = Vector2.zero

    local function applyRect(p1, p2)
        local minX = math.min(p1.X, p2.X)
        local minY = math.min(p1.Y, p2.Y)
        local maxX = math.max(p1.X, p2.X)
        local maxY = math.max(p1.Y, p2.Y)
        rect.Position = UDim2.fromOffset(minX, minY)
        rect.Size     = UDim2.fromOffset(maxX - minX, maxY - minY)
        return minX, minY, maxX, maxY
    end

    -- model:GetPivot() returns the WorldPivot which doesn't update when parts
    -- are moved via direct CFrame assignment (the stacker placement uses that
    -- path). GetBoundingBox().Position is always derived from current part
    -- positions, so it stays correct after any movement.
    local function modelWorldPos(model)
        local ok, cf = pcall(function() return (model:GetBoundingBox()) end)
        if ok and cf then return cf.Position end
        return model:GetPivot().Position
    end

    local function updateSelection(minX, minY, maxX, maxY)
        local camera = workspace.CurrentCamera
        if Util.Imports.CoreFramework._groupSelect then
            -- Group selection: for each item type that falls inside the rectangle,
            -- select every item of that type on the property (not just those on screen).
            local processedTypes = {}
            for _, model in Util.Imports.Paths.PlayerModels:GetChildren() do
                if not self:LassoCanSelect(model) then continue end
                local screenPos, onScreen = camera:WorldToViewportPoint(modelWorldPos(model))
                if not onScreen then continue end
                if screenPos.X >= minX and screenPos.X <= maxX
                and screenPos.Y >= minY and screenPos.Y <= maxY then
                    local nameObj = model:FindFirstChild("ItemName")
                        or model:FindFirstChild("BoxItemName")
                        or model:FindFirstChild("PurchasedBoxItemName")
                        or model:FindFirstChild("TreeClass")
                    local typeName = nameObj and nameObj.Value
                    if typeName and not processedTypes[typeName] then
                        processedTypes[typeName] = true
                        -- Select every selectable item of this type
                        for _, other in Util.Imports.Paths.PlayerModels:GetChildren() do
                            local otherName = other:FindFirstChild("ItemName")
                                or other:FindFirstChild("BoxItemName")
                                or other:FindFirstChild("PurchasedBoxItemName")
                                or other:FindFirstChild("TreeClass")
                            if self:LassoCanSelect(other) and otherName and otherName.Value == typeName then
                                self:LassoSelectItem(other)
                            end
                        end
                    elseif not typeName then
                        -- No type name — fall back to selecting just this item
                        self:LassoSelectItem(model)
                    end
                end
            end
        else
            for _, model in Util.Imports.Paths.PlayerModels:GetChildren() do
                if not self:LassoCanSelect(model) then continue end
                local screenPos, onScreen = camera:WorldToViewportPoint(modelWorldPos(model))
                if not onScreen then continue end
                if screenPos.X >= minX and screenPos.X <= maxX
                and screenPos.Y >= minY and screenPos.Y <= maxY then
                    self:LassoSelectItem(model)
                end
            end
        end
    end

    -- Mouse OR touch — same rectangle logic for both. Touch carries position in input.Position;
    -- for mouse we read GetMouseLocation() instead since MouseMovement.Position can lag.
    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end
    local function pointerPos(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            return Vector2.new(input.Position.X, input.Position.Y)
        end
        return Util.Services.UserInputService:GetMouseLocation()
    end

    local c1 = Util.Services.UserInputService.InputBegan:Connect(function(input, processed)
        if not isPointer(input) then return end
        dragging = true
        startPos = pointerPos(input)
        applyRect(startPos, startPos)
        rect.Visible = true
    end)
    local c2 = Util.Services.UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
           and input.UserInputType ~= Enum.UserInputType.Touch then return end
        applyRect(startPos, pointerPos(input))
    end)
    local c3 = Util.Services.UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if not isPointer(input) then return end
        dragging = false
        local minX, minY, maxX, maxY = applyRect(startPos, pointerPos(input))
        updateSelection(minX, minY, maxX, maxY)
        rect.Visible = false
    end)
    Util.Imports.Maid:register("LassoDragBegin",   c1)
    Util.Imports.Maid:register("LassoDragChanged", c2)
    Util.Imports.Maid:register("LassoDragEnd",     c3)
    self._lassoDragConns = { c1, c2, c3 }
end

function CoreFramework:LassoStop()
    self.Status.LassoActive = false

    if self._lassoDragConns then
        for _, c in self._lassoDragConns do pcall(function() c:Disconnect() end) end
        self._lassoDragConns = nil
    end
    Util.Imports.Maid:deregister("LassoDragBegin")
    Util.Imports.Maid:deregister("LassoDragChanged")
    Util.Imports.Maid:deregister("LassoDragEnd")

    if self._lassoGui and self._lassoGui.Parent then
        self._lassoGui:Destroy()
    end
    self._lassoGui = nil
    -- Also clean up any orphaned overlay from a previous re-exec.
    local old = Util.Services.CoreGui:FindFirstChild("LassoOverlay")
    if old then pcall(function() old:Destroy() end) end
end

function CoreFramework:LassoGroupSelect(Query)
    local anySelected = false
    for _, selected in self.Status.LassoSelectedItems do
        local name = selected:FindFirstChild("ItemName") or selected:FindFirstChild("BoxItemName") or selected:FindFirstChild("PurchasedBoxItemName") or selected:FindFirstChild("TreeClass")
        if name and name.Value == Query then
            anySelected = true
            break
        end
    end

    for _, Item in Util.Imports.Paths.PlayerModels:GetChildren() do
        local name = Item:FindFirstChild("ItemName") or Item:FindFirstChild("BoxItemName") or Item:FindFirstChild("PurchasedBoxItemName") or Item:FindFirstChild("TreeClass")
        if self:LassoCanSelect(Item) and name and name.Value == Query then
            if anySelected then
                self:LassoDeselectItem(Item)
            else
                self:LassoSelectItem(Item)
            end
        end
    end
end

function CoreFramework:LassoClickStart()
    -- Only allowed inside build mode — refuse silently if not active.
    if not (Util.Imports.BuildMode and Util.Imports.BuildMode._active) then return end
    -- Disconnect any lingering click connections from a previous call / re-exec.
    if self._lassoClickConns then
        for _, c in self._lassoClickConns do pcall(function() c:Disconnect() end) end
        self._lassoClickConns = nil
    end

    local clickStart  = Vector2.zero
    local clickActive = false

    local function isPointer(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch
    end
    local function pointerPos(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            return Vector2.new(input.Position.X, input.Position.Y)
        end
        return Util.Services.UserInputService:GetMouseLocation()
    end

    local beginConn = Util.Services.UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if not isPointer(input) then return end
        clickActive = true
        clickStart  = pointerPos(input)
    end)

    local endConn = Util.Services.UserInputService.InputEnded:Connect(function(input, processed)
        if processed then return end
        if not isPointer(input) then return end
        if not clickActive then return end
        clickActive = false

        local cur = pointerPos(input)
        if (cur - clickStart).Magnitude >= 6 then return end

        local camera = workspace.CurrentCamera
        local ray    = camera:ViewportPointToRay(cur.X, cur.Y)
        local result = workspace:Raycast(ray.Origin, ray.Direction * 1000)
        if not result then return end

        local model = result.Instance.Parent
        if not self:LassoCanSelect(model) then return end
        local ItemName = model:FindFirstChild("ItemName") or model:FindFirstChild("BoxItemName") or model:FindFirstChild("PurchasedBoxItemName")
        local TreeClass = model:FindFirstChild("TreeClass")
        if Util.Imports.CoreFramework._groupSelect and (ItemName or TreeClass) then
            self:LassoGroupSelect(ItemName and ItemName.Value or TreeClass.Value)
        elseif table.find(self.Status.LassoSelectedItems, model) then
            self:LassoDeselectItem(model)
        else
            self:LassoSelectItem(model)
        end
    end)

    Util.Imports.Maid:register("LassoClickBegin", beginConn)
    Util.Imports.Maid:register("LassoClickEnd",   endConn)
    self._lassoClickConns = { beginConn, endConn }
end

function CoreFramework:LassoClickStop()
    if self._lassoClickConns then
        for _, c in self._lassoClickConns do pcall(function() c:Disconnect() end) end
        self._lassoClickConns = nil
    end
    Util.Imports.Maid:deregister("LassoClickBegin")
    Util.Imports.Maid:deregister("LassoClickEnd")
end

-- Lock / unlock the lasso stack preview from following the mouse.
function CoreFramework:LassoLockPreview()   self._lassoLocked = true  end
function CoreFramework:LassoUnlockPreview() self._lassoLocked = false end
function CoreFramework:LassoIsLocked()      return self._lassoLocked == true end
function CoreFramework:LassoHasPreview()    return self._lassoPreviewModel ~= nil end

-- Apply the current rotation to the lasso preview at its frozen position.
function CoreFramework:LassoApplyRotationInPlace()
    local preview = self._lassoPreviewModel
    if not preview then return end
    local pos = preview:GetPivot().Position
    preview:PivotTo(CFrame.new(pos) * Util.Imports.Placement:GetRotationCFrame())
    Util.Imports.Placement._BottomOffsetRotKey = nil
end

function CoreFramework:LassoClearPreview()
    for _, key in {"LassoPreviewUpdate","LassoPreviewConfirm","LassoRotateY","LassoRotateZ","LassoRotateX"} do
        Util.Imports.Maid:deregister(key)
    end
    self._lassoLocked = false
    self._lassoLastValidPivot = nil

    -- Reset shared rotation state so Wire Art / next preview start clean
    local rot = Util.Imports.Placement.Settings.Rotations
    rot.X = 0  rot.Y = 0  rot.Z = 0
    Util.Imports.Placement._BottomOffset       = nil
    Util.Imports.Placement._BottomOffsetRotKey = nil

    if self._lassoPreviewModel and self._lassoPreviewModel.Parent then
        self._lassoPreviewModel:Destroy()
    end
    self._lassoPreviewModel    = nil
    self._lassoPreviewItems    = nil
    self._lassoPreviewOffsets  = nil
    self._lassoPreviewRefParts = nil

    local orphan = workspace:FindFirstChild("LassoPreview")
    if orphan then orphan:Destroy() end
end

function CoreFramework:RefreshLassoKeybinds(rot)
    local UIS  = Util.Services.UserInputService
    local keys = Util.Imports.Settings.Placement
    if not keys then return end
    rot = rot or (Util.Imports.Placement and Util.Imports.Placement.Settings.Rotations)
    if not rot then return end

    for _, name in {"LassoRotateY", "LassoRotateZ", "LassoRotateX"} do
        Util.Imports.Maid:deregister(name)
    end

    local kY = Enum.KeyCode[keys.RotateYKey]
    local kZ = Enum.KeyCode[keys.RotateTiltKey]
    local kX = Enum.KeyCode[keys.RotateXKey]

    Util.Imports.Maid:register("LassoRotateY", UIS.InputBegan:Connect(function(key, processed)
        if not processed and key.KeyCode == kY then
            rot.Y += 90
            if self._lassoLocked then self:LassoApplyRotationInPlace() end
        end
    end))
    Util.Imports.Maid:register("LassoRotateZ", UIS.InputBegan:Connect(function(key, processed)
        if not processed and key.KeyCode == kZ then
            rot.Z += 90
            if self._lassoLocked then self:LassoApplyRotationInPlace() end
        end
    end))
    Util.Imports.Maid:register("LassoRotateX", UIS.InputBegan:Connect(function(key, processed)
        if not processed and key.KeyCode == kX then
            rot.X += 90
            if self._lassoLocked then self:LassoApplyRotationInPlace() end
        end
    end))
end

function CoreFramework:LassoPreview(xAxis, yAxis, zAxis)
    self:LassoClearPreview()
    self._lassoLocked = false
    self._lassoLastValidPivot = nil
    -- Align snap with the visual grid on the player's property.
    pcall(function() Util.Imports.Placement:RefreshSnapAnchor() end)

    -- Shallow copy so we don't mutate the live selection list
    local items = {}
    for _, v in ipairs(self.Status.LassoSelectedItems) do
        table.insert(items, v)
    end
    if #items == 0 then
        self:Notice("No items selected.", 3)
        return
    end

    local function _snapRotation(cf)
        local rx, ry, rz = cf:ToEulerAnglesXYZ()
        local s = math.pi / 2
        return CFrame.new(cf.Position)
            * CFrame.fromEulerAnglesXYZ(
                math.round(rx / s) * s,
                math.round(ry / s) * s,
                math.round(rz / s) * s
            )
    end

    local function _topY(model)
        local cf, size = model:GetBoundingBox()
        local h = size * 0.5
        local top = -math.huge
        for _, sx in ipairs({ -h.X, h.X }) do
            for _, sy in ipairs({ -h.Y, h.Y }) do
                for _, sz in ipairs({ -h.Z, h.Z }) do
                    local y = cf:PointToWorldSpace(Vector3.new(sx, sy, sz)).Y
                    if y > top then top = y end
                end
            end
        end
        return top
    end

    local processed = {}
    for _, model in ipairs(items) do
        if not model or not model.Parent then continue end

        local clone = model:Clone()
        -- Strip scripts AND any placement-pin constraints/attachments left over
        -- from a previous Item Stacker run.
        for _, desc in clone:GetDescendants() do
            if desc:IsA("Script")
               or desc:IsA("LocalScript")
               or desc:IsA("AlignPosition")
               or desc:IsA("AlignOrientation")
               or (desc:IsA("Attachment") and desc.Name == "StackerPin") then
                desc:Destroy()
            end
        end

        -- Find a reference part. Prefer WoodSection (planks/logs) since the
        -- model's pivot is unreliable after prior stacker runs; fall back to
        -- PrimaryPart or the first BasePart so boxed items still work.
        local refPart
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") and d.Name == "WoodSection" then
                refPart = d; break
            end
        end
        if not refPart then refPart = clone.PrimaryPart end
        if not refPart then
            for _, d in ipairs(clone:GetDescendants()) do
                if d:IsA("BasePart") then refPart = d; break end
            end
        end
        if not refPart then continue end

        -- Anchor / style the clone's parts. Use Model:PivotTo for positioning
        -- (NOT direct CFrame assignment) so the clone's WorldPivot stays in
        -- sync — same teleport mechanism the live placement uses.
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored     = true
                d.CanCollide   = false
                d.CanQuery     = false
                d.Transparency = math.min(d.Transparency + 0.4, 0.9)
            end
        end

        -- Make refPart act as the model's pivot so subsequent PivotTo lands
        -- the refPart exactly on the target CFrame.
        clone.PrimaryPart = refPart

        local function moveTo(targetCF)
            clone:PivotTo(targetCF)
        end

        local _, sz = clone:GetBoundingBox()
        table.insert(processed, {
            model    = model,
            clone    = clone,
            refPart  = refPart,
            moveTo   = moveTo,
            size     = sz,
            vol      = sz.X * sz.Y * sz.Z,
            worldY   = _topY(model),
        })
    end

    table.sort(processed, function(a, b)
        if a.vol ~= b.vol then return a.vol > b.vol end
        return a.worldY < b.worldY
    end)

    items = {}
    for _, p in ipairs(processed) do table.insert(items, p.model) end

    xAxis  = math.max(1, math.floor(xAxis or 1))
    zAxis  = math.max(1, math.floor(zAxis or 1))
    yAxis  = math.max(1, math.floor(yAxis or math.ceil(#processed / (xAxis * zAxis))))
    local yCount = yAxis

    local cellX, cellY, cellZ = 0, 0, 0
    for _, p in ipairs(processed) do
        if p.size.X > cellX then cellX = p.size.X end
        if p.size.Y > cellY then cellY = p.size.Y end
        if p.size.Z > cellZ then cellZ = p.size.Z end
    end
    cellX = math.max(cellX, 0.1)
    cellY = math.max(cellY, 0.1)
    cellZ = math.max(cellZ, 0.1)

    -- Per-column stack tops so each item sits precisely on the one below it,
    -- regardless of height variation between items.
    local columnTop = {}
    local function colTop(x, z)
        columnTop[x] = columnTop[x] or {}
        return columnTop[x][z] or 0
    end
    local function colAdvance(x, z, h)
        columnTop[x] = columnTop[x] or {}
        columnTop[x][z] = (columnTop[x][z] or 0) + h
    end

    local finalOffsets = {}
    local count = 0
    for y = 1, yCount do
        for x = 1, xAxis do
            for z = 1, zAxis do
                count += 1
                if count > #processed then break end
                local p    = processed[count]
                local halfH = p.size.Y / 2
                local centerY = colTop(x, z) + halfH
                colAdvance(x, z, p.size.Y)
                finalOffsets[count] = CFrame.new(
                    (x - 0.5) * cellX - xAxis * cellX * 0.5,
                    centerY,
                    (z - 0.5) * cellZ - zAxis * cellZ * 0.5
                )
            end
            if count > #processed then break end
        end
        if count > #processed then break end
    end

    -- Re-centre X and Z on the actual placed items so the group tracks the mouse
    -- correctly even when fewer items exist than the configured axis count.
    if #finalOffsets > 0 then
        local sumX, sumZ = 0, 0
        for _, off in ipairs(finalOffsets) do
            sumX += off.X
            sumZ += off.Z
        end
        local cx = sumX / #finalOffsets
        local cz = sumZ / #finalOffsets
        for i, off in ipairs(finalOffsets) do
            finalOffsets[i] = CFrame.new(off.X - cx, off.Y, off.Z - cz)
        end
    end

    local group = Instance.new("Model")
    group.Name = "LassoPreview"

    local pivot = Instance.new("Part")
    pivot.Name        = "PreviewPivot"
    pivot.Size        = Vector3.new(0.1, 0.1, 0.1)
    pivot.Transparency = 1
    pivot.CanCollide  = false
    pivot.CanQuery    = false
    pivot.Anchored    = true
    pivot.Parent      = group
    group.PrimaryPart = pivot

    for i, p in ipairs(processed) do
        if not finalOffsets[i] then continue end
        -- Direct CFrame placement via the reference part — bypasses PivotTo
        -- which becomes unreliable after the model has been moved/pinned by
        -- a prior stacker run.
        p.moveTo(finalOffsets[i])
        p.clone.Parent = group
    end

    group.Parent = workspace
    self._lassoPreviewModel   = group
    self._lassoPreviewItems   = items
    self._lassoPreviewOffsets = finalOffsets
    -- Per-item: clone's reference part (whose CFrame is the EXACT world position
    -- the user sees in the preview). Captured at place-time so placement can
    -- mirror the preview pixel-perfect instead of reconstructing via math.
    self._lassoPreviewRefParts = {}
    for i, p in ipairs(processed) do
        self._lassoPreviewRefParts[i] = p.refPart
    end

    -- Seed _lassoLastValidPivot at the player's character so any subsequent
    -- off-property frame has a guaranteed on-property fallback target.
    local char = Util.Client.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        pcall(function() group:PivotTo(CFrame.new(root.Position)) end)
        if Util.Imports.Placement:IsOnProperty(group) then
            self._lassoLastValidPivot = group:GetPivot()
        end
    end

    local rot = Util.Imports.Placement.Settings.Rotations
    rot.X = 0  rot.Y = 0  rot.Z = 0
    Util.Imports.Placement._BottomOffset       = nil
    Util.Imports.Placement._BottomOffsetRotKey = nil

    self:RefreshLassoKeybinds(rot)

    Util.Imports.Maid:register("LassoPreviewUpdate", Util.Services.RunService.PreSimulation:Connect(function()
        if self._lassoLocked then return end
        local preview = self._lassoPreviewModel
        if not preview or not preview.Parent then return end

        local camera   = workspace.CurrentCamera
        local mouseLoc = Util.Services.UserInputService:GetMouseLocation()
        local ray      = camera:ViewportPointToRay(mouseLoc.X, mouseLoc.Y)

        -- Pass 1: cursor ray. Light filter so it hits whatever the user is
        -- pointing at (placed items, tables, blueprints, terrain — anything
        -- they might legitimately want to stack ON).
        local cursorParams = RaycastParams.new()
        local cursorFilter = { preview }
        if Util.Client.Character then table.insert(cursorFilter, Util.Client.Character) end
        for _, plr in Util.Services.Players:GetPlayers() do
            if plr.Character then table.insert(cursorFilter, plr.Character) end
        end
        cursorParams.FilterDescendantsInstances = cursorFilter
        cursorParams.FilterType = Enum.RaycastFilterType.Exclude

        local cursorHit = workspace:Raycast(ray.Origin, ray.Direction * 2000, cursorParams)
        if not cursorHit then return end

        -- Pass 2: from just above the cursor hit, cast straight down with all
        -- placed items / structures excluded so we land on the actual property
        -- floor. We use this to decide whether the cursor hit was "reasonable"
        -- (close to the floor — a table, a stack to build on) or "sky-floating"
        -- (a tree leaf far above the spot the user is actually pointing at).
        local groundParams = RaycastParams.new()
        local groundFilter = { preview }
        if Util.Client.Character then table.insert(groundFilter, Util.Client.Character) end
        for _, plr in Util.Services.Players:GetPlayers() do
            if plr.Character then table.insert(groundFilter, plr.Character) end
        end
        if Util.Imports.Paths.PlayerModels then
            table.insert(groundFilter, Util.Imports.Paths.PlayerModels)
        end
        groundParams.FilterDescendantsInstances = groundFilter
        groundParams.FilterType = Enum.RaycastFilterType.Exclude

        local downOrigin = Vector3.new(cursorHit.Position.X, cursorHit.Position.Y + 50, cursorHit.Position.Z)
        local groundHit  = workspace:Raycast(downOrigin, Vector3.new(0, -500, 0), groundParams)
        local floorY     = groundHit and groundHit.Position.Y

        -- Use the cursor hit Y by default (so tables, blueprints, existing
        -- stacks all still work). Only fall back to the floor when the cursor
        -- hit is unrealistically high above the actual ground — that's the
        -- sky-leaf / floating-obstacle case the user was complaining about.
        local MAX_PLACE_HEIGHT_ABOVE_FLOOR = 15
        local groundY = cursorHit.Position.Y
        if floorY and (cursorHit.Position.Y - floorY) > MAX_PLACE_HEIGHT_ABOVE_FLOOR then
            groundY = floorY
        end

        local snappedX, snappedZ = Util.Imports.Placement:SnapXZ(cursorHit.Position.X, cursorHit.Position.Z, preview)

        local rotation = Util.Imports.Placement:GetRotationCFrame()
        preview:PivotTo(CFrame.new(snappedX, groundY, snappedZ) * rotation)

        local bottomY = Util.Imports.Placement:GetPreviewBottomY(preview)
        preview:PivotTo(preview:GetPivot() + Vector3.new(0, groundY - bottomY, 0))

        -- Hard constraint: preview must NEVER leave the player's property.
        if Util.Imports.Placement:IsOnProperty(preview) then
            self._lassoLastValidPivot = preview:GetPivot()
        else
            if not self._lassoLastValidPivot then
                local char = Util.Client.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if root then
                    self._lassoLastValidPivot = CFrame.new(root.Position)
                end
            end
            if self._lassoLastValidPivot then
                preview:PivotTo(self._lassoLastValidPivot)
            end
        end
    end))

end

-- MARK: Stacker Queue

function CoreFramework:StartStackerQueue(groups, xAxis, yAxis, zAxis)
    self._stackerQueue      = groups
    self._stackerQueueIndex = 0
    self._stackerQueueAxes  = { x = xAxis, y = yAxis, z = zAxis }
    self:_advanceStackerGroup()
end

function CoreFramework:ClearStackerQueue()
    self._stackerQueue      = nil
    self._stackerQueueIndex = nil
    self._stackerQueueAxes  = nil
end

function CoreFramework:_advanceStackerGroup()
    self._stackerQueueIndex = (self._stackerQueueIndex or 0) + 1
    local group = self._stackerQueue and self._stackerQueue[self._stackerQueueIndex]
    if not group then
        self:ClearStackerQueue()
        pcall(function() self:LassoClearSelection() end)
        return
    end
    local total   = #self._stackerQueue
    local idx     = self._stackerQueueIndex
    local first   = group[1]
    local name    = first and first.Name or "Items"
    local isBoxed = first and (first:FindFirstChild("BoxItemName") ~= nil or first:FindFirstChild("PurchasedBoxItemName") ~= nil)
    local label   = name .. (isBoxed and " (boxed)" or "")
    self:Notice("Stacking group " .. tostring(idx) .. "/" .. tostring(total) .. ": " .. tostring(label) .. " (" .. tostring(#group) .. " item" .. tostring(#group ~= 1 and "s" or "") .. ")", 4)
    -- Destroy selection boxes for all previously-selected items before replacing
    -- the list, otherwise their boxes linger visually.
    if self._lassoBoxes then
        for _, model in ipairs(self.Status.LassoSelectedItems) do
            if self._lassoBoxes[model] then
                pcall(function() self._lassoBoxes[model]:Destroy() end)
                self._lassoBoxes[model] = nil
            end
        end
    end
    self.Status.LassoSelectedItems = group
    local axes = self._stackerQueueAxes
    local y    = axes.y > 0 and axes.y or nil
    self:LassoPreview(axes.x, y, axes.z)
end

-- MARK: Lasso Begin Placement

function CoreFramework:LassoBeginPlacement()
    local preview = self._lassoPreviewModel
    if not preview then return end

    -- Hard refuse if preview is somehow off-property at confirm time.
    if not Util.Imports.Placement:IsOnProperty(preview) then
        self:LassoClearPreview()
        return self:Notice("Item Stacker cancelled — placement is outside your property.")
    end

    local items    = self._lassoPreviewItems
    local offsets  = self._lassoPreviewOffsets
    local refParts = self._lassoPreviewRefParts
    if not items or not offsets or #items == 0 then return end

    local originCF = preview:GetPivot()

    -- Capture the EXACT world CFrame of each clone's reference part RIGHT NOW
    -- (before LassoClearPreview destroys them). This is what the user actually
    -- sees in the preview — placement teleports each real item's reference
    -- part to this exact CFrame for a pixel-perfect match.
    local previewRefCFs = {}
    if refParts then
        for i, refPart in ipairs(refParts) do
            if refPart and refPart.Parent then
                previewRefCFs[i] = refPart.CFrame
            end
        end
    end

    -- Destroy the preview first, so it's gone before any teleports fire
    self:LassoClearPreview()
    pcall(function() Util.Imports.BuildMode:RefreshLockVisual() end)

    -- Strip any items that are already gone or have no offset before we count
    local validItems    = {}
    local validOffsets  = {}
    local validRefCFs   = {}
    for i, model in ipairs(items) do
        if model and model.Parent and offsets[i] then
            table.insert(validItems,   model)
            table.insert(validOffsets, offsets[i])
            table.insert(validRefCFs,  previewRefCFs[i])  -- may be nil; fallback uses computed targetCF
        end
    end
    items    = validItems
    offsets  = validOffsets
    refParts = validRefCFs

    local session  = {}
    local total    = #items
    local placed   = 0
    local startedAt = os.clock()
    local progressNotice

    local function formatDuration(seconds)
        seconds = math.max(0, math.floor(seconds + 0.5))
        local minutes   = math.floor(seconds / 60)
        local remainder = seconds % 60
        if minutes > 0 then
            return tostring(minutes) .. "m " .. tostring(remainder) .. "s"
        end
        return tostring(remainder) .. "s"
    end

    local function isActive()
        return self.Status._lassoPlacementSession == session
    end

    local function updateNotice()
        if not isActive() then return end
        local remaining = math.max(total - placed, 0)
        local etaText   = "calculating"
        if placed > 0 then
            local elapsed = os.clock() - startedAt
            etaText = formatDuration((elapsed / placed) * remaining)
        end
        local message = "Placing items: " .. tostring(placed) .. "/" .. tostring(total) .. ", " .. tostring(remaining) .. " left, ETA " .. tostring(etaText)
        if progressNotice and progressNotice:IsActive() then
            progressNotice:Set(message)
        else
            progressNotice = self:Notice(message, false)
        end
        progressNotice:SetProgress(placed / math.max(total, 1))
    end

    -- Truck setup (optional)
    local vehicle            = nil
    local oldVehiclePosition = nil
    local _vehConstraints    = {}

    local function clearVehicleLock()
        for _, obj in _vehConstraints do pcall(function() obj:Destroy() end) end
        table.clear(_vehConstraints)
    end

    -- Apply AlignPosition + AlignOrientation at the vehicle's current position so it
    -- stays frozen in place even when constraints from the previous item are cleared.
    local function lockVehicleInPlace()
        if not (vehicle and vehicle.Parent) then return end
        clearVehicleLock()
        local primary = vehicle.PrimaryPart
        if not primary then return end
        local att = Instance.new("Attachment", primary)
        local ap  = Instance.new("AlignPosition")
        ap.Mode             = Enum.PositionAlignmentMode.OneAttachment
        ap.Position         = primary.Position
        ap.MaxForce         = math.huge
        ap.Responsiveness   = 200
        ap.RigidityEnabled  = true
        ap.Attachment0      = att
        ap.Parent           = primary
        local ao  = Instance.new("AlignOrientation")
        ao.Mode             = Enum.OrientationAlignmentMode.OneAttachment
        -- Strictly upright (zero roll/pitch, preserve yaw).
        local _, ry, _ = primary.CFrame:ToOrientation()
        ao.CFrame           = CFrame.new(primary.Position) * CFrame.fromOrientation(0, ry, 0)
        ao.MaxTorque        = math.huge
        ao.Responsiveness   = 200
        ao.RigidityEnabled  = true
        ao.Attachment0      = att
        ao.Parent           = primary
        table.insert(_vehConstraints, att)
        table.insert(_vehConstraints, ap)
        table.insert(_vehConstraints, ao)
    end

    local originalPosition = Util.Client.Character:GetPivot().Position
    local _truckCollideConn = nil

    local function EndPlacement()
        --if not isActive() then return end
        self.Status._lassoPlacementSession = nil
        self.Status._endLassoPlacement     = nil
        if progressNotice then
            progressNotice:Dismiss()
            progressNotice = nil
        end
        if _truckCollideConn then
            pcall(function() _truckCollideConn:Disconnect() end)
            _truckCollideConn = nil
        end
        clearVehicleLock()
        if vehicle and vehicle.Parent then
            pcall(function() self:SetVehicleProperties(vehicle, { CanCollide = true }) end)
            if oldVehiclePosition then
                pcall(function() vehicle:PivotTo(CFrame.new(oldVehiclePosition)) end)
            end
        end
        if vehicle then
            pcall(function() self:SetHumanoidState(Enum.HumanoidStateType.Jumping, true) end)
            pcall(function() self:Teleport(CFrame.new(originalPosition)) end)
        end
        local btn = Util.Imports.Library.Buttons["Place Items"]
        if btn then btn:Set("Place Items") end
        -- Always clear selection when placement finishes — but NOT mid-queue,
        -- because the queue manager needs the selection list for the next group.
        if not self._stackerQueue then
            pcall(function() self:LassoClearSelection() end)
        end
        if self._stackerQueue then
            task.defer(function() self:_advanceStackerGroup() end)
        end
    end

    self.Status._lassoPlacementSession = session
    self.Status._endLassoPlacement     = EndPlacement

    local btn = Util.Imports.Library.Buttons["Place Items"]
    if btn then btn:Set("Abort") end

    updateNotice()

    task.spawn(function()
        -- ── Truck init ────────────────────────────────────────────────────────
        if self._stackerUseTruck then
            local ok, veh = pcall(function() return Util.Imports.Ancestor:SelectVehicle() end)
            vehicle = ok and veh or nil
            if vehicle then
                oldVehiclePosition = vehicle:GetPivot().Position
                pcall(function() self:LassoDeselectItem(vehicle) end)
                -- Remove the vehicle from the placement list if it ended up there.
                local filteredItems, filteredOffsets = {}, {}
                for idx, m in ipairs(items) do
                    if m ~= vehicle then
                        table.insert(filteredItems,   m)
                        table.insert(filteredOffsets, offsets[idx])
                    end
                end
                items   = filteredItems
                offsets = filteredOffsets
                total   = #items
                -- Disable fly before sitting (matches autobuy pattern).
                if Util.Imports.Settings.Character.Fly then
                    Util.Imports.Settings.Character.Fly = false
                    pcall(function() self:NoFly() end)
                end
                Util.Imports.Ancestor:ForceSitInVehicle(vehicle)
                repeat Util.Imports.Maid:Wait()
                    if not isActive() then EndPlacement() return end
                until Util.Client.Character.Humanoid.SeatPart ~= nil
                -- Lock humanoid in seat so it can't be ejected.
                pcall(function() self:SetHumanoidState(Enum.HumanoidStateType.Jumping, false) end)
                -- Every-frame enforcer: keep the truck non-collidable for the whole session.
                _truckCollideConn = Util.Services.RunService.Heartbeat:Connect(function()
                    if vehicle and vehicle.Parent then
                        pcall(function() self:SetVehicleProperties(vehicle, { CanCollide = false }) end)
                    end
                end)
            else
                self:Notice("No vehicle selected — stacking without truck.")
            end
        end

        -- ── Placement loop ────────────────────────────────────────────────────
        local placed_set = {}

        -- Pre-sort iteration order by WORLD position of each item's final spot.
        -- Primary key: Y (lowest first → bottom layer first).
        -- Secondary keys: X then Z, so items within the same layer are placed
        -- in a deterministic spatial order rather than random selection order.
        local order = {}
        for idx = 1, #items do order[idx] = idx end
        local worldPos = {}
        for idx = 1, #items do
            worldPos[idx] = (originCF * offsets[idx]).Position
        end
        local EPS = 0.05
        table.sort(order, function(a, b)
            local pa, pb = worldPos[a], worldPos[b]
            if math.abs(pa.Y - pb.Y) > EPS then return pa.Y < pb.Y end
            if math.abs(pa.X - pb.X) > EPS then return pa.X < pb.X end
            return pa.Z < pb.Z
        end)

        local function zeroVelocity(m)
            for _, d in m:GetDescendants() do
                if d:IsA("BasePart") then
                    d.AssemblyLinearVelocity  = Vector3.zero
                    d.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end

        -- No AlignPosition / AlignOrientation / StackerPin attachments are
        -- created anywhere in the stacker. zeroVelocity + the settle pass below
        -- are the only post-placement stabilisation we use.

        -- Computes the world Y of the model's LOWEST point if it were placed at
        -- plannedCF (without actually moving it). Correctly accounts for any
        -- rotation applied to the preview (tilt / flip / rotate).
        local function bottomYAtCFrame(m, plannedCF)
            local currentPivot = m:GetPivot()
            local minY = math.huge
            for _, p in m:GetDescendants() do
                if p:IsA("BasePart") then
                    local localCF = currentPivot:ToObjectSpace(p.CFrame)
                    local worldCF = plannedCF * localCF
                    local sx, sy, sz = p.Size.X * 0.5, p.Size.Y * 0.5, p.Size.Z * 0.5
                    for _, dx in ipairs({-sx, sx}) do
                        for _, dy in ipairs({-sy, sy}) do
                            for _, dz in ipairs({-sz, sz}) do
                                local corner = worldCF * Vector3.new(dx, dy, dz)
                                if corner.Y < minY then minY = corner.Y end
                            end
                        end
                    end
                end
            end
            return minY
        end

        -- Raycast at the target XZ to find the actual resting surface, then shift
        -- the placed CFrame in world Y so the model's true rotated bottom sits
        -- exactly on the hit point. Rotation is preserved.
        local function snapTargetToSurface(m, plannedCF)
            local rp     = RaycastParams.new()
            local filter = { m }
            if Util.Client.Character then table.insert(filter, Util.Client.Character) end
            if vehicle then table.insert(filter, vehicle) end
            rp.FilterDescendantsInstances = filter
            rp.FilterType                 = Enum.RaycastFilterType.Exclude
            local castOrigin = Vector3.new(plannedCF.Position.X, plannedCF.Position.Y + 200, plannedCF.Position.Z)
            local hit        = workspace:Raycast(castOrigin, Vector3.new(0, -400, 0), rp)
            if not hit then return plannedCF end
            local bottomY = bottomYAtCFrame(m, plannedCF)
            local deltaY  = hit.Position.Y - bottomY
            return plannedCF + Vector3.new(0, deltaY, 0)
        end

        for orderIdx = 1, #order do
            if not isActive() then break end
            local i = order[orderIdx]
            if placed_set[i] then continue end
            local model = items[i]
            if not (model and model.Parent) then continue end

            local targetCF = originCF * offsets[i]

            if vehicle and vehicle.Parent then
                local main    = model:FindFirstChild("Main") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
                local vehCF, vehSize = vehicle:GetBoundingBox()

                -- Teleport truck next to this item (CanCollide = true during the move,
                -- matching the autobuy pattern so physics positions correctly).
                if (vehCF.Position - model:GetPivot().Position).Magnitude > 5 then
                    clearVehicleLock()
                    pcall(function() self:SetVehicleProperties(vehicle, { CanCollide = true }) end)

                    -- The bed is the "Part" inside Vehicle.Parts with the most Welds.
                    local bedPart
                    local partsFolder = vehicle:FindFirstChild("Parts")
                    if partsFolder then
                        local bestWelds = -1
                        for _, child in partsFolder:GetChildren() do
                            if child:IsA("BasePart") and child.Name == "Part" then
                                local weldCount = 0
                                for _, sub in child:GetChildren() do
                                    if sub:IsA("WeldConstraint") or sub:IsA("Weld") then
                                        weldCount += 1
                                    end
                                end
                                if weldCount > bestWelds then
                                    bestWelds = weldCount
                                    bedPart   = child
                                end
                            end
                        end
                    end

                    -- Build an upright target CFrame at the model's position.
                    local modelPos = model:GetPivot().Position
                    local _, modelSize = model:GetBoundingBox()
                    -- Truck sits BELOW the model so the bed pokes up into the bottom —
                    -- improves contact / network ownership acquisition.
                    local dropY  = (modelSize.Y * 0.5) + (vehSize.Y * 0.5) - 2.5
                    local target = CFrame.new(modelPos.X, modelPos.Y - dropY, modelPos.Z)

                    -- We want bedWorldCF == target, so pivot = target * (pivot→bed offset)⁻¹.
                    -- TeleportVehicle_Autobuy then applies its own forward offset; pre-compensate so
                    -- the net effect lands the bed exactly under the model.
                    local pivotCF = vehicle:GetPivot()
                    local bedLocal
                    if bedPart then
                        bedLocal = pivotCF:ToObjectSpace(bedPart.CFrame)
                    else
                        -- No named bed — assume rear quarter of the vehicle.
                        bedLocal = CFrame.new(0, 0, vehSize.Z * 0.25)
                    end
                    -- Cancel rotation in the offset (we only care about translation under upright truck).
                    bedLocal = CFrame.new(bedLocal.Position)
                    -- Also pre-cancel the +Z, -Size.X/2 shift that TeleportVehicle_Autobuy adds:
                    local autobuyOffset = CFrame.new(0, 0, -vehSize.X / 2)
                    local preTarget = target * (autobuyOffset * bedLocal):Inverse()

                    local att, ap, ao = self:TeleportVehicle_Autobuy(preTarget, vehicle)
                    if att then
                        -- Force the AlignOrientation to keep the truck strictly upright
                        -- (zero roll/pitch, preserve yaw).
                        if ao then
                            local _, ry, _ = ao.CFrame:ToOrientation()
                            ao.CFrame = CFrame.new(ao.CFrame.Position) * CFrame.fromOrientation(0, ry, 0)
                        end
                        table.insert(_vehConstraints, att)
                        table.insert(_vehConstraints, ap)
                        table.insert(_vehConstraints, ao)
                    else
                        lockVehicleInPlace()
                    end
                end

                -- Raycast to align the bed precisely against the model's underside,
                -- BEFORE waiting for network ownership.
                if bedPart and bedPart.Parent then
                    local rp     = RaycastParams.new()
                    local filter = { model }
                    if Util.Client.Character then table.insert(filter, Util.Client.Character) end
                    rp.FilterDescendantsInstances = filter
                    rp.FilterType                 = Enum.RaycastFilterType.Exclude
                    local origin = model:GetPivot().Position + Vector3.new(0, 200, 0)
                    local hit    = workspace:Raycast(origin, Vector3.new(0, -400, 0), rp)
                    if hit and hit.Instance and hit.Instance:IsDescendantOf(vehicle) then
                        local _, modelSizeNow = model:GetBoundingBox()
                        local modelBottomY    = origin.Y - modelSizeNow.Y * 0.5
                        local bedTopY         = hit.Position.Y
                        local deltaY          = modelBottomY - bedTopY
                        if math.abs(deltaY) > 0.05 then
                            pcall(function()
                                vehicle:PivotTo(vehicle:GetPivot() + Vector3.new(0, deltaY, 0))
                            end)
                            lockVehicleInPlace()
                            pcall(function() self:SetVehicleProperties(vehicle, { CanCollide = false }) end)
                        end
                    end
                end

                -- Build a strict-order batch: the current item plus any IMMEDIATELY
                -- following items in the sorted order that we already own. We stop
                -- at the first unowned item, so the batch is always contiguous in
                -- preview-Y order — guaranteeing strict bottom-to-top placement.
                local batch = { {model = model, targetCF = targetCF, idx = i} }
                for k = orderIdx + 1, #order do
                    local j = order[k]
                    if placed_set[j] then continue end
                    local m = items[j]
                    if not (m and m.Parent) then break end
                    local owned = false
                    for _, d in m:GetDescendants() do
                        if d:IsA("BasePart") and isnetworkowner(d) then
                            owned = true
                            break
                        end
                    end
                    if not owned then break end  -- stop at first unowned: preserve order
                    table.insert(batch, {
                        model    = m,
                        targetCF = originCF * offsets[j],
                        previewCF = refParts and refParts[j] or nil,
                        idx      = j,
                    })
                end

                -- Helper: any BasePart in the model is network-owned.
                local function ownsAnyPart(m)
                    if not (m and m.Parent) then return false end
                    for _, d in m:GetDescendants() do
                        if d:IsA("BasePart") and isnetworkowner(d) then
                            return true
                        end
                    end
                    return false
                end

                -- Acquire ownership of EVERY item in the batch BEFORE any teleport.
                -- We don't move on until isnetworkowner returns true for at least
                -- one part of every entry — otherwise the server snaps items back.
                local allOwned = false
                while not allOwned do
                    if not isActive() then break end
                    allOwned = true
                    for _, entry in ipairs(batch) do
                        if not ownsAnyPart(entry.model) then
                            allOwned = false
                            Util:FireServer("ClientIsDragging", entry.model)
                        end
                    end
                    if not allOwned then
                        Util.Services.RunService.Heartbeat:Wait()
                    end
                end

                -- Now that we own them all, place each in strict batch order — instantly.
                -- Planks have an unreliable model pivot (it goes stale after prior stacks
                -- and PivotTo can leave the parts at their old world positions on
                -- subsequent attempts). Position by the first WoodSection's CFrame
                -- directly so the placement always lands at placeCF regardless of
                -- whatever the model's pivot is currently pointing at.
                local placedThisBatch = {}
                for _, entry in ipairs(batch) do
                    if not isActive() then break end
                    if not (entry.model and entry.model.Parent) then continue end
                    -- Use the literal CFrame the user saw in the preview.
                    local placeCF = entry.previewCF or entry.targetCF
                    zeroVelocity(entry.model)
                    -- Use the exact same teleport path the non-batch / non-stacker
                    -- code uses (TeleportObject → PivotTo). Direct CFrame
                    -- assignment leaves Model.WorldPivot stale, which breaks
                    -- downstream selection/lasso checks (planks getting
                    -- selected from outside the lasso bounds was the symptom).
                    self:TeleportObject(entry.model, placeCF)
                    zeroVelocity(entry.model)
                    placed_set[entry.idx] = true
                    self:LassoDeselectItem(entry.model)
                    placed += 1
                    table.insert(placedThisBatch, entry.model)
                end
                updateNotice()

                -- ── Settle phase ──────────────────────────────────────────────
                -- Distance to the next item determines how long we wait. Items far
                -- apart give physics & networking more time to fully relax before
                -- the truck convoys across the property.
                local nextIdx
                for k = orderIdx + 1, #order do
                    local j = order[k]
                    if not placed_set[j] and items[j] and items[j].Parent then
                        nextIdx = j; break
                    end
                end

                local settleTime = 0.1
                if nextIdx then
                    local lastPlaced = placedThisBatch[#placedThisBatch]
                    if lastPlaced and lastPlaced.Parent then
                        local dist = (items[nextIdx]:GetPivot().Position - lastPlaced:GetPivot().Position).Magnitude
                        -- 0.1s base, +1s per 500 studs, capped at 0.5s.
                        settleTime = math.clamp(0.1 + dist / 500, 0.1, 0.5)
                    end
                end

                -- Two quick velocity-zero passes during the settle window.
                local steps    = 2
                local stepWait = settleTime / steps
                for _ = 1, steps do
                    if not isActive() then break end
                    for _, m in ipairs(placedThisBatch) do
                        if m and m.Parent then zeroVelocity(m) end
                    end
                    task.wait(stepWait)
                end

                -- Lift truck straight up before traversing so it doesn't plow
                -- through the just-placed stack on its way to the next item.
                if vehicle and vehicle.Parent and nextIdx then
                    pcall(function()
                        local cur = vehicle:GetPivot()
                        vehicle:PivotTo(cur + Vector3.new(0, 30, 0))
                    end)
                    clearVehicleLock()
                    lockVehicleInPlace()
                end
            else
                local placeCF = targetCF
                zeroVelocity(model)
                self:TeleportObject(model, placeCF)
                zeroVelocity(model)
                for _ = 1, 4 do
                    Util:InvokeServer("TestPing")
                end
                self:LassoDeselectItem(model)
                placed += 1
                updateNotice()
            end
        end
        EndPlacement()
    end)
end

function CoreFramework:OwnsBlueprint(Name)
	local Cache = self._blueprintCache or Util.Client.PlayerBlueprints.Blueprints:GetChildren()
	for _, v in Cache do
		if v.Name == Name then
			return true
		end
	end
	return false
end

function CoreFramework:TemporaryBlueprints(State)
    local PlayerBlueprints = Util.Client.PlayerBlueprints.Blueprints

    if not State then
        if not self._blueprintCache then return end
        Util.Imports.Maid:deregister("TemporaryBlueprintWatcher")
        PlayerBlueprints:ClearAllChildren()
        for _, Blueprint in self._blueprintCache do
            Blueprint.Parent = PlayerBlueprints
        end
        self._blueprintCache = nil
        return
    end

    self._blueprintCache = (function()
        local list = {}
        for _, Blueprint in PlayerBlueprints:GetChildren() do
            table.insert(list, Blueprint:Clone())
        end
        return list
    end)()

    PlayerBlueprints:ClearAllChildren()
    for _, Blueprint in Util.Services.ReplicatedStorage.ClientItemInfo:QueryDescendants("#WoodCost") do
        local Model = Blueprint.Parent
        local Folder = Instance.new("Folder")
        Folder.Name = Model.Name
        Model.ItemCategory:Clone().Parent = Folder
        Folder.Parent = PlayerBlueprints
    end
end

