-- While the player holds LeftShift AND workspace.Dragger exists, force the
-- humanoid's WalkSpeed to 0. The previous WalkSpeed is restored when either
-- condition no longer holds. Runtime only — never modifies saved settings.
task.spawn(function()
	local UIS = Util.Services.UserInputService
	local locked      = false
