        actionLabel.TextXAlignment         = Enum.TextXAlignment.Left
        actionLabel.ZIndex                 = 22
        actionLabel.Parent                 = row

        local startKeyCode = safeKeyCode(entry.section, entry.key)

        local chip = Instance.new("TextButton")
        chip.Name                   = "WAChip_" .. entry.name
        chip.BackgroundColor3       = T.ElementDark
        chip.BackgroundTransparency = 0
        chip.BorderSizePixel        = 0
        chip.AnchorPoint            = Vector2.new(1, 0.5)
        chip.Position               = UDim2.new(1, -8, 0.5, 0)
        chip.Size                   = UDim2.new(0, 70, 0, 24)
        chip.Text                   = keyName(startKeyCode)
        chip.TextColor3             = T.Text
        chip.TextSize               = 14
        chip.Font                   = Enum.Font.GothamBold
        chip.AutoButtonColor        = false
        chip.ZIndex                 = 23
        Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 7)
        chip.Parent = row
        waChips[entry.name] = chip

        chip.Activated:Connect(function()
            -- Toggle off if this chip is already capturing
            if waActiveCapture == entry then
                waActiveCapture = nil
                tw(chip, fast, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                chip.Text = keyName(safeKeyCode(entry.section, entry.key))
                return
            end

            -- Reset previously-capturing chip
            if waActiveCapture then
                local prev = waChips[waActiveCapture.name]
                if prev then
                    tw(prev, med, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                    prev.Text = keyName(safeKeyCode(waActiveCapture.section, waActiveCapture.key))
                end
            end

            waActiveCapture = entry
            local oldText = chip.Text
            chip.Text = "..."
            tw(chip, fast, { BackgroundColor3 = T.Accent, TextColor3 = Color3.new(1, 1, 1) }):Play()

            local conn
            conn = game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                conn:Disconnect()
                if waActiveCapture ~= entry then return end
                waActiveCapture = nil

                if input.KeyCode == Enum.KeyCode.Escape then
                    chip.Text = oldText
                    tw(chip, med, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()
                    return
                end

                local enumName = tostring(input.KeyCode):match("Enum%.KeyCode%.(.+)") or tostring(input.KeyCode)
                chip.Text = keyName(input.KeyCode)
                tw(chip, med, { BackgroundColor3 = T.ElementDark, TextColor3 = T.Text }):Play()

                -- Save to settings, sync BuildMode entry, refresh active listeners.
                local sec = Util.Imports.Settings[entry.section]
                if sec then sec[entry.key] = enumName end
                for _, e in ipairs(BuildMode.Keybinds) do
                    if e.action == entry.bmAction then
                        e.keyCode = input.KeyCode
                        e.display = keyName(input.KeyCode)
                        break
                    end
                end
                if writefile then
                    pcall(writefile, "Ancestor/Games/" .. tostring(Util.GameId) .. "/ClientSettings.json", Util.Services.HttpService:JSONEncode(Util.Imports.Settings))
                end
                pcall(function() Util.Imports.Placement:RefreshKeybinds() end)
                pcall(function() Util.Imports.CoreFramework:RefreshLassoKeybinds() end)
            end)
        end)
    end

    local function borrow()
        -- Offset so borrowed wire-art controls sit between the "WIRE ART"
        -- sub-header (10) and the "GRID" sub-header (50).
        for i, row in ipairs(rows) do
            row.LayoutOrder = 10 + i
            row.ZIndex      = 21
            row.Parent      = section
        end
    end

    local function restore()
        for _, row in ipairs(rows) do
            if row.Parent == section then
                row.LayoutOrder = rowLO[row]
                row.ZIndex      = rowZ[row]
                row.Parent      = rowHome[row]
            end
        end
    end

    makeScrollable(panel, section, T, 900)
    local show, hide, reset = makePanelFade(panel, section, title, borrow, restore)
    return panel, show, hide, function()
        restore()
        if _waGridStepRestore then pcall(_waGridStepRestore) end
        reset()
    end
end

