local _AutobuyRawSelections = {}
local _AutobuyQuantity = 1
local _AutobuyTotalLabel = {}

local function _RefreshAutobuyLabel()
    local label = _AutobuyTotalLabel[1]
    if not label then return end
    local total = 0
    for _, item in ipairs(_AutobuyRawSelections) do
        local price = tonumber(item:match("%$(%d+)"))
        if price then total += price end
    end
    local cost = total * _AutobuyQuantity
    label:SetVisible(cost > 0)
    label:Set("Total Cost: $" .. tostring(cost))
end

