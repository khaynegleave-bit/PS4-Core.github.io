function Ancestor:HardDragger()
	setconstant(Util.Imports.Environments.Dragger.click, 61, Util.Imports.Settings.Player.HardDragger and 9e9 or 5)

	if not Util.Imports.Settings.Player.HardDragger then
		Util.Imports.Maid:deregister('HardDragger')
		return
	end

	local function applyToDragger(Dragger)
		local BodyGyro     = Dragger:WaitForChild('BodyGyro')
		local BodyPosition = Dragger:WaitForChild('BodyPosition')

		repeat Util.Imports.Maid:Wait()
			if Util.Imports.Settings.Player.HardDragger then
				BodyPosition.P        = 10000 * 8
				BodyPosition.D        = 1000
				BodyPosition.maxForce = Vector3.new(1, 1, 1) * 1000000
				BodyGyro.maxTorque    = Vector3.new(1, 1, 1) * 200
				BodyGyro.P            = 1200
				BodyGyro.D            = 140
			end
		until not workspace:FindFirstChild('Dragger') or not Util.Imports.Settings.Player.HardDragger

		-- Revert physics whether the dragger left or the toggle was disabled.
		BodyPosition.P        = 10000
		BodyPosition.D        = 800
		BodyPosition.maxForce = Vector3.new(17000, 17000, 17000)
		BodyGyro.maxTorque    = Vector3.new(200, 200, 200)
		BodyGyro.P            = 1200
		BodyGyro.D            = 140
	end

	-- Apply immediately if a dragger is already in the workspace.
	local existing = workspace:FindFirstChild('Dragger')
	if existing then
		task.spawn(applyToDragger, existing)
	end

	Util.Imports.Maid:register("HardDragger", workspace.ChildAdded:Connect(function(Dragger)
		if tostring(Dragger) == 'Dragger' then
			task.spawn(applyToDragger, Dragger)
		end
	end))
end

