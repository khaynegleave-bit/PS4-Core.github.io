function CoreFramework:IsTreeModdable(Tree)
    local treeClass = Tree:FindFirstChild("TreeClass")
    if not treeClass then return false end

    local sections = Tree:QueryDescendants("#WoodSection")
    if not sections or #sections <= 4 then return false end

    local isConifer = treeClass.Value == "Pine" or treeClass.Value == "Fir"

    if isConifer then
        for _, ws in sections do
            if ws.Size.X >= 0.5 and ws.Size.Y >= .3 then
                return true
            end
        end
        return false
    end

    for _, ws in sections do
        local id = ws:FindFirstChild("ID")
        local parentId = ws:FindFirstChild("ParentID")
        if id and parentId and id.Value >= 3 then
            for _, sibling in sections do
                if sibling.Parent == ws.Parent then
                    local sid = sibling:FindFirstChild("ID")
                    if sid and sid.Value == parentId.Value then
                        return true
                    end
                end
            end
        end
    end
    return false
end

function CoreFramework:FindTree(RequestedClass, RequireModdable)
    local UnitAmount, BestTree = 0, nil
    local TreeRegions = self.Status.TreeRegions
    for _, TreeRegion in TreeRegions do
        for _, Tree in TreeRegion:GetChildren() do
            local TreeClass = Tree:FindFirstChild("TreeClass")
            local Owner = Tree:FindFirstChild("Owner")
            if (TreeClass and Owner) and TreeClass.Value == RequestedClass and (Owner.Value == Util.Client or Owner.Value == nil) then
                local TreeUnits = self:GetWoodUnits(Tree)
                if TreeUnits > UnitAmount  then
                    local Trunk = self:GetTrunkFromTree(Tree)
                    if Trunk.Size.Y < .5 then
                        continue
                    end
                    if RequireModdable and not self:IsTreeModdable(Tree) then
                        continue
                    end
                    BestTree, UnitAmount = Tree, TreeUnits
                end
            end
        end
    end
    return BestTree
end

